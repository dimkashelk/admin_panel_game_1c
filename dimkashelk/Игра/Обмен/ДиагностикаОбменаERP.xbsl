импорт Данные

@ВПроекте
метод СостояниеСвязи(ЕстьСообщение: Булево, ВозрастСекунд: Число): Строка
    если не ЕстьСообщение
        возврат "Сообщения ещё не получены"
    ;
    возврат ВозрастСекунд > 120 ? "Более 2 минут без сообщений" : "Сообщение получено недавно"
;

@НаСервере
метод НастройкаКоманды(Игра: Игры.Объект, Участник: УчастникиИгры.Объект): Строка
    если Игра.Демонстрационная
        возврат "Демонстрационная игра — ERP не требуется"
    ;
    попытка
        ПроверкиДанных.Требовать(Игра.ПрофильERP != Неопределено, "Не сохранён профиль игры")
        ПроверкиДанных.Требовать(Участник.ПодключениеERP != Неопределено, "Не назначено подключение ERP")
        ПроверкиДанных.Требовать(Участник.ПодключениеERP!.ЗагрузитьОбъект()!.Активно, "Подключение ERP отключено")
        знч Привязка = ОбменERP.ИдПривязки(Участник.Ссылка)
        знч Подключение = Участник.ПодключениеERP
        для Элемент из ПротоколERP.МассивJson(ПротоколERP.Прочитать(НастройкиERP.ПримерСоответствий()).Получить("items"))
            знч Код = ПротоколERP.СтрокаJson(ПротоколERP.ОбъектJson(Элемент), "itemCode")
            знч Номенклатура = ОбменERP.Продукт(Код)
            знч Соответствие = Запрос{
                ВЫБРАТЬ RefKey, КоэффициентПересчета, ЕдиницаERP ИЗ СоответствияERP
                ГДЕ Подключение == %Подключение И НоменклатураИгры == %Номенклатура
            }.Выполнить().ПервыйИлиНеопределено()
            ПроверкиДанных.Требовать(Соответствие != Неопределено и Соответствие!.КоэффициентПересчета > 0
                и Соответствие!.ЕдиницаERP != "", "Нет полного соответствия: %{Код}")
            ПротоколERP.ПроверитьСхему(Соответствие!.RefKey, КонтрактERP.Схема("UUID"), "Соответствие %{Код}")
        ;
        возврат "Настройки заполнены; готовность ERP проверяется при подготовке"
    поймать Ошибка: Исключение
        возврат Ошибка.Описание
    ;
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод Получить(Игра: Игры.Ссылка, ТолькоНезавершенные: Булево): ДиагностикаИгрыERP
    ДоступИгры.ПроверитьВедущего(Игра)
    исп КонтекстДоступа.Привилегированный()
    знч Объект = Игра.ЗагрузитьОбъект()!
    знч Подключения = <СтрокаПодключенияERP>[]
    знч Команды = <СтрокаДиагностикиERP>[]
    для Строка из Запрос{
        ВЫБРАТЬ Ссылка ИЗ УчастникиИгры ГДЕ Игра == %Игра И Активен УПОРЯДОЧИТЬ ПО ПорядокУчастника
    }.Выполнить()
        знч Участник = Строка.Ссылка
        знч Команда = Участник.ЗагрузитьОбъект()!
        знч Привязка = Запрос{ВЫБРАТЬ ИдПривязки ИЗ ПривязкиСервисовERP ГДЕ Участник == %Участник И Активно}.Выполнить().ПервыйИлиНеопределено()
        знч Последнее = Запрос{
            ВЫБРАТЬ ПЕРВЫЕ 1 ВремяПриема КАК Время ИЗ СообщенияERP
            ГДЕ Игра == %Игра И Участник == %Участник И Маршрут != "" И Маршрут != "admin-reconciliation"
            УПОРЯДОЧИТЬ ПО ВремяПриема УБЫВ
        }.Выполнить().ПервыйИлиНеопределено()?.Время
        знч Итог = новый СтрокаПодключенияERP(Участник = Участник, Команда = Команда.НаименованиеКоманды,
            База = Команда.ПодключениеERP?.ЗагрузитьОбъект()?.КодБазы ?? "Не назначена",
            Привязка = Привязка?.ИдПривязки ?? "Не назначена", ПоследнееСообщение = Последнее,
            Связь = СостояниеСвязи(Последнее != Неопределено, Последнее == Неопределено ? 0 : (Момент.Сейчас() - Последнее!).ВСекундах()),
            Настройка = НастройкаКоманды(Объект, Команда))
        для Задание из Запрос{ВЫБРАТЬ Статус ИЗ КомандыОбмена ГДЕ Игра == %Игра И Участник == %Участник}.Выполнить()
            если Задание.Статус == СтатусыКомандОбмена.Ожидает
                Итог.Ожидают = Итог.Ожидают + 1
            иначе если Задание.Статус == СтатусыКомандОбмена.Выполняется
                Итог.Выполняются = Итог.Выполняются + 1
            иначе если Задание.Статус == СтатусыКомандОбмена.Ошибка
                Итог.Ошибки = Итог.Ошибки + 1
            ;
        ;
        Подключения.Добавить(Итог)
    ;
    для Задание из Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 200 Ссылка ИЗ КомандыОбмена ГДЕ Игра == %Игра
            И (НЕ %ТолькоНезавершенные ИЛИ Статус != СтатусыКомандОбмена.Выполнена)
        УПОРЯДОЧИТЬ ПО ВремяСоздания УБЫВ, Последовательность УБЫВ
    }.Выполнить()
        знч Команда = Задание.Ссылка.ЗагрузитьОбъект()!
        пер Документы = ""
        если Команда.Подтверждение != Неопределено
            знч Подтверждение = ПротоколERP.Прочитать(СообщенияERP.Текст(Команда.Подтверждение!))
            для Документ из ПротоколERP.МассивJson(Подтверждение.ПолучитьИлиУмолчание("erpDocumentIds", <Объект?>[]))
                Документы = Документы + (Документы == "" ? "" : ", ") + (Документ как Строка)
            ;
        ;
        Команды.Добавить(новый СтрокаДиагностикиERP(Команда = Команда.Участник!.ЗагрузитьОбъект()!.НаименованиеКоманды,
            НомерРаунда = Команда.Раунд?.ЗагрузитьОбъект()?.НомерРаунда, Последовательность = Команда.Последовательность,
            ИдКоманды = Команда.ИдОперации, Действие = Команда.Вид.Представление(), Статус = Команда.Статус.Представление(),
            Создана = Команда.ВремяСоздания, Подтверждена = Команда.ВремяПодтверждения,
            КодОшибки = Команда.КодОшибки, ОписаниеОшибки = Команда.ОписаниеОшибки, ДокументыERP = Документы))
    ;
    возврат новый ДиагностикаИгрыERP(Игра = Игра, Версия = Объект.ВерсияСостояния,
        Сводка = "%{Объект.Наименование}: %{Объект.Статус.Представление()}, %{Объект.Фаза.Представление()}. Команд: %{Подключения.Размер()}",
        Подключения = Подключения, Команды = Команды)
;
