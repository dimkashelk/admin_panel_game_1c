импорт Данные

@ВПроекте
метод НайтиЗаказ(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, ИдЗаказа: Строка): КомандыОбмена.Объект
    знч СсылкаИгры = Игра.Ссылка
    для Строка из Запрос{
        ВЫБРАТЬ Ссылка ИЗ КомандыОбмена ГДЕ Игра == %СсылкаИгры И Участник == %Участник И Вид == ВидыКомандERP.СоздатьЗаказКлиента
            И Статус == СтатусыКомандОбмена.Выполнена
    }.Выполнить()
        знч Команда = Строка.Ссылка.ЗагрузитьОбъект()!
        знч Подтверждение = ПротоколERP.Прочитать(СообщенияERP.Текст(Команда.Подтверждение!))
        если ПротоколERP.МассивJson(Подтверждение.Получить("erpDocumentIds")).Содержит(ИдЗаказа)
            возврат Команда
        ;
    ;
    выбросить новый ПротоколERP.Ошибка("Заказ ERP не подтверждён в своей области", 404, "RESOURCE_NOT_FOUND")
;

@ВПроекте
метод ПроверитьИсторическийТокен(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка,
    Данные: Соответствие<Строка, Объект?>, Фаза: Строка)
    знч СсылкаИгры = Игра.Ссылка
    знч Токен = ПротоколERP.СтрокаJson(Данные, "phaseToken")
    знч Раунд = ОбменERP.Раунд(Игра, ПротоколERP.ЧислоJson(Данные, "roundNumber"))
    пер Найден = Ложь
    для Строка из Запрос{
        ВЫБРАТЬ Ссылка ИЗ КомандыОбмена ГДЕ Игра == %СсылкаИгры И Участник == %Участник И Раунд == %Раунд И ТокенФазы == %Токен
            И (Вид == ВидыКомандERP.ОткрытьФазу ИЛИ Вид == ВидыКомандERP.Возобновить)
    }.Выполнить()
        знч Команда = Строка.Ссылка.ЗагрузитьОбъект()!
        знч Нагрузка = ПротоколERP.ОбъектJson(ПротоколERP.Прочитать(СообщенияERP.Текст(Команда.Конверт!)).Получить("payload"))
        если Нагрузка.Получить("phaseCode") == Фаза
            Найден = Истина
        ;
    ;
    ПротоколERP.Требовать(Найден, "PHASE_CONFLICT", "Токен не относится к ранее открытой фазе этой команды", КодОтвета = 409)
;

@ВПроекте
метод СуммаСтроки(Игра: Игры.Объект, Код: Строка, Количество: Число, Цена: Число): Число
    знч Ставка = новый Число(ПротоколERP.СтрокаJson(НастройкиERP.ПравилоПродукта(Игра, Код), "vatRate"))
    возврат ПротоколERP.СуммаСНДС(Количество, Цена, НастройкиERP.Настройки(Игра).Получить("taxMode") == "price_excludes_vat", Ставка)
;

@ВПроекте
метод ПринятьПродажи(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Данные: Соответствие<Строка, Объект?>, Ресурс: Строка): Строка
    знч ИдРеализации = ПротоколERP.СтрокаJson(Данные, "erpRealizationId")
    знч Версия = ПротоколERP.ЧислоJson(Данные, "stateVersion")
    знч Старый = ОбменERP.ПоследнееСостояние(Игра, Участник, "sales-events", ИдРеализации)
    если ОбменERP.ПроверитьВерсию(Старый, Данные, Версия)
        возврат Старый!.ЗагрузитьОбъект()!.Ресурс
    ;
    знч Заказ = НайтиЗаказ(Игра, Участник, ПротоколERP.СтрокаJson(Данные, "erpOrderId"))
    знч КонвертЗаказа = ПротоколERP.Прочитать(СообщенияERP.Текст(Заказ.Конверт!))
    знч Нагрузка = ПротоколERP.ОбъектJson(КонвертЗаказа.Получить("payload"))
    ПротоколERP.Требовать(Нагрузка.Получить("allocationId") == Данные.Получить("allocationId")
        и КонвертЗаказа.Получить("gameMonth") == Данные.Получить("gameMonth")
        и КонвертЗаказа.Получить("roundNumber") == Данные.Получить("roundNumber"), "PHASE_CONFLICT", "Реализация не соответствует заказу и периоду", КодОтвета = 409)
    знч Фаза = ПротоколERP.ЧислоJson(Данные, "roundNumber") == 0 ? "initial_sales" : "sales"
    ПроверитьИсторическийТокен(Игра, Участник, Данные, Фаза)
    знч Строки = ПротоколERP.МассивJson(Данные.Получить("lines"))
    знч Платежи = ПротоколERP.МассивJson(Данные.Получить("payments"))
    ПротоколERP.УникальныеПоля(Строки, ["productCode"], "lines")
    ПротоколERP.УникальныеПоля(Платежи, ["erpPaymentId"], "payments")
    если Старый != Неопределено
        знч ПрежниеДанные = ПротоколERP.Прочитать(СообщенияERP.Текст(Старый!))
        ПротоколERP.Требовать(ПрежниеДанные.Получить("erpOrderId") == Данные.Получить("erpOrderId")
            и ПрежниеДанные.Получить("allocationId") == Данные.Получить("allocationId"), "BUSINESS_OPERATION_CONFLICT", "Реализация уже привязана к другому заказу", КодОтвета = 409)
        для Элемент из ПротоколERP.МассивJson(ПрежниеДанные.Получить("payments"))
            знч СтарыйПлатеж = ПротоколERP.ОбъектJson(Элемент)
            пер Сохранен = Ложь
            для Новый из Платежи
                если ПротоколERP.ОбъектJson(Новый).Получить("erpPaymentId") == СтарыйПлатеж.Получить("erpPaymentId")
                    Сохранен = Истина
                ;
            ;
            ПротоколERP.Требовать(Сохранен, "VALIDATION_ERROR", "Исчезнувший платёж требуется передать как reversed", "payments")
        ;
    ;
    знч Расчет = новый РасчетыРынка.Ссылка(новый Ууид(ПротоколERP.СтрокаJson(Данные, "allocationId")))
    знч СсылкаРаунда = Заказ.Раунд
    ПротоколERP.Требовать(Расчет.ЗагрузитьОбъект()?.Раунд == СсылкаРаунда, "PHASE_CONFLICT", "Распределение не принадлежит раунду", КодОтвета = 409)
    знч Проведена = ПротоколERP.БулевоJson(Данные, "posted")
    пер Сумма = 0
    для Элемент из Строки
        знч Строка = ПротоколERP.ОбъектJson(Элемент)
        знч Код = ПротоколERP.СтрокаJson(Строка, "productCode")
        знч Количество = ПротоколERP.ЧислоJson(Строка, "quantity")
        знч Цена = новый Число(ПротоколERP.СтрокаJson(Строка, "unitPrice"))
        пер ЕстьСтрокаЗаказа = Ложь
        для ЭлементЗаказа из ПротоколERP.МассивJson(Нагрузка.Получить("lines"))
            знч СтрокаЗаказа = ПротоколERP.ОбъектJson(ЭлементЗаказа)
            если СтрокаЗаказа.Получить("productCode") == Код
                ПротоколERP.Требовать(Цена == новый Число(ПротоколERP.СтрокаJson(СтрокаЗаказа, "unitPrice")), "VALIDATION_ERROR", "Цена отличается от заказа рынка", "lines.unitPrice")
                знч Продукт = ОбменERP.Продукт(Код)
                знч Другие = Запрос{
                    ВЫБРАТЬ СУММА(Отгружено).ЗаменитьNull(0) КАК Количество ИЗ ИсполнениеПродаж
                    ГДЕ Расчет == %Расчет И Участник == %Участник И Продукт == %Продукт И ИдРеализацииERP != %ИдРеализации
                }.Выполнить().ПервыйИлиНеопределено()!
                ПротоколERP.Требовать((Проведена ? Количество : 0) + Другие.Количество <= ПротоколERP.ЧислоJson(СтрокаЗаказа, "quantity"),
                    "VALIDATION_ERROR", "Суммарная отгрузка превышает заказ рынка", "lines.quantity")
                ЕстьСтрокаЗаказа = Истина
            ;
        ;
        ПротоколERP.Требовать(ЕстьСтрокаЗаказа, "VALIDATION_ERROR", "Строка отсутствует в заказе рынка", "lines.productCode")
        знч ИтогСтроки = новый Число(ПротоколERP.СтрокаJson(Строка, "lineAmount"))
        ПротоколERP.Требовать(ИтогСтроки == СуммаСтроки(Игра, Код, Количество, Цена), "VALIDATION_ERROR", "Сумма строки или НДС не соответствует профилю", "lines.lineAmount")
        Сумма = Сумма + (Проведена ? ИтогСтроки : 0)
    ;
    пер Оплачено = 0
    для Элемент из Платежи
        знч Платеж = ПротоколERP.ОбъектJson(Элемент)
        если Платеж.Получить("status") == "posted"
            Оплачено = Оплачено + новый Число(ПротоколERP.СтрокаJson(Платеж, "amount"))
        ;
    ;
    ПротоколERP.Требовать(Оплачено <= Сумма, "VALIDATION_ERROR", "Переплата или оплаченная отмена требуют исправления учёта", "payments")
    ЗаписатьПродажу(Расчет, Участник, Данные, Сумма)
    ПометитьДляСверки(Игра, Участник, СсылкаРаунда!)
    ЗапроситьОплату(Игра, Участник, Данные, Сумма - Оплачено)
    возврат Ресурс
;

метод ЗаписатьПродажу(Расчет: РасчетыРынка.Ссылка, Участник: УчастникиИгры.Ссылка, Данные: Соответствие<Строка, Объект?>, Сумма: Число)
    знч ИдРеализации = ПротоколERP.СтрокаJson(Данные, "erpRealizationId")
    знч Версия = ПротоколERP.ЧислоJson(Данные, "stateVersion")
    знч Проведена = ПротоколERP.БулевоJson(Данные, "posted")
    знч Исполнение = новый ИсполнениеПродаж.НаборЗаписей()
    Исполнение.Фильтр.Установить(Расчет = Расчет, Участник = Участник, ИдРеализацииERP = ИдРеализации)
    знч ПлатежныеЗаписи = новый ПлатежиПродаж.НаборЗаписей()
    ПлатежныеЗаписи.Фильтр.Установить(Расчет = Расчет, Участник = Участник, ИдРеализацииERP = ИдРеализации)
    знч Строки = ПротоколERP.МассивJson(Данные.Получить("lines"))
    знч Распределено: Соответствие<Строка, Число> = {:}
    пер Индекс = 0
    для Элемент из Строки
        знч Строка = ПротоколERP.ОбъектJson(Элемент)
        знч Продукт = ОбменERP.Продукт(ПротоколERP.СтрокаJson(Строка, "productCode"))
        знч СуммаСтроки = Проведена ? новый Число(ПротоколERP.СтрокаJson(Строка, "lineAmount")) : 0
        пер Оплачено = 0
        для ЭлементПлатежа из ПротоколERP.МассивJson(Данные.Получить("payments"))
            знч Платеж = ПротоколERP.ОбъектJson(ЭлементПлатежа)
            знч Ид = ПротоколERP.СтрокаJson(Платеж, "erpPaymentId")
            знч СуммаПлатежа = Платеж.Получить("status") == "posted" ? новый Число(ПротоколERP.СтрокаJson(Платеж, "amount")) : 0
            пер Доля = Индекс == Строки.Размер() - 1 ? СуммаПлатежа - Распределено.ПолучитьИлиУмолчание(Ид, 0)
                : (Сумма == 0 ? 0 : (СуммаПлатежа * СуммаСтроки / Сумма).Округлить(2))
            знч Осталось = СуммаПлатежа - Распределено.ПолучитьИлиУмолчание(Ид, 0)
            Доля = Доля > Осталось ? Осталось : (Доля < 0 ? 0 : Доля)
            Распределено.Вставить(Ид, Распределено.ПолучитьИлиУмолчание(Ид, 0) + Доля)
            ПлатежныеЗаписи.ДобавитьЗапись(Расчет = Расчет, Участник = Участник, Продукт = Продукт, ИдРеализацииERP = ИдРеализации,
                ИдПлатежаERP = Ид, СуммаПлатежа = Доля, ВерсияФакта = Версия, МоментПлатежа = новый Момент(ПротоколERP.СтрокаJson(Данные, "capturedAt")))
            Оплачено = Оплачено + Доля
        ;
        Исполнение.ДобавитьЗапись(Расчет = Расчет, Участник = Участник, Продукт = Продукт, ИдРеализацииERP = ИдРеализации,
            Отгружено = Проведена ? ПротоколERP.ЧислоJson(Строка, "quantity") : 0, Цена = новый Число(ПротоколERP.СтрокаJson(Строка, "unitPrice")),
            СуммаРеализации = СуммаСтроки, Оплачено = Оплачено, ВерсияФакта = Версия)
        Индекс = Индекс + 1
    ;
    ПлатежныеЗаписи.Записать()
    Исполнение.Записать()
;

@ВПроекте
метод ЗапроситьОплату(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Данные: Соответствие<Строка, Объект?>, Долг: Число)
    если Долг <= 0 или не Участник.ЗагрузитьОбъект()!.Активен или Игра.Статус != СостоянияИгры.Идет или не [ФазыИгры.СтартоваяПродажа, ФазыИгры.Продажи].Содержит(Игра.Фаза)
        или ПротоколERP.ЧислоJson(Данные, "roundNumber") != ОбменERP.НомерРаунда(Игра)
        или (Игра.Дедлайн != Неопределено и Момент.Сейчас() > Игра.Дедлайн!)
        возврат
    ;
    знч СсылкаИгры = Игра.Ссылка
    знч ИдРеализации = ПротоколERP.СтрокаJson(Данные, "erpRealizationId")
    пер Зарезервировано = 0
    знч Операции = <Строка>[]
    для Строка из Запрос{
        ВЫБРАТЬ Ссылка ИЗ КомандыОбмена ГДЕ Игра == %СсылкаИгры И Участник == %Участник И Вид == ВидыКомандERP.ОплатитьРеализацию
            И Статус != СтатусыКомандОбмена.Ошибка И Статус != СтатусыКомандОбмена.Отменена
    }.Выполнить()
        знч Команда = Строка.Ссылка.ЗагрузитьОбъект()!
        знч Нагрузка = ПротоколERP.ОбъектJson(ПротоколERP.Прочитать(СообщенияERP.Текст(Команда.Конверт!)).Получить("payload"))
        если Нагрузка.Получить("erpRealizationId") != ИдРеализации
            продолжить
        ;
        знч Операция = ПротоколERP.СтрокаJson(Нагрузка, "paymentOperationId")
        если Операции.Содержит(Операция)
            продолжить
        ;
        Операции.Добавить(Операция)
        пер Отражена = Ложь
        если Команда.Статус == СтатусыКомандОбмена.Выполнена и Команда.Подтверждение != Неопределено
            знч Документы = ПротоколERP.МассивJson(ПротоколERP.Прочитать(СообщенияERP.Текст(Команда.Подтверждение!)).Получить("erpDocumentIds"))
            для Платеж из ПротоколERP.МассивJson(Данные.Получить("payments"))
                если Документы.Содержит(ПротоколERP.ОбъектJson(Платеж).Получить("erpPaymentId"))
                    Отражена = Истина
                ;
            ;
        ;
        если не Отражена
            Зарезервировано = Зарезервировано + новый Число(ПротоколERP.СтрокаJson(Нагрузка, "amount"))
        ;
    ;
    знч КОплате = Долг - Зарезервировано
    если КОплате <= 0
        возврат
    ;
    знч Версия = ПротоколERP.ЧислоJson(Данные, "stateVersion")
    знч Ключ = "%{ИдРеализации}:%{Версия}"
    знч Нагрузка: Соответствие<Строка, Объект?> = {"erpRealizationId": ИдРеализации,
        "paymentOperationId": Ууид.Версия5("erp-payment:%{СсылкаИгры.Ид}:%{Участник.Ид}:%{Ключ}").ВСтроку(),
        "amount": НастройкиERP.Деньги(КОплате), "currency": "RUB",
        "documentDate": НастройкиERP.КалендарьРаунда(Игра, ОбменERP.НомерРаунда(Игра)).Получить("documentDate")}
    ОбменERP.ВыдатьКоманду(Игра, Участник, ВидыКомандERP.ОплатитьРеализацию, "pay_realization", Нагрузка, Ключ)
;

@ВПроекте
метод ПринятьИсполнение(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Данные: Соответствие<Строка, Объект?>, Ресурс: Строка): Строка
    ПротоколERP.Требовать(НастройкиERP.Настройки(Игра).Получить("executionMode") == "automatic", "MODE_MISMATCH", "Автоматические цепочки недоступны в basic", КодОтвета = 409)
    знч Вид = ПротоколERP.СтрокаJson(Данные, "executionKind")
    знч Ид = ПротоколERP.СтрокаJson(Данные, "operationId")
    знч Версия = ПротоколERP.ЧислоJson(Данные, "executionVersion")
    знч Старый = ОбменERP.ПоследнееСостояние(Игра, Участник, "execution-events", Ид)
    если ОбменERP.ПроверитьВерсию(Старый, Данные, Версия)
        возврат Старый!.ЗагрузитьОбъект()!.Ресурс
    ;
    знч Номер = ПротоколERP.ЧислоJson(Данные, "roundNumber")
    знч Фаза = Вид == "month_closing" ? "analysis" : (Вид == "sales" и Номер == 0 ? "initial_sales" : Вид)
    ПроверитьИсторическийТокен(Игра, Участник, Данные, Фаза)
    пер ХозяйственныйКлюч = "%{Номер}:%{Вид}"
    если Вид == "sales"
        знч Заказ = НайтиЗаказ(Игра, Участник, ПротоколERP.СтрокаJson(Данные, "erpOrderId"))
        ПротоколERP.Требовать(Заказ.Раунд == ОбменERP.Раунд(Игра, Номер), "PHASE_CONFLICT", "Цепочка продажи относится к другому раунду", КодОтвета = 409)
        ХозяйственныйКлюч = "sales:" + ПротоколERP.СтрокаJson(Данные, "erpOrderId")
    иначе если Вид == "month_closing"
        ХозяйственныйКлюч = "month_closing:" + ПротоколERP.СтрокаJson(Данные, "gameMonth")
    ;
    знч ХозяйственныйИдентификатор = ОбменERP.ПоследнееСостояние(Игра, Участник, "execution-key", ХозяйственныйКлюч)
    если ХозяйственныйИдентификатор != Неопределено
        знч ПрежняяЦепочка = ПротоколERP.Прочитать(СообщенияERP.Текст(ХозяйственныйИдентификатор!))
        ПротоколERP.Требовать(ПрежняяЦепочка.Получить("operationId") == Ид
            и ПрежняяЦепочка.ПолучитьИлиНеопределено("planId") == Данные.ПолучитьИлиНеопределено("planId")
            и ПрежняяЦепочка.ПолучитьИлиНеопределено("planVersion") == Данные.ПолучитьИлиНеопределено("planVersion"),
            "BUSINESS_OPERATION_CONFLICT", "Вторая цепочка или изменение утверждённого плана запрещены", КодОтвета = 409)
    ;
    знч Корректировки = ПротоколERP.МассивJson(Данные.Получить("adjustments"))
    ПротоколERP.УникальныеПоля(Корректировки, ["itemCode"], "adjustments")
    для Элемент из Корректировки
        знч Корректировка = ПротоколERP.ОбъектJson(Элемент)
        знч Исходное = новый Число(ПротоколERP.СтрокаJson(Корректировка, "originalQuantity"))
        знч Исполняемое = новый Число(ПротоколERP.СтрокаJson(Корректировка, "effectiveQuantity"))
        знч Код = ПротоколERP.СтрокаJson(Корректировка, "itemCode")
        ПротоколERP.Требовать(Исполняемое <= Исходное и (Корректировка.Получить("reasonCode") != "unchanged" или Исполняемое == Исходное),
            "VALIDATION_ERROR", "Неверное сокращение плана", "adjustments")
        ПротоколERP.Требовать(Корректировка.Получить("unitCode") == НастройкиERP.Единица(Код), "MAPPING_INCOMPLETE", "Неверная единица плана", "adjustments.unitCode")
        если Вид == "production"
            ПротоколERP.Требовать(["CityRide", "SportDrive", "CargoMax", "TourPro"].Содержит(Код)
                и Исходное == Исходное.Округлить(0) и Исполняемое == Исполняемое.Округлить(0), "VALIDATION_ERROR", "Выпуск должен содержать целые велосипеды", "adjustments")
        иначе если Вид == "purchasing"
            ПротоколERP.Требовать(["FRAME_STD", "FRAME_CARGO", "POWER_350", "POWER_500", "BAT_300", "BAT_500", "BAT_800",
                "WHEELS_STD", "WHEELS_HEAVY", "EQUIP_BASE", "EQUIP_PLUS"].Содержит(Код), "MAPPING_INCOMPLETE", "Закупка содержит неизвестную комплектующую", "adjustments.itemCode")
        ;
    ;
    знч Шаги = ПротоколERP.МассивJson(Данные.Получить("steps"))
    ПротоколERP.УникальныеПоля(Шаги, ["stepCode"], "steps")
    ПротоколERP.УникальныеПоля(Шаги, ["businessOperationId"], "steps")
    знч Обязательные = Вид == "purchasing" ? ["create_supplier_order", "receive_components", "pay_supplier"] :
        (Вид == "production" ? ["create_production_order", "issue_materials", "produce_goods", "move_goods"] :
        (Вид == "sales" ? ["ship_goods", "create_realization", "await_customer_payment"] : ["close_month"]))
    ПротоколERP.Требовать(Шаги.Размер() == Обязательные.Размер(), "VALIDATION_ERROR", "Неполный набор шагов", "steps")
    пер Индекс = 0
    для Элемент из Шаги
        знч Шаг = ПротоколERP.ОбъектJson(Элемент)
        ПротоколERP.Требовать(Шаг.Получить("stepCode") == Обязательные[Индекс], "VALIDATION_ERROR", "Нарушен порядок шагов", "steps")
        если Данные.Получить("status") == "completed"
            ПротоколERP.Требовать(["completed", "skipped"].Содержит(ПротоколERP.СтрокаJson(Шаг, "status")), "VALIDATION_ERROR", "Не все обязательные шаги завершены", "steps.status")
        ;
        ПротоколERP.Требовать(Шаг.Получить("status") != "skipped" или ПротоколERP.МассивJson(Шаг.Получить("erpDocumentIds")).Пусто(), "VALIDATION_ERROR", "Пропущенный шаг не создаёт документов", "steps.erpDocumentIds")
        Индекс = Индекс + 1
    ;
    если Старый != Неопределено
        знч ПрежниеДанные = ПротоколERP.Прочитать(СообщенияERP.Текст(Старый!))
        для Поле из ["executionKind", "roundNumber", "gameMonth", "planId", "planVersion", "erpOrderId"]
            ПротоколERP.Требовать(ПрежниеДанные.ПолучитьИлиНеопределено(Поле) == Данные.ПолучитьИлиНеопределено(Поле), "BUSINESS_OPERATION_CONFLICT", "Контекст цепочки неизменяем", Поле, 409)
        ;
        знч СтарыеШаги = ПротоколERP.МассивJson(ПрежниеДанные.Получить("steps"))
        ПротоколERP.Требовать(Шаги.Размер() == СтарыеШаги.Размер(), "BUSINESS_OPERATION_CONFLICT", "Шаги цепочки неизменяемы", КодОтвета = 409)
        пер НомерШага = 0
        для Элемент из Шаги
            знч Шаг = ПротоколERP.ОбъектJson(Элемент)
            знч СтарыйШаг = ПротоколERP.ОбъектJson(СтарыеШаги[НомерШага])
            ПротоколERP.Требовать(СтарыйШаг.Получить("stepCode") == Шаг.Получить("stepCode") и СтарыйШаг.Получить("businessOperationId") == Шаг.Получить("businessOperationId"),
                "BUSINESS_OPERATION_CONFLICT", "Хозяйственные ключи шагов неизменяемы", КодОтвета = 409)
            если СтарыйШаг.Получить("status") == "completed" или СтарыйШаг.Получить("status") == "skipped"
                ПротоколERP.Требовать(СтарыйШаг.Получить("status") == Шаг.Получить("status")
                    и ПротоколERP.КаноническийJson(СтарыйШаг.Получить("erpDocumentIds")) == ПротоколERP.КаноническийJson(Шаг.Получить("erpDocumentIds")),
                    "BUSINESS_OPERATION_CONFLICT", "Завершённый шаг не исполняется заново", КодОтвета = 409)
            ;
            НомерШага = НомерШага + 1
        ;
    ;
    если ХозяйственныйИдентификатор == Неопределено
        ОбменERP.СохранитьСообщение(Игра, Участник, ОбменERP.ИдПривязки(Участник), Данные, "execution-key", ХозяйственныйКлюч, 1, Ид)
    ;
    если Вид == "sales" и Данные.Получить("status") == "completed"
        ПроверитьОплаты(Игра, Участник, ОбменERP.Раунд(Игра, Номер))
    ;
    возврат Ресурс
;

@ВПроекте
метод ПроверитьОплаты(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Раунд: РаундыИгры.Ссылка)
    знч Расчет = Раунд.ЗагрузитьОбъект()!.ОкончательныйРасчет
    ПротоколERP.Требовать(Расчет != Неопределено, "PHASE_CONFLICT", "Окончательный рынок ещё не рассчитан", КодОтвета = 409)
    знч Финансы = Запрос{
        ВЫБРАТЬ СУММА(СуммаРеализации).ЗаменитьNull(0) КАК Выручка, СУММА(Оплачено).ЗаменитьNull(0) КАК Оплачено
        ИЗ ИсполнениеПродаж ГДЕ Расчет == %Расчет И Участник == %Участник
    }.Выполнить().ПервыйИлиНеопределено()!
    ПротоколERP.Требовать(Финансы.Выручка == Финансы.Оплачено, "VALIDATION_ERROR", "Не все реализации оплачены", "financials.customerDebt")
;

@ВПроекте
метод СохранитьИтог(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Снимок: СнимкиERP.Объект)
    знч Раунд = Снимок.Раунд!.ЗагрузитьОбъект()!
    знч Расчет = Раунд.ОкончательныйРасчет
    знч Финансы = Запрос{
        ВЫБРАТЬ СУММА(СуммаРеализации).ЗаменитьNull(0) КАК Выручка ИЗ ИсполнениеПродаж ГДЕ Расчет == %Расчет И Участник == %Участник
    }.Выполнить().ПервыйИлиНеопределено()!
    пер ДеньгиНачало = новый Число(ПротоколERP.СтрокаJson(НастройкиERP.Подготовка(Игра), "initialCash"))
    если Раунд.НомерРаунда > 0
        знч СсылкаИгры = Игра.Ссылка
        знч Номер = Раунд.НомерРаунда - 1
        знч ПредыдущийРаунд = Запрос{ВЫБРАТЬ Ссылка ИЗ РаундыИгры ГДЕ Игра == %СсылкаИгры И НомерРаунда == %Номер}.Выполнить().ПервыйИлиНеопределено()!.Ссылка
        знч Итог = Запрос{ВЫБРАТЬ ДеньгиКонец, ЗакрытиеМесяцаПодтверждено ИЗ РезультатыРаундов ГДЕ Раунд == %ПредыдущийРаунд И Участник == %Участник}.Выполнить().ПервыйИлиНеопределено()
        ПротоколERP.Требовать(Итог != Неопределено и Итог!.ЗакрытиеМесяцаПодтверждено, "MONTH_NOT_CLOSED", "Предыдущий период требует сверки", КодОтвета = 409)
        ДеньгиНачало = Итог!.ДеньгиКонец
    ;
    пер Остаток = 0
    для Строка из Снимок.Остатки
        если Строка.СкладERP == "finished_goods"
            Остаток = Остаток + Строка.Количество
        ;
    ;
    знч Итоги = новый РезультатыРаундов.НаборЗаписей()
    Итоги.Фильтр.Установить(Раунд = Снимок.Раунд, Участник = Участник)
    Итоги.ДобавитьЗапись(Раунд = Снимок.Раунд, Участник = Участник, ФинальныйСнимок = Снимок.Ссылка,
        ДеньгиНачало = ДеньгиНачало, ДеньгиКонец = Снимок.Деньги, ВыручкаФакт = Финансы.Выручка,
        Прибыль = Снимок.Прибыль, Долги = 0, ОстаткиГП = Остаток, ЗакрытиеМесяцаПодтверждено = Истина)
    Итоги.Записать()
;

@ВПроекте
метод ПометитьДляСверки(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Раунд: РаундыИгры.Ссылка)
    знч ИграСсылка = Игра.Ссылка
    знч Номер = Раунд.ЗагрузитьОбъект()!.НомерРаунда
    пер Изменено = Ложь
    для Период из Запрос{ВЫБРАТЬ Ссылка ИЗ РаундыИгры ГДЕ Игра == %ИграСсылка И НомерРаунда >= %Номер}.Выполнить()
        знч СсылкаРаунда = Период.Ссылка
        знч Старый = Запрос{
            ВЫБРАТЬ ФинальныйСнимок, ДеньгиНачало, ДеньгиКонец, ВыручкаФакт, Прибыль, Долги, ОстаткиГП
            ИЗ РезультатыРаундов ГДЕ Раунд == %СсылкаРаунда И Участник == %Участник
        }.Выполнить().ПервыйИлиНеопределено()
        если Старый == Неопределено
            продолжить
        ;
        знч Итоги = новый РезультатыРаундов.НаборЗаписей()
        Итоги.Фильтр.Установить(Раунд = СсылкаРаунда, Участник = Участник)
        Итоги.ДобавитьЗапись(Раунд = СсылкаРаунда, Участник = Участник, ФинальныйСнимок = Старый!.ФинальныйСнимок,
            ДеньгиНачало = Старый!.ДеньгиНачало, ДеньгиКонец = Старый!.ДеньгиКонец, ВыручкаФакт = Старый!.ВыручкаФакт,
            Прибыль = Старый!.Прибыль, Долги = Старый!.Долги, ОстаткиГП = Старый!.ОстаткиГП, ЗакрытиеМесяцаПодтверждено = Ложь)
        Итоги.Записать()
        Изменено = Истина
    ;
    если Изменено
        Игра.РезультатыОпубликованы = Ложь
        Игра.Записать()
    ;
;

@ВПроекте
метод ПроверитьГотовностьИсполнения(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка)
    если НастройкиERP.Настройки(Игра).Получить("executionMode") != "automatic" или не [ФазыИгры.Закупки, ФазыИгры.Производство].Содержит(Игра.Фаза)
        возврат
    ;
    знч Вид = НастройкиERP.КодФазы(Игра.Фаза)
    знч Ключ = "%{ОбменERP.НомерРаунда(Игра)}:%{Вид}"
    знч Маркер = ОбменERP.ПоследнееСостояние(Игра, Участник, "execution-key", Ключ)
    ПротоколERP.Требовать(Маркер != Неопределено, "PHASE_CONFLICT", "Автоматическая цепочка ещё не зарегистрирована", КодОтвета = 409)
    знч Ид = ПротоколERP.СтрокаJson(ПротоколERP.Прочитать(СообщенияERP.Текст(Маркер!)), "operationId")
    знч Состояние = ОбменERP.ПоследнееСостояние(Игра, Участник, "execution-events", Ид)
    ПротоколERP.Требовать(Состояние != Неопределено и ПротоколERP.Прочитать(СообщенияERP.Текст(Состояние!)).Получить("status") == "completed",
        "PHASE_CONFLICT", "Автоматическое исполнение не завершено", КодОтвета = 409)
;

@ВПроекте
метод ПроверитьНачальныйСнимок(Игра: Игры.Объект, Снимок: СнимкиERP.Объект)
    знч Задание = НастройкиERP.Подготовка(Игра)
    для Элемент из ПротоколERP.МассивJson(Задание.Получить("balances"))
        знч Остаток = ПротоколERP.ОбъектJson(Элемент)
        знч Номенклатура = ОбменERP.Продукт(ПротоколERP.СтрокаJson(Остаток, "itemCode"))
        пер Совпал = Ложь
        для Строка из Снимок.Остатки
            если Строка.Номенклатура == Номенклатура и Строка.СкладERP == Остаток.Получить("warehouseId")
                Совпал = Строка.Количество == новый Число(ПротоколERP.СтрокаJson(Остаток, "quantity"))
            ;
        ;
        ПротоколERP.Требовать(Совпал, "VALIDATION_ERROR", "Начальные остатки отличаются от задания", "snapshotId")
    ;
    для Элемент из ПротоколERP.МассивJson(Задание.Получить("initialPrices"))
        знч Цена = ПротоколERP.ОбъектJson(Элемент)
        пер Совпала = Ложь
        для Предложение из Снимок.Предложения
            если Предложение.Продукт == ОбменERP.Продукт(ПротоколERP.СтрокаJson(Цена, "productCode"))
                Совпала = Предложение.Цена == новый Число(ПротоколERP.СтрокаJson(Цена, "price"))
            ;
        ;
        ПротоколERP.Требовать(Совпала, "VALIDATION_ERROR", "Начальные цены отличаются от задания", "snapshotId")
    ;
    знч ИдСнимка = Снимок.Ссылка.Ид.ВСтроку()
    знч Конверт = Запрос{ВЫБРАТЬ Ссылка ИЗ СообщенияERP ГДЕ Ресурс == %ИдСнимка И Вид == "snapshots"}.Выполнить().ПервыйИлиНеопределено()!
    знч Данные = ПротоколERP.Прочитать(СообщенияERP.Текст(Конверт.Ссылка))
    ПротоколERP.Требовать(Данные.СодержитКлюч("financials") и ПротоколERP.ОбъектJson(Данные.Получить("financials")).Получить("cash") == Задание.Получить("initialCash"),
        "VALIDATION_ERROR", "Контрольный снимок должен подтверждать начальные деньги", "snapshotId")
;

@ВПроекте
метод ПроверитьЦенуПланирования(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Данные: Соответствие<Строка, Объект?>, Код: Строка, Цена: Число)
    если НастройкиERP.Настройки(Игра).Получить("priceFixation") != "after_planning" или ПротоколERP.ЧислоJson(Данные, "roundNumber") == 0
        возврат
    ;
    знч Команда = ОбменERP.НайтиКоманду(Игра, Участник, ПротоколERP.СтрокаJson(Данные, "freezeCommandId"))
    знч ТекущаяНагрузка = ПротоколERP.ОбъектJson(ПротоколERP.Прочитать(СообщенияERP.Текст(Команда.Конверт!)).Получить("payload"))
    если ТекущаяНагрузка.Получить("phaseCode") != "sales"
        возврат
    ;
    знч СсылкаИгры = Игра.Ссылка
    знч Раунд = Команда.Раунд
    пер Зафиксирована = Ложь
    для Строка из Запрос{
        ВЫБРАТЬ Ссылка ИЗ КомандыОбмена ГДЕ Игра == %СсылкаИгры И Участник == %Участник И Раунд == %Раунд
            И Вид == ВидыКомандERP.ЗафиксироватьФазу И Статус == СтатусыКомандОбмена.Выполнена
    }.Выполнить()
        знч Фиксация = Строка.Ссылка.ЗагрузитьОбъект()!
        знч Нагрузка = ПротоколERP.ОбъектJson(ПротоколERP.Прочитать(СообщенияERP.Текст(Фиксация.Конверт!)).Получить("payload"))
        если Нагрузка.Получить("phaseCode") != "planning"
            продолжить
        ;
        знч Подтверждение = ПротоколERP.Прочитать(СообщенияERP.Текст(Фиксация.Подтверждение!))
        знч Снимок = ОбменERP.СнимокОбласти(Игра, Участник, ПротоколERP.СтрокаJson(Подтверждение, "snapshotId"))
        для Предложение из Снимок.Предложения
            если Предложение.Продукт == ОбменERP.Продукт(Код)
                ПротоколERP.Требовать(Предложение.Цена == Цена, "VALIDATION_ERROR", "Цена отличается от фиксации планирования", "offers.price")
                Зафиксирована = Истина
            ;
        ;
    ;
    ПротоколERP.Требовать(Зафиксирована, "SNAPSHOT_NOT_FROZEN", "Нет подтверждённой цены планирования", КодОтвета = 409)
;

@ВПроекте
метод ВозобновитьОплаты(Игра: Игры.Объект)
    знч Ссылка = Игра.Ссылка
    для Участник из ОбменERP.Участники(Игра)
        знч Ключи = Запрос{ВЫБРАТЬ РАЗЛИЧНЫЕ Ключ ИЗ СообщенияERP ГДЕ Игра == %Ссылка
            И Участник == %Участник И Вид == "sales-events"}.Выполнить()
        для Ключ из Ключи
            знч Документ = ОбменERP.ПоследнееСостояние(Игра, Участник, "sales-events", Ключ.Ключ)!
            знч Данные = ПротоколERP.Прочитать(СообщенияERP.Текст(Документ))
            пер Долг = 0
            если ПротоколERP.БулевоJson(Данные, "posted")
                для Строка из ПротоколERP.МассивJson(Данные.Получить("lines"))
                    Долг = Долг + новый Число(ПротоколERP.СтрокаJson(ПротоколERP.ОбъектJson(Строка), "lineAmount"))
                ;
                для Строка из ПротоколERP.МассивJson(Данные.Получить("payments"))
                    знч Платеж = ПротоколERP.ОбъектJson(Строка)
                    если Платеж.Получить("status") == "posted"
                        Долг = Долг - новый Число(ПротоколERP.СтрокаJson(Платеж, "amount"))
                    ;
                ;
                ЗапроситьОплату(Игра, Участник, Данные, Долг)
            ;
        ;
    ;
;

@ВПроекте
метод ПроверитьИсполнениеЗаказа(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Ссылка: КомандыОбмена.Ссылка)
    знч Команда = Ссылка.ЗагрузитьОбъект()!
    знч Подтверждение = ПротоколERP.Прочитать(СообщенияERP.Текст(Команда.Подтверждение!))
    для Ид из ПротоколERP.МассивJson(Подтверждение.Получить("erpDocumentIds"))
        знч ИдЗаказа = Ид как Строка
        если НастройкиERP.Настройки(Игра).Получить("executionMode") == "automatic"
            знч Ключ = "sales:%{ИдЗаказа}"
            знч Маркер = ОбменERP.ПоследнееСостояние(Игра, Участник, "execution-key", Ключ)
            ПроверкиДанных.Требовать(Маркер != Неопределено, "Нет отчёта об исполнении заказа")
            знч Начало = ПротоколERP.Прочитать(СообщенияERP.Текст(Маркер!))
            знч Последний = ОбменERP.ПоследнееСостояние(Игра, Участник, "execution-events", ПротоколERP.СтрокаJson(Начало, "operationId"))!
            ПроверкиДанных.Требовать(ПротоколERP.Прочитать(СообщенияERP.Текст(Последний)).Получить("status") == "completed", "Продажа ERP не завершена")
        иначе
            знч ИграСсылка = Игра.Ссылка
            пер Найдено = Ложь
            для Строка из Запрос{ВЫБРАТЬ РАЗЛИЧНЫЕ Ключ ИЗ СообщенияERP ГДЕ Игра == %ИграСсылка И Участник == %Участник И Вид == "sales-events"}.Выполнить()
                знч Событие = ПротоколERP.Прочитать(СообщенияERP.Текст(ОбменERP.ПоследнееСостояние(Игра, Участник, "sales-events", Строка.Ключ)!))
                если Событие.Получить("erpOrderId") == ИдЗаказа
                    Найдено = Истина
                ;
            ;
            ПроверкиДанных.Требовать(Найдено, "Нет фактов исполнения заказа ERP")
        ;
    ;
;
