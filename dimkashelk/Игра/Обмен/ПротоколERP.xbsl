импорт Данные

@ВПроекте
исключение Ошибка
    обз знч КодОтвета: Число
    обз знч Код: Строка
    знч Поле: Строка = ""
;

@ВПроекте
метод Требовать(Условие: Булево, Код: Строка, Сообщение: Строка, Поле: Строка = "", КодОтвета: Число = 422)
    если не Условие
        выбросить новый Ошибка(Описание = Сообщение, КодОтвета = КодОтвета, Код = Код, Поле = Поле)
    ;
;

@ВПроекте
метод ОбъектJson(Значение: Объект?, Путь: Строка = ""): Соответствие<Строка, Объект?>
    попытка
        знч Исходное = Значение как ЧитаемоеСоответствие<Строка, Объект?>
        знч Результат = <Строка, Объект?>{:}
        для Пара из Исходное
            Результат.Вставить(Пара.Ключ, Пара.Значение)
        ;
        возврат Результат
    поймать НеверныйТип: ИсключениеПроверкиТипа
        выбросить новый Ошибка(Описание = "Ожидается объект JSON", КодОтвета = 422, Код = "VALIDATION_ERROR", Поле = Путь)
    ;
;

@ВПроекте
метод МассивJson(Значение: Объект?, Путь: Строка = ""): Массив<Объект?>
    попытка
        знч Исходное = Значение как ЧитаемыйМассив<Объект?>
        знч Результат = <Объект?>[]
        для Элемент из Исходное
            Результат.Добавить(Элемент)
        ;
        возврат Результат
    поймать НеверныйТип: ИсключениеПроверкиТипа
        выбросить новый Ошибка(Описание = "Ожидается массив JSON", КодОтвета = 422, Код = "VALIDATION_ERROR", Поле = Путь)
    ;
;

@ВПроекте
метод СтрокаJson(Данные: ЧитаемоеСоответствие<Строка, Объект?>, Поле: Строка): Строка
    возврат Данные.Получить(Поле) как Строка
;

@ВПроекте
метод ЧислоJson(Данные: ЧитаемоеСоответствие<Строка, Объект?>, Поле: Строка): Число
    возврат Данные.Получить(Поле) как Число
;

@ВПроекте
метод БулевоJson(Данные: ЧитаемоеСоответствие<Строка, Объект?>, Поле: Строка): Булево
    возврат Данные.Получить(Поле) как Булево
;

@ВПроекте
метод Прочитать(Текст: Строка): Соответствие<Строка, Объект?>
    возврат СериализацияJson.ПрочитатьОбъект<Соответствие<Строка, Объект?>>(Текст)
;

@ВПроекте
метод Json(Значение: Объект?): Строка
    знч Настройки = новый НастройкиЗаписиОбъектовJson()
    Настройки.РежимЗаписиТипа = РежимЗаписиТипаJson.НеЗаписывать
    Настройки.ПереносСтрок = ПереносСтрокJson.Отсутствует
    Настройки.ЭкранированиеСимволов = ЭкранированиеСимволовJson.Отсутствует
    Настройки.ЭкранироватьСлеш = Ложь
    Настройки.ЭкранироватьОдинарныеКавычки = Ложь
    Настройки.ЭкранироватьАмперсанд = Ложь
    Настройки.ЭкранироватьУгловыеСкобки = Ложь
    Настройки.ЭкранироватьРазделителиСтрокИАбзацев = Ложь
    возврат СериализацияJson.ЗаписатьОбъект(Значение, Настройки)
;

// Canonical JSON follows Appendix В 1. Ordinary output formatting is independent.
@ВПроекте
метод КаноническийJson(Значение: Объект?): Строка
    если Значение == Неопределено
        возврат "null"
    ;
    попытка
        знч Данные = ОбъектJson(Значение)
        знч Ключи = <Строка>[]
        для Пара из Данные
            Ключи.Добавить(Пара.Ключ)
        ;
        пер Результат = "{"
        пер Разделитель = ""
        для Ключ из Ключи.Сортировать((Левый, Правый) -> Левый.Сравнить(Правый))
            Результат = Результат + Разделитель + Json(Ключ) + ":" + КаноническийJson(Данные.Получить(Ключ))
            Разделитель = ","
        ;
        возврат Результат + "}"
    поймать НеОбъект: Ошибка
        // Continue with array or primitive.
    ;
    попытка
        пер Результат = "["
        пер Разделитель = ""
        для Элемент из МассивJson(Значение)
            Результат = Результат + Разделитель + КаноническийJson(Элемент)
            Разделитель = ","
        ;
        возврат Результат + "]"
    поймать НеМассив: Ошибка
        // Continue with primitive.
    ;
    возврат Json(Значение)
;

@ВПроекте
метод Хеш(Данные: Строка|Байты): Строка
    знч Вычислитель = новый ХешированиеДанных(АлгоритмХеширования.Sha256)
    если Данные.ПолучитьТип() == Тип<Строка>
        Вычислитель.ДобавитьДанные((Данные как Строка).ВБайты())
    иначе
        Вычислитель.ДобавитьДанные(Данные)
    ;
    возврат Вычислитель.Результат.ВСтроку().ВНижнийРегистр()
;

@ВПроекте
метод ПроверитьСхему(Значение: Объект?, Схема: Соответствие<Строка, Объект?>, Путь: Строка = "")
    если Схема.СодержитКлюч("\$ref")
        ПроверитьСхему(Значение, КонтрактERP.Схема(СтрокаJson(Схема, "\$ref").Подстрока(21)), Путь)
        возврат
    ;
    если Схема.СодержитКлюч("anyOf")
        пер Подходит = Ложь
        для Вариант из МассивJson(Схема.Получить("anyOf"))
            попытка
                ПроверитьСхему(Значение, ОбъектJson(Вариант), Путь)
                Подходит = Истина
            поймать Несовпадение: Ошибка
                // Try the other explicitly permitted type, e.g. a nullable deadline.
            ;
        ;
        Требовать(Подходит, "VALIDATION_ERROR", "Значение не соответствует допустимым типам", Путь)
        возврат
    ;
    если Схема.СодержитКлюч("const")
        Требовать(Значение == Схема.Получить("const"), "VALIDATION_ERROR", "Недопустимое значение", Путь)
    ;
    если Схема.СодержитКлюч("enum")
        Требовать(МассивJson(Схема.Получить("enum")).Содержит(Значение), "VALIDATION_ERROR", "Значение отсутствует в перечне", Путь)
    ;
    знч ТипЗначения = Схема.ПолучитьИлиНеопределено("type")
    если ТипЗначения == "null"
        Требовать(Значение == Неопределено, "VALIDATION_ERROR", "Ожидается null", Путь)
    иначе если ТипЗначения == "object"
        знч Данные = ОбъектJson(Значение, Путь)
        знч Свойства = ОбъектJson(Схема.ПолучитьИлиУмолчание("properties", <Строка, Объект?>{:}))
        для Имя из МассивJson(Схема.ПолучитьИлиУмолчание("required", <Объект?>[]))
            Требовать(Данные.СодержитКлюч(Имя как Строка), "VALIDATION_ERROR", "Обязательное поле отсутствует", Путь + "." + (Имя как Строка))
        ;
        для Пара из Данные
            Требовать(Свойства.СодержитКлюч(Пара.Ключ) или Схема.ПолучитьИлиНеопределено("additionalProperties") != Ложь,
                "VALIDATION_ERROR", "Неизвестное поле", Путь + "." + Пара.Ключ)
            если Свойства.СодержитКлюч(Пара.Ключ)
                ПроверитьСхему(Пара.Значение, ОбъектJson(Свойства.Получить(Пара.Ключ)), Путь + "." + Пара.Ключ)
            ;
        ;
    иначе если ТипЗначения == "array"
        знч Значения = МассивJson(Значение, Путь)
        Требовать(Значения.Размер() >= (Схема.ПолучитьИлиУмолчание("minItems", 0) как Число)
            и Значения.Размер() <= (Схема.ПолучитьИлиУмолчание("maxItems", 2000) как Число), "VALIDATION_ERROR", "Неверное число элементов массива", Путь)
        знч Уникальные = <Строка>[]
        пер Индекс = 0
        для Элемент из Значения
            ПроверитьСхему(Элемент, ОбъектJson(Схема.Получить("items")), Путь + "[%{Индекс}]")
            если Схема.ПолучитьИлиНеопределено("uniqueItems") == Истина
                знч Ключ = КаноническийJson(Элемент)
                Требовать(не Уникальные.Содержит(Ключ), "VALIDATION_ERROR", "Повтор элемента", Путь)
                Уникальные.Добавить(Ключ)
            ;
            Индекс = Индекс + 1
        ;
    иначе если ТипЗначения == "integer"
        Требовать(Значение?.ПолучитьТип() == Тип<Число>, "VALIDATION_ERROR", "Ожидается целое число", Путь)
        знч Количество = Значение как Число
        Требовать(Количество == Количество.Округлить(0) и Количество >= ЧислоJson(Схема, "minimum")
            и Количество <= ЧислоJson(Схема, "maximum"), "VALIDATION_ERROR", "Число вне допустимого целого диапазона", Путь)
    иначе если ТипЗначения == "boolean"
        Требовать(Значение?.ПолучитьТип() == Тип<Булево>, "VALIDATION_ERROR", "Ожидается boolean", Путь)
    иначе если ТипЗначения == "string"
        Требовать(Значение?.ПолучитьТип() == Тип<Строка>, "VALIDATION_ERROR", "Ожидается строка", Путь)
        знч Текст = Значение как Строка
        Требовать(Текст.Длина() >= (Схема.ПолучитьИлиУмолчание("minLength", 0) как Число)
            и Текст.Длина() <= (Схема.ПолучитьИлиУмолчание("maxLength", 1048576) как Число), "VALIDATION_ERROR", "Неверная длина строки", Путь)
        если Схема.СодержитКлюч("pattern")
            Требовать(Текст.ПолноеСовпадение(новый Образец(СтрокаJson(Схема, "pattern"))), "VALIDATION_ERROR", "Неверный формат строки", Путь)
        ;
        знч Формат = Схема.ПолучитьИлиНеопределено("format")
        если Формат == "date" или Формат == "date-time"
            попытка
                если Формат == "date"
                    Требовать(Текст.ПолноеСовпадение('[0-9]{4}-[0-9]{2}-[0-9]{2}'), "VALIDATION_ERROR", "Ожидается дата YYYY-MM-DD", Путь)
                    знч ДатаДокумента = новый Дата(Текст)
                иначе
                    Требовать(Текст.ПолноеСовпадение('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})'),
                        "VALIDATION_ERROR", "Дата-время должна содержать смещение", Путь)
                    знч ВремяДанных = новый Момент(Текст)
                ;
            поймать НевернаяДата: ИсключениеНедопустимыйФормат
                Требовать(Ложь, "VALIDATION_ERROR", "Недопустимая дата", Путь)
            ;
        ;
    ;
    если Схема.СодержитКлюч("allOf")
        для Условие из МассивJson(Схема.Получить("allOf"))
            знч Правило = ОбъектJson(Условие)
            пер Применять = Истина
            если Правило.СодержитКлюч("if")
                попытка
                    ПроверитьСхему(Значение, ОбъектJson(Правило.Получить("if")), Путь)
                поймать Несовпадение: Ошибка
                    Применять = Ложь
                ;
            ;
            если Применять
                ПроверитьСхему(Значение, ОбъектJson(Правило.Получить("then")), Путь)
            ;
        ;
    ;
    // Conditional subschemas have properties/required but intentionally no type.
    если ТипЗначения == Неопределено и (Схема.СодержитКлюч("properties") или Схема.СодержитКлюч("required"))
        Схема.Вставить("type", "object")
        ПроверитьСхему(Значение, Схема, Путь)
    ;
;

@ВПроекте
метод УникальныеПоля(Массив: Массив<Объект?>, Поля: ЧитаемыйМассив<Строка>, Путь: Строка)
    знч Ключи = <Строка>[]
    для Элемент из Массив
        знч Данные = ОбъектJson(Элемент)
        пер Ключ = ""
        для Поле из Поля
            Ключ = Ключ + ":" + КаноническийJson(Данные.ПолучитьИлиНеопределено(Поле))
        ;
        Требовать(не Ключи.Содержит(Ключ), "VALIDATION_ERROR", "Повтор предметного ключа", Путь)
        Ключи.Добавить(Ключ)
    ;
;

@ВПроекте
метод Ответ(Запрос: HttpСервисЗапрос, Значение: Объект?, Код: Число = 200)
    Запрос.Ответ.Заголовки.Установить("X-Game-Contract-Version", "1.0")
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json; charset=utf-8")
    Запрос.Ответ.Заголовки.Установить("Cache-Control", "no-store")
    Запрос.Ответ.УстановитьКодСтатуса(Код)
    Запрос.Ответ.УстановитьТело(Json(Значение))
;

@ВПроекте
метод ОтветОшибка(Запрос: HttpСервисЗапрос, КодОтвета: Число, Код: Строка, Сообщение: Строка, Поле: Строка = "")
    знч Данные: Соответствие<Строка, Объект?> = {"contractVersion": "1.0", "code": Код,
        "message": Сообщение, "correlationId": новый Ууид().ВСтроку()}
    если КодОтвета == 422
        Данные.Вставить("details", <Объект?>[<Строка, Объект?>{"field": Поле == "" ? "$" : Поле, "code": Код, "message": Сообщение}])
    ;
    Ответ(Запрос, Данные, КодОтвета)
;

@ВПроекте
метод СтраницаОчереди(Конверты: Массив<Объект?>, Завершенные: ЧитаемыйМассив<Число>, Лимит: Число): Соответствие<Строка, Объект?>
    знч Упорядоченные = Конверты.Сортировать((Левый, Правый) -> ЧислоJson(ОбъектJson(Левый), "sequence").Сравнить(ЧислоJson(ОбъектJson(Правый), "sequence")))
    знч Ожидающие = <Объект?>[]
    пер Подтверждено = 0
    пер Непрерывно = Истина
    пер Управляющая: Соответствие<Строка, Объект?>? = Неопределено
    пер ВерсияУправления = 0
    для Элемент из Упорядоченные
        знч Конверт = ОбъектJson(Элемент)
        знч Номер = ЧислоJson(Конверт, "sequence")
        знч Окончательная = Завершенные.Содержит(Номер)
        если Окончательная и Непрерывно и Номер == Подтверждено + 1
            Подтверждено = Номер
        иначе
            Непрерывно = Ложь
        ;
        если Окончательная
            продолжить
        ;
        Ожидающие.Добавить(Конверт)
        если ["pause_game", "resume_game"].Содержит(СтрокаJson(Конверт, "kind"))
            знч Версия = ЧислоJson(ОбъектJson(Конверт.Получить("payload")), "stateVersion")
            если Версия >= ВерсияУправления
                Управляющая = Конверт
                ВерсияУправления = Версия
            ;
        ;
    ;
    знч Порция = <Объект?>[]
    знч ОбычныйЛимит = Управляющая == Неопределено ? Лимит : Лимит - 1
    для Элемент из Ожидающие
        знч Конверт = ОбъектJson(Элемент)
        если Управляющая != Неопределено и Конверт.Получить("commandId") == Управляющая!.Получить("commandId")
            продолжить
        ;
        если Порция.Размер() < ОбычныйЛимит
            Порция.Добавить(Элемент)
        ;
    ;
    если Управляющая != Неопределено
        Порция.Добавить(Управляющая!)
    ;
    возврат <Строка, Объект?>{"commands": Порция.Сортировать((Левый, Правый) -> ЧислоJson(ОбъектJson(Левый), "sequence").Сравнить(ЧислоJson(ОбъектJson(Правый), "sequence"))),
        "acknowledgedThroughSequence": Подтверждено, "hasMore": Ожидающие.Размер() > Порция.Размер()}
;

@ВПроекте
метод Деньги(Сумма: Число): Строка
    знч Значение = Сумма.Округлить(2).ВСтроку()
    знч Части = Значение.Разделить(".")
    если Части.Размер() == 1
        возврат Значение + ".00"
    ;
    возврат Части[0] + "." + (Части[1] + "00").ПодстрокаСНачала(2)
;

@ВПроекте
метод СуммаСНДС(Количество: Число, Цена: Число, НДСВключать: Булево, Ставка: Число): Число
    знч База = (Количество * Цена).Округлить(2)
    возврат НДСВключать ? База + (База * Ставка / 100).Округлить(2) : База
;
