импорт Данные

@ВПроекте @НаСервере @ДоступноСКлиента
метод СохранитьПрофиль(Ссылка: Игры.Ссылка, Текст: Строка)
    ДоступИгры.ПроверитьВедущего(Ссылка)
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Игра = Ссылка.ЗагрузитьОбъект(Истина)!
    ПроверкиДанных.Требовать(Игра.Статус == СостоянияИгры.Черновик,
        "Профиль ERP задаётся до подготовки обычной игры")
    знч Профиль = ПротоколERP.Прочитать(Текст)
    ПротоколERP.Требовать(Профиль.Размер() == 2 и Профиль.СодержитКлюч("settings") и Профиль.СодержитКлюч("prepare"),
        "VALIDATION_ERROR", "Профиль содержит только settings и prepare")
    знч Настройки = ПротоколERP.ОбъектJson(Профиль.Получить("settings"))
    ПроверитьНастройки(Настройки)
    знч Подготовка = ПротоколERP.ОбъектJson(Профиль.Получить("prepare"))
    Подготовка.Вставить("settingsHash", ПротоколERP.Хеш(ПротоколERP.КаноническийJson(Настройки)))
    Профиль.Вставить("prepare", Подготовка)
    ПроверитьПодготовку(Подготовка, Настройки)
    для Элемент из ПротоколERP.МассивJson(Подготовка.Получить("balances"))
        знч Остаток = ПротоколERP.ОбъектJson(Элемент)
        знч Код = ПротоколERP.СтрокаJson(Остаток, "itemCode")
        знч Есть = Запрос{ВЫБРАТЬ Ссылка ИЗ НоменклатураИгры ГДЕ Код == %Код}.Выполнить().ПервыйИлиНеопределено()
        если Есть == Неопределено
            знч Номенклатура = новый НоменклатураИгры.Объект()
            Номенклатура.Код = Код
            Номенклатура.Наименование = Код
            Номенклатура.Единица = Единица(Код) == "pcs" ? "шт" : "комплект"
            Номенклатура.Вид = ["CityRide", "SportDrive", "CargoMax", "TourPro"].Содержит(Код) ? ВидыНоменклатурыИгры.ГотоваяПродукция : ВидыНоменклатурыИгры.Комплектующее
            Номенклатура.Записать()
        ;
    ;
    знч Документ = новый СообщенияERP.Объект()
    Документ.Дата = ДатаВремя.Сейчас()
    Документ.Игра = Ссылка
    Документ.Вид = "profile"
    Документ.Ресурс = новый Ууид().ВСтроку()
    Документ.ВремяПриема = Момент.Сейчас()
    Документ.ХешДанных = ПротоколERP.СтрокаJson(Подготовка, "settingsHash")
    СообщенияERP.ЗаполнитьТело(Документ, ПротоколERP.КаноническийJson(Профиль))
    Документ.Записать()
    Игра.ПрофильERP = Документ.Ссылка
    Игра.Записать()
;

@ВПроекте @НаСервере
метод ПроверитьПодготовку(Подготовка: Соответствие<Строка, Объект?>, Настройки: Соответствие<Строка, Объект?>)
    ПротоколERP.ПроверитьСхему(Подготовка, КонтрактERP.Схема("PrepareGamePayload"))
    ПроверитьБалансы(ПротоколERP.МассивJson(Подготовка.Получить("balances")), Истина)
    ПротоколERP.УникальныеПоля(ПротоколERP.МассивJson(Подготовка.Получить("initialPrices")), ["productCode"], "initialPrices")
    // Подготовленная ERP — источник начального пакета; профиль задаёт формат,
    // а не обязательные количества, себестоимость, деньги и продажные цены.
    ПротоколERP.Требовать(Подготовка.Получить("currency") == Настройки.Получить("currency"),
        "VALIDATION_ERROR", "Валюта начального пакета отличается от настроек", "prepare.currency")
    для Элемент из ПротоколERP.МассивJson(Подготовка.Получить("initialPrices"))
        знч Цена = ПротоколERP.ОбъектJson(Элемент)
        ПротоколERP.Требовать(["CityRide", "SportDrive", "CargoMax", "TourPro"].Содержит(ПротоколERP.СтрокаJson(Цена, "productCode")),
            "MAPPING_INCOMPLETE", "Неизвестная начальная цена", "prepare.initialPrices")
    ;
;

@ВПроекте @НаСервере
метод Профиль(Игра: Игры.Объект): Соответствие<Строка, Объект?>
    ПротоколERP.Требовать(Игра.ПрофильERP != Неопределено, "BINDING_NOT_ASSIGNED", "Ведущий ещё не настроил профиль ERP", КодОтвета = 409)
    возврат ПротоколERP.Прочитать(СообщенияERP.Текст(Игра.ПрофильERP!))
;

@ВПроекте @НаСервере
метод Настройки(Игра: Игры.Объект): Соответствие<Строка, Объект?>
    возврат ПротоколERP.ОбъектJson(Профиль(Игра).Получить("settings"))
;

@ВПроекте @НаСервере
метод Подготовка(Игра: Игры.Объект): Соответствие<Строка, Объект?>
    возврат ПротоколERP.ОбъектJson(Профиль(Игра).Получить("prepare"))
;

@ВПроекте @НаСервере
метод КалендарьРаунда(Игра: Игры.Объект, Номер: Число): Соответствие<Строка, Объект?>
    для Элемент из ПротоколERP.МассивJson(Настройки(Игра).Получить("calendar"))
        знч Календарь = ПротоколERP.ОбъектJson(Элемент)
        если ПротоколERP.ЧислоJson(Календарь, "roundNumber") == Номер
            возврат Календарь
        ;
    ;
    выбросить новый ПротоколERP.Ошибка("Раунд отсутствует в календаре", 409, "PHASE_CONFLICT")
;

@ВПроекте @НаСервере
метод ПроверитьНастройки(Настройки: Соответствие<Строка, Объект?>)
    ПротоколERP.ПроверитьСхему(Настройки, КонтрактERP.Схема("GameSettings"))
    ПротоколERP.Требовать(ПротоколERP.СтрокаJson(Настройки, "profileId") == "BICYCLE_SIMPLE"
        и ПротоколERP.СтрокаJson(Настройки, "profileVersion") == "1.0", "VALIDATION_ERROR", "Поддерживается профиль BICYCLE_SIMPLE 1.0", "profileId")
    знч Календарь = ПротоколERP.МассивJson(Настройки.Получить("calendar"))
    ПротоколERP.Требовать(Календарь.Размер() == ПротоколERP.ЧислоJson(Настройки, "roundCount") + 1, "VALIDATION_ERROR", "Неполный календарь", "calendar")
    пер Номер = 0
    пер ПредыдущийМесяц = ""
    пер ПредыдущийНомерМесяца = -1
    для Элемент из Календарь
        знч Раунд = ПротоколERP.ОбъектJson(Элемент)
        знч Месяц = ПротоколERP.СтрокаJson(Раунд, "gameMonth")
        знч НомерМесяца = новый Число(Месяц.ПодстрокаСНачала(4)) * 12 + новый Число(Месяц.Подстрока(5))
        ПротоколERP.Требовать((ПредыдущийНомерМесяца == -1 или НомерМесяца == ПредыдущийНомерМесяца + 1) и ПротоколERP.СтрокаJson(Раунд, "documentDate") == Месяц + "-15",
            "VALIDATION_ERROR", "Календарь содержит последовательные месяцы и дату 15-го числа", "calendar")
        ПредыдущийНомерМесяца = НомерМесяца
        ПротоколERP.Требовать(ПротоколERP.ЧислоJson(Раунд, "roundNumber") == Номер и Месяц.Сравнить(ПредыдущийМесяц) > 0
            и ПротоколERP.СтрокаJson(Раунд, "documentDate").ПодстрокаСНачала(7) == Месяц,
            "VALIDATION_ERROR", "Номера календаря идут от нуля, месяцы возрастают, дата принадлежит месяцу", "calendar")
        Номер = Номер + 1
        ПредыдущийМесяц = Месяц
    ;
    знч Продукты = ПротоколERP.МассивJson(Настройки.Получить("products"))
    ПротоколERP.УникальныеПоля(Продукты, ["productCode"], "products")
    для Элемент из Продукты
        знч Продукт = ПротоколERP.ОбъектJson(Элемент)
        ПротоколERP.Требовать(новый Число(ПротоколERP.СтрокаJson(Продукт, "minPrice")) <= новый Число(ПротоколERP.СтрокаJson(Продукт, "maxPrice")),
            "VALIDATION_ERROR", "Минимум цены превышает максимум", "products")
        знч Ставка = новый Число(ПротоколERP.СтрокаJson(Продукт, "vatRate"))
        ПротоколERP.Требовать(Ставка <= 100 и (ПротоколERP.СтрокаJson(Настройки, "taxMode") != "no_vat" или Ставка == 0),
            "VALIDATION_ERROR", "Недопустимая ставка НДС", "products.vatRate")
    ;
    ПротоколERP.Требовать(ПротоколERP.ЧислоJson(Настройки, "connectionLostSeconds") > ПротоколERP.ЧислоJson(Настройки, "requestTimeoutSeconds")
        + ПротоколERP.ЧислоJson(Настройки, "pollIntervalSeconds"), "VALIDATION_ERROR", "Порог потери связи слишком мал", "connectionLostSeconds")
;

@ВПроекте @НаСервере
метод ПравилоПродукта(Игра: Игры.Объект, Код: Строка): Соответствие<Строка, Объект?>
    для Элемент из ПротоколERP.МассивJson(Настройки(Игра).Получить("products"))
        знч Правило = ПротоколERP.ОбъектJson(Элемент)
        если ПротоколERP.СтрокаJson(Правило, "productCode") == Код
            возврат Правило
        ;
    ;
    выбросить новый ПротоколERP.Ошибка("Продукт отсутствует в профиле", 422, "MAPPING_INCOMPLETE")
;

@ВПроекте @НаСервере
метод НачальнаяЦена(Подготовка: Соответствие<Строка, Объект?>, Код: Строка): Число
    для Элемент из ПротоколERP.МассивJson(Подготовка.Получить("initialPrices"))
        знч Начальная = ПротоколERP.ОбъектJson(Элемент)
        если Начальная.Получить("productCode") == Код
            возврат новый Число(ПротоколERP.СтрокаJson(Начальная, "price"))
        ;
    ;
    выбросить новый ПротоколERP.Ошибка("Продукт отсутствует в начальном пакете", 422, "MAPPING_INCOMPLETE")
;

@ВПроекте @НаСервере
метод ПроверитьЦенуПредложения(Настройки: Соответствие<Строка, Объект?>,
    Подготовка: Соответствие<Строка, Объект?>, НомерРаунда: Число, Код: Строка, Цена: Число)
    если НомерРаунда == 0
        // Стартовая продажа идёт по принятой цене ERP, даже если она ниже
        // диапазона, установленного для ценовой стратегии производственных раундов.
        ПротоколERP.Требовать(Цена == НачальнаяЦена(Подготовка, Код),
            "VALIDATION_ERROR", "Стартовая цена отличается от принятой цены ERP", "offers.price")
        возврат
    иначе
        для Элемент из ПротоколERP.МассивJson(Настройки.Получить("products"))
            знч Правило = ПротоколERP.ОбъектJson(Элемент)
            если Правило.Получить("productCode") == Код
                ПротоколERP.Требовать(Цена >= новый Число(ПротоколERP.СтрокаJson(Правило, "minPrice"))
                    и Цена <= новый Число(ПротоколERP.СтрокаJson(Правило, "maxPrice")),
                    "VALIDATION_ERROR", "Цена вне утверждённого диапазона", "offers.price")
                возврат
            ;
        ;
    ;
    выбросить новый ПротоколERP.Ошибка("Продукт отсутствует в профиле", 422, "MAPPING_INCOMPLETE")
;

@ВПроекте @НаСервере
метод Единица(Код: Строка): Строка
    возврат ["POWER_350", "POWER_500", "WHEELS_STD", "WHEELS_HEAVY", "EQUIP_BASE", "EQUIP_PLUS"].Содержит(Код) ? "set" : "pcs"
;

@ВПроекте @НаСервере
метод ПроверитьБалансы(Строки: Массив<Объект?>, Начальные: Булево)
    ПротоколERP.Требовать(Строки.Размер() == 26, "MAPPING_INCOMPLETE", "Требуются все 26 остатков, включая нули", "balances")
    ПротоколERP.УникальныеПоля(Строки, ["itemCode", "warehouseId"], "balances")
    для Элемент из Строки
        знч Остаток = ПротоколERP.ОбъектJson(Элемент)
        знч Код = ПротоколERP.СтрокаJson(Остаток, "itemCode")
        знч Склад = ПротоколERP.СтрокаJson(Остаток, "warehouseId")
        знч ЭтоПродукт = ["CityRide", "SportDrive", "CargoMax", "TourPro"].Содержит(Код)
        знч ЭтоКомпонент = ["FRAME_STD", "FRAME_CARGO", "POWER_350", "POWER_500", "BAT_300", "BAT_500", "BAT_800",
            "WHEELS_STD", "WHEELS_HEAVY", "EQUIP_BASE", "EQUIP_PLUS"].Содержит(Код)
        ПротоколERP.Требовать((ЭтоПродукт и Склад == "finished_goods") или (ЭтоКомпонент и ["purchases", "workshop"].Содержит(Склад)),
            "MAPPING_INCOMPLETE", "Код или склад отсутствует в профиле", "balances")
        ПротоколERP.Требовать(ПротоколERP.СтрокаJson(Остаток, "unitCode") == Единица(Код), "MAPPING_INCOMPLETE", "Неверная игровая единица", "balances.unitCode")
        знч Количество = новый Число(ПротоколERP.СтрокаJson(Остаток, "quantity"))
        ПротоколERP.Требовать(не ЭтоПродукт или Количество == Количество.Округлить(0), "VALIDATION_ERROR", "Число велосипедов должно быть целым", "balances.quantity")
    ;
;

@ВПроекте @НаСервере
метод Деньги(Сумма: Число): Строка
    возврат ПротоколERP.Деньги(Сумма)
;

@ВПроекте @НаСервере
метод КодФазы(Фаза: ФазыИгры): Строка
    если Фаза == ФазыИгры.Подготовка
        возврат "initialization"
    иначе если Фаза == ФазыИгры.СтартоваяПродажа
        возврат "initial_sales"
    иначе если Фаза == ФазыИгры.Планирование
        возврат "planning"
    иначе если Фаза == ФазыИгры.Закупки
        возврат "purchasing"
    иначе если Фаза == ФазыИгры.Производство
        возврат "production"
    иначе если Фаза == ФазыИгры.Продажи
        возврат "sales"
    ;
    возврат "analysis"
;

@ВПроекте @НаСервере
метод КодСостояния(Статус: СостоянияИгры): Строка
    если Статус == СостоянияИгры.Черновик
        возврат "draft"
    иначе если Статус == СостоянияИгры.Подготовка
        возврат "preparing"
    иначе если Статус == СостоянияИгры.Идет
        возврат "running"
    иначе если Статус == СостоянияИгры.Пауза
        возврат "paused"
    иначе если Статус == СостоянияИгры.Завершена
        возврат "completed"
    ;
    возврат "cancelled"
;


@ВПроекте @НаСервере @ДоступноСКлиента
метод ШаблонСоответствий(): Строка
    возврат "{\"items\":[{\"itemCode\":\"CityRide\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"pcs\",\"coefficient\":\"1\"},{\"itemCode\":\"SportDrive\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"pcs\",\"coefficient\":\"1\"},{\"itemCode\":\"CargoMax\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"pcs\",\"coefficient\":\"1\"},{\"itemCode\":\"TourPro\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"pcs\",\"coefficient\":\"1\"},{\"itemCode\":\"FRAME_STD\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"pcs\",\"coefficient\":\"1\"},{\"itemCode\":\"FRAME_CARGO\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"pcs\",\"coefficient\":\"1\"},{\"itemCode\":\"POWER_350\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"set\",\"coefficient\":\"1\"},{\"itemCode\":\"POWER_500\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"set\",\"coefficient\":\"1\"},{\"itemCode\":\"BAT_300\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"pcs\",\"coefficient\":\"1\"},{\"itemCode\":\"BAT_500\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"pcs\",\"coefficient\":\"1\"},{\"itemCode\":\"BAT_800\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"pcs\",\"coefficient\":\"1\"},{\"itemCode\":\"WHEELS_STD\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"set\",\"coefficient\":\"1\"},{\"itemCode\":\"WHEELS_HEAVY\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"set\",\"coefficient\":\"1\"},{\"itemCode\":\"EQUIP_BASE\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"set\",\"coefficient\":\"1\"},{\"itemCode\":\"EQUIP_PLUS\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"set\",\"coefficient\":\"1\"}]}"
;
