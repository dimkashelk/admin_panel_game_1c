импорт Данные

@ВПроекте @НаСервере @ДоступноСКлиента
метод СохранитьПрофиль(Ссылка: Игры.Ссылка, Текст: Строка)
    ДоступИгры.ПроверитьВедущего(Ссылка)
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Игра = Ссылка.ЗагрузитьОбъект(Истина)!
    ПроверкиДанных.Требовать(Игра.Статус == СостоянияИгры.Черновик,
        "Профиль ERP задаётся до подготовки обычной игры")
    знч Профиль = ПротоколERP.Прочитать(Текст)
    ПротоколERP.Требовать(Профиль.Размер() == 2 и Профиль.СодержитКлюч("settings") и Профиль.СодержитКлюч("prepare"),
        "VALIDATION_ERROR", "Профиль содержит только settings и prepare")
    знч Настройки = ПротоколERP.ОбъектJson(Профиль.Получить("settings"))
    ПроверитьНастройки(Настройки)
    знч Подготовка = ПротоколERP.ОбъектJson(Профиль.Получить("prepare"))
    Подготовка.Вставить("settingsHash", ПротоколERP.Хеш(ПротоколERP.КаноническийJson(Настройки)))
    Профиль.Вставить("prepare", Подготовка)
    ПроверитьПодготовку(Подготовка, Настройки)
    для Элемент из ПротоколERP.МассивJson(Подготовка.Получить("balances"))
        знч Остаток = ПротоколERP.ОбъектJson(Элемент)
        знч Код = ПротоколERP.СтрокаJson(Остаток, "itemCode")
        знч Есть = Запрос{ВЫБРАТЬ Ссылка ИЗ НоменклатураИгры ГДЕ Код == %Код}.Выполнить().ПервыйИлиНеопределено()
        если Есть == Неопределено
            знч Номенклатура = новый НоменклатураИгры.Объект()
            Номенклатура.Код = Код
            Номенклатура.Наименование = Код
            Номенклатура.Единица = Единица(Код) == "pcs" ? "шт" : "комплект"
            Номенклатура.Вид = ["CityRide", "SportDrive", "CargoMax", "TourPro"].Содержит(Код) ? ВидыНоменклатурыИгры.ГотоваяПродукция : ВидыНоменклатурыИгры.Комплектующее
            Номенклатура.Записать()
        ;
    ;
    знч Документ = новый СообщенияERP.Объект()
    Документ.Дата = ДатаВремя.Сейчас()
    Документ.Игра = Ссылка
    Документ.Вид = "profile"
    Документ.Ресурс = новый Ууид().ВСтроку()
    Документ.ВремяПриема = Момент.Сейчас()
    Документ.ХешДанных = ПротоколERP.СтрокаJson(Подготовка, "settingsHash")
    СообщенияERP.ЗаполнитьТело(Документ, ПротоколERP.КаноническийJson(Профиль))
    Документ.Записать()
    Игра.ПрофильERP = Документ.Ссылка
    Игра.Записать()
;

@ВПроекте @НаСервере
метод СоздатьПрофильПоУмолчанию(Ссылка: Игры.Ссылка)
    знч Шаблон = ПротоколERP.Прочитать(ПрофильНастройкиOData.Получить())
    знч Игра = Ссылка.ЗагрузитьОбъект()!
    ПроверкиДанных.Требовать(Игра.Сценарий != Неопределено, "Выберите сценарий игры")
    знч Сценарий = Игра.Сценарий!.ЗагрузитьОбъект()!
    Сценарий.ПроверитьНастройки()
    знч Подготовка = ПротоколERP.ОбъектJson(Шаблон.Получить("initial"))
    знч Остатки = <Объект?>[]
    для Ресурс из Сценарий.НачальныеРесурсы
        знч Номенклатура = Ресурс.Номенклатура!.ЗагрузитьОбъект()!
        знч ГотоваяПродукция = Номенклатура.Вид == ВидыНоменклатурыИгры.ГотоваяПродукция
        знч Масштаб = ГотоваяПродукция ? 1 : 10000
        знч Минимум = (Ресурс.МинимальноеКоличество * Масштаб).Округлить(0, РежимОкругления.Вниз)
        знч Максимум = (Ресурс.МаксимальноеКоличество * Масштаб).Округлить(0, РежимОкругления.Вниз)
        знч Приоритет = ПроверкиДанных.СтабильныйПриоритет(Номенклатура.Код, Игра.Seed, 0)
        знч Количество = (Минимум + (Сценарий.СлучайныеНачальныеРесурсы ? Приоритет % (Максимум - Минимум + 1) : 0)) / Масштаб
        Остатки.Добавить({"itemCode": Номенклатура.Код, "quantity": Количество.ВСтроку(),
            "unitCode": Единица(Номенклатура.Код), "warehouseId": ГотоваяПродукция ? "finished_goods" : "purchases",
            "unitCost": ПротоколERP.Деньги(Ресурс.УчетнаяЦена)})
        если не ГотоваяПродукция
            Остатки.Добавить({"itemCode": Номенклатура.Код, "quantity": "0", "unitCode": Единица(Номенклатура.Код),
                "warehouseId": "workshop", "unitCost": ПротоколERP.Деньги(Ресурс.УчетнаяЦена)})
        ;
    ;
    Подготовка.Вставить("balances", Остатки)
    знч Цены = <Объект?>[]
    для Правило из Сценарий.ПараметрыРынка
        Цены.Добавить({"productCode": Правило.Продукт!.ЗагрузитьОбъект()!.Код,
            "price": ПротоколERP.Деньги(Правило.РеферентнаяЦена)})
    ;
    Подготовка.Вставить("initialPrices", Цены)
    ПрименитьУсловияКПрофилю(Шаблон, Подготовка)
    знч ДатаНачала = ПротоколERP.СтрокаJson(ПротоколERP.ОбъектJson(Шаблон.Получить("defaults")), "setupDate")
    СохранитьПрофиль(Ссылка, ПротоколERP.Json(СформироватьПрофиль(Ссылка, Подготовка, ДатаНачала)))
;

@ВПроекте @НаСервере
метод СформироватьПрофиль(Ссылка: Игры.Ссылка, Подготовка: Соответствие<Строка, Объект?>,
    ДатаНачала: Строка): Соответствие<Строка, Объект?>
    знч Игра = Ссылка.ЗагрузитьОбъект()!
    ПроверкиДанных.Требовать(Игра.Сценарий != Неопределено, "Выберите сценарий игры")
    знч Сценарий = Игра.Сценарий!.ЗагрузитьОбъект()!
    знч Шаблон = ПротоколERP.Прочитать(ПрофильНастройкиOData.Получить())
    знч Настройки = ПротоколERP.ОбъектJson(Шаблон.Получить("gameSettings"))
    Настройки.Вставить("roundCount", Сценарий.ЧислоРаундов)
    Настройки.Вставить("priceFixation", "before_sales")
    знч Продукты = <Объект?>[]
    для Правило из Сценарий.ПараметрыРынка
        знч Код = Правило.Продукт!.ЗагрузитьОбъект()!.Код
        Продукты.Добавить({"productCode": Код, "minPrice": ПротоколERP.Деньги(Правило.МинимальнаяЦена),
            "maxPrice": ПротоколERP.Деньги(Правило.МаксимальнаяЦена), "vatRate": "22.00"})
    ;
    Настройки.Вставить("products", Продукты)
    пер Год = новый Число(ДатаНачала.ПодстрокаСНачала(4))
    пер Месяц = новый Число(ДатаНачала.ПодстрокаСНачала(7).Подстрока(5))
    пер Номер = 0
    знч Календарь = <Объект?>[]
    пока Номер <= Сценарий.ЧислоРаундов
        знч ИгровойМесяц = Год.ВСтроку() + "-" + (Месяц < 10 ? "0" : "") + Месяц.ВСтроку()
        Календарь.Добавить({"roundNumber": Номер, "gameMonth": ИгровойМесяц, "documentDate": ИгровойМесяц + "-15"})
        Номер = Номер + 1
        Месяц = Месяц + 1
        если Месяц > 12
            Месяц = 1
            Год = Год + 1
        ;
    ;
    Настройки.Вставить("calendar", Календарь)
    Подготовка.Вставить("seed", Игра.Seed.ВСтроку())
    Подготовка.Вставить("settingsHash", ПротоколERP.Хеш(ПротоколERP.КаноническийJson(Настройки)))
    возврат {"settings": Настройки, "prepare": Подготовка}
;

// Общие стартовые условия игры не перезаписываются данными следующей команды.
@ВПроекте @НаСервере
метод ПринятьНачальныеДанные(Ссылка: Игры.Ссылка, Результат: Соответствие<Строка, Объект?>, ДатаНачала: Строка)
    знч Игра = Ссылка.ЗагрузитьОбъект(Истина)!
    ПроверкиДанных.Требовать(Игра.Статус == СостоянияИгры.Черновик, "Идентификаторы и профиль сохраняются до подготовки игры")
    знч Подготовка = ПротоколERP.ОбъектJson(Результат.Получить("prepare"))
    знч НовыйПрофиль = СформироватьПрофиль(Ссылка, Подготовка, ДатаНачала)
    знч Настройки = ПротоколERP.ОбъектJson(НовыйПрофиль.Получить("settings"))
    Настройки.Вставить("taxMode", Результат.Получить("priceIncludesVAT") == Истина ? "price_includes_vat" : "price_excludes_vat")
    знч ПродуктыСНДС = <Объект?>[]
    для Элемент из ПротоколERP.МассивJson(Настройки.Получить("products"))
        знч Продукт = ПротоколERP.ОбъектJson(Элемент)
        для Ставка из ПротоколERP.МассивJson(Результат.Получить("vatRates"))
            знч Данные = ПротоколERP.ОбъектJson(Ставка)
            если Данные.Получить("productCode") == Продукт.Получить("productCode")
                Продукт.Вставить("vatRate", Данные.Получить("vatRate"))
            ;
        ;
        ПродуктыСНДС.Добавить(Продукт)
    ;
    Настройки.Вставить("products", ПродуктыСНДС)
    Подготовка.Вставить("settingsHash", ПротоколERP.Хеш(ПротоколERP.КаноническийJson(Настройки)))
    НовыйПрофиль.Вставить("settings", Настройки)
    НовыйПрофиль.Вставить("prepare", Подготовка)
    ПроверитьНастройки(Настройки)
    ПроверитьПодготовку(Подготовка, Настройки)
    если Игра.ПрофильERP == Неопределено
        СохранитьПрофиль(Ссылка, ПротоколERP.Json(НовыйПрофиль))
        возврат
    ;
    знч СохраненныеНастройки = НастройкиERP.Настройки(Игра)
    ПроверкиДанных.Требовать(СохраненныеНастройки.Получить("taxMode") == Настройки.Получить("taxMode"), "НДС базы отличается от профиля игры")
    ПроверкиДанных.Требовать(КалендарьРаунда(Игра, 0).Получить("gameMonth") == ДатаНачала.ПодстрокаСНачала(7),
        "Месяц начальных данных ERP отличается от календаря игры")
    для Ставка из ПротоколERP.МассивJson(Результат.Получить("vatRates"))
        знч Данные = ПротоколERP.ОбъектJson(Ставка)
        ПроверкиДанных.Требовать(новый Число(ПротоколERP.СтрокаJson(ПравилоПродукта(Игра, ПротоколERP.СтрокаJson(Данные, "productCode")), "vatRate"))
            == новый Число(ПротоколERP.СтрокаJson(Данные, "vatRate")), "Ставка НДС базы отличается от профиля игры")
    ;
    ПроверитьСовпадениеНачальныхДанных(НастройкиERP.Подготовка(Игра), Подготовка)
;

@НаСервере
метод ПроверитьСовпадениеНачальныхДанных(Сохраненные: Соответствие<Строка, Объект?>, Фактические: Соответствие<Строка, Объект?>)
    ПроверкиДанных.Требовать(Сохраненные.Получить("currency") == Фактические.Получить("currency")
        и новый Число(ПротоколERP.СтрокаJson(Сохраненные, "initialCash")) == новый Число(ПротоколERP.СтрокаJson(Фактические, "initialCash")),
        "Начальные деньги ERP отличаются от общих условий игры")
    знч Остатки = <Строка, Соответствие<Строка, Объект?>>{:}
    для Значение из ПротоколERP.МассивJson(Сохраненные.Получить("balances"))
        знч Строка = ПротоколERP.ОбъектJson(Значение)
        Остатки.Вставить(ПротоколERP.СтрокаJson(Строка, "itemCode") + "|" + ПротоколERP.СтрокаJson(Строка, "warehouseId"), Строка)
    ;
    для Значение из ПротоколERP.МассивJson(Фактические.Получить("balances"))
        знч Строка = ПротоколERP.ОбъектJson(Значение)
        знч Ключ = ПротоколERP.СтрокаJson(Строка, "itemCode") + "|" + ПротоколERP.СтрокаJson(Строка, "warehouseId")
        ПроверкиДанных.Требовать(Остатки.СодержитКлюч(Ключ), "Остаток отсутствует в профиле: %{Ключ}")
        знч Было = Остатки.Получить(Ключ)
        ПроверкиДанных.Требовать(ПротоколERP.СтрокаJson(Было, "unitCode") == ПротоколERP.СтрокаJson(Строка, "unitCode"),
            "Единица ERP %{Строка.Получить("unitCode")} отличается от профиля %{Было.Получить("unitCode")}: %{Ключ}")
        знч КоличествоПрофиля = новый Число(ПротоколERP.СтрокаJson(Было, "quantity"))
        знч КоличествоERP = новый Число(ПротоколERP.СтрокаJson(Строка, "quantity"))
        ПроверкиДанных.Требовать(КоличествоПрофиля == КоличествоERP,
            "Остаток ERP %{КоличествоERP} отличается от профиля %{КоличествоПрофиля}: %{Ключ}")
        знч ЦенаПрофиля = новый Число(ПротоколERP.СтрокаJson(Было, "unitCost"))
        знч ЦенаERP = новый Число(ПротоколERP.СтрокаJson(Строка, "unitCost"))
        ПроверкиДанных.Требовать(ЦенаПрофиля == ЦенаERP,
            "Учётная цена ERP %{ЦенаERP} отличается от профиля %{ЦенаПрофиля}: %{Ключ}")
    ;
    для Значение из ПротоколERP.МассивJson(Фактические.Получить("initialPrices"))
        знч Цена = ПротоколERP.ОбъектJson(Значение)
        ПроверкиДанных.Требовать(НачальнаяЦена(Сохраненные, ПротоколERP.СтрокаJson(Цена, "productCode"))
            == новый Число(ПротоколERP.СтрокаJson(Цена, "price")), "Начальные продажные цены ERP отличаются от профиля игры")
    ;
;

@ВПроекте @НаСервере
метод ПроверитьПодготовку(Подготовка: Соответствие<Строка, Объект?>, Настройки: Соответствие<Строка, Объект?>)
    ПротоколERP.ПроверитьСхему(Подготовка, КонтрактERP.Схема("PrepareGamePayload"))
    ПроверитьБалансы(ПротоколERP.МассивJson(Подготовка.Получить("balances")), Истина)
    ПротоколERP.УникальныеПоля(ПротоколERP.МассивJson(Подготовка.Получить("initialPrices")), ["productCode"], "initialPrices")
    // Подготовленная ERP — источник начального пакета; профиль задаёт формат,
    // а не обязательные количества, себестоимость, деньги и продажные цены.
    ПротоколERP.Требовать(Подготовка.Получить("currency") == Настройки.Получить("currency"),
        "VALIDATION_ERROR", "Валюта начального пакета отличается от настроек", "prepare.currency")
    для Элемент из ПротоколERP.МассивJson(Подготовка.Получить("initialPrices"))
        знч Цена = ПротоколERP.ОбъектJson(Элемент)
        ПротоколERP.Требовать(["CityRide", "SportDrive", "CargoMax", "TourPro"].Содержит(ПротоколERP.СтрокаJson(Цена, "productCode")),
            "MAPPING_INCOMPLETE", "Неизвестная начальная цена", "prepare.initialPrices")
    ;
;

@ВПроекте @НаСервере
метод Профиль(Игра: Игры.Объект): Соответствие<Строка, Объект?>
    ПротоколERP.Требовать(Игра.ПрофильERP != Неопределено, "BINDING_NOT_ASSIGNED", "Ведущий ещё не настроил профиль ERP", КодОтвета = 409)
    возврат ПротоколERP.Прочитать(СообщенияERP.Текст(Игра.ПрофильERP!))
;

@ВПроекте @НаСервере
метод Настройки(Игра: Игры.Объект): Соответствие<Строка, Объект?>
    возврат ПротоколERP.ОбъектJson(Профиль(Игра).Получить("settings"))
;

@ВПроекте @НаСервере
метод Подготовка(Игра: Игры.Объект): Соответствие<Строка, Объект?>
    возврат ПротоколERP.ОбъектJson(Профиль(Игра).Получить("prepare"))
;

@ВПроекте @НаСервере
метод КалендарьРаунда(Игра: Игры.Объект, Номер: Число): Соответствие<Строка, Объект?>
    для Элемент из ПротоколERP.МассивJson(Настройки(Игра).Получить("calendar"))
        знч Календарь = ПротоколERP.ОбъектJson(Элемент)
        если ПротоколERP.ЧислоJson(Календарь, "roundNumber") == Номер
            возврат Календарь
        ;
    ;
    выбросить новый ПротоколERP.Ошибка("Раунд отсутствует в календаре", 409, "PHASE_CONFLICT")
;

@ВПроекте @НаСервере
метод ПроверитьНастройки(Настройки: Соответствие<Строка, Объект?>)
    ПротоколERP.ПроверитьСхему(Настройки, КонтрактERP.Схема("GameSettings"))
    ПротоколERP.Требовать(ПротоколERP.СтрокаJson(Настройки, "profileId") == "BICYCLE_SIMPLE"
        и ПротоколERP.СтрокаJson(Настройки, "profileVersion") == "1.0", "VALIDATION_ERROR", "Поддерживается профиль BICYCLE_SIMPLE 1.0", "profileId")
    знч Календарь = ПротоколERP.МассивJson(Настройки.Получить("calendar"))
    ПротоколERP.Требовать(Календарь.Размер() == ПротоколERP.ЧислоJson(Настройки, "roundCount") + 1, "VALIDATION_ERROR", "Неполный календарь", "calendar")
    пер Номер = 0
    пер ПредыдущийМесяц = ""
    пер ПредыдущийНомерМесяца = -1
    для Элемент из Календарь
        знч Раунд = ПротоколERP.ОбъектJson(Элемент)
        знч Месяц = ПротоколERP.СтрокаJson(Раунд, "gameMonth")
        знч НомерМесяца = новый Число(Месяц.ПодстрокаСНачала(4)) * 12 + новый Число(Месяц.Подстрока(5))
        ПротоколERP.Требовать((ПредыдущийНомерМесяца == -1 или НомерМесяца == ПредыдущийНомерМесяца + 1) и ПротоколERP.СтрокаJson(Раунд, "documentDate") == Месяц + "-15",
            "VALIDATION_ERROR", "Календарь содержит последовательные месяцы и дату 15-го числа", "calendar")
        ПредыдущийНомерМесяца = НомерМесяца
        ПротоколERP.Требовать(ПротоколERP.ЧислоJson(Раунд, "roundNumber") == Номер и Месяц.Сравнить(ПредыдущийМесяц) > 0
            и ПротоколERP.СтрокаJson(Раунд, "documentDate").ПодстрокаСНачала(7) == Месяц,
            "VALIDATION_ERROR", "Номера календаря идут от нуля, месяцы возрастают, дата принадлежит месяцу", "calendar")
        Номер = Номер + 1
        ПредыдущийМесяц = Месяц
    ;
    знч Продукты = ПротоколERP.МассивJson(Настройки.Получить("products"))
    ПротоколERP.УникальныеПоля(Продукты, ["productCode"], "products")
    для Элемент из Продукты
        знч Продукт = ПротоколERP.ОбъектJson(Элемент)
        ПротоколERP.Требовать(новый Число(ПротоколERP.СтрокаJson(Продукт, "minPrice")) <= новый Число(ПротоколERP.СтрокаJson(Продукт, "maxPrice")),
            "VALIDATION_ERROR", "Минимум цены превышает максимум", "products")
        знч Ставка = новый Число(ПротоколERP.СтрокаJson(Продукт, "vatRate"))
        ПротоколERP.Требовать(Ставка <= 100 и (ПротоколERP.СтрокаJson(Настройки, "taxMode") != "no_vat" или Ставка == 0),
            "VALIDATION_ERROR", "Недопустимая ставка НДС", "products.vatRate")
    ;
    ПротоколERP.Требовать(ПротоколERP.ЧислоJson(Настройки, "connectionLostSeconds") > ПротоколERP.ЧислоJson(Настройки, "requestTimeoutSeconds")
        + ПротоколERP.ЧислоJson(Настройки, "pollIntervalSeconds"), "VALIDATION_ERROR", "Порог потери связи слишком мал", "connectionLostSeconds")
;

@ВПроекте @НаСервере
метод ПравилоПродукта(Игра: Игры.Объект, Код: Строка): Соответствие<Строка, Объект?>
    для Элемент из ПротоколERP.МассивJson(Настройки(Игра).Получить("products"))
        знч Правило = ПротоколERP.ОбъектJson(Элемент)
        если ПротоколERP.СтрокаJson(Правило, "productCode") == Код
            возврат Правило
        ;
    ;
    выбросить новый ПротоколERP.Ошибка("Продукт отсутствует в профиле", 422, "MAPPING_INCOMPLETE")
;

@ВПроекте @НаСервере
метод НачальнаяЦена(Подготовка: Соответствие<Строка, Объект?>, Код: Строка): Число
    для Элемент из ПротоколERP.МассивJson(Подготовка.Получить("initialPrices"))
        знч Начальная = ПротоколERP.ОбъектJson(Элемент)
        если Начальная.Получить("productCode") == Код
            возврат новый Число(ПротоколERP.СтрокаJson(Начальная, "price"))
        ;
    ;
    выбросить новый ПротоколERP.Ошибка("Продукт отсутствует в начальном пакете", 422, "MAPPING_INCOMPLETE")
;

@ВПроекте @НаСервере
метод ПроверитьЦенуПредложения(Настройки: Соответствие<Строка, Объект?>,
    Подготовка: Соответствие<Строка, Объект?>, НомерРаунда: Число, Код: Строка, Цена: Число)
    если НомерРаунда == 0
        // Стартовая продажа использует актуальную цену ERP; начальная цена профиля
        // не блокирует последующее изменение прайс-листа до продаж.
        ПротоколERP.Требовать(Цена > 0 и Цена == Цена.Округлить(2),
            "VALIDATION_ERROR", "Стартовая цена ERP должна быть положительной, с точностью до копейки", "offers.price")
        возврат
    иначе
        для Элемент из ПротоколERP.МассивJson(Настройки.Получить("products"))
            знч Правило = ПротоколERP.ОбъектJson(Элемент)
            если Правило.Получить("productCode") == Код
                ПротоколERP.Требовать(Цена >= новый Число(ПротоколERP.СтрокаJson(Правило, "minPrice"))
                    и Цена <= новый Число(ПротоколERP.СтрокаJson(Правило, "maxPrice")),
                    "VALIDATION_ERROR", "Цена вне утверждённого диапазона", "offers.price")
                возврат
            ;
        ;
    ;
    выбросить новый ПротоколERP.Ошибка("Продукт отсутствует в профиле", 422, "MAPPING_INCOMPLETE")
;

@ВПроекте @НаСервере
метод Единица(Код: Строка): Строка
    возврат ["POWER_350", "POWER_500", "WHEELS_STD", "WHEELS_HEAVY", "EQUIP_BASE", "EQUIP_PLUS"].Содержит(Код) ? "set" : "pcs"
;

@ВПроекте @НаСервере
метод ПроверитьБалансы(Строки: Массив<Объект?>, Начальные: Булево)
    ПротоколERP.Требовать(Строки.Размер() == 26, "MAPPING_INCOMPLETE", "Требуются все 26 остатков, включая нули", "balances")
    ПротоколERP.УникальныеПоля(Строки, ["itemCode", "warehouseId"], "balances")
    для Элемент из Строки
        знч Остаток = ПротоколERP.ОбъектJson(Элемент)
        знч Код = ПротоколERP.СтрокаJson(Остаток, "itemCode")
        знч Склад = ПротоколERP.СтрокаJson(Остаток, "warehouseId")
        знч ЭтоПродукт = ["CityRide", "SportDrive", "CargoMax", "TourPro"].Содержит(Код)
        знч ЭтоКомпонент = ["FRAME_STD", "FRAME_CARGO", "POWER_350", "POWER_500", "BAT_300", "BAT_500", "BAT_800",
            "WHEELS_STD", "WHEELS_HEAVY", "EQUIP_BASE", "EQUIP_PLUS"].Содержит(Код)
        ПротоколERP.Требовать((ЭтоПродукт и Склад == "finished_goods") или (ЭтоКомпонент и ["purchases", "workshop"].Содержит(Склад)),
            "MAPPING_INCOMPLETE", "Код или склад отсутствует в профиле", "balances")
        ПротоколERP.Требовать(ПротоколERP.СтрокаJson(Остаток, "unitCode") == Единица(Код), "MAPPING_INCOMPLETE", "Неверная игровая единица", "balances.unitCode")
        знч Количество = новый Число(ПротоколERP.СтрокаJson(Остаток, "quantity"))
        ПротоколERP.Требовать(не ЭтоПродукт или Количество == Количество.Округлить(0), "VALIDATION_ERROR", "Число велосипедов должно быть целым", "balances.quantity")
    ;
;

@ВПроекте @НаСервере
метод Деньги(Сумма: Число): Строка
    возврат ПротоколERP.Деньги(Сумма)
;

@ВПроекте @НаСервере
метод КодФазы(Фаза: ФазыИгры): Строка
    если Фаза == ФазыИгры.Подготовка
        возврат "initialization"
    иначе если Фаза == ФазыИгры.СтартоваяПродажа
        возврат "initial_sales"
    иначе если Фаза == ФазыИгры.Планирование
        возврат "planning"
    иначе если Фаза == ФазыИгры.Закупки
        возврат "purchasing"
    иначе если Фаза == ФазыИгры.Производство
        возврат "production"
    иначе если Фаза == ФазыИгры.Продажи
        возврат "sales"
    ;
    возврат "analysis"
;

@ВПроекте @НаСервере
метод КодСостояния(Статус: СостоянияИгры): Строка
    если Статус == СостоянияИгры.Черновик
        возврат "draft"
    иначе если Статус == СостоянияИгры.Подготовка
        возврат "preparing"
    иначе если Статус == СостоянияИгры.Идет
        возврат "running"
    иначе если Статус == СостоянияИгры.Пауза
        возврат "paused"
    иначе если Статус == СостоянияИгры.Завершена
        возврат "completed"
    ;
    возврат "cancelled"
;


@ВПроекте @НаСервере @ДоступноСКлиента
метод ШаблонСоответствий(): Строка
    возврат "{\"items\":[{\"itemCode\":\"CityRide\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"pcs\",\"coefficient\":\"1\"},{\"itemCode\":\"SportDrive\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"pcs\",\"coefficient\":\"1\"},{\"itemCode\":\"CargoMax\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"pcs\",\"coefficient\":\"1\"},{\"itemCode\":\"TourPro\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"pcs\",\"coefficient\":\"1\"},{\"itemCode\":\"FRAME_STD\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"pcs\",\"coefficient\":\"1\"},{\"itemCode\":\"FRAME_CARGO\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"pcs\",\"coefficient\":\"1\"},{\"itemCode\":\"POWER_350\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"set\",\"coefficient\":\"1\"},{\"itemCode\":\"POWER_500\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"set\",\"coefficient\":\"1\"},{\"itemCode\":\"BAT_300\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"pcs\",\"coefficient\":\"1\"},{\"itemCode\":\"BAT_500\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"pcs\",\"coefficient\":\"1\"},{\"itemCode\":\"BAT_800\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"pcs\",\"coefficient\":\"1\"},{\"itemCode\":\"WHEELS_STD\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"set\",\"coefficient\":\"1\"},{\"itemCode\":\"WHEELS_HEAVY\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"set\",\"coefficient\":\"1\"},{\"itemCode\":\"EQUIP_BASE\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"set\",\"coefficient\":\"1\"},{\"itemCode\":\"EQUIP_PLUS\",\"refKey\":\"\",\"characteristicId\":\"\",\"unitCode\":\"set\",\"coefficient\":\"1\"}]}"
;

// Профиль документов ERP строится из сохранённых условий игры, до первого HTTP-запроса.
@ВПроекте @НаСервере
метод ПрофильНастройкиБазы(Игра: Игры.Объект): Строка
    знч Профиль = ПротоколERP.Прочитать(ПрофильНастройкиOData.Получить())
    знч Условия = Подготовка(Игра)
    ПрименитьУсловияКПрофилю(Профиль, Условия)
    возврат ПротоколERP.Json(Профиль)
;

@ВПроекте @НаСервере
метод ПрименитьУсловияКПрофилю(Профиль: Соответствие<Строка, Объект?>, Условия: Соответствие<Строка, Объект?>)
    знч Остатки = <Строка, Соответствие<Строка, Объект?>>{:}
    для Элемент из ПротоколERP.МассивJson(Условия.Получить("balances"))
        знч Остаток = ПротоколERP.ОбъектJson(Элемент)
        Остатки.Вставить(ПротоколERP.СтрокаJson(Остаток, "itemCode") + "/" + ПротоколERP.СтрокаJson(Остаток, "warehouseId"), Остаток)
    ;
    // Контракт обмена требует все 26 пар номенклатура/склад. Отсутствие
    // ресурса в сценарии означает нулевой остаток, а не отсутствие НСИ.
    знч ПолныеОстатки = <Объект?>[]
    знч ШаблонПрофиля = ПротоколERP.Прочитать(ПрофильНастройкиOData.Получить())
    знч Начальные = ПротоколERP.ОбъектJson(ШаблонПрофиля.Получить("initial"))
    для Элемент из ПротоколERP.МассивJson(Начальные.Получить("balances"))
        знч Шаблон = ПротоколERP.ОбъектJson(Элемент)
        знч Ид = ПротоколERP.СтрокаJson(Шаблон, "itemCode") + "/" + ПротоколERP.СтрокаJson(Шаблон, "warehouseId")
        если не Остатки.СодержитКлюч(Ид)
            Остатки.Вставить(Ид, {"itemCode": Шаблон.Получить("itemCode"), "warehouseId": Шаблон.Получить("warehouseId"),
                "unitCode": Шаблон.Получить("unitCode"), "quantity": "0", "unitCost": Шаблон.Получить("unitCost")})
        ;
        ПолныеОстатки.Добавить(Остатки.Получить(Ид))
    ;
    ПроверкиДанных.Требовать(ПолныеОстатки.Размер() == Остатки.Размер(), "Неизвестный код или склад начального ресурса")
    Условия.Вставить("balances", ПолныеОстатки)
    знч Цены = <Строка, Число>{:}
    для Элемент из ПротоколERP.МассивJson(Условия.Получить("initialPrices"))
        знч Цена = ПротоколERP.ОбъектJson(Элемент)
        Цены.Вставить(ПротоколERP.СтрокаJson(Цена, "productCode"), новый Число(ПротоколERP.СтрокаJson(Цена, "price")))
    ;
    знч Узлы = <Объект?>[]
    для Элемент из ПротоколERP.МассивJson(Профиль.Получить("nodes"))
        знч Узел = ПротоколERP.ОбъектJson(Элемент)
        знч Ключ = ПротоколERP.СтрокаJson(Узел, "key")
        если не ["initial_stock", "initial_components", "initial_supplier_prices", "initial_prices"].Содержит(Ключ)
            Узлы.Добавить(Элемент)
            продолжить
        ;
        знч Поля = ПротоколERP.ОбъектJson(Узел.Получить("fields"))
        знч ИмяТаблицы = Ключ == "initial_prices" ? "Товары2_5" : "Товары"
        знч Товары = <Объект?>[]
        для СтрокаДанных из ПротоколERP.МассивJson(Поля.Получить(ИмяТаблицы))
            знч Строка = ПротоколERP.ОбъектJson(СтрокаДанных)
            знч Код = ПротоколERP.СтрокаJson(Строка, "Номенклатура_Key").Подстрока(1)
            если Ключ == "initial_prices" и Строка.Получить("ВидЦены_Key") == "@sales_price"
                ПроверкиДанных.Требовать(Цены.СодержитКлюч(Код), "В сценарии отсутствует цена " + Код)
                Строка.Вставить("Цена", Цены.Получить(Код))
            иначе
                знч Склад = Ключ == "initial_stock" или Цены.СодержитКлюч(Код) ? "finished_goods" : "purchases"
                знч Ид = Код + "/" + Склад
                знч Остаток = Остатки.Получить(Ид)
                знч Цена = новый Число(ПротоколERP.СтрокаJson(Остаток, "unitCost"))
                Строка.Вставить("Цена", Цена)
                если Ключ == "initial_stock" или Ключ == "initial_components"
                    знч Количество = новый Число(ПротоколERP.СтрокаJson(Остаток, "quantity"))
                    если Количество == 0
                        продолжить
                    ;
                    Строка.Вставить("Количество", Количество)
                    Строка.Вставить("КоличествоУпаковок", Количество)
                    Строка.Вставить("Сумма", (Количество * Цена).Округлить(2))
                ;
            ;
            Товары.Добавить(Строка)
        ;
        // Не создаём пустой документ ввода остатков.
        если (Ключ == "initial_stock" или Ключ == "initial_components") и Товары.Пусто()
            продолжить
        ;
        Поля.Вставить(ИмяТаблицы, Товары)
        Узел.Вставить("fields", Поля)
        Узлы.Добавить(Узел)
    ;
    Профиль.Вставить("nodes", Узлы)
    Профиль.Вставить("initial", Условия)
;
