импорт Данные

// Инициатор соединений — Элемент. Секрет ERP никогда не возвращается клиенту.
@ВПроекте @НаСервере
метод АдресСервиса(База: ПодключенияERP.Объект): Строка
    знч Адрес = База.АдресHttpApi.Сократить()
    возврат Адрес == "" ? НастройкаБазOData.АдресПубликации(База.АдресOData) + "hs/game/v1/"
        : (Адрес.ЗаканчиваетсяНа("/") ? Адрес : Адрес + "/")
;

@ВПроекте @НаСервере
метод ПроверитьПодключение(Команда: УчастникиИгры.Объект)
    НастройкаБазOData.ПроверитьДоступЗаказов(Команда)
    знч База = Команда.ПодключениеERP!.ЗагрузитьОбъект()!
    ПроверкиДанных.Требовать(АдресСервиса(База).НачинаетсяС("https://"), "Укажите HTTPS-адрес HTTP-сервиса ERP")
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод НастройкиHttp(Игра: Игры.Ссылка, Участник: УчастникиИгры.Ссылка): Строка
    ДоступИгры.ПроверитьВедущего(Игра)
    исп КонтекстДоступа.Привилегированный()
    знч Команда = Участник.ЗагрузитьОбъект()!
    ПроверкиДанных.Требовать(Команда.Игра == Игра, "Выберите команду выбранной игры")
    возврат Команда.ПодключениеERP == Неопределено ? "" : АдресСервиса(Команда.ПодключениеERP!.ЗагрузитьОбъект()!)
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод СохранитьАдресHttp(Игра: Игры.Ссылка, Участник: УчастникиИгры.Ссылка, Адрес: Строка)
    ДоступИгры.ПроверитьВедущего(Игра)
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч ОбъектИгры = Игра.ЗагрузитьОбъект(Истина)!
    знч Команда = Участник.ЗагрузитьОбъект(Истина)!
    ПроверкиДанных.Требовать(Команда.Игра == Игра и Команда.ПодключениеERP != Неопределено,
        "Сначала сохраните подключение ERP команды")
    ПроверкиДанных.Требовать(ОбъектИгры.Статус == СостоянияИгры.Черновик, "Адрес HTTP-сервиса изменяется до подготовки игры")
    знч АдресСервисаERP = Адрес.Сократить()
    ПроверкиДанных.Требовать(АдресСервисаERP == "" или (АдресСервисаERP.НачинаетсяС("https://")
        и АдресСервисаERP.Длина() <= 1000 и не АдресСервисаERP.Содержит("@")
        и не АдресСервисаERP.Содержит("?") и не АдресСервисаERP.Содержит("#")), "Укажите HTTPS-адрес сервиса без логина и параметров")
    знч База = Команда.ПодключениеERP!.ЗагрузитьОбъект(Истина)!
    База.АдресHttpApi = АдресСервисаERP
    База.РежимОбмена = РежимыОбменаERP.Гибридный
    База.Записать()
;

// Внешний Context использует английские поля контракта. bindingId не нужен.
@НаСервере
метод Контекст(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка): Соответствие<Строка, Объект?>
    знч Старый = ОбменERP.Контекст(Участник.Ид.ВСтроку(), Участник, Игра)
    знч Результат: Соответствие<Строка, Объект?> = {:}
    для Пара из Старый
        если Пара.Ключ != "bindingId"
            Результат.Вставить(Пара.Ключ, Пара.Значение)
        ;
    ;
    Результат.Вставить("phaseState", Игра.СостояниеФазы == СостоянияФазы.Открыта ? "open"
        : (Игра.СостояниеФазы == СостоянияФазы.Фиксация ? "freezing"
            : (Игра.СостояниеФазы == СостоянияФазы.ОжиданиеERP ? "waiting_erp" : "closed")))
    возврат Результат
;

@НаСервере
метод ЗапросHttp(База: ПодключенияERP.Объект, Ресурс: Строка,
    Данные: Соответствие<Строка, Объект?>, ИдОперации: Строка): Соответствие<Строка, Объект?>
    ПроверкиДанных.Требовать(не Транзакции.ЕстьАктивная(), "Сетевой обмен выполняется вне транзакции игры")
    знч Соединение = КлиентHttp.СБазовымUrl(АдресСервиса(База))
        .САутентификацией(новый АутентификацияHttp(База.ЛогинOData, База.ПарольOData!))
        .СТаймаутомСоединения(5с).СТаймаутомЗапроса(15с).СМаксимумомПеренаправлений(0)
    знч Запрос = Соединение.СоздатьЗапрос("POST", Ресурс)
        .УстановитьЗаголовок("Accept", "application/json")
        .УстановитьЗаголовок("X-Game-Contract-Version", "1.0")
        .УстановитьЗаголовок("Idempotency-Key", ИдОперации)
        .УстановитьТипСодержимого("application/json; charset=utf-8")
        .УстановитьТело(ПротоколERP.КаноническийJson(Данные))
    исп Ответ = Запрос.Выполнить()
    если Ресурс == "ack"
        ПротоколERP.Требовать(Ответ.КодСтатуса == 204, "ERP_HTTP", "ERP не подтвердила приём квитанции обмена")
        возврат {:}
    ;
    ПротоколERP.Требовать(Ответ.КодСтатуса == 200 или Ответ.КодСтатуса == 202, "ERP_HTTP",
        "HTTP-сервис ERP вернул %{Ответ.КодСтатуса}. Проверьте публикацию сервиса и доступ ERP")
    исп Буфер = новый ВременныйПотокЗаписи()
    знч Размер = Ответ.Тело.КопироватьВ(Буфер, Количество = 1048577)
    ПротоколERP.Требовать(Размер <= 1048576, "PAYLOAD_TOO_LARGE", "Ответ ERP превышает 1 МиБ")
    знч Результат = ПротоколERP.Прочитать(Буфер.ОткрытьПотокЧтения().ПрочитатьКакСтроку())
    ПротоколERP.ПроверитьСхему(Результат, КонтрактERP.Схема("ERPResponse"))
    возврат Результат
;

@НаСервере
метод СоответствияКоманды(Команда: УчастникиИгры.Объект): Массив<Объект?>
    знч Подключение = Команда.ПодключениеERP
    знч Результат = <Объект?>[]
    для Строка из Запрос{ВЫБРАТЬ НоменклатураИгры, RefKey, КлючХарактеристики, ЕдиницаERP, КоэффициентПересчета
        ИЗ СоответствияERP ГДЕ Подключение == %Подключение}.Выполнить()
        Результат.Добавить(<Строка, Объект?>{"itemCode": Строка.НоменклатураИгры!.ЗагрузитьОбъект()!.Код,
            "refKey": Строка.RefKey, "characteristicId": Строка.КлючХарактеристики,
            "unitCode": Строка.ЕдиницаERP, "coefficient": Строка.КоэффициентПересчета.ВСтроку().Заменить(",", ".")})
    ;
    возврат Результат
;

@НаСервере
метод ЗаказыКоманды(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка): Массив<Объект?>
    знч СсылкаИгры = Игра.Ссылка
    знч Раунд = Игра.ТекущийРаунд
    знч Результат = <Объект?>[]
    знч Заказы = <Строка>[]
    для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ КомандыОбмена
        ГДЕ Игра == %СсылкаИгры И Участник == %Участник И Раунд == %Раунд
            И Вид == ВидыКомандERP.СоздатьЗаказКлиента И Статус == СтатусыКомандОбмена.Выполнена
        УПОРЯДОЧИТЬ ПО Последовательность УБЫВ}.Выполнить()
        знч Задание = Строка.Ссылка.ЗагрузитьОбъект()!
        знч Конверт = ПротоколERP.Прочитать(СообщенияERP.Текст(Задание.Конверт!))
        знч ИдЗаказа = ПротоколERP.СтрокаJson(ПротоколERP.ОбъектJson(Конверт.Получить("payload")), "externalOrderId")
        если Заказы.Содержит(ИдЗаказа)
            продолжить
        ;
        Заказы.Добавить(ИдЗаказа)
        знч Подтверждение = ПротоколERP.Прочитать(СообщенияERP.Текст(Задание.Подтверждение!))
        Результат.Добавить(<Строка, Объект?>{"command": Конверт, "erpDocumentIds": Подтверждение.Получить("erpDocumentIds")})
    ;
    возврат Результат
;

// Резерв задания фиксируется отдельно; СледующаяПопытка служит арендой отправки.
@НаСервере
метод Резервировать(Игра: Игры.Ссылка, Участник: УчастникиИгры.Ссылка): КомандыОбмена.Ссылка?
    исп Транзакции.Начать()
    знч ОбъектИгры = Игра.ЗагрузитьОбъект(Истина)!
    если ОбъектИгры.ТолькоРынок
        возврат Неопределено
    ;
    знч Токен = ОбъектИгры.ТокенФазы
    знч Строки = Запрос{ВЫБРАТЬ Ссылка ИЗ КомандыОбмена
        ГДЕ Игра == %Игра И Участник == %Участник И НЕ ПометкаУдаления
            И (Статус == СтатусыКомандОбмена.Ожидает ИЛИ Статус == СтатусыКомандОбмена.Выполняется)
        УПОРЯДОЧИТЬ ПО Последовательность}.Выполнить().Преобразовать(Строка -> Строка)
    знч ОчередьОтправки = <КомандыОбмена.Ссылка>[]
    // Применение текущего состояния ERP предшествует хозяйственным операциям.
    для Строка из Строки
        знч Задание = Строка.Ссылка.ЗагрузитьОбъект()!
        если Задание.ТокенФазы == Токен
            и [ВидыКомандERP.ОткрытьФазу, ВидыКомандERP.Приостановить, ВидыКомандERP.Возобновить].Содержит(Задание.Вид)
            ОчередьОтправки.Добавить(Задание.Ссылка)
        ;
    ;
    для Строка из Строки
        если не ОчередьОтправки.Содержит(Строка.Ссылка)
            ОчередьОтправки.Добавить(Строка.Ссылка)
        ;
    ;
    для СсылкаЗадания из ОчередьОтправки
        знч Задание = СсылкаЗадания.ЗагрузитьОбъект(Истина)!
        // Возобновление уже создало новые конверты с прежними хозяйственными Ид.
        если Задание.ТокенФазы != Токен
            Задание.Статус = СтатусыКомандОбмена.Отменена
            Задание.Записать()
            продолжить
        ;
        если [СостоянияИгры.Пауза, СостоянияИгры.Отменена, СостоянияИгры.Завершена].Содержит(ОбъектИгры.Статус)
            и Задание.Вид != ВидыКомандERP.Приостановить
            продолжить
        ;
        если Задание.СледующаяПопытка != Неопределено и Задание.СледующаяПопытка! > Момент.Сейчас()
            возврат Неопределено
        ;
        Задание.СледующаяПопытка = Момент.Сейчас() + 5м
        Задание.ЧислоПопыток = Задание.ЧислоПопыток + 1
        Задание.Статус = СтатусыКомандОбмена.Выполняется
        Задание.Записать()
        возврат Задание.Ссылка
    ;
    возврат Неопределено
;

@НаСервере
метод ПринятьСообщение(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Маршрут: Строка,
    ИмяСхемы: Строка, Данные: Соответствие<Строка, Объект?>, ИдКоманды: Строка = ""): Строка
    ПротоколERP.ПроверитьСхему(Данные, КонтрактERP.Схема(ИмяСхемы))
    знч Тело = ПротоколERP.КаноническийJson(Данные)
    знч Ответ = ОбменERP.ОбработатьPost(Игра, Участник, Участник.Ид.ВСтроку(), Маршрут, Данные,
        Тело, ПротоколERP.Хеш(Маршрут + "|" + Тело), ИдКоманды)
    возврат ПротоколERP.СтрокаJson(Ответ, "resourceId")
;

// snapshotId ERP — messageId вложенного снимка; заменяется только локальной ссылкой.
@ВПроекте @НаСервере
метод ПодставитьСнимок(Данные: Соответствие<Строка, Объект?>, ИдСообщения: Строка, ИдСнимка: Строка)
    если Данные.СодержитКлюч("snapshotId")
        ПротоколERP.Требовать(Данные.Получить("snapshotId") == ИдСообщения и ИдСнимка != "",
            "SNAPSHOT_NOT_FROZEN", "Подтверждение должно ссылаться на снимок из этого ответа")
        Данные.Вставить("snapshotId", ИдСнимка)
    ;
;

@НаСервере
метод СохранитьОтвет(СсылкаИгры: Игры.Ссылка, Участник: УчастникиИгры.Ссылка,
    Ответ: Соответствие<Строка, Объект?>, Задание: КомандыОбмена.Ссылка?, НомерПопытки: Число,
    Версия: Число, Токен: Строка): Массив<Строка>
    ПротоколERP.ПроверитьСхему(Ответ, КонтрактERP.Схема("ERPResponse"))
    знч Принятые = <Строка>[]
    исп Транзакции.Начать()
    знч Игра = СсылкаИгры.ЗагрузитьОбъект(Истина)!
    знч Команда = Участник.ЗагрузитьОбъект()!
    если Игра.ТолькоРынок или Команда.Игра != СсылкаИгры или не Команда.Активен
        возврат Принятые
    ;
    // Запоздалый ответ не меняет новую фазу; задание будет повторено с тем же Ид.
    если Игра.ВерсияСостояния != Версия или Игра.ТокенФазы != Токен
        возврат Принятые
    ;
    знч ИдКоманды = Ответ.ПолучитьИлиУмолчание("commandId", "") как Строка
    если Задание != Неопределено
        знч ОбъектЗадания = Задание!.ЗагрузитьОбъект(Истина)!
        если ОбъектЗадания.ЧислоПопыток != НомерПопытки
            возврат Принятые
        ;
        ПротоколERP.Требовать(ИдКоманды == ОбъектЗадания.ИдОперации, "BINDING_FORBIDDEN", "Ответ относится к другому заданию ERP")
    иначе
        ПротоколERP.Требовать(ИдКоманды == "" и не Ответ.СодержитКлюч("receipt"), "VALIDATION_ERROR", "Чтение состояния не подтверждает задания")
    ;
    пер ИдСнимка = ""
    пер ИдСообщенияСнимка = ""
    // Факты принимаются до final: проверка итогов должна видеть последние оплаты.
    для Значение из ПротоколERP.МассивJson(Ответ.Получить("salesEvents"))
        ПринятьСообщение(Игра, Участник, "sales-events", "SalesEventRequest", ПротоколERP.ОбъектJson(Значение))
        Принятые.Добавить(ПротоколERP.СтрокаJson(ПротоколERP.ОбъектJson(Значение), "messageId"))
    ;
    для Значение из ПротоколERP.МассивJson(Ответ.Получить("executionEvents"))
        ПринятьСообщение(Игра, Участник, "execution-events", "ExecutionEventRequest", ПротоколERP.ОбъектJson(Значение))
        Принятые.Добавить(ПротоколERP.СтрокаJson(ПротоколERP.ОбъектJson(Значение), "messageId"))
    ;
    если Ответ.СодержитКлюч("snapshot")
        знч Снимок = ПротоколERP.ОбъектJson(Ответ.Получить("snapshot"))
        ИдСообщенияСнимка = ПротоколERP.СтрокаJson(Снимок, "messageId")
        ИдСнимка = ПринятьСообщение(Игра, Участник, "snapshots", "SnapshotRequest", Снимок)
        Принятые.Добавить(ИдСообщенияСнимка)
    ;
    если Ответ.СодержитКлюч("receipt")
        знч Подтверждение = ПротоколERP.ОбъектJson(Ответ.Получить("receipt"))
        ПодставитьСнимок(Подтверждение, ИдСообщенияСнимка, ИдСнимка)
        ПринятьСообщение(Игра, Участник, "commands/%{ИдКоманды}/receipt", "CommandReceiptRequest", Подтверждение, ИдКоманды)
        Принятые.Добавить(ПротоколERP.СтрокаJson(Подтверждение, "messageId"))
        знч ОбъектЗадания = Задание!.ЗагрузитьОбъект(Истина)!
        ОбъектЗадания.СледующаяПопытка = Момент.Сейчас() + 5с
        ОбъектЗадания.КодОшибки = ОбъектЗадания.Статус == СтатусыКомандОбмена.Ошибка ? ОбъектЗадания.КодОшибки : ""
        ОбъектЗадания.ОписаниеОшибки = ОбъектЗадания.Статус == СтатусыКомандОбмена.Ошибка ? ОбъектЗадания.ОписаниеОшибки : ""
        ОбъектЗадания.Записать()
    ;
    если Ответ.СодержитКлюч("readiness") и Игра.СостояниеФазы == СостоянияФазы.Открыта и Игра.Статус != СостоянияИгры.Пауза
        знч Готовность = ПротоколERP.ОбъектJson(Ответ.Получить("readiness"))
        ПодставитьСнимок(Готовность, ИдСообщенияСнимка, ИдСнимка)
        ПринятьСообщение(Игра, Участник, "readiness", "ReadinessRequest", Готовность)
        Принятые.Добавить(ПротоколERP.СтрокаJson(Готовность, "messageId"))
    ;
    ОчиститьОшибкуСвязи(Игра, Участник)
    возврат Принятые
;

@НаСервере
метод ОчиститьОшибкуСвязи(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка)
    знч Раунд = Игра.ТекущийРаунд
    знч Токен = Игра.ТокенФазы
    знч Состояние = Запрос{ВЫБРАТЬ Готов, ПоследнийСнимок, Ошибка ИЗ СостоянияУчастников
        ГДЕ Участник == %Участник И Раунд == %Раунд И ТокенФазы == %Токен}.Выполнить().ПервыйИлиНеопределено()
    если Состояние != Неопределено и Состояние!.Ошибка.НачинаетсяС("Связь с ERP: ")
        ОбменERP.ЗаписатьГотовность(Игра, Участник, Состояние!.ПоследнийСнимок, Состояние!.Готов, "")
    ;
;

@НаСервере
метод СохранитьОшибку(СсылкаИгры: Игры.Ссылка, Участник: УчастникиИгры.Ссылка,
    Задание: КомандыОбмена.Ссылка?, НомерПопытки: Число, Версия: Число, Описание: Строка)
    исп Транзакции.Начать()
    знч Игра = СсылкаИгры.ЗагрузитьОбъект(Истина)!
    если Игра.ТолькоРынок или Игра.ВерсияСостояния != Версия
        возврат
    ;
    если Задание != Неопределено
        знч ОбъектЗадания = Задание!.ЗагрузитьОбъект(Истина)!
        если ОбъектЗадания.ЧислоПопыток != НомерПопытки
            возврат
        ;
        если ОбъектЗадания.Статус == СтатусыКомандОбмена.Выполняется или ОбъектЗадания.Статус == СтатусыКомандОбмена.Ожидает
            ОбъектЗадания.СледующаяПопытка = Момент.Сейчас() + 15с
            ОбъектЗадания.КодОшибки = "ERP_TRANSPORT"
            ОбъектЗадания.ОписаниеОшибки = Описание
            ОбъектЗадания.Записать()
        ;
    ;
    знч Раунд = Игра.ТекущийРаунд
    знч Токен = Игра.ТокенФазы
    знч Состояние = Запрос{ВЫБРАТЬ Готов, ПоследнийСнимок ИЗ СостоянияУчастников
        ГДЕ Участник == %Участник И Раунд == %Раунд И ТокенФазы == %Токен}.Выполнить().ПервыйИлиНеопределено()
    ОбменERP.ЗаписатьГотовность(Игра, Участник, Состояние?.ПоследнийСнимок, Состояние?.Готов ?? Ложь, "Связь с ERP: " + Описание)
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод Синхронизировать(СсылкаИгры: Игры.Ссылка)
    ДоступИгры.ПроверитьВедущего(СсылкаИгры)
    ПроверкиДанных.Требовать(не Транзакции.ЕстьАктивная(), "Синхронизация запускается после сохранения перехода игры")
    исп КонтекстДоступа.Привилегированный()
    знч ИгровойОбъект = СсылкаИгры.ЗагрузитьОбъект()!
    если ИгровойОбъект.ТолькоРынок или ИгровойОбъект.Статус == СостоянияИгры.Черновик
        возврат
    ;
    для Участник из ОбменERP.Участники(ИгровойОбъект)
        ПланироватьКоманду(СсылкаИгры, Участник)
    ;
;

// Этот метод вызывается только обработчиком серверного задания, без сессии ведущего.
@ВПодсистеме @НаСервере
метод ПланироватьФоновыйОбмен()
    исп КонтекстДоступа.Привилегированный()
    для Строка из Запрос{ВЫБРАТЬ Ссылка, Игра ИЗ УчастникиИгры
        ГДЕ Активен И НЕ ПометкаУдаления И Игра != Неопределено И НЕ Игра.ПометкаУдаления
            И Игра.Статус != СостоянияИгры.Черновик}.Выполнить()
        знч Игра = Строка.Игра!.ЗагрузитьОбъект()!
        если ЕстьРаботаФоном(Игра, Строка.Ссылка)
            ПланироватьКоманду(Строка.Игра!, Строка.Ссылка)
        ;
    ;
;

@НаСервере
метод ЕстьРаботаФоном(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка): Булево
    если Игра.ТолькоРынок
        возврат РынокЗаказов.ПродажиОткрыты(Игра)
    ;
    если [СостоянияИгры.Подготовка, СостоянияИгры.Идет, СостоянияИгры.Пауза].Содержит(Игра.Статус)
        возврат Истина
    ;
    если [СостоянияИгры.Завершена, СостоянияИгры.Отменена].Содержит(Игра.Статус)
        знч СсылкаИгры = Игра.Ссылка
        знч Токен = Игра.ТокенФазы
        возврат не Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ КомандыОбмена
            ГДЕ Игра == %СсылкаИгры И Участник == %Участник И ТокенФазы == %Токен И НЕ ПометкаУдаления
                И Вид == ВидыКомандERP.Приостановить
                И (Статус == СтатусыКомандОбмена.Ожидает ИЛИ Статус == СтатусыКомандОбмена.Выполняется)}.Выполнить().Пусто()
    ;
    возврат Ложь
;

@НаСервере
метод ПланироватьКоманду(Игра: Игры.Ссылка, Участник: УчастникиИгры.Ссылка)
    // Один экземпляр на команду: следующий тик не прерывает текущий HTTP-запрос.
    ОбменКомандыERP.Создать(Игра = Игра, Участник = Участник)
        .Настроить(Ключ = "ERP_TEAM:%{Игра.Ид}:%{Участник.Ид}", СтратегияПубликации = СтратегияПубликацииЗадания.Отбросить)
        .Запланировать()
;

@ВПодсистеме @НаСервере
метод СинхронизироватьФоном(СсылкаИгры: Игры.Ссылка, Участник: УчастникиИгры.Ссылка)
    ПроверкиДанных.Требовать(не Транзакции.ЕстьАктивная(), "Фоновый обмен выполняется вне транзакции")
    исп КонтекстДоступа.Привилегированный()
    знч Игра = СсылкаИгры.ЗагрузитьОбъект()
    знч Команда = Участник.ЗагрузитьОбъект()
    если Игра == Неопределено или Команда == Неопределено или Игра!.ПометкаУдаления
        или Команда!.ПометкаУдаления или не Команда!.Активен или Команда!.Игра != СсылкаИгры
        возврат
    ;
    // Свободный рынок использует OData и в полном цикле, и в режиме «Только рынок».
    // Чтение и публикация завершают собственные транзакции до продолжения обмена.
    если РынокЗаказов.ПродажиОткрыты(Игра!)
        РынокЗаказов.СинхронизироватьРынокФоном(СсылкаИгры, Участник)
        РынокЗаказов.Обновить(СсылкаИгры)
    ;
    если Игра!.ТолькоРынок
        возврат
    ;
    если ЕстьРаботаФоном(Игра!, Участник)
        СинхронизироватьКоманду(СсылкаИгры, Участник)
    ;
;

@НаСервере
метод СинхронизироватьКоманду(СсылкаИгры: Игры.Ссылка, Участник: УчастникиИгры.Ссылка)
    знч Задание = Резервировать(СсылкаИгры, Участник)
    знч Игра = СсылкаИгры.ЗагрузитьОбъект()!
    если Игра.ТолькоРынок
        возврат
    ;
    знч Завершена = [СостоянияИгры.Отменена, СостоянияИгры.Завершена].Содержит(Игра.Статус)
    если Завершена и Задание == Неопределено
        возврат
    ;
    знч Версия = Игра.ВерсияСостояния
    знч Токен = Игра.ТокенФазы
    знч НомерПопытки = Задание?.ЗагрузитьОбъект()?.ЧислоПопыток ?? 0
    попытка
        знч Команда = Участник.ЗагрузитьОбъект()!
        ПроверитьПодключение(Команда)
        знч База = Команда.ПодключениеERP!.ЗагрузитьОбъект()!
        знч КонтекстИгры = Контекст(Игра, Участник)
        знч Соответствия = СоответствияКоманды(Команда)
        знч ИгрокЗавершил = ДоступКабинета.Завершено(Участник, Игра.ТекущийРаунд, Токен)
        знч РасчетГотов = Игра.ТекущийРаунд?.ЗагрузитьОбъект()?.ОкончательныйРасчет != Неопределено
        если Задание != Неопределено
            знч Документ = Задание!.ЗагрузитьОбъект()!
            знч Конверт = ПротоколERP.Прочитать(СообщенияERP.Текст(Документ.Конверт!))
            знч Запрос: Соответствие<Строка, Объект?> = {"contractVersion": "1.0", "context": КонтекстИгры,
                "organization": Команда.ОрганизацияERP, "mappings": Соответствия,
                "orders": ЗаказыКоманды(Игра, Участник), "playerFinished": ИгрокЗавершил,
                "allocationReady": РасчетГотов, "command": Конверт}
            ПротоколERP.ПроверитьСхему(Запрос, КонтрактERP.Схема("ERPCommandRequest"))
            знч Ответ = ПротоколERP.СтрокаJson(Конверт, "kind") == "create_customer_order"
                ? СоздатьЗаказ(База, Команда.ОрганизацияERP, Конверт) : ЗапросHttp(База, "commands", Запрос, Документ.ИдОперации)
            знч Принятые = СохранитьОтвет(СсылкаИгры, Участник, Ответ, Задание, НомерПопытки, Версия, Токен)
            если ПротоколERP.СтрокаJson(Конверт, "kind") != "create_customer_order"
                ПодтвердитьПрием(База, СсылкаИгры, Участник, Принятые)
            ;
        ;
        если Завершена
            возврат
        ;
        // На закрытой фазе ERP возвращает факты, но не новый monitoring/readiness.
        знч ЗапросСостояния: Соответствие<Строка, Объект?> = {"contractVersion": "1.0", "context": КонтекстИгры,
            "organization": Команда.ОрганизацияERP, "mappings": Соответствия,
            "orders": ЗаказыКоманды(Игра, Участник), "playerFinished": ИгрокЗавершил, "allocationReady": РасчетГотов}
        ПротоколERP.ПроверитьСхему(ЗапросСостояния, КонтрактERP.Схема("ERPStateRequest"))
        знч Состояние = ЗапросHttp(База, "state", ЗапросСостояния, новый Ууид().ВСтроку())
        знч Принятые = СохранитьОтвет(СсылкаИгры, Участник, Состояние, Неопределено, 0, Версия, Токен)
        ПодтвердитьПрием(База, СсылкаИгры, Участник, Принятые)
    поймать Ошибка: Исключение
        // Не сохраняем текст произвольного HTTP-ответа или исключения с секретами.
        знч Описание = Ошибка это ПротоколERP.Ошибка ? Ошибка.Описание
            : "Не удалось связаться с ERP. Проверьте адрес, публикацию и учётные данные базы; обмен повторится автоматически."
        СохранитьОшибку(СсылкаИгры, Участник, Задание, НомерПопытки, Версия, Описание)
    ;
;

@НаСервере
метод ПодтвердитьПрием(База: ПодключенияERP.Объект, Игра: Игры.Ссылка, Участник: УчастникиИгры.Ссылка, ИдСообщений: Массив<Строка>)
    если ИдСообщений.Пусто()
        возврат
    ;
    знч Квитанция: Соответствие<Строка, Объект?> = {"contractVersion": "1.0", "gameId": Игра.Ид.ВСтроку(),
        "participantId": Участник.Ид.ВСтроку(), "messageIds": ИдСообщений}
    // Квитанция отправляется только после фиксации СохранитьОтвет; потеря квитанции приводит к безопасному повтору.
    ЗапросHttp(База, "ack", Квитанция, новый Ууид().ВСтроку())
;

@НаСервере
метод СоздатьЗаказ(База: ПодключенияERP.Объект, Организация: Строка,
    Команда: Соответствие<Строка, Объект?>): Соответствие<Строка, Объект?>
    знч Нагрузка = ПротоколERP.ОбъектJson(Команда.Получить("payload"))
    знч ИдЗаказа = ПротоколERP.СтрокаJson(Нагрузка, "externalOrderId")
    знч Результат = НастройкаБазOData.СоздатьЗаказПоСтрокамOData(База.АдресOData, База.ЛогинOData,
        База.ПарольOData!, Организация, ИдЗаказа, ПротоколERP.МассивJson(Нагрузка.Получить("lines")),
        ПротоколERP.СтрокаJson(Нагрузка, "documentDate"))
    знч ИдКоманды = ПротоколERP.СтрокаJson(Команда, "commandId")
    знч Подтверждение: Соответствие<Строка, Объект?> = {"messageId": Ууид.Версия5("odata-receipt:" + ИдКоманды).ВСтроку(),
        "gameId": Команда.Получить("gameId"), "participantId": Команда.Получить("participantId"),
        "phaseToken": Команда.Получить("phaseToken"), "roundNumber": Команда.Получить("roundNumber"),
        "gameMonth": Команда.Получить("gameMonth"), "status": "completed",
        "erpDocumentIds": <Объект?>[ПротоколERP.СтрокаJson(Результат, "refKey")]}
    возврат {"contractVersion": "1.0", "commandId": ИдКоманды, "receipt": Подтверждение,
        "salesEvents": <Объект?>[], "executionEvents": <Объект?>[]}
;
