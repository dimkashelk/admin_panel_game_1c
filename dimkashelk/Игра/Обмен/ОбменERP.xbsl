импорт Данные

@ВПроекте @НаСервере @ДоступноСКлиента
метод НазначитьСервис(Участник: УчастникиИгры.Ссылка, Пользователь: Пользователи.Ссылка, Активно: Булево): Строка
    ДоступИгры.ТребоватьАдминистратора()
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч ИграУчастника = Участник.ЗагрузитьОбъект()!.Игра
    ПроверкиДанных.Требовать(ИграУчастника != Неопределено, "Команда не назначена игре")
    знч БлокировкаИгры = ИграУчастника!.ЗагрузитьОбъект(Истина)
    знч БлокировкаПользователя = Пользователь.ЗагрузитьОбъект(Истина)
    знч Команда = Участник.ЗагрузитьОбъект(Истина)!
    ПроверкиДанных.Требовать(Команда.Игра != Неопределено и Команда.ПодключениеERP != Неопределено,
        "Назначьте участнику подключение ERP")
    знч Другие = Запрос{
        ВЫБРАТЬ Участник ИЗ ПривязкиСервисовERP
        ГДЕ СервисныйПользователь == %Пользователь И Активно И Участник != %Участник
    }.Выполнить()
    ПроверкиДанных.Требовать(не Активно или Другие.Пусто(), "Сервисный пользователь уже назначен другой игровой области")
    знч ДругиеПользователи = Запрос{
        ВЫБРАТЬ СервисныйПользователь ИЗ ПривязкиСервисовERP
        ГДЕ Участник == %Участник И Активно И СервисныйПользователь != %Пользователь
    }.Выполнить()
    ПроверкиДанных.Требовать(не Активно или ДругиеПользователи.Пусто(), "У команды уже есть активный сервисный пользователь")
    знч Старый = Запрос{
        ВЫБРАТЬ ИдПривязки ИЗ ПривязкиСервисовERP ГДЕ СервисныйПользователь == %Пользователь И Участник == %Участник
    }.Выполнить().ПервыйИлиНеопределено()
    знч ИдПривязки = Старый != Неопределено и Старый!.ИдПривязки != "" ? Старый!.ИдПривязки : новый Ууид().ВСтроку()
    знч Записи = новый ПривязкиСервисовERP.НаборЗаписей()
    Записи.Фильтр.Установить(СервисныйПользователь = Пользователь, Участник = Участник)
    Записи.ДобавитьЗапись(СервисныйПользователь = Пользователь, Участник = Участник, Активно = Активно, ИдПривязки = ИдПривязки)
    Записи.Записать()
    возврат ИдПривязки
;

@ВПроекте @НаСервере
метод УчастникСервиса(ИдПривязки: Строка): УчастникиИгры.Ссылка
    знч Пользователь = Пользователи.ТекущийПользователь
    ПротоколERP.Требовать(Пользователь != Неопределено, "AUTH_REQUIRED", "Требуется служебный токен", КодОтвета = 401)
    исп КонтекстДоступа.Привилегированный()
    знч Привязка = Запрос{
        ВЫБРАТЬ Участник ИЗ ПривязкиСервисовERP
        ГДЕ СервисныйПользователь == %Пользователь И ИдПривязки == %ИдПривязки И Активно
    }.Выполнить().ПервыйИлиНеопределено()
    ПротоколERP.Требовать(Привязка != Неопределено и Привязка!.Участник != Неопределено,
        "BINDING_FORBIDDEN", "Привязка не назначена этому сервисному пользователю", КодОтвета = 403)
    возврат Привязка!.Участник!
;

@ВПроекте @НаСервере
метод ИдПривязки(Участник: УчастникиИгры.Ссылка): Строка
    знч Строки = Запрос{
        ВЫБРАТЬ ИдПривязки ИЗ ПривязкиСервисовERP ГДЕ Участник == %Участник И Активно
    }.Выполнить().Преобразовать(Строка -> Строка)
    ПротоколERP.Требовать(Строки.Размер() == 1 и Строки[0].ИдПривязки != "", "BINDING_NOT_ASSIGNED", "У команды должна быть одна активная сервисная привязка", КодОтвета = 409)
    возврат Строки[0].ИдПривязки
;

@ВПроекте @НаСервере
метод Возможности(): Массив<Объект?>
    возврат <Объект?>["consistentSnapshot", "phaseGuard", "idempotentCommands", "salesFacts", "finalFinancials", "automaticExecution", "executionReports"]
;

@ВПроекте @НаСервере
метод Контекст(ИдПривязки: Строка, Участник: УчастникиИгры.Ссылка, Игра: Игры.Объект): Соответствие<Строка, Объект?>
    ПротоколERP.Требовать(Игра.ТокенФазы != "" и Игра.ВерсияСостояния > 0, "BINDING_NOT_ASSIGNED", "Игра ещё не подготовлена", КодОтвета = 409)
    знч Номер = НомерРаунда(Игра)
    знч Календарь = НастройкиERP.КалендарьРаунда(Игра, Номер)
    знч Настройки = НастройкиERP.Настройки(Игра)
    знч Ответ: Соответствие<Строка, Объект?> = {"contractVersion": "1.0", "bindingId": ИдПривязки,
        "gameId": Игра.Ссылка.Ид.ВСтроку(), "participantId": Участник.Ид.ВСтроку(), "roundNumber": Номер,
        "phaseCode": НастройкиERP.КодФазы(Игра.Фаза), "phaseToken": Игра.ТокенФазы,
        "stateVersion": Игра.ВерсияСостояния, "gameState": НастройкиERP.КодСостояния(Игра.Статус),
        "gameMonth": Календарь.Получить("gameMonth"), "documentDate": Календарь.Получить("documentDate"),
        "deadline": Игра.Статус == СостоянияИгры.Идет ? Игра.Дедлайн?.ВСтроку() : Неопределено,
        "serverTime": Момент.Сейчас().ВСтроку(), "settings": Настройки,
        "settingsHash": ПротоколERP.Хеш(ПротоколERP.КаноническийJson(Настройки)), "capabilities": Возможности()}
    ПротоколERP.ПроверитьСхему(Ответ, КонтрактERP.Схема("Context"))
    возврат Ответ
;

@ВПроекте @НаСервере
метод НомерРаунда(Игра: Игры.Объект): Число
    возврат Игра.ТекущийРаунд == Неопределено ? 0 : Игра.ТекущийРаунд!.ЗагрузитьОбъект()!.НомерРаунда
;

@ВПроекте @НаСервере
метод Раунд(Игра: Игры.Объект, Номер: Число): РаундыИгры.Ссылка
    знч СсылкаИгры = Игра.Ссылка
    знч Найден = Запрос{
        ВЫБРАТЬ Ссылка ИЗ РаундыИгры ГДЕ Игра == %СсылкаИгры И НомерРаунда == %Номер
    }.Выполнить().ПервыйИлиНеопределено()
    ПротоколERP.Требовать(Найден != Неопределено, "PHASE_CONFLICT", "Раунд ещё не создан", КодОтвета = 409)
    возврат Найден!.Ссылка
;

@ВПроекте @НаСервере
метод СохранитьСообщение(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка?, ИдПривязки: Строка,
    Данные: Соответствие<Строка, Объект?>, Вид: Строка, Ключ: Строка, Версия: Число,
    Ресурс: Строка, Маршрут: Строка = "", Тело: Строка = "", ХешЗапроса: Строка = ""): СообщенияERP.Ссылка
    знч Документ = новый СообщенияERP.Объект()
    Документ.Дата = ДатаВремя.Сейчас()
    Документ.Игра = Игра.Ссылка
    Документ.Участник = Участник
    Документ.ИдПривязки = ИдПривязки
    Документ.ИдСообщения = Маршрут == "" ? "" : Данные.ПолучитьИлиУмолчание("messageId", "") как Строка
    Документ.Ресурс = Ресурс
    Документ.Маршрут = Маршрут
    Документ.Вид = Вид
    Документ.Ключ = Ключ
    Документ.Версия = Версия
    Документ.ХешЗапроса = ХешЗапроса
    Документ.ХешДанных = ПротоколERP.Хеш((Вид == "snapshots" ? ПротоколERP.СтрокаJson(Данные, "phaseToken") + "|" : "") + ПредметныеДанные(Данные))
    Документ.ВремяПриема = Момент.Сейчас()
    СообщенияERP.ЗаполнитьТело(Документ, Тело == "" ? ПротоколERP.КаноническийJson(Данные) : Тело)
    Документ.Записать()
    возврат Документ.Ссылка
;

@ВПроекте @НаСервере
метод ПредметныеДанные(Данные: Соответствие<Строка, Объект?>): Строка
    знч Предмет: Соответствие<Строка, Объект?> = {:}
    для Пара из Данные
        если не ["messageId", "capturedAt", "phaseToken"].Содержит(Пара.Ключ)
            Предмет.Вставить(Пара.Ключ, Пара.Значение)
        ;
    ;
    возврат ПротоколERP.КаноническийJson(Предмет)
;

@ВПроекте @НаСервере
метод ПоследнееСостояние(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Вид: Строка, Ключ: Строка): СообщенияERP.Ссылка?
    знч СсылкаИгры = Игра.Ссылка
    возврат Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ СообщенияERP ГДЕ Игра == %СсылкаИгры И Участник == %Участник И Вид == %Вид И Ключ == %Ключ
        УПОРЯДОЧИТЬ ПО Версия УБЫВ, ВремяПриема УБЫВ
    }.Выполнить().ПервыйИлиНеопределено()?.Ссылка
;

@ВПроекте @НаСервере
метод ПроверитьВерсию(Предыдущий: СообщенияERP.Ссылка?, Данные: Соответствие<Строка, Объект?>, Версия: Число): Булево
    если Предыдущий == Неопределено
        возврат Ложь
    ;
    знч Старый = Предыдущий!.ЗагрузитьОбъект()!
    ПротоколERP.Требовать(Версия >= Старый.Версия, "STALE_EVENT_VERSION", "Пришла старая версия состояния", КодОтвета = 409)
    если Версия == Старый.Версия
        ПротоколERP.Требовать(Старый.ХешДанных == ПротоколERP.Хеш(ПредметныеДанные(Данные)), "EVENT_VERSION_CONFLICT", "Версия уже содержит другие данные", КодОтвета = 409)
        возврат Истина
    ;
    возврат Ложь
;

@ВПроекте @НаСервере
метод ПроверитьОбласть(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Данные: Соответствие<Строка, Объект?>)
    ПротоколERP.Требовать(ПротоколERP.СтрокаJson(Данные, "gameId") == Игра.Ссылка.Ид.ВСтроку()
        и ПротоколERP.СтрокаJson(Данные, "participantId") == Участник.Ид.ВСтроку(), "BINDING_FORBIDDEN", "Сообщение относится к другой игровой области", КодОтвета = 403)
    знч Календарь = НастройкиERP.КалендарьРаунда(Игра, ПротоколERP.ЧислоJson(Данные, "roundNumber"))
    ПротоколERP.Требовать(ПротоколERP.СтрокаJson(Данные, "gameMonth") == ПротоколERP.СтрокаJson(Календарь, "gameMonth"), "PHASE_CONFLICT", "Месяц не соответствует раунду", КодОтвета = 409)
;

@ВПроекте @НаСервере
метод ПроверитьТекущуюФазу(Игра: Игры.Объект, Данные: Соответствие<Строка, Объект?>, ПроверятьСрок: Булево = Истина, РазрешитьПаузу: Булево = Ложь)
    ПротоколERP.Требовать(ПротоколERP.СтрокаJson(Данные, "phaseToken") == Игра.ТокенФазы
        и ПротоколERP.ЧислоJson(Данные, "roundNumber") == НомерРаунда(Игра), "PHASE_CONFLICT", "Раунд или токен уже сменился", КодОтвета = 409)
    ПротоколERP.Требовать(Игра.Статус == СостоянияИгры.Идет или Игра.Статус == СостоянияИгры.Подготовка
        или (РазрешитьПаузу и Игра.Статус == СостоянияИгры.Пауза),
        "PHASE_CONFLICT", "Приём учебных изменений закрыт", КодОтвета = 409)
    если ПроверятьСрок
        ПротоколERP.Требовать(Игра.Дедлайн == Неопределено или Момент.Сейчас() <= Игра.Дедлайн!, "PHASE_CONFLICT", "Срок фазы истёк", КодОтвета = 409)
    ;
;

@ВПроекте @НаСервере
метод НайтиКоманду(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Ид: Строка): КомандыОбмена.Объект
    знч СсылкаИгры = Игра.Ссылка
    знч Команда = Запрос{
        ВЫБРАТЬ Ссылка ИЗ КомандыОбмена ГДЕ Игра == %СсылкаИгры И Участник == %Участник И ИдОперации == %Ид
    }.Выполнить().ПервыйИлиНеопределено()
    ПротоколERP.Требовать(Команда != Неопределено, "RESOURCE_NOT_FOUND", "Команда не найдена в своей области", КодОтвета = 404)
    возврат Команда!.Ссылка.ЗагрузитьОбъект(Истина)!
;

@ВПроекте @НаСервере
метод ПроверитьКонтекстКоманды(Команда: КомандыОбмена.Объект, Данные: Соответствие<Строка, Объект?>)
    знч Конверт = ПротоколERP.Прочитать(СообщенияERP.Текст(Команда.Конверт!))
    для Поле из ["gameId", "participantId", "phaseToken", "roundNumber", "gameMonth"]
        ПротоколERP.Требовать(Конверт.Получить(Поле) == Данные.Получить(Поле), "PHASE_CONFLICT", "Событие не соответствует выданной команде", Поле, 409)
    ;
;

@ВПроекте @НаСервере
метод Очередь(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Лимит: Число): Соответствие<Строка, Объект?>
    знч СсылкаИгры = Игра.Ссылка
    знч Конверты = <Объект?>[]
    знч Завершенные = <Число>[]
    для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ КомандыОбмена ГДЕ Игра == %СсылкаИгры
        И Участник == %Участник УПОРЯДОЧИТЬ ПО Последовательность}.Выполнить()
        знч Команда = Строка.Ссылка.ЗагрузитьОбъект()!
        Конверты.Добавить(ПротоколERP.Прочитать(СообщенияERP.Текст(Команда.Конверт!)))
        если Команда.Статус == СтатусыКомандОбмена.Выполнена или Команда.Статус == СтатусыКомандОбмена.Ошибка
            Завершенные.Добавить(Команда.Последовательность)
        ;
    ;
    знч Ответ = ПротоколERP.СтраницаОчереди(Конверты, Завершенные, Лимит)
    Ответ.Вставить("contractVersion", "1.0")
    Ответ.Вставить("gameId", СсылкаИгры.Ид.ВСтроку())
    возврат Ответ
;

@ВПроекте @НаСервере
метод ВыдатьКоманду(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Вид: ВидыКомандERP,
    КодВида: Строка, ПолезнаяНагрузка: Соответствие<Строка, Объект?>, ХозяйственныйКлюч: Строка): КомандыОбмена.Ссылка
    ПроверкиДанных.Требовать(Транзакции.ЕстьАктивная(), "Выдача команды требует транзакции игры")
    знч Привязка = ИдПривязки(Участник)
    знч СсылкаИгры = Игра.Ссылка
    знч Ид = Ууид.Версия5("erp-command:%{СсылкаИгры.Ид}:%{Участник.Ид}:%{КодВида}:%{ХозяйственныйКлюч}").ВСтроку()
    знч Старая = Запрос{
        ВЫБРАТЬ Ссылка ИЗ КомандыОбмена ГДЕ ИдОперации == %Ид
    }.Выполнить().ПервыйИлиНеопределено()
    если Старая != Неопределено
        знч СтарыйКонверт = ПротоколERP.Прочитать(СообщенияERP.Текст(Старая!.Ссылка.ЗагрузитьОбъект()!.Конверт!))
        ПротоколERP.Требовать(ПротоколERP.КаноническийJson(СтарыйКонверт.Получить("payload")) == ПротоколERP.КаноническийJson(ПолезнаяНагрузка),
            "BUSINESS_OPERATION_CONFLICT", "Хозяйственный ключ уже содержит другие данные", КодОтвета = 409)
        возврат Старая!.Ссылка
    ;
    знч Последняя = Запрос{
        ВЫБРАТЬ МАКСИМУМ(Последовательность).ЗаменитьNull(0) КАК Номер ИЗ КомандыОбмена ГДЕ Игра == %СсылкаИгры И Участник == %Участник
    }.Выполнить().ПервыйИлиНеопределено()!
    знч Номер = НомерРаунда(Игра)
    знч Календарь = НастройкиERP.КалендарьРаунда(Игра, Номер)
    знч Конверт: Соответствие<Строка, Объект?> = {"commandId": Ид, "gameId": СсылкаИгры.Ид.ВСтроку(), "participantId": Участник.Ид.ВСтроку(),
        "sequence": Последняя.Номер + 1, "phaseToken": Игра.ТокенФазы, "roundNumber": Номер,
        "gameMonth": Календарь.Получить("gameMonth"), "issuedAt": Момент.Сейчас().ВСтроку(), "kind": КодВида, "payload": ПолезнаяНагрузка}
    ПротоколERP.ПроверитьСхему(Конверт, КонтрактERP.Схема("Command"))
    знч Команда = новый КомандыОбмена.Объект()
    Команда.Наименование = КодВида
    Команда.Игра = СсылкаИгры
    Команда.Участник = Участник
    Команда.Раунд = Игра.ТекущийРаунд
    Команда.ИдОперации = Ид
    Команда.Последовательность = Последняя.Номер + 1
    Команда.ТокенФазы = Игра.ТокенФазы
    Команда.Вид = Вид
    Команда.ВремяСоздания = Момент.Сейчас()
    Команда.Конверт = СохранитьСообщение(Игра, Участник, Привязка, Конверт, "command", Ид, 1, Ид)
    Команда.ХешТела = ПротоколERP.Хеш(ПротоколERP.КаноническийJson(Конверт))
    Команда.Записать()
    возврат Команда.Ссылка
;

@ВПроекте @НаСервере
метод ОбработатьPost(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Привязка: Строка,
    Маршрут: Строка, Данные: Соответствие<Строка, Объект?>, Тело: Строка, ХешЗапроса: Строка, ИдКоманды: Строка): Соответствие<Строка, Объект?>
    знч ИдСообщения = ПротоколERP.СтрокаJson(Данные, "messageId")
    // Read replay ledger before validating the current phase, deadline or version.
    знч Повтор = Запрос{
        ВЫБРАТЬ ХешЗапроса, Ресурс ИЗ СообщенияERP ГДЕ ИдПривязки == %Привязка И ИдСообщения == %ИдСообщения
    }.Выполнить().ПервыйИлиНеопределено()
    если Повтор != Неопределено
        ПротоколERP.Требовать(Повтор!.ХешЗапроса == ХешЗапроса, "IDEMPOTENCY_CONFLICT", "messageId уже использован с другим методом, маршрутом или телом", КодОтвета = 409)
        возврат Принято(ИдСообщения, Повтор!.Ресурс, Истина)
    ;
    если Маршрут == "snapshots" или Маршрут == "readiness"
        ПротоколERP.Требовать(Участник.ЗагрузитьОбъект()!.Активен, "PHASE_CONFLICT", "Команда исключена из учебных изменений", КодОтвета = 409)
    ;
    ПроверитьОбласть(Игра, Участник, Данные)
    пер Ресурс = новый Ууид().ВСтроку()
    пер Вид = Маршрут
    пер Ключ = ИдСообщения
    пер Версия = 1
    если Маршрут == "snapshots"
        Ресурс = ПринятьСнимок(Игра, Участник, Данные)
        Ключ = ПротоколERP.СтрокаJson(Данные, "sourceVersion")
    иначе если Маршрут == "readiness"
        ПринятьГотовность(Игра, Участник, Данные)
    иначе если Маршрут.НачинаетсяС("commands/")
        ПринятьПодтверждение(Игра, Участник, Данные, ИдКоманды)
        Вид = "receipt"
        Ключ = ИдКоманды
    иначе если Маршрут == "sales-events"
        Ресурс = ФактыERP.ПринятьПродажи(Игра, Участник, Данные, Ресурс)
        Ключ = ПротоколERP.СтрокаJson(Данные, "erpRealizationId")
        Версия = ПротоколERP.ЧислоJson(Данные, "stateVersion")
    иначе если Маршрут == "execution-events"
        Ресурс = ФактыERP.ПринятьИсполнение(Игра, Участник, Данные, Ресурс)
        Ключ = ПротоколERP.СтрокаJson(Данные, "operationId")
        Версия = ПротоколERP.ЧислоJson(Данные, "executionVersion")
    ;
    знч Сообщение = СохранитьСообщение(Игра, Участник, Привязка, Данные, Вид, Ключ, Версия, Ресурс, Маршрут, Тело, ХешЗапроса)
    если Вид == "receipt"
        знч Команда = НайтиКоманду(Игра, Участник, ИдКоманды)
        Команда.Подтверждение = Сообщение
        Команда.Записать()
    ;
    возврат Принято(ИдСообщения, Ресурс, Ложь)
;

@ВПроекте @НаСервере
метод Принято(ИдСообщения: Строка, Ресурс: Строка, Повтор: Булево): Соответствие<Строка, Объект?>
    возврат <Строка, Объект?>{"contractVersion": "1.0", "messageId": ИдСообщения, "resourceId": Ресурс, "replayed": Повтор}
;

@ВПроекте @НаСервере
метод ПринятьСнимок(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Данные: Соответствие<Строка, Объект?>, Сверка: Булево = Ложь): Строка
    // Сверка вызывается только авторизованной административной процедурой.
    // HTTP-обработчик всегда использует обычный режим с проверкой текущей фазы.
    если не Сверка
        ПроверитьТекущуюФазу(Игра, Данные, Ложь, Истина)
    ;
    знч Вид = ПротоколERP.СтрокаJson(Данные, "kind")
    ПроверкиДанных.Требовать(не Сверка или (Транзакции.ЕстьАктивная() и Вид == "final"), "Для сверки нужен финальный снимок в транзакции")
    знч Источник = ПротоколERP.СтрокаJson(Данные, "sourceVersion")
    знч Старый = ПоследнееСостояние(Игра, Участник, "snapshots", Источник)
    если Старый != Неопределено
        ПротоколERP.Требовать(Старый!.ЗагрузитьОбъект()!.ХешДанных == ПротоколERP.Хеш(ПротоколERP.СтрокаJson(Данные, "phaseToken") + "|" + ПредметныеДанные(Данные)),
            "BUSINESS_OPERATION_CONFLICT", "sourceVersion уже содержит другие данные", КодОтвета = 409)
        возврат Старый!.ЗагрузитьОбъект()!.Ресурс
    ;
    если Вид == "monitoring"
        ПроверитьТекущуюФазу(Игра, Данные)
        ПротоколERP.Требовать(Игра.СостояниеФазы == СостоянияФазы.Открыта, "PHASE_CONFLICT", "Мониторинг зафиксированной фазы закрыт", КодОтвета = 409)
    иначе
        знч Команда = НайтиКоманду(Игра, Участник, ПротоколERP.СтрокаJson(Данные, "freezeCommandId"))
        ПроверитьКонтекстКоманды(Команда, Данные)
        ПротоколERP.Требовать((Вид == "frozen" и Команда.Вид == ВидыКомандERP.ЗафиксироватьФазу)
            или (Вид == "final" и Команда.Вид == ВидыКомандERP.ЗапроситьИтог), "SNAPSHOT_NOT_FROZEN", "Нет соответствующей серверной команды фиксации", КодОтвета = 409)
        знч Нагрузка = ПротоколERP.ОбъектJson(ПротоколERP.Прочитать(СообщенияERP.Текст(Команда.Конверт!)).Получить("payload"))
        если не Сверка
            ПротоколERP.Требовать(ПротоколERP.СтрокаJson(Нагрузка, "sourceVersion") == Источник, "SNAPSHOT_NOT_FROZEN", "Версия фиксации отличается от задания", КодОтвета = 409)
        ;
    ;
    НастройкиERP.ПроверитьБалансы(ПротоколERP.МассивJson(Данные.Получить("balances")), Ложь)
    знч Предложения = ПротоколERP.МассивJson(Данные.Получить("offers"))
    ПротоколERP.УникальныеПоля(Предложения, ["productCode"], "offers")
    для Элемент из Предложения
        знч Предложение = ПротоколERP.ОбъектJson(Элемент)
        для Строка из ПротоколERP.МассивJson(Данные.Получить("balances"))
            знч Остаток = ПротоколERP.ОбъектJson(Строка)
            если Остаток.Получить("itemCode") == Предложение.Получить("productCode")
                ПротоколERP.Требовать(ПротоколERP.ЧислоJson(Предложение, "availableQuantity") <= новый Число(ПротоколERP.СтрокаJson(Остаток, "quantity")),
                    "VALIDATION_ERROR", "Предложение превышает остаток готовой продукции", "offers.availableQuantity")
            ;
        ;
    ;
    знч КомандаУчастника = Участник.ЗагрузитьОбъект()!
    знч Снимок = новый СнимкиERP.Объект()
    Снимок.Дата = ДатаВремя.Сейчас()
    Снимок.Игра = Игра.Ссылка
    Снимок.Участник = Участник
    Снимок.Раунд = Раунд(Игра, ПротоколERP.ЧислоJson(Данные, "roundNumber"))
    Снимок.ТокенФазы = ПротоколERP.СтрокаJson(Данные, "phaseToken")
    Снимок.ИдСообщения = ПротоколERP.СтрокаJson(Данные, "messageId")
    Снимок.ВерсияИсточника = Источник
    Снимок.ВидСнимка = Вид
    Снимок.ВремяДанных = новый Момент(ПротоколERP.СтрокаJson(Данные, "capturedAt"))
    Снимок.ВремяПриема = Момент.Сейчас()
    для Элемент из Предложения
        знч Предложение = ПротоколERP.ОбъектJson(Элемент)
        знч Код = ПротоколERP.СтрокаJson(Предложение, "productCode")
        знч Цена = новый Число(ПротоколERP.СтрокаJson(Предложение, "price"))
        если Вид == "frozen"
            НастройкиERP.ПроверитьЦенуПредложения(НастройкиERP.Настройки(Игра), НастройкиERP.Подготовка(Игра),
                ПротоколERP.ЧислоJson(Данные, "roundNumber"), Код, Цена)
            ФактыERP.ПроверитьЦенуПланирования(Игра, Участник, Данные, Код, Цена)
        ;
        Снимок.Предложения.Добавить(новый СнимкиERP.Предложения(Продукт = Продукт(Код), Цена = Цена,
            ДоступноКПродаже = ПротоколERP.ЧислоJson(Предложение, "availableQuantity"), Единица = "pcs"))
    ;
    для Элемент из ПротоколERP.МассивJson(Данные.Получить("balances"))
        знч Остаток = ПротоколERP.ОбъектJson(Элемент)
        знч Код = ПротоколERP.СтрокаJson(Остаток, "itemCode")
        знч Номенклатура = Продукт(Код)
        знч Подключение = КомандаУчастника.ПодключениеERP
        знч Соответствие = Запрос{
            ВЫБРАТЬ RefKey, КлючХарактеристики, КоэффициентПересчета ИЗ СоответствияERP
            ГДЕ Подключение == %Подключение И НоменклатураИгры == %Номенклатура
        }.Выполнить().ПервыйИлиНеопределено()
        ПротоколERP.Требовать(Соответствие != Неопределено и Соответствие!.КоэффициентПересчета > 0 и Соответствие!.RefKey != "",
            "MAPPING_INCOMPLETE", "Нет соответствия номенклатуры или единицы ERP", "balances.itemCode")
        знч Характеристика = Остаток.ПолучитьИлиУмолчание("characteristicId", "") как Строка
        ПротоколERP.Требовать(Характеристика == Соответствие!.КлючХарактеристики, "MAPPING_INCOMPLETE", "Характеристика не соответствует настройке ERP", "balances.characteristicId")
        Снимок.Остатки.Добавить(новый СнимкиERP.Остатки(Номенклатура = Номенклатура,
            ХарактеристикаERP = Характеристика, СкладERP = ПротоколERP.СтрокаJson(Остаток, "warehouseId"),
            Количество = новый Число(ПротоколERP.СтрокаJson(Остаток, "quantity")), Единица = ПротоколERP.СтрокаJson(Остаток, "unitCode")))
    ;
    если Вид == "final"
        знч Финансы = ПротоколERP.ОбъектJson(Данные.Получить("financials"))
        ПротоколERP.Требовать(ПротоколERP.БулевоJson(Финансы, "monthClosed"), "MONTH_NOT_CLOSED", "Месяц не закрыт", КодОтвета = 409)
        ПротоколERP.Требовать(ПротоколERP.СтрокаJson(Финансы, "customerDebt") == "0.00" и ПротоколERP.СтрокаJson(Финансы, "supplierDebt") == "0.00", "VALIDATION_ERROR", "Обязательные долги не погашены", "financials")
        ФактыERP.ПроверитьОплаты(Игра, Участник, Снимок.Раунд!)
        Снимок.ЕстьДеньги = Истина
        Снимок.Деньги = новый Число(ПротоколERP.СтрокаJson(Финансы, "cash"))
        Снимок.Прибыль = новый Число(ПротоколERP.СтрокаJson(Финансы, "profit"))
        Снимок.ЗакрытиеМесяцаПодтверждено = Истина
    ;
    Снимок.Записать()
    если Вид == "final"
        ФактыERP.СохранитьИтог(Игра, Участник, Снимок)
    ;
    возврат Снимок.Ссылка.Ид.ВСтроку()
;

@ВПроекте @НаСервере
метод Продукт(Код: Строка): НоменклатураИгры.Ссылка
    знч Найден = Запрос{ВЫБРАТЬ Ссылка ИЗ НоменклатураИгры ГДЕ Код == %Код И Активна}.Выполнить().ПервыйИлиНеопределено()
    ПротоколERP.Требовать(Найден != Неопределено, "MAPPING_INCOMPLETE", "Номенклатура отсутствует в игровом профиле", "itemCode")
    возврат Найден!.Ссылка
;

@ВПроекте @НаСервере
метод СнимокОбласти(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Ид: Строка): СнимкиERP.Объект
    знч СсылкаИгры = Игра.Ссылка
    знч СсылкаСнимка = новый СнимкиERP.Ссылка(новый Ууид(Ид))
    знч Найден = Запрос{
        ВЫБРАТЬ Ссылка ИЗ СнимкиERP ГДЕ Ссылка == %СсылкаСнимка И Игра == %СсылкаИгры И Участник == %Участник
    }.Выполнить().ПервыйИлиНеопределено()
    ПротоколERP.Требовать(Найден != Неопределено, "RESOURCE_NOT_FOUND", "Снимок не найден в своей области", КодОтвета = 404)
    возврат Найден!.Ссылка.ЗагрузитьОбъект()!
;

@ВПроекте @НаСервере
метод ПринятьГотовность(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Данные: Соответствие<Строка, Объект?>)
    ПроверитьТекущуюФазу(Игра, Данные)
    ПротоколERP.Требовать(Игра.СостояниеФазы == СостоянияФазы.Открыта, "PHASE_CONFLICT", "Приём готовности закрыт", КодОтвета = 409)
    знч Снимок = СнимокОбласти(Игра, Участник, ПротоколERP.СтрокаJson(Данные, "snapshotId"))
    ПротоколERP.Требовать(Снимок.ТокенФазы == Игра.ТокенФазы и Снимок.Раунд == Игра.ТекущийРаунд, "PHASE_CONFLICT", "Снимок относится к другой фазе", КодОтвета = 409)
    ПротоколERP.Требовать(Игра.Фаза != ФазыИгры.Анализ или Снимок.ВидСнимка == "final", "MONTH_NOT_CLOSED", "Анализ требует финального снимка", КодОтвета = 409)
    если ПротоколERP.БулевоJson(Данные, "ready")
        ФактыERP.ПроверитьГотовностьИсполнения(Игра, Участник)
    ;
    ЗаписатьГотовность(Игра, Участник, Снимок.Ссылка, ПротоколERP.БулевоJson(Данные, "ready"), Данные.ПолучитьИлиУмолчание("reason", "") как Строка)
;

@ВПроекте @НаСервере
метод ЗаписатьГотовность(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Снимок: СнимкиERP.Ссылка?, Готов: Булево, Ошибка: Строка)
    знч Записи = новый СостоянияУчастников.НаборЗаписей()
    Записи.Фильтр.Установить(Участник = Участник, Раунд = Игра.ТекущийРаунд, ТокенФазы = Игра.ТокенФазы)
    Записи.ДобавитьЗапись(Участник = Участник, Раунд = Игра.ТекущийРаунд, ТокенФазы = Игра.ТокенФазы, Готов = Готов,
        ПоследнийСнимок = Снимок, ВремяСвязи = Момент.Сейчас(), Версия = Игра.ВерсияСостояния, Ошибка = Ошибка.ПодстрокаСНачала(1000))
    Записи.Записать()
;

@ВПроекте @НаСервере
метод ПринятьПодтверждение(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Данные: Соответствие<Строка, Объект?>, Ид: Строка)
    знч Команда = НайтиКоманду(Игра, Участник, Ид)
    ПроверитьКонтекстКоманды(Команда, Данные)
    знч Статус = ПротоколERP.СтрокаJson(Данные, "status")
    если Команда.Статус == СтатусыКомандОбмена.Выполнена или Команда.Статус == СтатусыКомандОбмена.Ошибка
        знч СтарыеДанные = ПротоколERP.Прочитать(СообщенияERP.Текст(Команда.Подтверждение!))
        ПротоколERP.Требовать(ПредметныеДанные(СтарыеДанные) == ПредметныеДанные(Данные), "EVENT_VERSION_CONFLICT", "Окончательное подтверждение неизменяемо", КодОтвета = 409)
        возврат
    ;
    если Статус == "completed"
        знч Нагрузка = ПротоколERP.ОбъектJson(ПротоколERP.Прочитать(СообщенияERP.Текст(Команда.Конверт!)).Получить("payload"))
        если [ВидыКомандERP.ПодготовитьИгру, ВидыКомандERP.ЗафиксироватьФазу, ВидыКомандERP.ЗапроситьИтог].Содержит(Команда.Вид)
            ПротоколERP.Требовать(Данные.СодержитКлюч("snapshotId"), "VALIDATION_ERROR", "Нужен принятый снимок", "snapshotId")
            знч Снимок = СнимокОбласти(Игра, Участник, ПротоколERP.СтрокаJson(Данные, "snapshotId"))
            ПротоколERP.Требовать(Снимок.ТокенФазы == Команда.ТокенФазы и Снимок.Раунд == Команда.Раунд, "PHASE_CONFLICT", "Снимок не соответствует команде", КодОтвета = 409)
            если Команда.Вид == ВидыКомандERP.ПодготовитьИгру
                ПротоколERP.Требовать(Снимок.ВидСнимка == "monitoring" и Данные.СодержитКлюч("supportedCapabilities"), "VALIDATION_ERROR", "Нужен контрольный снимок и возможности ERP", "supportedCapabilities")
                знч ВозможностиERP = ПротоколERP.МассивJson(Данные.Получить("supportedCapabilities"))
                для Возможность из Возможности()
                    если НастройкиERP.Настройки(Игра).Получить("executionMode") == "basic" и ["automaticExecution", "executionReports"].Содержит(Возможность как Строка)
                        продолжить
                    ;
                    ПротоколERP.Требовать(ВозможностиERP.Содержит(Возможность), "UNSUPPORTED_CAPABILITY", "ERP не поддерживает обязательную возможность", "supportedCapabilities")
                ;
                ФактыERP.ПроверитьНачальныйСнимок(Игра, Снимок)
            иначе
                знч ОжидаемыйВид = Команда.Вид == ВидыКомандERP.ЗафиксироватьФазу ? "frozen" : "final"
                ПротоколERP.Требовать(Снимок.ВидСнимка == ОжидаемыйВид и Снимок.ВерсияИсточника == ПротоколERP.СтрокаJson(Нагрузка, "sourceVersion"),
                    "SNAPSHOT_NOT_FROZEN", "Снимок не соответствует виду и версии фиксации", КодОтвета = 409)
            ;
            если Игра.ТокенФазы == Команда.ТокенФазы
                ЗаписатьГотовность(Игра, Участник, Снимок.Ссылка, Истина, "")
            ;
        ;
        если [ВидыКомандERP.ОткрытьФазу, ВидыКомандERP.Приостановить, ВидыКомандERP.Возобновить].Содержит(Команда.Вид)
            ПротоколERP.Требовать(Данные.СодержитКлюч("appliedStateVersion") и Данные.ПолучитьИлиНеопределено("appliedStateVersion") == Нагрузка.Получить("stateVersion"),
                "VALIDATION_ERROR", "Неверная применённая версия состояния", "appliedStateVersion")
        ;
        если Команда.Вид == ВидыКомандERP.СоздатьЗаказКлиента или Команда.Вид == ВидыКомандERP.ОплатитьРеализацию
            ПротоколERP.Требовать(не ПротоколERP.МассивJson(Данные.Получить("erpDocumentIds")).Пусто(), "VALIDATION_ERROR", "Нужны идентификаторы документов ERP", "erpDocumentIds")
        ;
    ;
    Команда.Статус = Статус == "completed" ? СтатусыКомандОбмена.Выполнена : (Статус == "failed" ? СтатусыКомандОбмена.Ошибка : СтатусыКомандОбмена.Выполняется)
    Команда.КодОшибки = Данные.ПолучитьИлиУмолчание("errorCode", "") как Строка
    Команда.ОписаниеОшибки = (Данные.ПолучитьИлиУмолчание("errorMessage", "") как Строка).ПодстрокаСНачала(1000)
    Команда.ВремяПодтверждения = Момент.Сейчас()
    Команда.Записать()
    если Статус == "failed" и Игра.ТокенФазы == Команда.ТокенФазы
        ЗаписатьГотовность(Игра, Участник, Неопределено, Ложь, Команда.ОписаниеОшибки)
    ;
;

@ВПроекте @НаСервере
метод Участники(Игра: Игры.Объект): Массив<УчастникиИгры.Ссылка>
    знч Ссылка = Игра.Ссылка
    возврат Запрос{ВЫБРАТЬ Ссылка ИЗ УчастникиИгры ГДЕ Игра == %Ссылка И Активен
        УПОРЯДОЧИТЬ ПО ПорядокУчастника}.Выполнить().Преобразовать(Строка -> Строка.Ссылка)
;

@ВПроекте @НаСервере
метод ПодготовитьУчастников(Игра: Игры.Объект)
    знч Настройки = НастройкиERP.Настройки(Игра)
    НастройкиERP.ПроверитьНастройки(Настройки)
    ПроверкиДанных.Требовать(Игра.ЧислоРаундов == ПротоколERP.ЧислоJson(Настройки, "roundCount"), "Календарь ERP отличается от числа раундов сценария")
    ПроверкиДанных.Требовать((Игра.ФиксацияЦен == МоментыФиксацииЦен.ПослеПланирования ? "after_planning" : "before_sales") == Настройки.Получить("priceFixation"), "Способ фиксации цен отличается от профиля ERP")
    для Правило из Игра.ПараметрыРынка
        знч Код = Правило.Продукт!.ЗагрузитьОбъект()!.Код
        знч Продукт = НастройкиERP.ПравилоПродукта(Игра, Код)
        ПроверкиДанных.Требовать(Правило.МинимальнаяЦена == новый Число(ПротоколERP.СтрокаJson(Продукт, "minPrice"))
            и Правило.МаксимальнаяЦена == новый Число(ПротоколERP.СтрокаJson(Продукт, "maxPrice")), "Границы цен сценария отличаются от профиля ERP")
    ;
    Игра.СлучайныеНачальныеРесурсы = Ложь
    Игра.НачальныеРесурсы.Очистить()
    знч Добавленные = <Строка>[]
    для Элемент из ПротоколERP.МассивJson(НастройкиERP.Подготовка(Игра).Получить("balances"))
        знч Остаток = ПротоколERP.ОбъектJson(Элемент)
        знч Код = ПротоколERP.СтрокаJson(Остаток, "itemCode")
        если Добавленные.Содержит(Код)
            продолжить
        ;
        Добавленные.Добавить(Код)
        знч Количество = новый Число(ПротоколERP.СтрокаJson(Остаток, "quantity"))
        Игра.НачальныеРесурсы.Добавить(новый Игры.НачальныеРесурсы(Номенклатура = Продукт(Код), МинимальноеКоличество = Количество,
            МаксимальноеКоличество = Количество, УчетнаяЦена = новый Число(ПротоколERP.СтрокаJson(Остаток, "unitCost"))))
    ;
    для Фаза из [ФазыИгры.СтартоваяПродажа, ФазыИгры.Планирование, ФазыИгры.Закупки, ФазыИгры.Производство, ФазыИгры.Продажи, ФазыИгры.Анализ]
        пер Найдена = Ложь
        для Срок из Игра.СрокиФаз
            если Срок.Фаза == Фаза и Срок.ДлительностьМинут > 0
                Найдена = Истина
            ;
        ;
        ПроверкиДанных.Требовать(Найдена, "Для обычной игры нужен положительный срок каждой фазы")
    ;
    для Участник из Участники(Игра)
        ВыдатьКоманду(Игра, Участник, ВидыКомандERP.ПодготовитьИгру, "prepare_game", НастройкиERP.Подготовка(Игра), "prepare")
    ;
;

@ВПроекте @НаСервере
метод ПроверитьЗадания(Игра: Игры.Объект, Вид: ВидыКомандERP)
    знч Ссылка = Игра.Ссылка
    знч Токен = Игра.ТокенФазы
    для Участник из Участники(Игра)
        знч Команды = Запрос{ВЫБРАТЬ Статус, Последовательность ИЗ КомандыОбмена ГДЕ Игра == %Ссылка
            И Участник == %Участник И ТокенФазы == %Токен И Вид == %Вид}.Выполнить().Преобразовать(Строка -> Строка)
        ПроверкиДанных.Требовать(не Команды.Пусто(), "Ещё нет задания ERP для команды %{Участник}")
        знч Последняя = Команды.Сортировать((Левый, Правый) -> Правый.Последовательность.Сравнить(Левый.Последовательность))[0]
        ПроверкиДанных.Требовать(Последняя.Статус == СтатусыКомандОбмена.Выполнена, "Ожидается успешное подтверждение ERP команды %{Участник}")
    ;
;

@ВПроекте @НаСервере
метод ОткрытьУчастникам(Игра: Игры.Объект, ПредыдущийТокен: Строка?, Возобновление: Булево, Версия: Число = 0)
    знч Календарь = НастройкиERP.КалендарьРаунда(Игра, НомерРаунда(Игра))
    ПротоколERP.Требовать(Игра.Дедлайн != Неопределено, "PHASE_CONFLICT", "Для открытия ERP-фазы нужен срок", КодОтвета = 409)
    знч Нагрузка: Соответствие<Строка, Объект?> = {"phaseCode": НастройкиERP.КодФазы(Игра.Фаза), "previousPhaseToken": ПредыдущийТокен,
        "stateVersion": Версия == 0 ? Игра.ВерсияСостояния : Версия, "documentDate": Календарь.Получить("documentDate"),
        "deadline": Игра.Дедлайн!.ВСтроку(), "settingsHash": НастройкиERP.Подготовка(Игра).Получить("settingsHash")}
    для Участник из Участники(Игра)
        ВыдатьКоманду(Игра, Участник, Возобновление ? ВидыКомандERP.Возобновить : ВидыКомандERP.ОткрытьФазу,
            Возобновление ? "resume_game" : "open_phase", Нагрузка, Игра.ТокенФазы)
        если Игра.Фаза == ФазыИгры.Анализ
            знч Финал: Соответствие<Строка, Объект?> = {"requireClosedMonth": Истина, "sourceVersion": "final:%{Игра.ТокенФазы}"}
            ВыдатьКоманду(Игра, Участник, ВидыКомандERP.ЗапроситьИтог, "request_final_snapshot", Финал, Игра.ТокенФазы)
        ;
    ;
;

@ВПроекте @НаСервере
метод ПриостановитьУчастников(Игра: Игры.Объект, Причина: Строка)
    знч Нагрузка: Соответствие<Строка, Объект?> = {"reason": Причина, "stateVersion": Игра.ВерсияСостояния}
    для Участник из Участники(Игра)
        ВыдатьКоманду(Игра, Участник, ВидыКомандERP.Приостановить, "pause_game", Нагрузка, Игра.ВерсияСостояния.ВСтроку())
    ;
;

@ВПроекте @НаСервере
метод ЗафиксироватьУчастников(Игра: Игры.Объект)
    знч Календарь = НастройкиERP.КалендарьРаунда(Игра, НомерРаунда(Игра))
    знч Нагрузка: Соответствие<Строка, Объект?> = {"phaseCode": НастройкиERP.КодФазы(Игра.Фаза), "documentDate": Календарь.Получить("documentDate"),
        "deadline": Игра.Дедлайн!.ВСтроку(), "snapshotKind": "frozen", "sourceVersion": "freeze:%{Игра.ТокенФазы}"}
    для Участник из Участники(Игра)
        ЗаписатьГотовность(Игра, Участник, Неопределено, Ложь, "Ожидается зафиксированный снимок ERP")
        ВыдатьКоманду(Игра, Участник, ВидыКомандERP.ЗафиксироватьФазу, "freeze_phase", Нагрузка, Игра.ТокенФазы)
    ;
;

@ВПроекте @НаСервере
метод СоздатьЗаказы(Игра: Игры.Объект)
    знч Расчет = Игра.ТекущийРаунд!.ЗагрузитьОбъект()!.ОкончательныйРасчет!.ЗагрузитьОбъект()!
    знч Календарь = НастройкиERP.КалендарьРаунда(Игра, НомерРаунда(Игра))
    для Участник из Участники(Игра)
        знч Строки = <Объект?>[]
        для Строка из Расчет.Распределение
            если Строка.Участник == Участник и Строка.Заказано > 0
                Строки.Добавить(<Строка, Объект?>{"productCode": Строка.Продукт!.ЗагрузитьОбъект()!.Код,
                    "quantity": Строка.Заказано, "unitPrice": НастройкиERP.Деньги(Строка.Цена)})
            ;
        ;
        если не Строки.Пусто()
            знч ИдЗаказа = Ууид.Версия5("erp-order:%{Расчет.Ссылка.Ид}:%{Участник.Ид}").ВСтроку()
            знч Нагрузка: Соответствие<Строка, Объект?> = {"allocationId": Расчет.Ссылка.Ид.ВСтроку(), "externalOrderId": ИдЗаказа,
                "currency": "RUB", "documentDate": Календарь.Получить("documentDate"), "lines": Строки}
            ВыдатьКоманду(Игра, Участник, ВидыКомандERP.СоздатьЗаказКлиента, "create_customer_order", Нагрузка, ИдЗаказа)
        ;
    ;
;

@ВПроекте @НаСервере
метод ПроверитьПродажи(Игра: Игры.Объект)
    знч Ссылка = Игра.Ссылка
    знч Раунд = Игра.ТекущийРаунд!
    для Участник из Участники(Игра)
        знч Команды = Запрос{ВЫБРАТЬ Ссылка, Последовательность ИЗ КомандыОбмена ГДЕ Игра == %Ссылка
            И Участник == %Участник И Раунд == %Раунд И (Вид == ВидыКомандERP.СоздатьЗаказКлиента ИЛИ Вид == ВидыКомандERP.ОплатитьРеализацию)}.Выполнить().Преобразовать(Строка -> Строка)
        знч Проверенные = <Строка>[]
        для Строка из Команды.Сортировать((Левый, Правый) -> Правый.Последовательность.Сравнить(Левый.Последовательность))
            знч Команда = Строка.Ссылка.ЗагрузитьОбъект()!
            знч Конверт = ПротоколERP.Прочитать(СообщенияERP.Текст(Команда.Конверт!))
            знч Ключ = ХозяйственныйКлючКоманды(ПротоколERP.СтрокаJson(Конверт, "kind"), ПротоколERP.ОбъектJson(Конверт.Получить("payload")))
            если Проверенные.Содержит(Ключ)
                продолжить
            ;
            Проверенные.Добавить(Ключ)
            ПроверкиДанных.Требовать(Команда.Статус == СтатусыКомандОбмена.Выполнена, "Ожидаются заказы или оплаты ERP")
            если Команда.Вид == ВидыКомандERP.СоздатьЗаказКлиента
                ФактыERP.ПроверитьИсполнениеЗаказа(Игра, Участник, Команда.Ссылка)
            ;
        ;
        ФактыERP.ПроверитьОплаты(Игра, Участник, Раунд)
    ;
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод ПолучитьСоответствия(Участник: УчастникиИгры.Ссылка): Массив<СтрокаСоответствияERP>
    ДоступИгры.ТребоватьАдминистратора()
    исп КонтекстДоступа.Привилегированный()
    знч Команда = Участник.ЗагрузитьОбъект()!
    ПроверкиДанных.Требовать(Команда.Игра != Неопределено и Команда.ПодключениеERP != Неопределено, "Назначьте команде игру и подключение ERP")
    знч Подключение = Команда.ПодключениеERP
    знч Строки = <СтрокаСоответствияERP>[]
    для Элемент из ПротоколERP.МассивJson(ПротоколERP.Прочитать(НастройкиERP.ПримерСоответствий()).Получить("items"))
        знч Пример = ПротоколERP.ОбъектJson(Элемент)
        знч Код = ПротоколERP.СтрокаJson(Пример, "itemCode")
        знч Номенклатура = Запрос{ВЫБРАТЬ Ссылка, Наименование ИЗ НоменклатураИгры ГДЕ Код == %Код И Активна}.Выполнить().ПервыйИлиНеопределено()
        пер Строка = новый СтрокаСоответствияERP(Код = Код, Номенклатура = Номенклатура?.Наименование ?? Код,
            Единица = ПротоколERP.СтрокаJson(Пример, "unitCode"), Коэффициент = "1")
        если Номенклатура != Неопределено
            знч Продукт = Номенклатура!.Ссылка
            знч Сохраненное = Запрос{
                ВЫБРАТЬ RefKey, КлючХарактеристики, ЕдиницаERP, КоэффициентПересчета ИЗ СоответствияERP
                ГДЕ Подключение == %Подключение И НоменклатураИгры == %Продукт
            }.Выполнить().ПервыйИлиНеопределено()
            если Сохраненное != Неопределено
                Строка.ИдентификаторERP = Сохраненное!.RefKey
                Строка.Характеристика = Сохраненное!.КлючХарактеристики
                Строка.Единица = Сохраненное!.ЕдиницаERP
                Строка.Коэффициент = Сохраненное!.КоэффициентПересчета.ВСтроку()
            ;
        ;
        Строки.Добавить(Строка)
    ;
    возврат Строки
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод СохранитьТаблицуСоответствий(Участник: УчастникиИгры.Ссылка, Строки: Массив<СтрокаСоответствияERP>)
    ДоступИгры.ТребоватьАдминистратора()
    знч Элементы = <Объект?>[]
    для Строка из Строки
        Элементы.Добавить(<Строка, Объект?>{"itemCode": Строка.Код,
            "refKey": Строка.ИдентификаторERP.Сократить().ВНижнийРегистр(),
            "characteristicId": Строка.Характеристика.Сократить().ВНижнийРегистр(),
            "unitCode": Строка.Единица.Сократить(), "coefficient": Строка.Коэффициент.Сократить()})
    ;
    СохранитьСоответствия(Участник, ПротоколERP.КаноническийJson(<Строка, Объект?>{"items": Элементы}))
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод СохранитьСоответствия(Участник: УчастникиИгры.Ссылка, Текст: Строка)
    ДоступИгры.ТребоватьАдминистратора()
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Команда = Участник.ЗагрузитьОбъект()!
    ПроверкиДанных.Требовать(Команда.Игра != Неопределено и Команда.ПодключениеERP != Неопределено, "Назначьте игре подключение ERP")
    знч Игра = Команда.Игра!.ЗагрузитьОбъект(Истина)!
    ПроверкиДанных.Требовать(Игра.Статус == СостоянияИгры.Черновик, "Соответствия задаются до подготовки игры")
    знч Данные = ПротоколERP.Прочитать(Текст)
    ПротоколERP.Требовать(Данные.Размер() == 1 и Данные.СодержитКлюч("items"), "VALIDATION_ERROR", "Нужен объект с массивом items")
    знч Строки = ПротоколERP.МассивJson(Данные.Получить("items"))
    ПротоколERP.Требовать(Строки.Размер() == 15, "MAPPING_INCOMPLETE", "Требуются все 15 позиций профиля")
    ПротоколERP.УникальныеПоля(Строки, ["itemCode"], "items")
    знч Записи = новый СоответствияERP.НаборЗаписей()
    Записи.Фильтр.Установить(Подключение = Команда.ПодключениеERP)
    для Элемент из Строки
        знч Строка = ПротоколERP.ОбъектJson(Элемент)
        ПротоколERP.Требовать(Строка.Размер() == 5, "VALIDATION_ERROR", "Укажите itemCode, refKey, characteristicId, unitCode, coefficient", "items")
        знч Код = ПротоколERP.СтрокаJson(Строка, "itemCode")
        ПротоколERP.Требовать(["CityRide", "SportDrive", "CargoMax", "TourPro", "FRAME_STD", "FRAME_CARGO", "POWER_350", "POWER_500", "BAT_300", "BAT_500", "BAT_800", "WHEELS_STD", "WHEELS_HEAVY", "EQUIP_BASE", "EQUIP_PLUS"].Содержит(Код), "MAPPING_INCOMPLETE", "Неизвестный код", "items.itemCode")
        знч RefKey = ПротоколERP.СтрокаJson(Строка, "refKey")
        ПротоколERP.ПроверитьСхему(RefKey, КонтрактERP.Схема("UUID"), "items.refKey")
        знч Характеристика = ПротоколERP.СтрокаJson(Строка, "characteristicId")
        если Характеристика != ""
            ПротоколERP.ПроверитьСхему(Характеристика, КонтрактERP.Схема("UUID"), "items.characteristicId")
        ;
        знч Единица = ПротоколERP.СтрокаJson(Строка, "unitCode")
        ПротоколERP.Требовать(Единица != "" и Единица.Длина() <= 30, "VALIDATION_ERROR", "Укажите единицу ERP", "items.unitCode")
        ПротоколERP.ПроверитьСхему(Строка.Получить("coefficient"), КонтрактERP.Схема("PositiveQuantity"), "items.coefficient")
        Записи.ДобавитьЗапись(Подключение = Команда.ПодключениеERP, НоменклатураИгры = Продукт(Код), EntitySet = "Catalog_Номенклатура",
            RefKey = RefKey, КлючХарактеристики = Характеристика, ЕдиницаERP = Единица,
            КоэффициентПересчета = новый Число(ПротоколERP.СтрокаJson(Строка, "coefficient")))
    ;
    Записи.Записать()
;

@ВПроекте @НаСервере
метод ПовторитьОшибки(Игра: Игры.Объект)
    знч Ссылка = Игра.Ссылка
    знч Токен = Игра.ТокенФазы
    для Участник из Участники(Игра)
        знч Последние = <Строка>[]
        знч Все = Запрос{ВЫБРАТЬ Ссылка, Последовательность ИЗ КомандыОбмена ГДЕ Игра == %Ссылка
            И Участник == %Участник И ТокенФазы == %Токен}.Выполнить().Преобразовать(Строка -> Строка)
        для Строка из Все.Сортировать((Левый, Правый) -> Правый.Последовательность.Сравнить(Левый.Последовательность))
            знч Команда = Строка.Ссылка.ЗагрузитьОбъект()!
            знч Конверт = ПротоколERP.Прочитать(СообщенияERP.Текст(Команда.Конверт!))
            знч Вид = ПротоколERP.СтрокаJson(Конверт, "kind")
            знч Нагрузка = ПротоколERP.ОбъектJson(Конверт.Получить("payload"))
            знч Ключ = ХозяйственныйКлючКоманды(Вид, Нагрузка)
            если Последние.Содержит(Ключ)
                продолжить
            ;
            Последние.Добавить(Ключ)
            если Команда.Статус != СтатусыКомандОбмена.Ошибка
                продолжить
            ;
            если Вид == "freeze_phase" или Вид == "request_final_snapshot"
                Нагрузка.Вставить("sourceVersion", "%{Вид}:%{Игра.ТокенФазы}:%{Игра.ВерсияСостояния}")
            ;
            ВыдатьКоманду(Игра, Участник, Команда.Вид, Вид, Нагрузка, "retry:%{Команда.ИдОперации}:%{Игра.ВерсияСостояния}")
        ;
    ;
;

@ВПроекте @НаСервере
метод ХозяйственныйКлючКоманды(Вид: Строка, Нагрузка: Соответствие<Строка, Объект?>): Строка
    если Вид == "create_customer_order"
        возврат Вид + ":" + ПротоколERP.СтрокаJson(Нагрузка, "externalOrderId")
    иначе если Вид == "pay_realization"
        возврат Вид + ":" + ПротоколERP.СтрокаJson(Нагрузка, "paymentOperationId")
    ;
    возврат Вид
;

@ВПроекте @НаСервере
метод ПродолжитьКомандыПослеПаузы(Игра: Игры.Объект, ПредыдущийТокен: Строка)
    знч Ссылка = Игра.Ссылка
    для Участник из Участники(Игра)
        для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ КомандыОбмена ГДЕ Игра == %Ссылка
            И Участник == %Участник И ТокенФазы == %ПредыдущийТокен
            И Статус != СтатусыКомандОбмена.Выполнена И Статус != СтатусыКомандОбмена.Отменена
            И (Вид == ВидыКомандERP.СоздатьЗаказКлиента ИЛИ Вид == ВидыКомандERP.ОплатитьРеализацию)}.Выполнить()
            знч Команда = Строка.Ссылка.ЗагрузитьОбъект()!
            знч Конверт = ПротоколERP.Прочитать(СообщенияERP.Текст(Команда.Конверт!))
            ВыдатьКоманду(Игра, Участник, Команда.Вид, ПротоколERP.СтрокаJson(Конверт, "kind"),
                ПротоколERP.ОбъектJson(Конверт.Получить("payload")), "resume:%{Команда.ИдОперации}:%{Игра.ТокенФазы}")
        ;
    ;
;
