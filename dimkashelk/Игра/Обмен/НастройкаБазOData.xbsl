импорт Данные

// Клиент ведущего получает только адрес, логин и признак сохранённого пароля.
@ВПроекте @НаСервере @ДоступноСКлиента
метод ПодключениеКоманды(Игра: Игры.Ссылка, Участник: УчастникиИгры.Ссылка): Соответствие<Строка, Объект?>
    ДоступИгры.ПроверитьВедущего(Игра)
    исп КонтекстДоступа.Привилегированный()
    знч Команда = Участник.ЗагрузитьОбъект()!
    ПроверкиДанных.Требовать(Команда.Игра == Игра и Команда.Активен и не Команда.ПометкаУдаления,
        "Выберите активную команду выбранной игры")
    если Команда.ПодключениеERP == Неопределено
        возврат {"connection": Неопределено, "address": "", "login": "", "organization": "", "hasPassword": Ложь, "active": Истина}
    ;
    знч База = Команда.ПодключениеERP!.ЗагрузитьОбъект()!
    возврат {"connection": База.Ссылка, "address": АдресПубликации(База.АдресOData), "login": База.ЛогинOData, "organization": Команда.ОрганизацияERP,
        "hasPassword": База.ПарольOData != Неопределено, "active": База.Активно и не База.ПометкаУдаления}
;

// Чтение организаций не записывает подключение и не передаёт сохранённый секрет на клиент.
@ВПроекте @НаСервере @ДоступноСКлиента
метод ОрганизацииБазы(Игра: Игры.Ссылка?, Участник: УчастникиИгры.Ссылка?,
    Адрес: Строка, Логин: Строка, Пароль: Строка): Массив<Строка>
    если Игра == Неопределено
        ДоступИгры.ТребоватьАдминистратора()
    иначе
        ДоступИгры.ПроверитьВедущего(Игра!)
    ;
    знч Url = НормализоватьАдрес(Адрес)
    ПроверкиДанных.Требовать(Логин.Сократить() != "" и Логин.Длина() <= 200 и Пароль.Длина() <= 1000,
        "Введите логин и пароль ERP")
    пер СекретПароля: Секрет|Строка = Пароль
    исп КонтекстДоступа.Привилегированный()
    если Игра != Неопределено
        ПроверкиДанных.Требовать(Участник != Неопределено, "Выберите команду игры")
        знч Команда = Участник!.ЗагрузитьОбъект()!
        ПроверкиДанных.Требовать(Команда.Игра == Игра и Команда.Активен и не Команда.ПометкаУдаления,
            "Выберите активную команду выбранной игры")
        если Пароль == "" и Команда.ПодключениеERP != Неопределено
            знч База = Команда.ПодключениеERP!.ЗагрузитьОбъект()!
            ПроверкиДанных.Требовать(НормализоватьАдрес(База.АдресOData) == Url
                и База.ЛогинOData == Логин.Сократить() и База.ПарольOData != Неопределено,
                "Для нового адреса или логина введите пароль ERP")
            СекретПароля = База.ПарольOData!
        ;
    ;
    ПроверкиДанных.Требовать(Пароль != "" или СекретПароля это Секрет, "Введите пароль ERP")
    знч Соединение = КлиентHttp.СБазовымUrl(Url)
        .САутентификацией(новый АутентификацияHttp(Логин.Сократить(), СекретПароля))
        .СТаймаутомСоединения(10с).СТаймаутомЗапроса(45с).СМаксимумомПеренаправлений(0)
    знч Результат = <Строка>[]
    пер Пропуск = 0
    пока Истина
        знч Строки = ПротоколERP.МассивJson(ЗапросOData(Соединение, "GET", "Catalog_Организации",
            {"\$select": "Ref_Key,Description", "\$filter": "DeletionMark eq false", "\$orderby": "Description,Ref_Key",
                "\$top": 100, "\$skip": Пропуск}).Получить("value"))
        для Значение из Строки
            знч Имя = ПротоколERP.СтрокаJson(ПротоколERP.ОбъектJson(Значение), "Description").Сократить()
            если Имя != "" и не Результат.Содержит(Имя)
                Результат.Добавить(Имя)
            ;
        ;
        если Строки.Размер() < 100
            прервать
        ;
        Пропуск = Пропуск + Строки.Размер()
    ;
    возврат Результат
;

@ВПроекте @НаСервере
метод АдресПубликации(Адрес: Строка): Строка
    если Адрес == ""
        возврат ""
    ;
    знч Url = НормализоватьАдрес(Адрес)
    знч Окончание = "/odata/standard.odata/"
    возврат Url.ПодстрокаСНачала(Url.Длина() - Окончание.Длина()) + "/"
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод СохранитьПодключениеКоманды(Игра: Игры.Ссылка, Участник: УчастникиИгры.Ссылка,
    Адрес: Строка, Организация: Строка, Логин: Строка, Пароль: Строка, Активно: Булево)
    ДоступИгры.ПроверитьВедущего(Игра)
    знч Url = НормализоватьАдрес(Адрес)
    ПроверкиДанных.Требовать(Логин.Сократить() != "" и Логин.Сократить().Длина() <= 200
        и Организация.Сократить() != "" и Организация.Сократить().Длина() <= 200 и Пароль.Длина() <= 1000
        и Url.Длина() <= 1000, "Укажите адрес OData, организацию, логин и пароль допустимой длины")
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    // Та же блокировка игры, что при резервировании заказа: база не меняется между резервом и HTTP.
    знч ОбъектИгры = Игра.ЗагрузитьОбъект(Истина)!
    знч Команда = Участник.ЗагрузитьОбъект(Истина)!
    ПроверкиДанных.Требовать(Команда.Игра == Игра и Команда.Активен и не Команда.ПометкаУдаления,
        "Выберите активную команду выбранной игры")
    ДоступИгры.ПроверитьВедущего(Игра)
    знч ГраницаПопытки = Момент.Сейчас() - 15м
    для Отправка из Запрос{ВЫБРАТЬ НачалоПопытки ИЗ ЗаказыРынка
        ГДЕ Участник == %Участник И Статус == "Отправляется"}.Выполнить()
        ПроверкиДанных.Требовать(Отправка.НачалоПопытки != Неопределено
            и Отправка.НачалоПопытки! <= ГраницаПопытки, "Дождитесь завершения отправки заказа в ERP")
    ;
    пер База = Команда.ПодключениеERP == Неопределено ? новый ПодключенияERP.Объект()
        : Команда.ПодключениеERP!.ЗагрузитьОбъект(Истина)!
    знч АдресПрежний = База.АдресOData == "" ? "" : НормализоватьАдрес(База.АдресOData)
    знч МеняетсяБаза = АдресПрежний != Url или Команда.ОрганизацияERP != Организация.Сократить()
    ПроверкиДанных.Требовать(ОбъектИгры.Статус == СостоянияИгры.Черновик
        или (Команда.ПодключениеERP != Неопределено и не МеняетсяБаза),
        "Адрес базы и организацию нужно настроить до подготовки игры")
    если МеняетсяБаза
        знч Заказы = Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ ЗаказыРынка ГДЕ Участник == %Участник}.Выполнить().ПервыйИлиНеопределено()
        ПроверкиДанных.Требовать(Заказы == Неопределено, "После получения заказов адрес базы и организацию менять нельзя")
    ;
    ПроверкиДанных.Требовать(Пароль != "" или (АдресПрежний == Url и База.ЛогинOData == Логин.Сократить()
        и База.ПарольOData != Неопределено), "Для нового адреса или логина укажите пароль OData")
    для Строка из Запрос{ВЫБРАТЬ ПодключениеERP ИЗ УчастникиИгры
        ГДЕ Игра == %Игра И Ссылка != %Участник И Активен И НЕ ПометкаУдаления И ПодключениеERP != Неопределено}.Выполнить()
        знч ДругаяБаза = Строка.ПодключениеERP!.ЗагрузитьОбъект()!
        ПроверкиДанных.Требовать(ДругаяБаза.АдресOData == "" или НормализоватьАдрес(ДругаяБаза.АдресOData) != Url,
            "Эта ERP уже назначена другой команде игры. У каждой команды должна быть собственная база")
    ;
    если Команда.ПодключениеERP != Неопределено
        знч ПрежняяБаза = Команда.ПодключениеERP!
        знч ОбщаяБаза = Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ УчастникиИгры
            ГДЕ ПодключениеERP == %ПрежняяБаза И Ссылка != %Участник}.Выполнить().ПервыйИлиНеопределено()
        если ОбщаяБаза != Неопределено или База.ПометкаУдаления
            ПроверкиДанных.Требовать(ОбъектИгры.Статус == СостоянияИгры.Черновик,
                "Отдельные активные подключения команд нужно настроить до подготовки игры")
            // Не изменяем подключение чужой команды, даже если оно было общим в старых данных.
            знч Копия = новый ПодключенияERP.Объект()
            Копия.АдресHttpApi = База.АдресHttpApi
            Копия.РежимОбмена = База.РежимОбмена
            Копия.ВерсияERP = База.ВерсияERP
            Копия.ВерсияМетаданных = База.ВерсияМетаданных
            Копия.ПарольOData = База.ПарольOData
            База = Копия
        ;
    ;
    если База.ЭтоНовый()
        База.КодБазы = "TEAM_" + Участник.Ид.ВСтроку()
    ;
    знч Наименование = "%{ОбъектИгры.Наименование} · %{Команда.НаименованиеКоманды}"
    База.Наименование = Наименование.Длина() > 200 ? Наименование.ПодстрокаСНачала(200) : Наименование
    База.АдресOData = Url
    База.РежимОбмена = РежимыОбменаERP.Гибридный
    База.ЛогинOData = Логин.Сократить()
    если Пароль != ""
        База.ПарольOData = новый СекретПриложения(Пароль)
    ;
    База.Активно = Активно
    База.Записать()
    Команда.ПодключениеERP = База.Ссылка
    Команда.ОрганизацияERP = Организация.Сократить()
    Команда.Записать()
;

// Не доступно с клиента. Пароль остаётся в серверном контексте вызова игрока.
@ВПроекте @НаСервере
метод ПроверитьДоступЗаказов(Команда: УчастникиИгры.Объект)
    ПроверкиДанных.Требовать(Команда.ПодключениеERP != Неопределено,
        "Ведущий должен настроить подключение ERP вашей команды")
    знч База = Команда.ПодключениеERP!.ЗагрузитьОбъект()!
    ПроверкиДанных.Требовать(База.Активно и не База.ПометкаУдаления и База.АдресOData != ""
        и База.ЛогинOData != "" и База.ПарольOData != Неопределено,
        "Ведущий должен настроить активное подключение и доступ OData вашей команды")
;

// Команда не создаёт копию заказа и не устанавливает Posted через PATCH.
// Проверка прав выполняется на сервере Элемента, проведение — бизнес-логикой ERP.
@ВПроекте @НаСервере @ДоступноСКлиента
метод ПровестиЗаказ(Подключение: ПодключенияERP.Ссылка, Логин: Строка, Пароль: Строка,
    ИдЗаказа: Строка): Соответствие<Строка, Объект?>
    ДоступИгры.ТребоватьАдминистратора()
    исп КонтекстДоступа.Привилегированный()
    знч База = Подключение.ЗагрузитьОбъект()!
    ПроверкиДанных.Требовать(База.Активно, "Подключение неактивно")
    возврат ПротоколERP.Прочитать(ПровестиЗаказOData(База.АдресOData, Логин, Пароль, ИдЗаказа))
;

@ВПроекте @НаСервере
метод ПровестиЗаказOData(Адрес: Строка, Логин: Строка, Пароль: Строка, ИдЗаказа: Строка): Строка
    ПротоколERP.Требовать(не Логин.Пусто() и не Пароль.Пусто(), "ODATA_AUTH", "Укажите логин и пароль OData")
    знч Ид = ИдЗаказа.Сократить()
    ПротоколERP.Требовать(Ид.ПолноеСовпадение(новый Образец("[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"))
        и Ид != "00000000-0000-0000-0000-000000000000", "ODATA_ID", "Укажите непустой GUID заказа клиента в ERP")
    знч Соединение = КлиентHttp.СБазовымUrl(НормализоватьАдрес(Адрес))
        .САутентификацией(новый АутентификацияHttp(Логин, Пароль))
        .СТаймаутомСоединения(10с).СТаймаутомЗапроса(45с).СМаксимумомПеренаправлений(0)
    знч Результат = ПровестиДокумент(Соединение, "Document_ЗаказКлиента(guid'" + Ид + "')")
    возврат ПротоколERP.Json(Результат)
;

@НаСервере
метод ПровестиДокумент(Соединение: КлиентHttp, Путь: Строка): Соответствие<Строка, Объект?>
    знч До = ЗапросOData(Соединение, "GET", Путь)
    ПротоколERP.Требовать(До.ПолучитьИлиНеопределено("DeletionMark") != Истина,
        "ODATA_DELETED", "Документ ERP помечен на удаление")
    знч УжеПроведен = До.Получить("Posted") == Истина
    если не УжеПроведен
        // Стандартный OData action по документации 1cfresh, без режима загрузки.
        ЗапросOData(Соединение, "POST", Путь + "/Post()")
    ;
    знч После = ЗапросOData(Соединение, "GET", Путь)
    ПротоколERP.Требовать(После.Получить("Posted") == Истина,
        "ODATA_POST", "ERP не подтвердила проведение документа; проверьте его реквизиты")
    возврат {"refKey": После.Получить("Ref_Key"), "number": После.Получить("Number"),
        "date": После.Получить("Date"), "erpStatus": После.ПолучитьИлиУмолчание("Статус", ""), "posted": Истина, "alreadyPosted": УжеПроведен}
;

@НаСервере
метод КомандаДляБазы(Подключение: ПодключенияERP.Ссылка, Выбранная: УчастникиИгры.Ссылка?, ОрганизацияИмя: Строка): УчастникиИгры.Ссылка?
    пер Команда = Выбранная
    если Команда == Неопределено
        знч Кандидаты = Запрос{ВЫБРАТЬ Ссылка ИЗ УчастникиИгры
            ГДЕ ПодключениеERP == %Подключение И Активен И НЕ ПометкаУдаления И Игра != Неопределено
        }.Выполнить().Преобразовать(Строка -> Строка.Ссылка)
        ПроверкиДанных.Требовать(Кандидаты.Размер() <= 1, "База используется несколькими командами. Выберите команду перед проверкой")
        Команда = Кандидаты.Пусто() ? Неопределено : Кандидаты[0]
    ;
    если Команда != Неопределено
        знч ПервыеДанные = Команда!.ЗагрузитьОбъект()!
        ПроверкиДанных.Требовать(ПервыеДанные.Игра != Неопределено, "Выберите команду игры")
        // Порядок блокировок совпадает с сохранением подключения и подготовкой игры.
        знч Игра = ПервыеДанные.Игра!.ЗагрузитьОбъект(Истина)!
        знч Данные = Команда!.ЗагрузитьОбъект(Истина)!
        ПроверкиДанных.Требовать(Данные.ПодключениеERP == Подключение и Данные.Игра == Игра.Ссылка
            и Данные.ОрганизацияERP == ОрганизацияИмя.Сократить() и Данные.Активен и не Данные.ПометкаУдаления,
            "Выберите активную команду этой базы и её сохранённую организацию")
    ;
    возврат Команда
;

@НаСервере
метод ПарольПодключения(База: ПодключенияERP.Объект, Логин: Строка, Пароль: Строка): Секрет|Строка
    если Пароль != ""
        возврат Пароль
    ;
    ПроверкиДанных.Требовать(База.ЛогинOData == Логин и База.ПарольOData != Неопределено,
        "Укажите пароль ERP для выбранного логина")
    возврат База.ПарольOData!
;

@НаСервере
метод СохранитьРезультатКоманды(Команда: УчастникиИгры.Ссылка?, Результат: Соответствие<Строка, Объект?>,
    ДатаДанных: Строка, ПроверятьНачальные: Булево = Истина)
    Результат.Вставить("savedAutomatically", Ложь)
    если Команда == Неопределено
        возврат
    ;
    знч Участник = Команда!.ЗагрузитьОбъект()!
    знч Игра = Участник.Игра!.ЗагрузитьОбъект(Истина)!
    если Игра.Статус != СостоянияИгры.Черновик
        возврат
    ;
    если ПроверятьНачальные или Игра.ПрофильERP == Неопределено
        НастройкиERP.ПринятьНачальныеДанные(Игра.Ссылка, Результат, ДатаДанных)
    иначе
        попытка
            НастройкиERP.ПринятьНачальныеДанные(Игра.Ссылка, Результат, ДатаДанных)
        поймать Расхождение: ИсключениеНедопустимыйАргумент
            // Остатки готовой ERP могут меняться; это не меняет GUID её номенклатуры.
            Результат.Вставить("initialDataWarning", Расхождение.Описание)
        ;
    ;
    ОбменERP.СохранитьСоответствия(Команда!, ПротоколERP.СтрокаJson(Результат, "mappingsText"))
    Результат.Вставить("savedAutomatically", Истина)
;

// Чтение готовой ERP не создаёт документов. GUID берутся из её собственных записей.
@ВПроекте @НаСервере @ДоступноСКлиента
метод ПрочитатьБазу(Подключение: ПодключенияERP.Ссылка, Логин: Строка, Пароль: Строка,
    ОрганизацияИмя: Строка, ДатаДанных: Строка, КомандаERP: УчастникиИгры.Ссылка? = Неопределено): Соответствие<Строка, Объект?>
    ДоступИгры.ТребоватьАдминистратора()
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Команда = КомандаДляБазы(Подключение, КомандаERP, ОрганизацияИмя)
    знч База = Подключение.ЗагрузитьОбъект(Истина)!
    ПроверкиДанных.Требовать(База.Активно и не База.ПометкаУдаления, "Подключение неактивно")
    знч ЛогинЗапроса = Логин == "" ? База.ЛогинOData : Логин
    знч Результат = ПротоколERP.Прочитать(ПрочитатьРынок(База.АдресOData, ЛогинЗапроса,
        ПарольПодключения(База, ЛогинЗапроса, Пароль), ОрганизацияИмя, ДатаДанных))
    СохранитьРезультатКоманды(Команда, Результат, ДатаДанных, Ложь)
    возврат Результат
;

@ВПроекте @НаСервере
метод ПрочитатьРынок(Адрес: Строка, Логин: Строка, Пароль: Секрет|Строка,
    ОрганизацияИмя: Строка, ДатаДанных: Строка): Строка
    ПротоколERP.Требовать(не Логин.Пусто() и (Пароль это Секрет или (Пароль как Строка) != ""), "ODATA_AUTH", "Укажите логин и пароль OData")
    ПротоколERP.Требовать(ДатаДанных.ПолноеСовпадение(новый Образец("[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}")),
        "ODATA_DATE", "Укажите игровую дату и время данных YYYY-MM-DDTHH:MM:SS")
    знч ПроверкаДаты = новый ДатаВремя(ДатаДанных)
    знч Соединение = КлиентHttp.СБазовымUrl(НормализоватьАдрес(Адрес))
        .САутентификацией(новый АутентификацияHttp(Логин, Пароль))
        .СТаймаутомСоединения(10с).СТаймаутомЗапроса(45с).СМаксимумомПеренаправлений(0)
    знч Профиль = ПротоколERP.Прочитать(ПрофильНастройкиOData.Получить())
    знч Нужные = <Строка>["organization", "finished_goods", "purchases", "workshop", "sales_price", "cost_products", "cost_components", "rub", "pcs"]
    для Значение из ПротоколERP.МассивJson(Профиль.Получить("items"))
        знч Позиция = ПротоколERP.ОбъектJson(Значение)
        Нужные.Добавить(ПротоколERP.СтрокаJson(Позиция, "refKey").Подстрока(1))
        знч Характеристика = ПротоколERP.СтрокаJson(Позиция, "characteristicId")
        если не Характеристика.Пусто()
            Нужные.Добавить(Характеристика.Подстрока(1))
        ;
    ;
    знч Ссылки = <Строка, Строка>{"organizationName": ОрганизацияИмя}
    знч Записи = <Строка, Соответствие<Строка, Объект?>>{:}
    для Значение из ПротоколERP.МассивJson(Профиль.Получить("nodes"))
        знч Узел = ПротоколERP.ОбъектJson(Значение)
        знч Ключ = ПротоколERP.СтрокаJson(Узел, "key")
        если не Нужные.Содержит(Ключ)
            продолжить
        ;
        знч Запись = Найти(Соединение, ПротоколERP.СтрокаJson(Узел, "entity"),
            ПротоколERP.ОбъектJson(Разрешить(Узел.Получить("match"), Ссылки)))
        ПротоколERP.Требовать(Запись != Неопределено и Запись!.ПолучитьИлиНеопределено("DeletionMark") != Истина,
            "ODATA_MAPPING", "Не найдена активная настройка ERP: %{Ключ}")
        Ссылки.Вставить(Ключ, ПротоколERP.СтрокаJson(Запись!, "Ref_Key"))
        Записи.Вставить(Ключ, Запись!)
    ;
    знч ВидЦены = Ссылки.Получить("sales_price")
    знч ТипЦены = Записи.Получить("sales_price")
    ПротоколERP.Требовать(ТипЦены.Получить("Статус") == "Действует" и ТипЦены.Получить("DeletionMark") != Истина,
        "ODATA_PRICE", "Вид продажной цены не действует")
    ПротоколERP.Требовать(ТипЦены.Получить("ВалютаЦены_Key") == Ссылки.Получить("rub"),
        "ODATA_PRICE", "Продажный вид цены должен быть в рублях")
    знч Цены = ПрочитатьВсе(Соединение, "InformationRegister_ЦеныНоменклатуры25")
    знч Остатки = ПрочитатьВсе(Соединение, "AccumulationRegister_ТоварыНаСкладах/Balance(Period=datetime'" + ДатаДанных + "')")
    знч Обязательства = ПрочитатьВсе(Соединение, "AccumulationRegister_ТоварыКОтгрузке/Balance(Period=datetime'" + ДатаДанных + "')")
    знч Предложения = <Объект?>[]
    для Код из ["CityRide", "SportDrive", "CargoMax", "TourPro"]
        знч Товар = Записи.Получить(Код)
        знч Ид = Ссылки.Получить(Код)
        ПротоколERP.Требовать(Товар.Получить("ЕдиницаИзмерения_Key") == Ссылки.Получить("pcs"),
            "ODATA_UNIT", "Единица велосипедов отличается от шт.: %{Код}")
        знч Цена = ПоследняяЦена(Цены, Ид, ВидЦены, Ссылки.Получить("rub"), ДатаДанных)
        знч Остаток = ОстатокПродукта(Остатки, Ид, Ссылки.Получить("finished_goods"), Обязательства)
        Предложения.Добавить({"productCode": Код, "refKey": Ид, "description": Товар.Получить("Description"),
            "price": ПротоколERP.Деньги(ПротоколERP.ЧислоJson(Цена, "Цена")), "pricePeriod": Цена.Получить("Period"),
            "physicalQuantity": Остаток.Получить("physicalQuantity"), "shippingQuantity": Остаток.Получить("shippingQuantity"),
            "availableQuantity": Остаток.Получить("availableQuantity"), "unitCode": "pcs"})
    ;
    знч НачальныеЦены = <Объект?>[]
    для Элемент из Предложения
        знч Предложение = ПротоколERP.ОбъектJson(Элемент)
        НачальныеЦены.Добавить({"productCode": Предложение.Получить("productCode"), "price": Предложение.Получить("price")})
    ;
    знч НачальныеОстатки = <Объект?>[]
    знч СтавкиНДС = <Объект?>[]
    для Элемент из ПротоколERP.МассивJson(Профиль.Получить("items"))
        знч Позиция = ПротоколERP.ОбъектJson(Элемент)
        знч Код = ПротоколERP.СтрокаJson(Позиция, "itemCode")
        знч Ид = Ссылки.Получить(Код)
        знч Товар = Записи.Получить(Код)
        ПротоколERP.Требовать(Товар.Получить("ЕдиницаИзмерения_Key") == Ссылки.Получить("pcs"),
            "ODATA_UNIT", "Единица ERP отличается от шт.: %{Код}")
        знч ЭтоПродукт = ["CityRide", "SportDrive", "CargoMax", "TourPro"].Содержит(Код)
        знч УчетнаяЦена = ПоследняяЦена(Цены, Ид, Ссылки.Получить(ЭтоПродукт ? "cost_products" : "cost_components"), Ссылки.Получить("rub"), ДатаДанных)
        если ЭтоПродукт
            знч Ставка = ЗапросOData(Соединение, "GET", "Catalog_СтавкиНДС(guid'" + ПротоколERP.СтрокаJson(Товар, "СтавкаНДС_Key") + "')")
            ПротоколERP.Требовать(Ставка.Получить("DeletionMark") != Истина, "ODATA_PRICE", "Ставка НДС помечена на удаление")
            СтавкиНДС.Добавить({"productCode": Код, "vatRate": ПротоколERP.Деньги(ПротоколERP.ЧислоJson(Ставка, "Ставка"))})
        ;
        знч Склады = <Строка>[]
        если ЭтоПродукт
            Склады.Добавить("finished_goods")
        иначе
            Склады.Добавить("purchases")
            Склады.Добавить("workshop")
        ;
        для Склад из Склады
            знч Остаток = ОстатокПродукта(Остатки, Ид, Ссылки.Получить(Склад), Обязательства)
            ПротоколERP.Требовать(Остаток.Получить("shippingQuantity") == 0, "ODATA_QUANTITY", "Начальные остатки содержат резервы: %{Код}")
            НачальныеОстатки.Добавить({"itemCode": Код, "warehouseId": Склад, "unitCode": НастройкиERP.Единица(Код),
                "quantity": ПротоколERP.ЧислоJson(Остаток, "availableQuantity").ВСтроку(),
                "unitCost": ПротоколERP.Деньги(ПротоколERP.ЧислоJson(УчетнаяЦена, "Цена"))})
        ;
    ;
    знч Подготовка = <Строка, Объект?>{"initialCash": ПротоколERP.Деньги(НачальныеДеньги(Соединение, Ссылки.Получить("organization"), Ссылки.Получить("rub"), ДатаДанных)),
        "currency": "RUB", "balances": НачальныеОстатки, "initialPrices": НачальныеЦены, "seed": "fixed"}
    возврат ПротоколERP.Json({"asOf": ДатаДанных, "warehouseName": Записи.Получить("finished_goods").Получить("Description"),
        "priceTypeName": ТипЦены.Получить("Description"), "offers": Предложения,
        "priceIncludesVAT": ТипЦены.Получить("ЦенаВключаетНДС"), "vatRates": СтавкиНДС, "prepare": Подготовка,
        "mappingsText": ПротоколERP.Json({"items": Разрешить(Профиль.Получить("items"), Ссылки)})})
;

@НаСервере
метод НачальныеДеньги(Соединение: КлиентHttp, Организация: Строка, Валюта: Строка, ДатаДанных: Строка): Число
    пер Сумма = 0
    для Пара из <Строка, Строка>{"ДенежныеСредстваБезналичные": "БанковскиеСчетаОрганизаций|БанковскийСчет_Key", "ДенежныеСредстваНаличные": "Кассы|Касса_Key"}
        знч Каталог = Пара.Ключ == "ДенежныеСредстваБезналичные" ? "БанковскиеСчетаОрганизаций" : "Кассы"
        знч ПолеСчета = Пара.Ключ == "ДенежныеСредстваБезналичные" ? "БанковскийСчет_Key" : "Касса_Key"
        для Элемент из ПрочитатьВсе(Соединение, "AccumulationRegister_" + Пара.Ключ + "/Balance(Period=datetime'" + ДатаДанных + "')")
            знч Строка = ПротоколERP.ОбъектJson(Элемент)
            если Строка.Получить("Организация_Key") != Организация
                продолжить
            ;
            знч Счет = ЗапросOData(Соединение, "GET", "Catalog_" + Каталог + "(guid'" + ПротоколERP.СтрокаJson(Строка, ПолеСчета) + "')")
            ПротоколERP.Требовать(Счет.Получить("DeletionMark") != Истина и Счет.Получить("ВалютаДенежныхСредств_Key") == Валюта,
                "ODATA_CASH", "Начальные деньги должны быть на активном рублёвом счёте или кассе")
            Сумма = Сумма + ПротоколERP.ЧислоJson(Строка, "СуммаBalance")
        ;
    ;
    ПротоколERP.Требовать(Сумма >= 0, "ODATA_CASH", "Начальные деньги не могут быть отрицательными")
    возврат Сумма
;

@НаСервере
метод ПрочитатьВсе(Соединение: КлиентHttp, Путь: Строка): Массив<Объект?>
    знч Результат = <Объект?>[]
    пер Пропуск = 0
    пока Пропуск < 20000
        знч Строки = ПротоколERP.МассивJson(ЗапросOData(Соединение, "GET", Путь, {"\$top": 100, "\$skip": Пропуск}).Получить("value"))
        для Строка из Строки
            Результат.Добавить(Строка)
        ;
        если Строки.Размер() < 100
            возврат Результат
        ;
        Пропуск = Пропуск + 100
    ;
    выбросить новый ПротоколERP.Ошибка("Слишком много строк; чтение ERP не завершено", 422, "ODATA_LIMIT")
;

@ВПроекте @НаСервере
метод ПоследняяЦена(Наборы: Массив<Объект?>, Ид: Строка, ВидЦены: Строка, Валюта: Строка, ДатаДанных: Строка): Соответствие<Строка, Объект?>
    пер Последняя: Соответствие<Строка, Объект?>? = Неопределено
    пер Конфликт = Ложь
    для Набор из Наборы
        для Значение из ПротоколERP.МассивJson(ПротоколERP.ОбъектJson(Набор).Получить("RecordSet"))
            знч Строка = ПротоколERP.ОбъектJson(Значение)
            если Строка.Получить("Active") != Истина или Строка.Получить("Номенклатура_Key") != Ид
                или Строка.Получить("ВидЦены_Key") != ВидЦены или ПротоколERP.СтрокаJson(Строка, "Period").Сравнить(ДатаДанных) > 0
                продолжить
            ;
            пер Подходит = Истина
            для Поле из ["ХарактеристикаЦО_Key", "УпаковкаЦО_Key", "СерияЦО_Key", "МаркетинговоеМероприятие_Key"]
                если Строка.Получить(Поле) != "00000000-0000-0000-0000-000000000000"
                    Подходит = Ложь
                ;
            ;
            если не Подходит
                продолжить
            ;
            если Последняя == Неопределено или ПротоколERP.СтрокаJson(Строка, "Period").Сравнить(ПротоколERP.СтрокаJson(Последняя!, "Period")) > 0
                Последняя = Строка
                Конфликт = Ложь
            иначе если Строка.Получить("Period") == Последняя!.Получить("Period")
                если Строка.Получить("Цена") != Последняя!.Получить("Цена") или Строка.Получить("Валюта_Key") != Последняя!.Получить("Валюта_Key")
                    или Строка.Получить("Упаковка_Key") != Последняя!.Получить("Упаковка_Key")
                    Конфликт = Истина
                ;
            ;
        ;
    ;
    ПротоколERP.Требовать(Последняя != Неопределено, "ODATA_PRICE", "Нет действующей продажной цены ERP: %{Ид}")
    ПротоколERP.Требовать(не Конфликт, "ODATA_PRICE", "Неоднозначная последняя цена ERP")
    ПротоколERP.Требовать(Последняя!.Получить("Валюта_Key") == Валюта и Последняя!.Получить("Упаковка_Key") == "00000000-0000-0000-0000-000000000000"
        и ПротоколERP.ЧислоJson(Последняя!, "Цена") > 0, "ODATA_PRICE", "Цена ERP задана в другой валюте, упаковке или неположительна")
    возврат Последняя!
;

@ВПроекте @НаСервере
метод ОстатокПродукта(Строки: Массив<Объект?>, Ид: Строка, Склад: Строка,
    Обязательства: Массив<Объект?> = []): Соответствие<Строка, Объект?>
    пер ВНаличии = 0
    пер КОтгрузке = 0
    для Значение из Строки
        знч Строка = ПротоколERP.ОбъектJson(Значение)
        если Строка.Получить("Номенклатура_Key") == Ид и Строка.Получить("Склад_Key") == Склад
            и Строка.Получить("Характеристика_Key") == "00000000-0000-0000-0000-000000000000"
            и Строка.Получить("Назначение_Key") == "00000000-0000-0000-0000-000000000000"
            ВНаличии = ВНаличии + ПротоколERP.ЧислоJson(Строка, "ВНаличииBalance")
            КОтгрузке = КОтгрузке + ПротоколERP.ЧислоJson(Строка, "КОтгрузкеBalance")
        ;
    ;
    пер ПоЗаказам = 0
    для Значение из Обязательства
        знч Строка = ПротоколERP.ОбъектJson(Значение)
        если Строка.Получить("Номенклатура_Key") == Ид и Строка.Получить("Склад_Key") == Склад
            и Строка.Получить("Характеристика_Key") == "00000000-0000-0000-0000-000000000000"
            и Строка.Получить("Назначение_Key") == "00000000-0000-0000-0000-000000000000"
            ПоЗаказам = ПоЗаказам + ПротоколERP.ЧислоJson(Строка, "КОтгрузкеBalance") + ПротоколERP.ЧислоJson(Строка, "ВРезервеBalance")
        ;
    ;
    // Два регистра отражают перекрывающиеся стадии отгрузки; не вычитаем их дважды.
    если ПоЗаказам > КОтгрузке
        КОтгрузке = ПоЗаказам
    ;
    знч Доступно = ВНаличии > КОтгрузке ? ВНаличии - КОтгрузке : 0
    ПротоколERP.Требовать(Доступно == Доступно.Округлить(0), "ODATA_QUANTITY", "Остаток велосипедов не целый")
    возврат {"physicalQuantity": ВНаличии, "shippingQuantity": КОтгрузке, "availableQuantity": Доступно}
;

// Учётные данные используются только для текущего вызова и не записываются в БД.
@ВПроекте @НаСервере @ДоступноСКлиента
метод Выполнить(Подключение: ПодключенияERP.Ссылка, Логин: Строка, Пароль: Строка, Применить: Булево,
    ОрганизацияИмя: Строка, ДатаНастройки: Строка, КомандаERP: УчастникиИгры.Ссылка? = Неопределено): Соответствие<Строка, Объект?>
    ДоступИгры.ТребоватьАдминистратора()
    исп КонтекстДоступа.Привилегированный()
    // Блокировка подключения исключает два одновременных запуска из приложения.
    исп Транзакции.Начать()
    знч Команда = КомандаДляБазы(Подключение, КомандаERP, ОрганизацияИмя)
    если Команда != Неопределено и Применить
        знч Участник = Команда!.ЗагрузитьОбъект()!
        ПроверкиДанных.Требовать(Участник.Игра!.ЗагрузитьОбъект()!.Статус == СостоянияИгры.Черновик,
            "База команды подготавливается до подготовки игры")
    ;
    знч База = Подключение.ЗагрузитьОбъект(Истина)!
    ПроверкиДанных.Требовать(База.Активно и не База.ПометкаУдаления, "Подключение неактивно")
    знч ЛогинЗапроса = Логин == "" ? База.ЛогинOData : Логин
    знч ПарольЗапроса = ПарольПодключения(База, ЛогинЗапроса, Пароль)
    знч Результат = ПротоколERP.Прочитать(Подготовить(База.АдресOData, ЛогинЗапроса, ПарольЗапроса, Применить, ОрганизацияИмя, ДатаНастройки))
    если Результат.Получить("success") == Истина и Применить
        знч ДатаСнимка = ДатаНастройки.ПодстрокаСНачала(10) + "T23:59:59"
        знч Фактические = ПротоколERP.Прочитать(ПрочитатьРынок(База.АдресOData, ЛогинЗапроса, ПарольЗапроса, ОрганизацияИмя, ДатаСнимка))
        // Повторное чтение ERP исключает сохранение временных GUID из dry-run.
        СохранитьРезультатКоманды(Команда, Фактические, ДатаСнимка)
        Результат.Вставить("mappingsText", Фактические.Получить("mappingsText"))
        Результат.Вставить("savedAutomatically", Фактические.Получить("savedAutomatically"))
        Результат.Вставить("prepare", Фактические.Получить("prepare"))
    ;
    возврат Результат
;

@ВПроекте @НаСервере
метод Подготовить(Адрес: Строка, Логин: Строка, Пароль: Секрет|Строка, Применить: Булево,
    ОрганизацияИмя: Строка = "ДвижжОК ООО", ДатаНастройки: Строка = "2026-10-15T00:00:00"): Строка
    ПротоколERP.Требовать(не Логин.Пусто() и (Пароль это Секрет или (Пароль как Строка) != ""), "ODATA_AUTH", "Укажите логин и пароль OData")
    ПротоколERP.Требовать(не ОрганизацияИмя.Сократить().Пусто(), "ODATA_ORGANIZATION", "Укажите наименование организации ERP")
    ПротоколERP.Требовать(ДатаНастройки.ПолноеСовпадение(новый Образец("[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}")),
        "ODATA_DATE", "Дата настройки: ожидается YYYY-MM-DDTHH:MM:SS")
    знч ДатаДокументов = новый ДатаВремя(ДатаНастройки)
    знч Публикация = НормализоватьАдрес(Адрес)
    знч Соединение = КлиентHttp.СБазовымUrl(Публикация)
        .САутентификацией(новый АутентификацияHttp(Логин, Пароль))
        .СТаймаутомСоединения(10с).СТаймаутомЗапроса(45с).СМаксимумомПеренаправлений(0)
    знч Профиль = ПротоколERP.Прочитать(ПрофильНастройкиOData.Получить())
    знч Ссылки = <Строка, Строка>{:}
    Ссылки.Вставить("organizationName", ОрганизацияИмя)
    Ссылки.Вставить("setupDate", ДатаНастройки)
    Ссылки.Вставить("specStartDate", ДатаНастройки.ПодстрокаСНачала(4) + "-01-01T00:00:00")
    знч Шаги = <Объект?>[]
    знч Завершенные = <Объект?>[]
    знч Найденные = <Строка, Соответствие<Строка, Объект?>?>{:}
    пер ТекущийШаг = "Проверка"
    попытка
        // Полный предварительный проход: публикация, реквизиты и конфликты до первой записи.
        для Значение из ПротоколERP.МассивJson(Профиль.Получить("nodes"))
            знч Узел = ПротоколERP.ОбъектJson(Значение)
            знч Ключ = ПротоколERP.СтрокаJson(Узел, "key")
            ТекущийШаг = Ключ
            знч Сущность = ПротоколERP.СтрокаJson(Узел, "entity")
            знч Поля = ПротоколERP.ОбъектJson(Разрешить(Узел.Получить("fields"), Ссылки))
            знч Имена = <Строка>[]
            для Пара из Поля
                Имена.Добавить(Пара.Ключ)
            ;
            ЗапросOData(Соединение, "GET", Сущность, {"\$top": 1, "\$select": СоединитьСтроки(Имена, ",")})
            пер Ид = новый Ууид().ВСтроку()
            пер Действие = "create"
            если ПротоколERP.СтрокаJson(Узел, "mode") == "finish"
                знч Цель = ПротоколERP.СтрокаJson(Узел, "target")
                Ид = Ссылки.Получить(Цель)
                знч Старый = Найденные.Получить(Цель)
                если Старый != Неопределено и не Совпадает(Старый, Поля)
                    знч Маркер = Узел.СодержитКлюч("ownershipField") ? ПротоколERP.СтрокаJson(Узел, "ownershipField") : "Описание"
                    ПротоколERP.Требовать(Старый!.ПолучитьИлиНеопределено(Маркер) == "BICYCLE_SIMPLE/1.0 OData setup",
                        "ODATA_CONFLICT", "Чужая запись не меняется автоматически: %{Ключ}")
                ;
                Действие = "finish"
            иначе
                знч Найден = Найти(Соединение, Сущность, ПротоколERP.ОбъектJson(Разрешить(Узел.Получить("match"), Ссылки)))
                Найденные.Вставить(Ключ, Найден)
                если Найден != Неопределено
                    Ид = ПротоколERP.СтрокаJson(Найден!, "Ref_Key")
                    ПротоколERP.Требовать(Найден!.ПолучитьИлиНеопределено("DeletionMark") != Истина,
                        "ODATA_CONFLICT", "Запись помечена на удаление: %{Ключ}")
                    знч Проверяемые = ПротоколERP.ОбъектJson(Поля)
                    если Ключ.НачинаетсяС("spec_")
                        Проверяемые.Удалить("Статус")
                    ;
                    знч Черновик = Узел.Получить("mode") == "document" и Найден!.ПолучитьИлиНеопределено("Posted") != Истина
                    ПротоколERP.Требовать(Черновик или Совпадает(Найден, Проверяемые), "ODATA_CONFLICT", "Существующая запись отличается от профиля: %{Ключ}")
                    Действие = "reuse"
                иначе
                    ПротоколERP.Требовать(ПротоколERP.СтрокаJson(Узел, "mode") != "existing",
                        "ODATA_CLASSIFIER", "Не найден обязательный классификатор: %{Ключ}")
                ;
                ЭкспортироватьСсылки(Узел, Найден, Ссылки)
            ;
            Ссылки.Вставить(Ключ, Ид)
            Шаги.Добавить({"key": Ключ, "label": Разрешить(Узел.Получить("label"), Ссылки), "entity": Сущность, "refKey": Ид, "action": Действие, "fields": Поля})
        ;
        ПроверитьЧистуюБазу(Соединение, Ссылки, Найденные, ДатаНастройки)
        ПроверитьЧистыеРасчеты(Соединение, Ссылки, Найденные, ДатаНастройки)
        если Применить
            пер Индекс = 0
            для Значение из ПротоколERP.МассивJson(Профиль.Получить("nodes"))
                знч Узел = ПротоколERP.ОбъектJson(Значение)
                знч Шаг = ПротоколERP.ОбъектJson(Шаги[Индекс])
                Индекс = Индекс + 1
                ТекущийШаг = ПротоколERP.СтрокаJson(Узел, "key")
                знч Сущность = ПротоколERP.СтрокаJson(Узел, "entity")
                знч Поля = ПротоколERP.ОбъектJson(Разрешить(Узел.Получить("fields"), Ссылки))
                пер Ид = Ссылки.Получить(ТекущийШаг)
                если Узел.Получить("mode") == "finish"
                    Ид = Ссылки.Получить(ПротоколERP.СтрокаJson(Узел, "target"))
                    знч Путь = Сущность + "(guid'" + Ид + "')"
                    знч Существующий = ЗапросOData(Соединение, "GET", Путь)
                    если не Совпадает(Существующий, Поля)
                        знч Маркер = Узел.СодержитКлюч("ownershipField") ? ПротоколERP.СтрокаJson(Узел, "ownershipField") : "Описание"
                        ПротоколERP.Требовать(Существующий.ПолучитьИлиНеопределено(Маркер) == "BICYCLE_SIMPLE/1.0 OData setup",
                            "ODATA_CONFLICT", "Чужая запись не меняется автоматически")
                        ЗапросOData(Соединение, "PATCH", Путь, {:}, Поля)
                        ПротоколERP.Требовать(Совпадает(ЗапросOData(Соединение, "GET", Путь), Поля),
                            "ODATA_VERIFY", "Не прошла сверка спецификации: %{ТекущийШаг}")
                    ;
                иначе
                    // ERP может назначить собственный UUID, поэтому зависимости разрешаются заново после POST.
                    пер Существующий = Найти(Соединение, Сущность, ПротоколERP.ОбъектJson(Разрешить(Узел.Получить("match"), Ссылки)))
                    если Существующий == Неопределено
                        знч Запись = ПротоколERP.ОбъектJson(Поля)
                        Запись.Вставить("Ref_Key", Ссылки.Получить(ТекущийШаг))
                        Существующий = ЗапросOData(Соединение, "POST", Сущность, {:}, Запись)
                    ;
                    Ид = ПротоколERP.СтрокаJson(Существующий!, "Ref_Key")
                    если Узел.Получить("mode") == "document"
                        знч Путь = Сущность + "(guid'" + Ид + "')"
                        знч Документ = ЗапросOData(Соединение, "GET", Путь)
                        если Документ.Получить("Posted") != Истина
                            если не Совпадает(Документ, Поля)
                                ЗапросOData(Соединение, "PATCH", Путь, {:}, Поля)
                            ;
                            ПротоколERP.Требовать(Совпадает(ЗапросOData(Соединение, "GET", Путь), Поля),
                                "ODATA_VERIFY", "Документ не прошёл сверку до проведения")
                            ПровестиДокумент(Соединение, Путь)
                        ;
                        ПротоколERP.Требовать(ЗапросOData(Соединение, "GET", Путь).Получить("Posted") == Истина,
                            "ODATA_VERIFY", "Документ не проведён")
                    ;
                    знч Проверяемые = ПротоколERP.ОбъектJson(Поля)
                    если ТекущийШаг.НачинаетсяС("spec_")
                        Проверяемые.Удалить("Статус")
                    ;
                    ПротоколERP.Требовать(Совпадает(ЗапросOData(Соединение, "GET", Сущность + "(guid'" + Ид + "')"), Проверяемые),
                        "ODATA_VERIFY", "Не прошла сверка записи: %{ТекущийШаг}")
                ;
                Ссылки.Вставить(ТекущийШаг, Ид)
                если Узел.СодержитКлюч("exports")
                    ЭкспортироватьСсылки(Узел, ЗапросOData(Соединение, "GET", Сущность + "(guid'" + Ид + "')"), Ссылки)
                ;
                Завершенные.Добавить({"key": ТекущийШаг, "label": Шаг.Получить("label"), "action": Шаг.Получить("action"), "refKey": Ид})
            ;
        ;
        знч Сверка = Применить ? ПроверитьНачальныйДолг(Соединение, Ссылки, Профиль, ДатаНастройки) : <Строка, Объект?>{:}
        возврат ПротоколERP.Json({"success": Истина, "dryRun": не Применить, "entries": Применить ? Завершенные : Шаги, "verification": Сверка,
            "fullSetupReady": Ложь, "manualSteps": Профиль.Получить("manualSteps"),
            "mappings": {"items": Разрешить(Профиль.Получить("items"), Ссылки)}})
    поймать Ошибка: Исключение
        возврат ПротоколERP.Json({"success": Ложь, "dryRun": не Применить, "step": ТекущийШаг,
            "message": Ошибка.Описание, "completed": Завершенные})
    ;
;

@НаСервере
метод ПроверитьЧистыеРасчеты(Соединение: КлиентHttp, Ссылки: Соответствие<Строка, Строка>,
    Найденные: Соответствие<Строка, Соответствие<Строка, Объект?>?>, ДатаНастройки: Строка)
    знч Документ = Найденные.Получить("initial_supplier_debt")
    если Документ != Неопределено и Документ!.Получить("Posted") == Истина
        возврат
    ;
    знч Объекты = <Строка>[]
    для Элемент из ПрочитатьВсе(Соединение, "Catalog_ОбъектыРасчетов")
        знч Строка = ПротоколERP.ОбъектJson(Элемент)
        если Строка.Получить("Организация_Key") == Ссылки.Получить("organization")
            Объекты.Добавить(ПротоколERP.СтрокаJson(Строка, "Ref_Key"))
        ;
    ;
    знч Момент = ДатаНастройки.ПодстрокаСНачала(10) + "T23:59:59"
    для Регистр из ["РасчетыСПоставщиками", "РасчетыСКлиентами"]
        для Элемент из ПрочитатьВсе(Соединение, "AccumulationRegister_" + Регистр + "/Balance(Period=datetime'" + Момент + "')")
            знч Строка = ПротоколERP.ОбъектJson(Элемент)
            ПротоколERP.Требовать(не Объекты.Содержит(ПротоколERP.СтрокаJson(Строка, "ОбъектРасчетов_Key"))
                или ПротоколERP.ЧислоJson(Строка, "СуммаBalance") == 0,
                "ODATA_CONFLICT", "В организации уже есть взаиморасчёты. Используйте чтение готовой базы")
        ;
    ;
;

@НаСервере
метод ПроверитьНачальныйДолг(Соединение: КлиентHttp, Ссылки: Соответствие<Строка, Строка>,
    Профиль: Соответствие<Строка, Объект?>, ДатаНастройки: Строка): Соответствие<Строка, Объект?>
    знч Источник = ЗапросOData(Соединение, "GET", "Document_ПервичныйДокумент(guid'" + Ссылки.Получить("initial_debt_source") + "')")
    знч Объект = ПротоколERP.СтрокаJson(Источник, "ОбъектРасчетов_Key")
    ПротоколERP.Требовать(Объект != "" и Объект != "00000000-0000-0000-0000-000000000000",
        "ODATA_VERIFY", "ERP не сформировала объект расчётов начального долга")
    знч Момент = ДатаНастройки.ПодстрокаСНачала(10) + "T23:59:59"
    пер Долг = 0
    для Элемент из ПрочитатьВсе(Соединение, "AccumulationRegister_РасчетыСПоставщиками/Balance(Period=datetime'" + Момент + "')")
        знч Строка = ПротоколERP.ОбъектJson(Элемент)
        если Строка.Получить("ОбъектРасчетов_Key") == Объект и Строка.Получить("Валюта_Key") == Ссылки.Получить("rub")
            Долг = Долг - ПротоколERP.ЧислоJson(Строка, "СуммаBalance")
        ;
    ;
    знч Начальные = ПротоколERP.ОбъектJson(Профиль.Получить("verification"))
    ПротоколERP.Требовать(Долг == новый Число(ПротоколERP.СтрокаJson(Начальные, "supplierDebt")),
        "ODATA_VERIFY", "Начальный долг поставщику не прошёл сверку с регистром ERP")
    возврат {"supplierDebt": ПротоколERP.Деньги(Долг)}
;

@НаСервере
метод ЭкспортироватьСсылки(Узел: Соответствие<Строка, Объект?>, Запись: Соответствие<Строка, Объект?>?,
    Ссылки: Соответствие<Строка, Строка>)
    если не Узел.СодержитКлюч("exports")
        возврат
    ;
    для Пара из ПротоколERP.ОбъектJson(Узел.Получить("exports"))
        знч Поле = Пара.Значение как Строка
        ПротоколERP.Требовать(Запись != Неопределено, "ODATA_CLASSIFIER", "Не найдена запись для обязательного реквизита: %{Поле}")
        знч Ид = ПротоколERP.СтрокаJson(Запись!, Поле)
        ПротоколERP.Требовать(Ид != "" и Ид != "00000000-0000-0000-0000-000000000000",
            "ODATA_CLASSIFIER", "Не заполнен обязательный реквизит: %{Поле}")
        Ссылки.Вставить(Пара.Ключ, Ид)
    ;
;

@НаСервере
метод ПроверитьЧистуюБазу(Соединение: КлиентHttp, Ссылки: Соответствие<Строка, Строка>,
    Найденные: Соответствие<Строка, Соответствие<Строка, Объект?>?>, ДатаНастройки: Строка)
    знч МоментОстатков = ДатаНастройки.ПодстрокаСНачала(10) + "T23:59:59"
    для Пара из <Строка, Строка>{"initial_stock": "finished_goods", "initial_components": "purchases"}
        знч Документ = Найденные.Получить(Пара.Ключ)
        если Документ != Неопределено и Документ!.Получить("Posted") == Истина
            продолжить
        ;
        для Элемент из ПрочитатьВсе(Соединение, "AccumulationRegister_ТоварыНаСкладах/Balance(Period=datetime'" + МоментОстатков + "')")
            знч Строка = ПротоколERP.ОбъектJson(Элемент)
            ПротоколERP.Требовать(Строка.Получить("Склад_Key") != Ссылки.Получить(Пара.Значение)
                или (Строка.Получить("ВНаличииBalance") == 0 и Строка.Получить("КОтгрузкеBalance") == 0),
                "ODATA_CONFLICT", "В базе уже есть начальные товары. Используйте чтение готовой базы")
        ;
    ;
    знч ДокументДенег = Найденные.Получить("initial_cash")
    если ДокументДенег != Неопределено и ДокументДенег!.Получить("Posted") == Истина
        возврат
    ;
    для Регистр из ["ДенежныеСредстваБезналичные", "ДенежныеСредстваНаличные"]
        для Элемент из ПрочитатьВсе(Соединение, "AccumulationRegister_" + Регистр + "/Balance(Period=datetime'" + МоментОстатков + "')")
            знч Строка = ПротоколERP.ОбъектJson(Элемент)
            ПротоколERP.Требовать(Строка.Получить("Организация_Key") != Ссылки.Получить("organization") или Строка.Получить("СуммаBalance") == 0,
                "ODATA_CONFLICT", "В организации уже есть деньги. Используйте чтение готовой базы")
        ;
    ;
;

@ВПроекте @НаСервере
метод НормализоватьАдрес(Адрес: Строка): Строка
    пер Результат = Адрес.Сократить()
    ПротоколERP.Требовать(Результат.ПолноеСовпадение(новый Образец("https://[A-Za-z0-9.-]+(:[0-9]+)?/[A-Za-z0-9_./-]*")),
        "ODATA_URL", "Укажите HTTPS-адрес публикации без логина, параметров и фрагмента")
    пока Результат.ЗаканчиваетсяНа("/")
        Результат = Результат.ПодстрокаСНачала(Результат.Длина() - 1)
    ;
    если Результат.ЗаканчиваетсяНа("/ru_RU")
        Результат = Результат.ПодстрокаСНачала(Результат.Длина() - 6)
    ;
    если не Результат.ЗаканчиваетсяНа("/odata/standard.odata")
        Результат = Результат + "/odata/standard.odata"
    ;
    возврат Результат + "/"
;

@НаСервере
метод ЗапросOData(Соединение: КлиентHttp, Метод: Строка, Путь: Строка,
    Параметры: Соответствие<Строка, Объект?> = {:}, Тело: Объект? = Неопределено): Соответствие<Строка, Объект?>
    знч Запрос = Соединение.СоздатьЗапрос(Метод, Путь).УстановитьПараметрЗапроса("\$format", "json")
        .УстановитьЗаголовок("Accept", "application/json")
    для Пара из Параметры
        Запрос.УстановитьПараметрЗапроса(Пара.Ключ, "%{Пара.Значение}")
    ;
    если Тело != Неопределено
        Запрос.УстановитьТипСодержимого("application/json; charset=utf-8").УстановитьТело(ПротоколERP.Json(Тело))
    ;
    исп Ответ = Запрос.Выполнить()
    ПротоколERP.Требовать(Ответ.КодСтатуса >= 200 и Ответ.КодСтатуса < 300,
        "ODATA_HTTP", "%{Метод} %{Путь}: HTTP %{Ответ.КодСтатуса}. Проверьте публикацию, права и реквизиты ERP")
    знч Текст = Ответ.Тело.ПрочитатьКакСтроку()
    возврат Текст.Пусто() ? <Строка, Объект?>{:} : ПротоколERP.Прочитать(Текст)
;

@НаСервере
метод Найти(Соединение: КлиентHttp, Сущность: Строка, Отбор: Соответствие<Строка, Объект?>): Соответствие<Строка, Объект?>?
    знч Условия = <Строка>[]
    для Пара из Отбор
        знч Текст = Пара.Значение как Строка
        если Пара.Ключ == "Комментарий"
            Условия.Добавить("substringof('" + Текст.Заменить("'", "''") + "',Комментарий) eq true")
            продолжить
        ;
        знч Ссылка = Пара.Ключ == "Ref_Key" или Пара.Ключ.ЗаканчиваетсяНа("_Key") или Пара.Ключ == "Owner"
        знч Имя = Пара.Ключ == "Owner" ? "cast(Owner,'Catalog_Номенклатура')" : Пара.Ключ
        Условия.Добавить(Имя + " eq " + (Ссылка ? "guid'" + Текст + "'" : "'" + Текст.Заменить("'", "''") + "'"))
    ;
    знч Ответ = ЗапросOData(Соединение, "GET", Сущность,
        {"\$filter": СоединитьСтроки(Условия, " and "), "\$top": 2,
            "\$orderby": Сущность.НачинаетсяС("Document_") ? "Ref_Key" : "Description,Ref_Key"})
    знч Строки = ПротоколERP.МассивJson(Ответ.Получить("value"))
    ПротоколERP.Требовать(Строки.Размер() <= 1, "ODATA_CONFLICT", "Неоднозначное соответствие в %{Сущность}")
    если не Строки.Пусто() и Отбор.СодержитКлюч("Комментарий")
        ПротоколERP.Требовать(ПротоколERP.ОбъектJson(Строки[0]).Получить("Комментарий") == Отбор.Получить("Комментарий"),
            "ODATA_CONFLICT", "Конфликт маркера документа")
    ;
    возврат Строки.Пусто() ? Неопределено : ПротоколERP.ОбъектJson(Строки[0])
;

@НаСервере
метод Разрешить(Значение: Объект?, Ссылки: Соответствие<Строка, Строка>): Объект?
    если Значение это Строка
        знч Текст = Значение как Строка
        возврат Текст.НачинаетсяС("@") ? Ссылки.Получить(Текст.Подстрока(1)) : Текст
    иначе если Значение это ЧитаемоеСоответствие<Строка, Объект?>
        знч Результат = <Строка, Объект?>{:}
        для Пара из ПротоколERP.ОбъектJson(Значение)
            Результат.Вставить(Пара.Ключ, Разрешить(Пара.Значение, Ссылки))
        ;
        возврат Результат
    иначе если Значение это ЧитаемыйМассив<Объект?>
        знч Результат = <Объект?>[]
        для Элемент из ПротоколERP.МассивJson(Значение)
            Результат.Добавить(Разрешить(Элемент, Ссылки))
        ;
        возврат Результат
    ;
    возврат Значение
;

@ВПроекте @НаСервере
метод Совпадает(Факт: Объект?, Эталон: Объект?): Булево
    если Эталон это ЧитаемоеСоответствие<Строка, Объект?>
        если не (Факт это ЧитаемоеСоответствие<Строка, Объект?>)
            возврат Ложь
        ;
        знч Данные = ПротоколERP.ОбъектJson(Факт)
        для Пара из ПротоколERP.ОбъектJson(Эталон)
            если не Данные.СодержитКлюч(Пара.Ключ) или не Совпадает(Данные.Получить(Пара.Ключ), Пара.Значение)
                возврат Ложь
            ;
        ;
        возврат Истина
    иначе если Эталон это ЧитаемыйМассив<Объект?>
        если не (Факт это ЧитаемыйМассив<Объект?>)
            возврат Ложь
        ;
        знч Строки = ПротоколERP.МассивJson(Факт)
        знч Ожидаемые = ПротоколERP.МассивJson(Эталон)
        если Строки.Размер() != Ожидаемые.Размер()
            возврат Ложь
        ;
        пер Индекс = 0
        для Ожидаемая из Ожидаемые
            если не Совпадает(Строки[Индекс], Ожидаемая)
                возврат Ложь
            ;
            Индекс = Индекс + 1
        ;
        возврат Истина
    иначе если Эталон это Число
        если Факт это Строка
            возврат новый Число(Факт как Строка) == Эталон
        ;
    ;
    возврат Факт == Эталон
;

@НаСервере
метод СоединитьСтроки(Строки: Массив<Строка>, Разделитель: Строка): Строка
    пер Результат = ""
    пер Префикс = ""
    для Текст из Строки
        Результат = Результат + Префикс + Текст
        Префикс = Разделитель
    ;
    возврат Результат
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод СохранитьСоответствия(Команда: УчастникиИгры.Ссылка, Подключение: ПодключенияERP.Ссылка, Текст: Строка)
    ДоступИгры.ТребоватьАдминистратора()
    исп КонтекстДоступа.Привилегированный()
    знч Участник = Команда.ЗагрузитьОбъект()!
    ПроверкиДанных.Требовать(Участник.ПодключениеERP == Подключение, "Команда подключена к другой информационной базе")
    ОбменERP.СохранитьСоответствия(Команда, Текст)
;

// Только серверный вызов после проверки игрока и закрепления заказа.
// Поддерживается подготовленный профиль BICYCLE_SIMPLE, без НДС, велосипеды в штуках.
@ВПроекте @НаСервере
метод СоздатьЗаказРынкаOData(Адрес: Строка, Логин: Строка, Пароль: Секрет|Строка, Организация: Строка,
    ИдОперации: Строка, КодПродукта: Строка, Количество: Число, Цена: Число, ДатаДокумента: Строка): Соответствие<Строка, Объект?>
    возврат СоздатьЗаказПоСтрокамOData(Адрес, Логин, Пароль, Организация, ИдОперации,
        <Объект?>[{"productCode": КодПродукта, "quantity": Количество, "unitPrice": НастройкиERP.Деньги(Цена)}], ДатаДокумента)
;

@ВПроекте @НаСервере
метод СоздатьЗаказПоСтрокамOData(Адрес: Строка, Логин: Строка, Пароль: Секрет|Строка, Организация: Строка,
    ИдОперации: Строка, СтрокиЗаказа: Массив<Объект?>, ДатаДокумента: Строка): Соответствие<Строка, Объект?>
    ПроверкиДанных.Требовать(не Транзакции.ЕстьАктивная(), "Создание документов ERP выполняется вне транзакции игры")
    ПротоколERP.Требовать(не Логин.Пусто() и (Пароль это Секрет или не (Пароль как Строка).Пусто()),
        "ODATA_AUTH", "Ведущий должен настроить доступ OData команды")
    ПротоколERP.ПроверитьСхему(ИдОперации, КонтрактERP.Схема("UUID"))
    ПротоколERP.Требовать(не СтрокиЗаказа.Пусто() и СтрокиЗаказа.Размер() <= 4, "ODATA_ORDER", "Некорректный состав заказа рынка")
    знч КодыПродуктов = ПроверитьСтрокиЗаказаERP(СтрокиЗаказа)
    знч ДатаЗаказа = ДатаДокумента + "T12:00:00"
    знч ПроверкаДаты = новый ДатаВремя(ДатаЗаказа)
    знч Соединение = КлиентHttp.СБазовымUrl(НормализоватьАдрес(Адрес))
        .САутентификацией(новый АутентификацияHttp(Логин, Пароль))
        .СТаймаутомСоединения(10с).СТаймаутомЗапроса(45с).СМаксимумомПеренаправлений(0)
    знч Маркер = "BICYCLE_PLAYER/" + ИдОперации
    пер Найден = Найти(Соединение, "Document_ЗаказКлиента", {"Комментарий": Маркер})
    знч Профиль = ПротоколERP.Прочитать(ПрофильНастройкиOData.Получить())
    знч Ссылки = <Строка, Строка>{"organizationName": Организация}
    знч Записи = <Строка, Соответствие<Строка, Объект?>>{:}
    для Значение из ПротоколERP.МассивJson(Профиль.Получить("nodes"))
        знч Узел = ПротоколERP.ОбъектJson(Значение)
        знч Ключ = ПротоколERP.СтрокаJson(Узел, "key")
        если не ["organization", "finished_goods", "customer", "counterparty_customer", "agreement_customer", "rub", "vat", "pcs"].Содержит(Ключ)
            и не КодыПродуктов.Содержит(Ключ)
            продолжить
        ;
        знч Запись = Найти(Соединение, ПротоколERP.СтрокаJson(Узел, "entity"),
            ПротоколERP.ОбъектJson(Разрешить(Узел.Получить("match"), Ссылки)))
        ПротоколERP.Требовать(Запись != Неопределено и Запись!.ПолучитьИлиНеопределено("DeletionMark") != Истина,
            "ODATA_MAPPING", "Не найдена настройка ERP: %{Ключ}")
        Ссылки.Вставить(Ключ, ПротоколERP.СтрокаJson(Запись!, "Ref_Key"))
        Записи.Вставить(Ключ, Запись!)
    ;
    знч Соглашение = Записи.Получить("agreement_customer")
    для Пара из <Строка, Строка>{"organization": "Организация_Key", "finished_goods": "Склад_Key", "customer": "Партнер_Key", "counterparty_customer": "Контрагент_Key", "rub": "Валюта_Key"}
        ПротоколERP.Требовать(Соглашение.Получить(Пара.Значение) == Ссылки.Получить(Пара.Ключ),
            "ODATA_MAPPING", "Соглашение относится к другой игровой области")
    ;
    ПротоколERP.Требовать(Соглашение.Получить("Статус") == "Действует", "ODATA_MAPPING", "Соглашение покупателя не действует")
    ПротоколERP.Требовать(Соглашение.ПолучитьИлиНеопределено("ЦенаВключаетНДС") == Истина,
        "ODATA_MAPPING", "Соглашение покупателя должно использовать цены с НДС")
    знч СтавкаНдс = ПротоколERP.ЧислоJson(Записи.Получить("vat"), "Ставка")
    ПротоколERP.Требовать(СтавкаНдс > 0 и СтавкаНдс <= 100, "ODATA_MAPPING", "Некорректная ставка НДС ERP")
    для Код из КодыПродуктов
        ПротоколERP.Требовать(Записи.Получить(Код).Получить("СтавкаНДС_Key") == Ссылки.Получить("vat"),
            "ODATA_MAPPING", "Ставка НДС товара отличается от профиля: %{Код}")
    ;
    // Документы, созданные до исправления НДС, при повторе сверяются по прежним условиям.
    знч СтарыйБезНдс = Найден != Неопределено
        и Найден!.ПолучитьИлиНеопределено("НалогообложениеНДС") == "ПродажаНеОблагаетсяНДС"
        и Найден!.ПолучитьИлиНеопределено("ЦенаВключаетНДС") == Ложь
    знч Налогообложение = СтарыйБезНдс ? "ПродажаНеОблагаетсяНДС" : "ПродажаОблагаетсяНДС"
    знч ТоварыЗаказа = ТоварыЗаказаERP(СтрокиЗаказа, Ссылки, ИдОперации, ДатаЗаказа, СтарыйБезНдс ? 0 : СтавкаНдс)
    пер СуммаЗаказа = 0
    для Значение из ТоварыЗаказа
        СуммаЗаказа = СуммаЗаказа + ПротоколERP.ЧислоJson(ПротоколERP.ОбъектJson(Значение), "Сумма")
    ;
    знч Поля: Соответствие<Строка, Объект?> = {"Date": ДатаЗаказа, "ДатаОтгрузки": ДатаЗаказа, "Комментарий": Маркер,
        "Организация_Key": Ссылки.Получить("organization"), "Партнер_Key": Ссылки.Получить("customer"),
        "Контрагент_Key": Ссылки.Получить("counterparty_customer"), "Соглашение_Key": Ссылки.Получить("agreement_customer"),
        "Валюта_Key": Ссылки.Получить("rub"), "Склад_Key": Ссылки.Получить("finished_goods"),
        "ХозяйственнаяОперация": "РеализацияКлиенту", "НалогообложениеНДС": Налогообложение,
        "ЦенаВключаетНДС": не СтарыйБезНдс, "Статус": "КОбеспечению", "СуммаДокумента": СуммаЗаказа,
        "Согласован": Истина, "ДатаСогласования": ДатаЗаказа, "СкидкиРассчитаны": Истина,
        "Товары": ТоварыЗаказа, "ЭтапыГрафикаОплаты": <Объект?>[{"LineNumber": "1",
            "ВариантОплаты": "КредитСдвиг", "ДатаПлатежа": ДатаЗаказа, "ПроцентПлатежа": 100,
            "СуммаПлатежа": СуммаЗаказа, "ВариантОтсчета": "ОтДатыОтгрузки", "ДатаОтгрузки": ДатаЗаказа}]}
    если Найден == Неопределено
        знч ДатаОстатков = ДатаДокумента + "T23:59:59"
        знч Остатки = ПрочитатьВсе(Соединение, "AccumulationRegister_ТоварыНаСкладах/Balance(Period=datetime'" + ДатаОстатков + "')")
        знч Обязательства = ПрочитатьВсе(Соединение, "AccumulationRegister_ТоварыКОтгрузке/Balance(Period=datetime'" + ДатаОстатков + "')")
        для Значение из СтрокиЗаказа
            знч СтрокаЗаказа = ПротоколERP.ОбъектJson(Значение)
            знч Код = ПротоколERP.СтрокаJson(СтрокаЗаказа, "productCode")
            знч Остаток = ОстатокПродукта(Остатки, Ссылки.Получить(Код), Ссылки.Получить("finished_goods"), Обязательства)
            если ПротоколERP.ЧислоJson(Остаток, "availableQuantity") < ПротоколERP.ЧислоJson(СтрокаЗаказа, "quantity")
                // Заказ фиксирует спрос для последующего обеспечения/производства.
                пер ИндексТовара = 0
                для Товар из ТоварыЗаказа
                    знч СтрокаТовара = ПротоколERP.ОбъектJson(Товар)
                    если СтрокаТовара.Получить("Номенклатура_Key") == Ссылки.Получить(Код)
                        СтрокаТовара.Вставить("ВариантОбеспечения", "Обеспечивать")
                        ТоварыЗаказа[ИндексТовара] = СтрокаТовара
                    ;
                    ИндексТовара = ИндексТовара + 1
                ;
            ;
        ;
        // Устойчивый GUID защищает повтор после потери ответа на POST.
        Поля.Вставить("Ref_Key", ИдОперации)
        Найден = ЗапросOData(Соединение, "POST", "Document_ЗаказКлиента", {:}, Поля)
    ;
    знч Ид = ПротоколERP.СтрокаJson(Найден!, "Ref_Key")
    знч Путь = "Document_ЗаказКлиента(guid'" + Ид + "')"
    знч ТоварыЭталона = <Объект?>[]
    для Значение из ТоварыЗаказа
        знч СтрокаТовара = ПротоколERP.ОбъектJson(Значение)
        ТоварыЭталона.Добавить(<Строка, Объект?>{"Номенклатура_Key": СтрокаТовара.Получить("Номенклатура_Key"),
            "Количество": СтрокаТовара.Получить("Количество"), "Цена": СтрокаТовара.Получить("Цена"),
            "Сумма": СтрокаТовара.Получить("Сумма"), "СуммаСНДС": СтрокаТовара.Получить("СуммаСНДС"),
            "СуммаНДС": СтрокаТовара.Получить("СуммаНДС"), "СтавкаНДС_Key": Ссылки.Получить("vat")})
    ;
    знч Эталон: Соответствие<Строка, Объект?> = {"Комментарий": Маркер, "Date": ДатаЗаказа,
        "Организация_Key": Ссылки.Получить("organization"), "Партнер_Key": Ссылки.Получить("customer"),
        "Контрагент_Key": Ссылки.Получить("counterparty_customer"), "Соглашение_Key": Ссылки.Получить("agreement_customer"),
        "Валюта_Key": Ссылки.Получить("rub"), "Склад_Key": Ссылки.Получить("finished_goods"), "СуммаДокумента": СуммаЗаказа,
        "НалогообложениеНДС": Налогообложение, "ЦенаВключаетНДС": не СтарыйБезНдс,
        "Товары": ТоварыЭталона}
    знч Документ = ЗапросOData(Соединение, "GET", Путь)
    ПротоколERP.Требовать(Совпадает(Документ, Эталон), "ODATA_CONFLICT", "Сохранённый заказ ERP отличается от заказа рынка")
    // В исходной ERP включена отгрузка одной датой: даты только в строках недостаточно.
    // Исправляем исключительно пустую дату своего непроведённого заказа после сверки условий.
    если Документ.Получить("Posted") != Истина
        знч Заполнение = <Строка, Объект?>{:}
        если ["", "0001-01-01T00:00:00"].Содержит(ПротоколERP.СтрокаJson(Документ, "ДатаОтгрузки"))
            Заполнение.Вставить("ДатаОтгрузки", ДатаЗаказа)
        ;
        если Документ.ПолучитьИлиНеопределено("Согласован") != Истина
            Заполнение.Вставить("Согласован", Истина)
            Заполнение.Вставить("ДатаСогласования", ДатаЗаказа)
        ;
        // Фиксированная цена рынка не использует автоматические скидки ERP.
        если Документ.ПолучитьИлиНеопределено("СкидкиРассчитаны") != Истина
            Заполнение.Вставить("СкидкиРассчитаны", Истина)
        ;
        если не Заполнение.Пусто()
            ЗапросOData(Соединение, "PATCH", Путь, {:}, Заполнение)
        ;
    ;
    знч Проведение = ПровестиДокумент(Соединение, Путь)
    знч После = ЗапросOData(Соединение, "GET", Путь)
    ПротоколERP.Требовать(Совпадает(После, Эталон), "ODATA_CONFLICT", "Данные проведённого заказа отличаются от заказа рынка")
    возврат Проведение
;

@НаСервере
метод ПроверитьСтрокиЗаказаERP(СтрокиЗаказа: Массив<Объект?>): Массив<Строка>
    ПротоколERP.Требовать(не СтрокиЗаказа.Пусто() и СтрокиЗаказа.Размер() <= 4, "ODATA_ORDER", "Некорректный состав заказа рынка")
    знч КодыПродуктов = <Строка>[]
    для Значение из СтрокиЗаказа
        знч СтрокаЗаказа = ПротоколERP.ОбъектJson(Значение)
        знч Код = ПротоколERP.СтрокаJson(СтрокаЗаказа, "productCode")
        ПротоколERP.Требовать(["CityRide", "SportDrive", "CargoMax", "TourPro"].Содержит(Код)
            и не КодыПродуктов.Содержит(Код) и ПротоколERP.ЧислоJson(СтрокаЗаказа, "quantity") > 0
            и новый Число(ПротоколERP.СтрокаJson(СтрокаЗаказа, "unitPrice")) > 0, "ODATA_ORDER", "Некорректная строка заказа рынка")
        КодыПродуктов.Добавить(Код)
    ;
    возврат КодыПродуктов
;

@НаСервере
метод ТоварыЗаказаERP(СтрокиЗаказа: Массив<Объект?>, Ссылки: Соответствие<Строка, Строка>,
    ИдОперации: Строка, ДатаЗаказа: Строка, СтавкаНдс: Число): Массив<Объект?>
    знч Ноль = "00000000-0000-0000-0000-000000000000"
    знч ТоварыЗаказа = <Объект?>[]
    пер НомерСтроки = 0
    для Значение из СтрокиЗаказа
        знч СтрокаЗаказа = ПротоколERP.ОбъектJson(Значение)
        знч Код = ПротоколERP.СтрокаJson(СтрокаЗаказа, "productCode")
        знч Количество = ПротоколERP.ЧислоJson(СтрокаЗаказа, "quantity")
        знч Цена = новый Число(ПротоколERP.СтрокаJson(СтрокаЗаказа, "unitPrice"))
        знч Сумма = (Количество * Цена).Округлить(2)
        знч СуммаНдс = (Сумма * СтавкаНдс / (100 + СтавкаНдс)).Округлить(2)
        НомерСтроки = НомерСтроки + 1
        ТоварыЗаказа.Добавить(<Строка, Объект?>{"LineNumber": НомерСтроки.ВСтроку(), "Номенклатура_Key": Ссылки.Получить(Код),
            "Характеристика_Key": Ноль, "Упаковка_Key": Ссылки.Получить("pcs"), "Количество": Количество,
            "КоличествоУпаковок": Количество, "Цена": Цена, "Сумма": Сумма, "СуммаСНДС": Сумма,
            "СуммаНДС": СуммаНдс, "СтавкаНДС_Key": Ссылки.Получить("vat"), "Склад_Key": Ссылки.Получить("finished_goods"),
            "ДатаОтгрузки": ДатаЗаказа, "ВариантОбеспечения": "Отгрузить", "КодСтроки": НомерСтроки.ВСтроку(),
            "КлючСвязи": НомерСтроки.ВСтроку(), "ИдентификаторСтроки": Ууид.Версия5("player-order-line:" + ИдОперации + (СтрокиЗаказа.Размер() == 1 ? "" : ":" + Код)).ВСтроку(), "Отменено": Ложь})
    ;
    возврат ТоварыЗаказа
;

// Чтение только номенклатуры и свободных остатков для общего рынка; без начальных денег и планов.
@ВПодсистеме @НаСервере
метод ПрочитатьОстаткиРынкаOData(Адрес: Строка, Логин: Строка, Пароль: Секрет|Строка,
    Организация: Строка, ДатаДокумента: Строка): Соответствие<Строка, Объект?>
    ПроверкиДанных.Требовать(не Транзакции.ЕстьАктивная(), "Остатки ERP читаются вне транзакции игры")
    знч Соединение = КлиентHttp.СБазовымUrl(НормализоватьАдрес(Адрес))
        .САутентификацией(новый АутентификацияHttp(Логин, Пароль))
        .СТаймаутомСоединения(10с).СТаймаутомЗапроса(45с).СМаксимумомПеренаправлений(0)
    знч Профиль = ПротоколERP.Прочитать(ПрофильНастройкиOData.Получить())
    знч Коды = ["CityRide", "SportDrive", "CargoMax", "TourPro"]
    знч Ссылки = <Строка, Строка>{"organizationName": Организация}
    для Значение из ПротоколERP.МассивJson(Профиль.Получить("nodes"))
        знч Узел = ПротоколERP.ОбъектJson(Значение)
        знч Ключ = ПротоколERP.СтрокаJson(Узел, "key")
        если не ["organization", "finished_goods", "pcs"].Содержит(Ключ) и не Коды.Содержит(Ключ)
            продолжить
        ;
        знч Запись = Найти(Соединение, ПротоколERP.СтрокаJson(Узел, "entity"),
            ПротоколERP.ОбъектJson(Разрешить(Узел.Получить("match"), Ссылки)))
        ПротоколERP.Требовать(Запись != Неопределено и Запись!.ПолучитьИлиНеопределено("DeletionMark") != Истина,
            "ODATA_MAPPING", "Не найдена настройка рынка ERP: %{Ключ}")
        если Коды.Содержит(Ключ)
            ПротоколERP.Требовать(Запись!.Получить("ЕдиницаИзмерения_Key") == Ссылки.Получить("pcs"),
                "ODATA_UNIT", "Для рынка нужны велосипеды в штуках: %{Ключ}")
        ;
        Ссылки.Вставить(Ключ, ПротоколERP.СтрокаJson(Запись!, "Ref_Key"))
    ;
    знч ДатаОстатков = ДатаДокумента + "T23:59:59"
    знч Остатки = ПрочитатьВсе(Соединение, "AccumulationRegister_ТоварыНаСкладах/Balance(Period=datetime'" + ДатаОстатков + "')")
    знч Обязательства = ПрочитатьВсе(Соединение, "AccumulationRegister_ТоварыКОтгрузке/Balance(Period=datetime'" + ДатаОстатков + "')")
    знч Предложения = <Объект?>[]
    для Код из Коды
        знч Остаток = ОстатокПродукта(Остатки, Ссылки.Получить(Код), Ссылки.Получить("finished_goods"), Обязательства)
        Предложения.Добавить(<Строка, Объект?>{"productCode": Код, "availableQuantity": Остаток.Получить("availableQuantity")})
    ;
    возврат {"asOf": ДатаОстатков, "offers": Предложения}
;

// Статус документа читается по GUID, а не по номеру или дате списка ERP.
@ВПодсистеме @НаСервере
метод ПрочитатьСтатусыЗаказовOData(Адрес: Строка, Логин: Строка, Пароль: Секрет|Строка,
    Организация: Строка, Заказы: Массив<Объект?>): Массив<Объект?>
    ПроверкиДанных.Требовать(не Транзакции.ЕстьАктивная(), "Статусы ERP читаются вне транзакции игры")
    знч Соединение = КлиентHttp.СБазовымUrl(НормализоватьАдрес(Адрес))
        .САутентификацией(новый АутентификацияHttp(Логин, Пароль))
        .СТаймаутомСоединения(10с).СТаймаутомЗапроса(45с).СМаксимумомПеренаправлений(0)
    знч ОрганизацияERP = Найти(Соединение, "Catalog_Организации", <Строка, Объект?>{"Description": Организация})
    ПротоколERP.Требовать(ОрганизацияERP != Неопределено, "ODATA_MAPPING", "Организация команды не найдена в ERP")
    знч ИдОрганизации = ПротоколERP.СтрокаJson(ОрганизацияERP!, "Ref_Key")
    знч Результат = <Объект?>[]
    пер Индекс = 0
    пока Индекс < Заказы.Размер()
        знч Условия = <Строка>[]
        знч Пакет = <Объект?>[]
        пока Индекс < Заказы.Размер() и Пакет.Размер() < 20
            знч Заказ = ПротоколERP.ОбъектJson(Заказы[Индекс])
            знч Ид = ПротоколERP.СтрокаJson(Заказ, "refKey")
            ПротоколERP.Требовать(Ид.ПолноеСовпадение(новый Образец("[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")),
                "ODATA_ID", "Некорректный идентификатор заказа ERP")
            Условия.Добавить("Ref_Key eq guid'" + Ид + "'")
            Пакет.Добавить(Заказ)
            Индекс = Индекс + 1
        ;
        знч Ответ = ЗапросOData(Соединение, "GET", "Document_ЗаказКлиента", <Строка, Объект?>{
            "\$filter": СоединитьСтроки(Условия, " or "),
            "\$select": "Ref_Key,Number,Date,Статус,Posted,DeletionMark,Комментарий,Организация_Key", "\$top": "20"})
        знч Документы = ПротоколERP.МассивJson(Ответ.Получить("value"))
        для Значение из Пакет
            знч Заказ = ПротоколERP.ОбъектJson(Значение)
            пер Документ: Соответствие<Строка, Объект?>? = Неопределено
            для СтрокаОтвета из Документы
                знч Кандидат = ПротоколERP.ОбъектJson(СтрокаОтвета)
                если Кандидат.Получить("Ref_Key") == Заказ.Получить("refKey")
                    Документ = Кандидат
                ;
            ;
            Результат.Добавить(СостояниеЗаказаERP(Заказ, Документ, ИдОрганизации))
        ;
    ;
    возврат Результат
;

@НаСервере
метод СостояниеЗаказаERP(Заказ: Соответствие<Строка, Объект?>,
    Документ: Соответствие<Строка, Объект?>?, ИдОрганизации: Строка): Соответствие<Строка, Объект?>
    знч Результат: Соответствие<Строка, Объект?> = {"orderId": Заказ.Получить("orderId"),
        "refKey": Заказ.Получить("refKey"), "error": ""}
    пер Ошибка = ""
    если Документ == Неопределено
        Ошибка = "Заказ по сохранённому GUID не найден в ERP команды. Проверьте подключение и документ."
    иначе если Документ!.Получить("Организация_Key") != ИдОрганизации
        или Документ!.Получить("Комментарий") != "BICYCLE_PLAYER/" + ПротоколERP.СтрокаJson(Заказ, "orderId")
        Ошибка = "Документ ERP не соответствует заказу и организации команды"
    иначе если Документ!.ПолучитьИлиНеопределено("DeletionMark") == Истина
        Ошибка = "Документ ERP помечен на удаление"
        Результат.Вставить("status", "Помечен на удаление")
        Результат.Вставить("closed", Ложь)
        Результат.Вставить("number", Документ!.Получить("Number"))
        Результат.Вставить("date", Документ!.Получить("Date"))
    иначе
        знч Статус = ПротоколERP.СтрокаJson(Документ!, "Статус")
        ПротоколERP.Требовать(Статус != "", "ODATA_STATUS", "ERP не вернула статус заказа")
        Результат.Вставить("status", Статус)
        Результат.Вставить("closed", Статус == "Закрыт" и Документ!.Получить("Posted") == Истина)
        Результат.Вставить("number", Документ!.Получить("Number"))
        Результат.Вставить("date", Документ!.Получить("Date"))
        если Документ!.Получить("Posted") != Истина
            Ошибка = "Заказ в ERP не проведён"
        ;
    ;
    Результат.Вставить("error", Ошибка)
    возврат Результат
;

@ВПроекте @НаСервере
метод ПрочитатьПрайсЛистOData(Адрес: Строка, Логин: Строка, Пароль: Секрет|Строка,
    ОрганизацияИмя: Строка, ДатаДанных: Строка, ЧитатьОстатки: Булево): Соответствие<Строка, Объект?>
    ПротоколERP.Требовать(не Логин.Пусто() и (Пароль это Секрет или (Пароль как Строка) != ""), "ODATA_AUTH", "Укажите логин и пароль OData")
    ПротоколERP.Требовать(ДатаДанных.ПолноеСовпадение(новый Образец("[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}")),
        "ODATA_DATE", "Укажите игровую дату и время данных YYYY-MM-DDTHH:MM:SS")
    знч ПроверкаДаты = новый ДатаВремя(ДатаДанных)
    знч Соединение = КлиентHttp.СБазовымUrl(НормализоватьАдрес(Адрес))
        .САутентификацией(новый АутентификацияHttp(Логин, Пароль))
        .СТаймаутомСоединения(10с).СТаймаутомЗапроса(45с).СМаксимумомПеренаправлений(0)
    знч Профиль = ПротоколERP.Прочитать(ПрофильНастройкиOData.Получить())
    знч Нужные = <Строка>["organization", "finished_goods", "sales_price", "rub", "pcs", "CityRide", "SportDrive", "CargoMax", "TourPro"]
    знч Ссылки = <Строка, Строка>{"organizationName": ОрганизацияИмя}
    знч Записи = <Строка, Соответствие<Строка, Объект?>>{:}
    для Значение из ПротоколERP.МассивJson(Профиль.Получить("nodes"))
        знч Узел = ПротоколERP.ОбъектJson(Значение)
        знч Ключ = ПротоколERP.СтрокаJson(Узел, "key")
        если не Нужные.Содержит(Ключ)
            продолжить
        ;
        знч Запись = Найти(Соединение, ПротоколERP.СтрокаJson(Узел, "entity"),
            ПротоколERP.ОбъектJson(Разрешить(Узел.Получить("match"), Ссылки)))
        ПротоколERP.Требовать(Запись != Неопределено и Запись!.ПолучитьИлиНеопределено("DeletionMark") != Истина,
            "ODATA_MAPPING", "Не найдена активная настройка ERP: %{Ключ}")
        Ссылки.Вставить(Ключ, ПротоколERP.СтрокаJson(Запись!, "Ref_Key"))
        Записи.Вставить(Ключ, Запись!)
    ;
    знч ВидЦены = Ссылки.Получить("sales_price")
    знч ТипЦены = Записи.Получить("sales_price")
    ПротоколERP.Требовать(ТипЦены.Получить("Статус") == "Действует" и ТипЦены.Получить("DeletionMark") != Истина,
        "ODATA_PRICE", "Вид продажной цены не действует")
    ПротоколERP.Требовать(ТипЦены.Получить("ВалютаЦены_Key") == Ссылки.Получить("rub"),
        "ODATA_PRICE", "Продажный вид цены должен быть в рублях")
    ПротоколERP.Требовать(ТипЦены.Получить("ЦенаВключаетНДС") == Истина,
        "ODATA_PRICE", "Прайс-лист должен содержать цены с НДС, как заказы ERP игры")
    знч Цены = ПрочитатьВсе(Соединение, "InformationRegister_ЦеныНоменклатуры25")
    знч Остатки = ЧитатьОстатки ? ПрочитатьВсе(Соединение, "AccumulationRegister_ТоварыНаСкладах/Balance(Period=datetime'" + ДатаДанных + "')") : <Объект?>[]
    знч Обязательства = ЧитатьОстатки ? ПрочитатьВсе(Соединение, "AccumulationRegister_ТоварыКОтгрузке/Balance(Period=datetime'" + ДатаДанных + "')") : <Объект?>[]
    знч Предложения = <Объект?>[]
    для Код из ["CityRide", "SportDrive", "CargoMax", "TourPro"]
        знч Товар = Записи.Получить(Код)
        знч Ид = Ссылки.Получить(Код)
        ПротоколERP.Требовать(Товар.Получить("ЕдиницаИзмерения_Key") == Ссылки.Получить("pcs"),
            "ODATA_UNIT", "Единица велосипедов отличается от шт.: %{Код}")
        знч Цена = ПоследняяЦена(Цены, Ид, ВидЦены, Ссылки.Получить("rub"), ДатаДанных)
        знч Остаток = ОстатокПродукта(Остатки, Ид, Ссылки.Получить("finished_goods"), Обязательства)
        Предложения.Добавить({"productCode": Код, "refKey": Ид, "description": Товар.Получить("Description"),
            "price": ПротоколERP.Деньги(ПротоколERP.ЧислоJson(Цена, "Цена")), "pricePeriod": Цена.Получить("Period"),
            "physicalQuantity": Остаток.Получить("physicalQuantity"), "shippingQuantity": Остаток.Получить("shippingQuantity"),
            "availableQuantity": Остаток.Получить("availableQuantity"), "unitCode": "pcs"})
    ;
    возврат {"asOf": ДатаДанных, "priceTypeName": ТипЦены.Получить("Description"),
        "priceIncludesVAT": ТипЦены.Получить("ЦенаВключаетНДС"), "offers": Предложения}
;
