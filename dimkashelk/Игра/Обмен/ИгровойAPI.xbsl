импорт Данные

метод Контекст(Запрос: HttpСервисЗапрос)
    Обработать(Запрос, "context", "Context")
;

метод Команды(Запрос: HttpСервисЗапрос)
    Обработать(Запрос, "commands", "CommandsResponse")
;

метод Снимки(Запрос: HttpСервисЗапрос)
    Обработать(Запрос, "snapshots", "SnapshotRequest")
;

метод Готовность(Запрос: HttpСервисЗапрос)
    Обработать(Запрос, "readiness", "ReadinessRequest")
;

метод Подтверждение(Запрос: HttpСервисЗапрос)
    Обработать(Запрос, "receipt", "CommandReceiptRequest")
;

метод Продажи(Запрос: HttpСервисЗапрос)
    Обработать(Запрос, "sales-events", "SalesEventRequest")
;

метод Исполнение(Запрос: HttpСервисЗапрос)
    Обработать(Запрос, "execution-events", "ExecutionEventRequest")
;

метод Обработать(Запрос: HttpСервисЗапрос, Маршрут: Строка, ИмяСхемы: Строка)
    если Запрос.Метод != (Маршрут == "context" или Маршрут == "commands" ? "GET" : "POST")
        НеверныйМетод(Запрос)
        возврат
    ;
    попытка
        ПроверитьЗаголовки(Запрос)
        знч Ответ = Выполнить(Запрос, Маршрут, ИмяСхемы)
        ПротоколERP.Ответ(Запрос, Ответ)
    поймать ОшибкаПротокола: ПротоколERP.Ошибка
        ПротоколERP.ОтветОшибка(Запрос, ОшибкаПротокола.КодОтвета, ОшибкаПротокола.Код, ОшибкаПротокола.Описание, ОшибкаПротокола.Поле)
    поймать НеверныйJson: ИсключениеЧтенияJson
        ПротоколERP.ОтветОшибка(Запрос, 400, "INVALID_JSON", "Неверный JSON")
    поймать Сбой: Исключение
        ПротоколERP.ОтветОшибка(Запрос, 500, "INTERNAL_ERROR", "Не удалось обработать запрос; используйте correlationId для диагностики")
    ;
;

метод ПроверитьЗаголовки(Запрос: HttpСервисЗапрос)
    знч Авторизация = Запрос.Заголовки.ПолучитьПервый("Authorization")
    ПротоколERP.Требовать(Авторизация != Неопределено и Авторизация!.НачинаетсяС("Bearer ")
        и Авторизация!.Длина() > 7 и Пользователи.ТекущийПользователь != Неопределено,
        "AUTH_REQUIRED", "Требуется действительный служебный Bearer-токен", КодОтвета = 401)
    ПротоколERP.Требовать(Запрос.Заголовки.ПолучитьПервый("X-Game-Contract-Version") == "1.0",
        "CONTRACT_VERSION_MISMATCH", "Поддерживается контракт 1.0", КодОтвета = 409)
;

метод Параметр(Запрос: HttpСервисЗапрос, Имя: Строка, ПоУмолчанию: Строка = ""): Строка
    знч Значения = Запрос.Параметры.ПолучитьВсе(Имя)
    ПротоколERP.Требовать(Значения.Размер() <= 1, "VALIDATION_ERROR", "Параметр повторяется", Имя)
    возврат Значения.Пусто() ? ПоУмолчанию : Значения[0]
;

метод Выполнить(Запрос: HttpСервисЗапрос, Маршрут: Строка, ИмяСхемы: Строка): Соответствие<Строка, Объект?>
    знч Допустимые = Маршрут == "commands" ? ["bindingId", "gameId", "afterSequence", "limit"] :
        (Маршрут == "receipt" ? ["bindingId", "commandId"] : ["bindingId"])
    для Имя из Запрос.Параметры.Имена()
        ПротоколERP.Требовать(Допустимые.Содержит(Имя), "VALIDATION_ERROR", "Неизвестный параметр запроса", Имя)
    ;
    знч Привязка = Параметр(Запрос, "bindingId")
    ПротоколERP.ПроверитьСхему(Привязка, КонтрактERP.Схема("UUID"), "bindingId")
    знч Участник = ОбменERP.УчастникСервиса(Привязка)
    // Authorization uses the original caller, before the narrow privileged data transaction.
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Команда = Участник.ЗагрузитьОбъект()!
    ПротоколERP.Требовать(Команда.Игра != Неопределено, "BINDING_NOT_ASSIGNED", "Игра ещё не назначена", КодОтвета = 409)
    знч Игра = Команда.Игра!.ЗагрузитьОбъект(Истина)!
    ПротоколERP.Требовать(не Игра.Демонстрационная, "MODE_MISMATCH", "HTTP-обмен предназначен для обычной игры", КодОтвета = 409)
    // Binding is checked again after acquiring the game lock, preventing revocation races.
    ПротоколERP.Требовать(ОбменERP.УчастникСервиса(Привязка) == Участник, "BINDING_FORBIDDEN", "Привязка отозвана", КодОтвета = 403)
    если Запрос.Метод == "GET"
        исп Буфер = новый ВременныйПотокЗаписи()
        знч Прочитано = Запрос.Тело.КопироватьВ(Буфер, Количество = 1)
        ПротоколERP.Требовать(Прочитано == 0, "VALIDATION_ERROR", "GET не содержит тела")
        если Маршрут == "context"
            возврат ОбменERP.Контекст(Привязка, Участник, Игра)
        ;
        знч ИдИгры = Параметр(Запрос, "gameId")
        ПротоколERP.ПроверитьСхему(ИдИгры, КонтрактERP.Схема("UUID"), "gameId")
        ПротоколERP.Требовать(ИдИгры == Игра.Ссылка.Ид.ВСтроку(), "BINDING_FORBIDDEN", "Очередь другой игры недоступна", КодОтвета = 403)
        знч Курсор = Параметр(Запрос, "afterSequence", "0")
        знч Лимит = Параметр(Запрос, "limit", "20")
        ПротоколERP.Требовать(Курсор.ПолноеСовпадение('(0|[1-9][0-9]{0,9})') и новый Число(Курсор) <= 2147483647, "VALIDATION_ERROR", "Неверный afterSequence", "afterSequence")
        ПротоколERP.Требовать(Лимит.ПолноеСовпадение('[1-9][0-9]{0,2}') и новый Число(Лимит) <= 100, "VALIDATION_ERROR", "limit от 1 до 100", "limit")
        // afterSequence is validated but cannot skip an earlier unacknowledged command.
        знч Ответ = ОбменERP.Очередь(Игра, Участник, новый Число(Лимит))
        ПротоколERP.ПроверитьСхему(Ответ, КонтрактERP.Схема("CommandsResponse"))
        возврат Ответ
    ;
    ПротоколERP.Требовать((Запрос.Заголовки.ПолучитьПервый("Content-Type") ?? "").ВНижнийРегистр().ПолноеСовпадение(новый Образец("application/json(\\s*;\\s*charset=utf-8)?")),
        "VALIDATION_ERROR", "Ожидается application/json UTF-8", "Content-Type")
    ПротоколERP.Требовать(Запрос.Заголовки.ПолучитьПервый("Content-Encoding") == Неопределено,
        "VALIDATION_ERROR", "Сжатие тела не поддерживается", "Content-Encoding")
    исп Буфер = новый ВременныйПотокЗаписи()
    знч Прочитано = Запрос.Тело.КопироватьВ(Буфер, Количество = 1048577)
    ПротоколERP.Требовать(Прочитано <= 1048576, "PAYLOAD_TOO_LARGE", "Размер тела превышает 1 МиБ", КодОтвета = 413)
    знч БайтыТела = Буфер.ОткрытьПотокЧтения().ПрочитатьКакБайты()
    знч Тело = ПотокЧтения.ИзБайтов(БайтыТела).ПрочитатьКакСтроку()
    знч Значение = СериализацияJson.ПрочитатьОбъект<Объект?>(Тело)
    ПротоколERP.ПроверитьСхему(Значение, КонтрактERP.Схема(ИмяСхемы))
    знч Данные = ПротоколERP.ОбъектJson(Значение)
    ПротоколERP.ПроверитьСхему(Данные, КонтрактERP.Схема(ИмяСхемы))
    ПротоколERP.Требовать(Запрос.Заголовки.ПолучитьПервый("Idempotency-Key") == ПротоколERP.СтрокаJson(Данные, "messageId"),
        "VALIDATION_ERROR", "Idempotency-Key должен совпадать с messageId", "Idempotency-Key")
    знч ИдКоманды = Маршрут == "receipt" ? Параметр(Запрос, "commandId") : ""
    если Маршрут == "receipt"
        ПротоколERP.ПроверитьСхему(ИдКоманды, КонтрактERP.Схема("UUID"), "commandId")
    ;
    знч Ресурс = Маршрут == "receipt" ? "commands/%{ИдКоманды}/receipt" : Маршрут
    знч Хеш = новый ХешированиеДанных(АлгоритмХеширования.Sha256)
    Хеш.ДобавитьДанные("POST\н/bindings/%{Привязка}/%{Ресурс}\н".ВБайты())
    Хеш.ДобавитьДанные(БайтыТела)
    возврат ОбменERP.ОбработатьPost(Игра, Участник, Привязка, Ресурс, Данные, Тело, Хеш.Результат.ВСтроку().ВНижнийРегистр(), ИдКоманды)
;

метод НеверныйМетод(Запрос: HttpСервисЗапрос)
    знч Метод = ["Контекст", "Команды"].Содержит(Запрос.ИмяШаблона) ? "GET" : "POST"
    Запрос.Ответ.Заголовки.Установить("Allow", Метод)
    ПротоколERP.ОтветОшибка(Запрос, 405, "METHOD_NOT_ALLOWED", "Допустимый метод: %{Метод}")
;

метод НеизвестныйМаршрут(Запрос: HttpСервисЗапрос)
    ПротоколERP.ОтветОшибка(Запрос, 404, "RESOURCE_NOT_FOUND", "Маршрут не найден")
;
