импорт Данные

@ВПроекте
метод ПроверитьУсловияСверки(Демонстрационная: Булево, Статус: СостоянияИгры, Версия: Число,
    АктуальнаяВерсия: Число, Подтвержден: Булево, Причина: Строка)
    ПроверкиДанных.Требовать(не Демонстрационная, "Сверка ERP недоступна для тестовой игры")
    ПроверкиДанных.Требовать(Статус == СостоянияИгры.Завершена или Статус == СостоянияИгры.Идет
        или Статус == СостоянияИгры.Пауза, "Сверка недоступна в этом состоянии игры")
    ПроверкиДанных.Требовать(Версия == АктуальнаяВерсия, "Состояние изменилось. Обновите список периодов")
    ПроверкиДанных.Требовать(не Подтвержден, "Итог уже подтверждён; его нельзя заменить вручную")
    ПроверкиДанных.Требовать(Причина.Сократить() != "" и Причина.Длина() <= 1000, "Укажите причину исправления, не более 1000 символов")
;

@ВПроекте
метод ПроверитьСвежесть(ВремяДанных: Момент, ПрежнееВремя: Момент, ПоследнийФакт: Момент?, Сейчас: Момент)
    ПроверкиДанных.Требовать(ВремяДанных > ПрежнееВремя и ВремяДанных <= Сейчас,
        "Нужен новый снимок ERP после прежнего итога; время не может быть в будущем")
    ПроверкиДанных.Требовать(ПоследнийФакт == Неопределено или ВремяДанных > ПоследнийФакт!,
        "Снимок должен быть получен в ERP после приёма последних исправленных фактов")
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод ПолучитьПериоды(Игра: Игры.Ссылка): Массив<СтрокаИсторииИтогов>
    ДоступИгры.ПроверитьВедущего(Игра)
    исп КонтекстДоступа.Привилегированный()
    знч Строки = <СтрокаИсторииИтогов>[]
    для Итог из Запрос{
        ВЫБРАТЬ Раунд, Участник, ДеньгиНачало, ДеньгиКонец, ВыручкаФакт, Прибыль, ЗакрытиеМесяцаПодтверждено, ФинальныйСнимок
        ИЗ РезультатыРаундов ГДЕ Раунд.Игра == %Игра
        УПОРЯДОЧИТЬ ПО Раунд.НомерРаунда, Участник.ПорядокУчастника
    }.Выполнить()
        знч Снимок = Итог.ФинальныйСнимок?.ЗагрузитьОбъект()
        Строки.Добавить(новый СтрокаИсторииИтогов(Раунд = Итог.Раунд, Участник = Итог.Участник,
            НомерРаунда = Итог.Раунд!.ЗагрузитьОбъект()!.НомерРаунда,
            Команда = Итог.Участник!.ЗагрузитьОбъект()!.НаименованиеКоманды, ДеньгиНачало = Итог.ДеньгиНачало,
            ДеньгиКонец = Итог.ДеньгиКонец, Выручка = Итог.ВыручкаФакт, Прибыль = Итог.Прибыль,
            Подтвержден = Итог.ЗакрытиеМесяцаПодтверждено, ВремяДанных = Снимок?.ВремяДанных,
            Источник = Снимок?.ВерсияИсточника ?? ""))
    ;
    возврат Строки
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод ПолучитьВерсию(Игра: Игры.Ссылка): Число
    ДоступИгры.ПроверитьВедущего(Игра)
    исп КонтекстДоступа.Привилегированный()
    возврат Игра.ЗагрузитьОбъект()!.ВерсияСостояния
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод Сверить(Игра: Игры.Ссылка, Раунд: РаундыИгры.Ссылка, Участник: УчастникиИгры.Ссылка,
    Версия: Число, СнимокJSON: Строка, Причина: Строка): Строка
    ДоступИгры.ПроверитьВедущего(Игра)
    знч Автор = ДоступИгры.ТекущийПользователь()
    ПроверкиДанных.Требовать(СнимокJSON.Длина() <= 262144, "Снимок слишком большой: не более 262144 символов")
    знч Данные = ПротоколERP.Прочитать(СнимокJSON)
    ПротоколERP.ПроверитьСхему(Данные, КонтрактERP.Схема("SnapshotRequest"))
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Объект = Игра.ЗагрузитьОбъект(Истина)!
    ДоступИгры.ПроверитьВедущего(Игра)
    знч Период = Раунд.ЗагрузитьОбъект()!
    знч Команда = Участник.ЗагрузитьОбъект()!
    ПроверкиДанных.Требовать(Период.Игра == Игра и Команда.Игра == Игра и Команда.Активен,
        "Раунд и активная команда должны принадлежать выбранной игре")
    знч Старый = Запрос{
        ВЫБРАТЬ ФинальныйСнимок, ЗакрытиеМесяцаПодтверждено ИЗ РезультатыРаундов
        ГДЕ Раунд == %Раунд И Участник == %Участник
    }.Выполнить().ПервыйИлиНеопределено()
    ПроверкиДанных.Требовать(Старый != Неопределено и Старый!.ФинальныйСнимок != Неопределено, "Нет ранее закрытого периода для сверки")
    ПроверитьУсловияСверки(Объект.Демонстрационная, Объект.Статус, Версия, Объект.ВерсияСостояния,
        Старый!.ЗакрытиеМесяцаПодтверждено, Причина)
    ОбменERP.ПроверитьОбласть(Объект, Участник, Данные)
    ПроверкиДанных.Требовать(Данные.Получить("kind") == "final" и ПротоколERP.ЧислоJson(Данные, "roundNumber") == Период.НомерРаунда,
        "Снимок должен быть финальным и относиться к выбранному раунду")
    знч ПрежнийСнимок = Старый!.ФинальныйСнимок!.ЗагрузитьОбъект()!
    знч Источник = ПротоколERP.СтрокаJson(Данные, "sourceVersion")
    ПроверкиДанных.Требовать(ОбменERP.ПоследнееСостояние(Объект, Участник, "snapshots", Источник) == Неопределено,
        "Версия снимка уже использована. Получите свежий снимок ERP с новой sourceVersion")
    знч ИдСообщения = ПротоколERP.СтрокаJson(Данные, "messageId")
    знч Повтор = Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ СообщенияERP ГДЕ Игра == %Игра И Участник == %Участник И ИдСообщения == %ИдСообщения}.Выполнить().ПервыйИлиНеопределено()
    ПроверкиДанных.Требовать(Повтор == Неопределено, "messageId уже использован; проверьте историю и получите новый снимок")
    знч ПоследнийФакт = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 ВремяПриема КАК Время ИЗ СообщенияERP
        ГДЕ Игра == %Игра И Участник == %Участник И Вид == "sales-events"
        УПОРЯДОЧИТЬ ПО ВремяПриема УБЫВ
    }.Выполнить().ПервыйИлиНеопределено()?.Время
    ПроверитьСвежесть(новый Момент(ПротоколERP.СтрокаJson(Данные, "capturedAt")), ПрежнийСнимок.ВремяДанных, ПоследнийФакт, Момент.Сейчас())
    знч Привязка = ОбменERP.ИдПривязки(Участник)
    // Приём использует проверки балансов, исходной команды, долгов и оплат HTTP-сервиса.
    // Предыдущий период обязан быть подтверждён; хозяйственные команды не выдаются.
    знч Ресурс = ОбменERP.ПринятьСнимок(Объект, Участник, Данные, Сверка = Истина)
    ОбменERP.СохранитьСообщение(Объект, Участник, Привязка, Данные, "snapshots", Источник, 1,
        Ресурс, "admin-reconciliation", СнимокJSON, ПротоколERP.Хеш("admin-reconciliation\н" + СнимокJSON))
    Объект.РезультатыОпубликованы = Ложь
    Объект.ВерсияСостояния = Версия + 1
    Объект.Записать()
    знч Событие = новый СобытияИгры.Объект()
    Событие.Дата = ДатаВремя.Сейчас()
    Событие.Момент = Момент.Сейчас()
    Событие.Игра = Игра
    Событие.Раунд = Раунд
    Событие.Участник = Участник
    Событие.Пользователь = Автор
    Событие.Вид = "Повторная сверка результатов"
    Событие.ИдОперации = ИдСообщения
    Событие.ВерсияДо = Версия
    Событие.ВерсияПосле = Объект.ВерсияСостояния
    Событие.Причина = Причина.Сократить()
    Событие.Детали = "Прежний снимок: %{ПрежнийСнимок.Ссылка.Ид}; новый: %{Ресурс}; версия: %{Источник}"
    Событие.Записать()
    возврат Ресурс
;
