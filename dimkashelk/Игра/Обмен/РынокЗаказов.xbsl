импорт Рынок

@ВПроекте @НаСервере
метод ПродажиОткрыты(Игра: Игры.Объект): Булево
    возврат Игра.СвободныйРынок и Игра.Статус == СостоянияИгры.Идет
        и (Игра.Фаза == ФазыИгры.СтартоваяПродажа или Игра.Фаза == ФазыИгры.Продажи)
        и Игра.СостояниеФазы == СостоянияФазы.Открыта
        и (Игра.Дедлайн == Неопределено или Момент.Сейчас() < Игра.Дедлайн!)
;

// Чистая функция: один seed и номер пакета дают одинаковые параметры.
@ВПроекте @НаСервере
метод ПараметрыПакета(Seed: Число, Раунд: Число, Номер: Число, Моделей: Число,
    МинКоличество: Число = 1, МаксКоличество: Число = 5,
    МинИнтервал: Число = 30, МаксИнтервал: Число = 90): Массив<Число>
    ПроверкиДанных.Требовать(Моделей > 0, "Нет моделей рынка")
    ПроверкиДанных.ПроверитьПараметрыЗаказов(МинКоличество, МаксКоличество, МинИнтервал, МаксИнтервал)
    знч Модель = ПроверкиДанных.СтабильныйПриоритет("order-model:%{Номер}", Seed, Раунд) % Моделей
    знч Количество = МинКоличество + ПроверкиДанных.СтабильныйПриоритет("order-quantity:%{Номер}", Seed, Раунд) % (МаксКоличество - МинКоличество + 1)
    знч Интервал = МинИнтервал + ПроверкиДанных.СтабильныйПриоритет("order-delay:%{Номер}", Seed, Раунд) % (МаксИнтервал - МинИнтервал + 1)
    возврат [Модель, Количество, Интервал]
;

@ВПроекте @НаСервере
метод Обновить(Ссылка: Игры.Ссылка)
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Игра = Ссылка.ЗагрузитьОбъект(Истина)!
    ЗавершитьПоСроку(Игра)
    если не ПродажиОткрыты(Игра) или Игра.СледующийЗаказ == Неопределено
        возврат
    ;
    знч Предложение = ПредложениеВсехКоманд(Игра)
    знч Остатки = ПротоколERP.ОбъектJson(Предложение.Получить("quantities"))
    знч Максимумы = ПротоколERP.ОбъектJson(Предложение.Получить("maximumQuantities"))
    знч Раунд = Игра.ТекущийРаунд!
    знч НомерРаунда = Раунд.ЗагрузитьОбъект()!.НомерРаунда
    если Игра.СледующийЗаказ! > Момент.Сейчас()
        возврат
    ;
    // Одна небольшая партия за срок. Публикация и закрепление используют одну блокировку игры.
    Игра.НомерПакетаЗаказов = Игра.НомерПакетаЗаказов + 1
    знч Пакет = ПараметрыПакета(Игра.Seed, НомерРаунда, Игра.НомерПакетаЗаказов, Игра.ПараметрыРынка.Размер(),
        Игра.МинКоличествоЗаказа, Игра.МаксКоличествоЗаказа, Игра.МинИнтервалЗаказов, Игра.МаксИнтервалЗаказов)
    знч Потребности = <Число>[]
    знч Веса = <Число>[]
    знч Основания = <Соответствие<Строка, Объект?>>[]
    для Правило из Игра.ПараметрыРынка
        знч Продукт = Правило.Продукт!
        знч Код = Продукт.ЗагрузитьОбъект()!.Код
        пер Тренд = Правило.Тренд
        для НастройкаТренда из Игра.ТрендыПоРаундам
            если НастройкаТренда.НомерРаунда == НомерРаунда и НастройкаТренда.Продукт == Продукт
                Тренд = НастройкаТренда.Тренд
            ;
        ;
        знч Получено = Запрос{ВЫБРАТЬ СУММА(Количество).ЗаменитьNull(0) КАК Количество ИЗ ЗаказыРынка
            ГДЕ Раунд == %Раунд И Продукт == %Продукт И Участник != НЕОПРЕДЕЛЕНО}.Выполнить().ПервыйИлиНеопределено()!.Количество
        знч ВОчереди = Запрос{ВЫБРАТЬ СУММА(Количество).ЗаменитьNull(0) КАК Количество ИЗ ЗаказыРынка
            ГДЕ Раунд == %Раунд И Продукт == %Продукт И Участник == НЕОПРЕДЕЛЕНО}.Выполнить().ПервыйИлиНеопределено()!.Количество
        знч Спрос = (Правило.БазовыйСпрос * Тренд).Округлить(0, РежимОкругления.ПоловинаВверх)
        знч ОстатокСпроса = Спрос > Получено ? Спрос - Получено : 0
        знч Доступно = ПротоколERP.ЧислоJson(Остатки, Код)
        знч МаксимумКоманды = ПротоколERP.ЧислоJson(Максимумы, Код)
        // Спрос покупателей не ограничивается товаром команд. Остатки определяют цену.
        знч Потребность = РазмерНовогоЗаказа(ОстатокСпроса, ВОчереди, Пакет[1])
        // Минимум из настроек не нарушается даже на последнем остатке спроса.
        Потребности.Добавить(Потребность >= Игра.МинКоличествоЗаказа ? Потребность : 0)
        знч Непокрыто = РазмерНовогоЗаказа(ОстатокСпроса, ВОчереди, ОстатокСпроса)
        Веса.Добавить(Потребность >= Игра.МинКоличествоЗаказа ? Непокрыто : 0)
        знч Цена = ДинамическаяЦена(Правило.РеферентнаяЦена, Правило.МинимальнаяЦена,
            Правило.МаксимальнаяЦена, Правило.Эластичность, ОстатокСпроса, Доступно)
        Основания.Добавить(<Строка, Объект?>{"model": "inverse-demand-v1", "productCode": Код,
            "baseDemand": Правило.БазовыйСпрос, "trend": Тренд, "committedQuantity": Получено,
            "remainingDemand": ОстатокСпроса, "availableSupply": Доступно, "maximumTeamSupply": МаксимумКоманды, "queuedQuantity": ВОчереди,
            "referencePrice": Правило.РеферентнаяЦена, "minimumPrice": Правило.МинимальнаяЦена,
            "maximumPrice": Правило.МаксимальнаяЦена, "elasticity": Правило.Эластичность,
            "price": Цена, "sourcesHash": Предложение.Получить("sourcesHash")})
    ;
    знч Модель = ВыбратьМодельПакета(Веса, Игра.Seed, НомерРаунда, Игра.НомерПакетаЗаказов)
    если Модель >= 0
        знч Основание = Основания[Модель]
        знч Заказ = новый ЗаказыРынка.Объект()
        Заказ.Игра = Ссылка
        Заказ.Раунд = Раунд
        Заказ.НомерПакета = Игра.НомерПакетаЗаказов
        Заказ.Наименование = "Заказ №%{Заказ.НомерПакета}"
        Заказ.Продукт = Игра.ПараметрыРынка[Модель].Продукт
        Заказ.Количество = Потребности[Модель]
        Заказ.Цена = ПротоколERP.ЧислоJson(Основание, "price")
        Заказ.ОснованиеЦены = ПротоколERP.КаноническийJson(Основание)
        Заказ.ХешОснованияЦены = ПротоколERP.Хеш(Заказ.ОснованиеЦены)
        Заказ.ВремяПоявления = Момент.Сейчас()
        Заказ.Статус = "Свободен"
        Заказ.Записать()
    ;
    Игра.СледующийЗаказ = Момент.Сейчас() + 1с * Пакет[2]
    Игра.Записать()
;

// Обратная зависимость от кривой спроса Excel. Цена общая для всех команд.
@ВПроекте @НаСервере
метод ДинамическаяЦена(РеферентнаяЦена: Число, МинимальнаяЦена: Число,
    МаксимальнаяЦена: Число, Эластичность: Число, ОстатокСпроса: Число, Предложение: Число): Число
    ПроверкиДанных.Требовать(РеферентнаяЦена > 0 и МинимальнаяЦена > 0
        и МаксимальнаяЦена >= МинимальнаяЦена и Эластичность >= 0
        и ОстатокСпроса >= 0 и Предложение >= 0, "Некорректные параметры цены рынка")
    пер Цена = РеферентнаяЦена
    если Предложение == 0
        Цена = МаксимальнаяЦена
    иначе если ОстатокСпроса == 0
        Цена = МинимальнаяЦена
    иначе если Эластичность > 0
        знч ДавлениеСпроса = ОстатокСпроса / Предложение
        если ДавлениеСпроса >= (МаксимальнаяЦена / РеферентнаяЦена) ** Эластичность
            Цена = МаксимальнаяЦена
        иначе если ДавлениеСпроса <= (МинимальнаяЦена / РеферентнаяЦена) ** Эластичность
            Цена = МинимальнаяЦена
        иначе
            Цена = РеферентнаяЦена * ДавлениеСпроса ** (1 / Эластичность)
        ;
    ;
    Цена = Цена < МинимальнаяЦена ? МинимальнаяЦена : Цена
    Цена = Цена > МаксимальнаяЦена ? МаксимальнаяЦена : Цена
    возврат Цена.Округлить(2, РежимОкругления.ПоловинаВверх)
;

@ВПроекте @НаСервере
метод РазмерНовогоЗаказа(ОстатокСпроса: Число, ВОчереди: Число, Размер: Число): Число
    знч Количество = ОстатокСпроса > ВОчереди ? ОстатокСпроса - ВОчереди : 0
    возврат Количество < Размер ? Количество : Размер
;

@ВПодсистеме @НаСервере
метод ВыбратьМодельПакета(Потребности: ЧитаемыйМассив<Число>, Seed: Число, Раунд: Число, Номер: Число): Число
    пер Всего = 0
    для Потребность из Потребности
        Всего = Всего + Потребность
    ;
    если Всего <= 0
        возврат -1
    ;
    пер Выбор = ПроверкиДанных.СтабильныйПриоритет("order-need:%{Номер}", Seed, Раунд) % Всего
    пер Индекс = 0
    для Потребность из Потребности
        если Выбор < Потребность
            возврат Индекс
        ;
        Выбор = Выбор - Потребность
        Индекс = Индекс + 1
    ;
    возврат -1
;

@ВПроекте @НаСервере
метод Резервировать(Участник: УчастникиИгры.Ссылка, СсылкаЗаказа: ЗаказыРынка.Ссылка, Токен: Строка): Строка
    знч СсылкаИгры = ДоступКабинета.ПроверитьИгрока(Участник)
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Игра = СсылкаИгры.ЗагрузитьОбъект(Истина)!
    ДоступКабинета.ПроверитьИгрока(Участник)
    ПроверкиДанных.Требовать((Игра.СвободныйРынок или Игра.ЗаказыПоЦенамERP) и Игра.Статус == СостоянияИгры.Идет и Игра.ТокенФазы == Токен, "Этап изменился. Обновите кабинет")
    знч Заказ = СсылкаЗаказа.ЗагрузитьОбъект(Истина)!
    ПроверкиДанных.Требовать(Заказ.Игра == СсылкаИгры и Заказ.Раунд == Игра.ТекущийРаунд, "Заказ относится к другой игре или раунду")
    // После автоматического завершения можно подтвердить ранее полученный заказ.
    ПроверкиДанных.Требовать(Заказ.Участник == Участник
        или не ДоступКабинета.Завершено(Участник, Игра.ТекущийРаунд, Токен), "Команда уже завершила этап")
    ПроверкиДанных.Требовать(ПродажиОткрыты(Игра) или (Заказ.Участник == Участник
        и (Игра.Фаза == ФазыИгры.Продажи или Игра.Фаза == ФазыИгры.СтартоваяПродажа)), "Рынок закрыт для новых заказов")
    ПроверкиДанных.Требовать(Заказ.Участник == Неопределено или Заказ.Участник == Участник, "Заказ уже забрала другая команда")
    если Заказ.Статус == "Проведен в ERP"
        возврат ""
    ;
    ПроверкиДанных.Требовать(Заказ.Статус != "Отправляется" или Заказ.НачалоПопытки == Неопределено
        или Момент.Сейчас() > Заказ.НачалоПопытки! + 15м, "Заказ уже отправляется. Дождитесь результата")
    если Заказ.Участник == Неопределено
        Заказ.Участник = Участник
        Заказ.ВремяПолучения = Момент.Сейчас()
    ;
    Заказ.ЧислоПопыток = Заказ.ЧислоПопыток + 1
    Заказ.Попытка = новый Ууид().ВСтроку()
    Заказ.НачалоПопытки = Момент.Сейчас()
    Заказ.Статус = "Отправляется"
    Заказ.Ошибка = ""
    Заказ.Записать()
    возврат Заказ.Попытка
;

@ВПроекте @НаСервере
метод Подтвердить(Участник: УчастникиИгры.Ссылка, СсылкаЗаказа: ЗаказыРынка.Ссылка, Попытка: Строка,
    Результат: Соответствие<Строка, Объект?>?, Ошибка: Строка, ОтказДоСоздания: Булево = Ложь)
    знч СсылкаИгры = ДоступКабинета.ПроверитьИгрока(Участник)
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Игра = СсылкаИгры.ЗагрузитьОбъект(Истина)!
    знч Заказ = СсылкаЗаказа.ЗагрузитьОбъект(Истина)!
    если Заказ.Попытка != Попытка
        возврат
    ;
    ПроверкиДанных.Требовать(Заказ.Участник == Участник и Заказ.Игра == СсылкаИгры, "Изменился владелец заказа")
    если Результат == Неопределено
        Заказ.Статус = "Ошибка ERP"
        Заказ.Ошибка = Ошибка
        если ОтказДоСоздания и Заказ.ЧислоПопыток == 1 и Заказ.СтрокиЗаказаJson == ""
            // Применяется только к доказанному отказу до первого POST.
            Заказ.Участник = Неопределено
            Заказ.ВремяПолучения = Неопределено
            Заказ.Статус = "Свободен"
            Заказ.ЧислоПопыток = 0
        ;
    иначе
        ПроверкиДанных.Требовать(Результат!.Получить("posted") == Истина, "ERP не подтвердила проведение")
        Заказ.ВнешнийДокумент = ПротоколERP.СтрокаJson(Результат!, "refKey")
        Заказ.НомерERP = ПротоколERP.СтрокаJson(Результат!, "number")
        Заказ.Статус = "Проведен в ERP"
        Заказ.ДатаERP = ПротоколERP.СтрокаJson(Результат!, "date")
        Заказ.СтатусERP = Результат!.ПолучитьИлиУмолчание("erpStatus", "") как Строка
        Заказ.ЗакрытERP = Заказ.СтатусERP == "Закрыт"
        Заказ.ВремяПроверкиERP = Заказ.СтатусERP == "" ? Неопределено : Момент.Сейчас()
        Заказ.ОшибкаПроверкиERP = ""
        ЗаписатьКомандуERP(Игра, Заказ)
    ;
    Заказ.Записать()
;

@НаСервере
метод ЗаписатьКомандуERP(Игра: Игры.Объект, Заказ: ЗаказыРынка.Объект)
    знч Раунд = Заказ.Раунд!
    знч Календарь = НастройкиERP.КалендарьРаунда(Игра, Раунд.ЗагрузитьОбъект()!.НомерРаунда)
    знч Нагрузка: Соответствие<Строка, Объект?> = {"allocationId": ИдРасчета(Раунд).ВСтроку(),
        "externalOrderId": Заказ.Ссылка.Ид.ВСтроку(), "currency": "RUB", "documentDate": Календарь.Получить("documentDate"),
        "lines": СтрокиЗаказаERP(Заказ)}
    знч СсылкаКоманды = ОбменERP.ВыдатьКоманду(Игра, Заказ.Участник!, ВидыКомандERP.СоздатьЗаказКлиента,
        "create_customer_order", Нагрузка, Заказ.Ссылка.Ид.ВСтроку(), Истина)
    знч Команда = СсылкаКоманды.ЗагрузитьОбъект(Истина)!
    знч Ответ: Соответствие<Строка, Объект?> = {"status": "completed", "erpDocumentIds": <Объект?>[Заказ.ВнешнийДокумент],
        "commandId": Команда.ИдОперации, "phaseToken": Команда.ТокенФазы}
    Команда.Статус = СтатусыКомандОбмена.Выполнена
    Команда.ВнешнийДокумент = Заказ.ВнешнийДокумент
    Команда.ВремяПодтверждения = Момент.Сейчас()
    Команда.Подтверждение = ОбменERP.СохранитьСообщение(Игра, Заказ.Участник, "", Ответ,
        "command-acknowledgements", Команда.ИдОперации, 1, Команда.ИдОперации)
    Команда.Записать()
    Заказ.КомандаERP = СсылкаКоманды
;

@ВПроекте @НаСервере
метод ИдРасчета(Раунд: РаундыИгры.Ссылка): Ууид
    возврат Ууид.Версия5("free-market-calculation:%{Раунд.Ид}")
;

@ВПроекте @НаСервере
метод ЗаполнитьРасчет(Игра: Игры.Объект, Расчет: РасчетыРынка.Объект)
    знч Раунд = Игра.ТекущийРаунд!
    для Строка из Запрос{ВЫБРАТЬ Участник, Продукт, Цена, СУММА(Количество) КАК Количество ИЗ ЗаказыРынка
        ГДЕ Раунд == %Раунд И Статус == "Проведен в ERP"
        СГРУППИРОВАТЬ ПО Участник, Продукт, Цена}.Выполнить()
        Расчет.Распределение.Добавить(новый РасчетыРынка.Распределение(Участник = Строка.Участник,
            Продукт = Строка.Продукт, Цена = Строка.Цена, Доступно = Строка.Количество,
            Заказано = Строка.Количество, РасчетнаяВыручка = Строка.Количество * Строка.Цена))
    ;
    для Правило из Игра.ПараметрыРынка
        знч Продукт = Правило.Продукт!
        знч Всего = Запрос{ВЫБРАТЬ СУММА(Количество).ЗаменитьNull(0) КАК Количество ИЗ ЗаказыРынка
            ГДЕ Раунд == %Раунд И Продукт == %Продукт}.Выполнить().ПервыйИлиНеопределено()!.Количество
        знч Взято = Запрос{ВЫБРАТЬ СУММА(Количество).ЗаменитьNull(0) КАК Количество ИЗ ЗаказыРынка
            ГДЕ Раунд == %Раунд И Продукт == %Продукт И Статус == "Проведен в ERP"}.Выполнить().ПервыйИлиНеопределено()!.Количество
        Расчет.СпросПродуктов.Добавить(новый РасчетыРынка.СпросПродуктов(Продукт = Продукт,
            СредняяЦена = Правило.РеферентнаяЦена, БазовыйСпрос = Правило.БазовыйСпрос,
            Тренд = Правило.Тренд, ИтоговыйСпрос = Всего, ОбщаяДоступность = Взято, НепокрытыйСпрос = Всего - Взято))
    ;
;

@ВПроекте @НаСервере
метод ЗавершитьПоСроку(Игра: Игры.Объект)
    // Вызывается под блокировкой игры, общей с ручным завершением и переходами.
    если Игра.ПометкаУдаления или Игра.Статус != СостоянияИгры.Идет
        или Игра.СостояниеФазы != СостоянияФазы.Открыта или Игра.Дедлайн == Неопределено
        или Момент.Сейчас() < Игра.Дедлайн! или Игра.ТекущийРаунд == Неопределено или Игра.ТокенФазы == ""
        возврат
    ;
    если не Игра.ЗаказыПоЦенамERP или Игра.Фаза == ФазыИгры.СтартоваяПродажа или Игра.Фаза == ФазыИгры.Продажи
        ФиксироватьИтогиРаунда(Игра)
    ;
    знч СсылкаИгры = Игра.Ссылка
    знч Раунд = Игра.ТекущийРаунд
    знч Токен = Игра.ТокенФазы
    для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ УчастникиИгры
        ГДЕ Игра == %СсылкаИгры И Активен И НЕ ПометкаУдаления}.Выполнить()
        знч Участник = Строка.Ссылка
        если ДоступКабинета.Завершено(Участник, Раунд, Токен)
            продолжить
        ;
        знч Записи = новый ЗаявленияКоманд.НаборЗаписей()
        Записи.Фильтр.Установить(Участник = Участник, Раунд = Раунд, ТокенФазы = Токен)
        Записи.ДобавитьЗапись(Участник = Участник, Раунд = Раунд, ТокенФазы = Токен, Завершено = Истина,
            Время = Игра.Дедлайн, Пользователь = Неопределено, Описание = "Завершено автоматически: время этапа истекло",
            ЗапрошенаБлокировкаERP = не Игра.ТолькоРынок)
        Записи.Записать()
    ;
;

// Под общей блокировкой игры: поздний ответ OData не меняет уже сохранённый итог.
@ВПроекте @НаСервере
метод ФиксироватьИтогиРаунда(Игра: Игры.Объект)
    знч Раунд = Игра.ТекущийРаунд
    если Раунд == Неопределено
        возврат
    ;
    знч Сейчас = Момент.Сейчас()
    знч Срок = Игра.Дедлайн != Неопределено и Игра.Дедлайн! <= Сейчас ? Игра.Дедлайн! : Сейчас
    для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ ЗаказыРынка
        ГДЕ Раунд == %Раунд И ВремяФиксацииИтога == Неопределено}.Выполнить()
        знч Заказ = Строка.Ссылка.ЗагрузитьОбъект(Истина)!
        Заказ.ВремяФиксацииИтога = Срок
        Заказ.Записать()
    ;
;

@ВПроекте @НаСервере
метод ПроверитьЗавершение(Игра: Игры.Объект)
    ЗавершитьПоСроку(Игра)
    если не Игра.СвободныйРынок и не Игра.ЗаказыПоЦенамERP
        возврат
    ;
    знч Раунд = Игра.ТекущийРаунд
    знч СсылкаИгры = Игра.Ссылка
    знч Токен = Игра.ТокенФазы
    если СборПрайсЛистовОткрыт(Игра)
        для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ УчастникиИгры
            ГДЕ Игра == %СсылкаИгры И Активен И НЕ ПометкаУдаления}.Выполнить()
            знч Причина = ПричинаОжиданияПрайсЛиста(Игра, Строка.Ссылка)
            ПроверкиДанных.Требовать(Причина == "", "%{Строка.Ссылка}: %{Причина}")
        ;
    ;
    знч Незавершенный = Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ ЗаказыРынка
        ГДЕ Раунд == %Раунд И Участник.Активен
            И Статус != "Проведен в ERP"}.Выполнить().ПервыйИлиНеопределено()
    ПроверкиДанных.Требовать(Незавершенный == Неопределено, "Ожидается подтверждение полученных заказов ERP")
    для Игрок из Запрос{ВЫБРАТЬ Участник ИЗ ИгрокиКоманд
        ГДЕ Игра == %СсылкаИгры И Активно И Участник.Активен}.Выполнить()
        ПроверкиДанных.Требовать(ДоступКабинета.Завершено(Игрок.Участник!, Раунд, Токен), "Не все команды заявили о завершении этапа")
    ;
;

@ВПроекте @НаСервере
метод ПеренестиЗаявления(Игра: Игры.Объект, ПредыдущийТокен: Строка)
    знч Раунд = Игра.ТекущийРаунд
    знч СсылкаИгры = Игра.Ссылка
    для Строка из Запрос{ВЫБРАТЬ Участник, Время, Пользователь, Описание, ЗапрошенаБлокировкаERP
        ИЗ ЗаявленияКоманд ГДЕ Участник.Игра == %СсылкаИгры И Раунд == %Раунд
            И ТокенФазы == %ПредыдущийТокен И Завершено}.Выполнить()
        знч Записи = новый ЗаявленияКоманд.НаборЗаписей()
        Записи.Фильтр.Установить(Участник = Строка.Участник, Раунд = Раунд, ТокенФазы = Игра.ТокенФазы)
        Записи.ДобавитьЗапись(Участник = Строка.Участник, Раунд = Раунд, ТокенФазы = Игра.ТокенФазы,
            Завершено = Истина, Время = Строка.Время, Пользователь = Строка.Пользователь,
            Описание = Строка.Описание, ЗапрошенаБлокировкаERP = Строка.ЗапрошенаБлокировкаERP)
        Записи.Записать()
    ;
;

// Готовность в режиме OData определяется проведёнными заказами и заявлением игроков.
@ВПроекте @НаСервере
метод ПричинаОжиданияКоманды(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка): Строка
    // Завершение меняет токен фазы; новое заявление от игрока уже не требуется.
    если Игра.Статус == СостоянияИгры.Завершена
        возврат ""
    ;
    если СборПрайсЛистовОткрыт(Игра)
        возврат ПричинаОжиданияПрайсЛиста(Игра, Участник)
    ;
    знч Раунд = Игра.ТекущийРаунд
    если не Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ ЗаказыРынка
        ГДЕ Раунд == %Раунд И Участник == %Участник И Статус != "Проведен в ERP"}.Выполнить().Пусто()
        возврат "Ожидается проведение полученных заказов через OData"
    ;
    знч СсылкаИгры = Игра.Ссылка
    если не Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Пользователь ИЗ ИгрокиКоманд
        ГДЕ Игра == %СсылкаИгры И Участник == %Участник И Активно
            И Пользователь != НЕОПРЕДЕЛЕНО}.Выполнить().Пусто()
        и не ДоступКабинета.Завершено(Участник, Раунд, Игра.ТокенФазы)
        возврат "Игроки ещё не завершили этап"
    ;
    возврат ""
;

// Недоступные/устаревшие остатки команды равны нулю и не блокируют остальные команды.
@ВПодсистеме @НаСервере
метод ПредложениеВсехКоманд(Игра: Игры.Объект): Соответствие<Строка, Объект?>
    знч Количества: Соответствие<Строка, Объект?> = {"CityRide": 0, "SportDrive": 0, "CargoMax": 0, "TourPro": 0}
    знч Максимумы: Соответствие<Строка, Объект?> = {"CityRide": 0, "SportDrive": 0, "CargoMax": 0, "TourPro": 0}
    знч Источники = <Объект?>[]
    пер НедоступноКоманд = 0
    знч СсылкаИгры = Игра.Ссылка
    знч Раунд = Игра.ТекущийРаунд
    для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ УчастникиИгры ГДЕ Игра == %СсылкаИгры И Активен
        И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО ПорядокУчастника}.Выполнить()
        знч Участник = Строка.Ссылка
        если ДоступКабинета.Завершено(Участник, Раунд, Игра.ТокенФазы)
            продолжить
        ;
        знч Команда = Участник.ЗагрузитьОбъект()!
        если Команда.ТокенРынкаOData != Игра.ТокенФазы или Команда.ОшибкаРынкаOData != ""
            или Команда.ВремяРынкаOData == Неопределено или Команда.ДанныеРынкаOData == ""
            или Команда.ВремяРынкаOData! + 90с < Момент.Сейчас()
            НедоступноКоманд = НедоступноКоманд + 1
            Источники.Добавить(<Строка, Объект?>{"participantId": Участник.Ид.ВСтроку(), "available": Ложь})
            продолжить
        ;
        знч Предложение = ПротоколERP.Прочитать(Команда.ДанныеРынкаOData)
        для Значение из ПротоколERP.МассивJson(Предложение.Получить("offers"))
            знч СтрокаПредложения = ПротоколERP.ОбъектJson(Значение)
            знч Код = ПротоколERP.СтрокаJson(СтрокаПредложения, "productCode")
            знч Продукт = ОбменERP.Продукт(Код)
            знч ВремяЧтения = Команда.ВремяРынкаOData!
            // Консервативно учитываем операции после начала чтения и неподтверждённые POST.
            пер ПослеЧтения = 0
            для Заказ из Запрос{ВЫБРАТЬ Количество, ВремяПолучения, Статус ИЗ ЗаказыРынка
                ГДЕ Раунд == %Раунд И Участник == %Участник И Продукт == %Продукт}.Выполнить()
                // Nullable-момент сравниваем после проверки типа вне XBQL.
                если Заказ.Статус != "Проведен в ERP" или Заказ.ВремяПолучения == Неопределено
                    или Заказ.ВремяПолучения! >= ВремяЧтения
                    ПослеЧтения = ПослеЧтения + Заказ.Количество
                ;
            ;
            знч Остаток = ПротоколERP.ЧислоJson(СтрокаПредложения, "availableQuantity")
            знч Свободно = Остаток > ПослеЧтения ? Остаток - ПослеЧтения : 0
            Количества.Вставить(Код, ПротоколERP.ЧислоJson(Количества, Код) + Свободно)
            если Свободно > ПротоколERP.ЧислоJson(Максимумы, Код)
                Максимумы.Вставить(Код, Свободно)
            ;
        ;
        Источники.Добавить(<Строка, Объект?>{"participantId": Участник.Ид.ВСтроку(),
            "readAt": Команда.ВремяРынкаOData!.ВСтроку(), "data": Предложение})
    ;
    возврат {"quantities": Количества, "maximumQuantities": Максимумы, "unavailableTeams": НедоступноКоманд,
        "sourcesHash": ПротоколERP.Хеш(ПротоколERP.КаноническийJson(Источники))}
;

@ВПодсистеме @НаСервере
метод ЗарезервироватьЧтениеРынка(СсылкаИгры: Игры.Ссылка, Участник: УчастникиИгры.Ссылка): Соответствие<Строка, Объект?>?
    исп Транзакции.Начать()
    знч Игра = СсылкаИгры.ЗагрузитьОбъект(Истина)!
    если не ПродажиОткрыты(Игра) и не СборПрайсЛистовОткрыт(Игра)
        возврат Неопределено
    ;
    знч Команда = Участник.ЗагрузитьОбъект(Истина)!
    если Команда.Игра != СсылкаИгры или не Команда.Активен или Команда.ПометкаУдаления
        возврат Неопределено
    ;
    если СборПрайсЛистовОткрыт(Игра)
        если не ДоступКабинета.Завершено(Участник, Игра.ТекущийРаунд, Игра.ТокенФазы)
            или (Команда.ТокенРынкаOData == Игра.ТокенФазы и Команда.ДанныеРынкаOData != "" и Команда.ОшибкаРынкаOData == "")
            возврат Неопределено
        ;
    ;
    если Команда.ТокенРынкаOData == Игра.ТокенФазы и Команда.СледующееЧтениеРынкаOData != Неопределено
        и Команда.СледующееЧтениеРынкаOData! > Момент.Сейчас()
        возврат Неопределено
    ;
    если Команда.ТокенРынкаOData != Игра.ТокенФазы
        Команда.ДанныеРынкаOData = ""
        Команда.ВремяРынкаOData = Неопределено
        Команда.ОшибкаРынкаOData = ""
    ;
    Команда.ТокенРынкаOData = Игра.ТокенФазы
    Команда.СледующееЧтениеРынкаOData = Момент.Сейчас() + 5м
    Команда.Записать()
    знч НомерРаунда = Игра.ТекущийРаунд!.ЗагрузитьОбъект()!.НомерРаунда
    возврат {"token": Игра.ТокенФазы, "startedAt": Момент.Сейчас(),
        "documentDate": НастройкиERP.КалендарьРаунда(Игра, НомерРаунда).Получить("documentDate"),
        "priceList": СборПрайсЛистовОткрыт(Игра), "initialStock": НомерРаунда == 0}
;

@ВПодсистеме @НаСервере
метод СохранитьОстаткиРынка(СсылкаИгры: Игры.Ссылка, Участник: УчастникиИгры.Ссылка,
    Токен: Строка, Начало: Момент, Данные: Строка, Ошибка: Строка)
    исп Транзакции.Начать()
    знч Игра = СсылкаИгры.ЗагрузитьОбъект(Истина)!
    знч Команда = Участник.ЗагрузитьОбъект(Истина)!
    если Игра.ТокенФазы != Токен или (не ПродажиОткрыты(Игра) и не СборПрайсЛистовОткрыт(Игра)) или Команда.Игра != СсылкаИгры
        или не Команда.Активен или Команда.ПометкаУдаления
        возврат
    ;
    если СборПрайсЛистовОткрыт(Игра) и Ошибка == ""
        попытка
            ПроверитьПрайсЛист(Игра, ПротоколERP.Прочитать(Данные))
        поймать Сбой: Исключение
            Команда.ДанныеРынкаOData = ""
            Команда.ВремяРынкаOData = Начало
            Команда.ТокенРынкаOData = Токен
            Команда.ОшибкаРынкаOData = Сбой.Описание
            Команда.СледующееЧтениеРынкаOData = Момент.Сейчас() + 15с
            Команда.Записать()
            возврат
        ;
    ;
    Команда.ДанныеРынкаOData = Данные
    Команда.ВремяРынкаOData = Начало
    Команда.ТокенРынкаOData = Токен
    Команда.ОшибкаРынкаOData = Ошибка
    Команда.СледующееЧтениеРынкаOData = Момент.Сейчас() + (Ошибка == "" ? 30с : 15с)
    Команда.Записать()
;

// Серверное задание команды вызывает этот метод вне транзакции и без сеанса игрока.
@ВПодсистеме @НаСервере
метод СинхронизироватьРынокФоном(СсылкаИгры: Игры.Ссылка, Участник: УчастникиИгры.Ссылка)
    исп КонтекстДоступа.Привилегированный()
    знч Контекст = ЗарезервироватьЧтениеРынка(СсылкаИгры, Участник)
    если Контекст == Неопределено
        возврат
    ;
    знч Токен = ПротоколERP.СтрокаJson(Контекст!, "token")
    знч Начало = Контекст!.Получить("startedAt") как Момент
    попытка
        знч Команда = Участник.ЗагрузитьОбъект()!
        НастройкаБазOData.ПроверитьДоступЗаказов(Команда)
        знч База = Команда.ПодключениеERP!.ЗагрузитьОбъект()!
        знч Данные = Контекст!.Получить("priceList") == Истина
            ? НастройкаБазOData.ПрочитатьПрайсЛистOData(База.АдресOData, База.ЛогинOData, База.ПарольOData!,
                Команда.ОрганизацияERP, ПротоколERP.СтрокаJson(Контекст!, "documentDate") + "T23:59:59", Контекст!.Получить("initialStock") == Истина)
            : НастройкаБазOData.ПрочитатьОстаткиРынкаOData(База.АдресOData, База.ЛогинOData,
                База.ПарольOData!, Команда.ОрганизацияERP, ПротоколERP.СтрокаJson(Контекст!, "documentDate"))
        СохранитьОстаткиРынка(СсылкаИгры, Участник, Токен, Начало, ПротоколERP.Json(Данные), "")
    поймать Ошибка: Исключение
        знч Сообщение = Контекст!.Получить("priceList") == Истина
            ? (Ошибка это ПротоколERP.Ошибка ? Ошибка.Описание : "Не удалось прочитать прайс-лист ERP; проверьте подключение")
            : "Не удалось обновить свободные остатки ERP команды"
        СохранитьОстаткиРынка(СсылкаИгры, Участник, Токен, Начало, "", Сообщение)
    ;
;

@ВПроекте @НаСервере
метод СостояниеДанныхРынка(Игра: Игры.Объект): Строка
    если Игра.ЗаказыПоЦенамERP
        если Игра.Фаза == ФазыИгры.Ценообразование
            возврат "Установите продажные цены с НДС в прайс-листе ERP на игровую дату и завершите этап. Элемент зафиксирует прайс-лист; ведущий выдаст каждой команде один заказ по ценам и спросу. Минимальный общий спрос равен числу команд."
        ;
        возврат "Персональные заказы сформированы по зафиксированным ценам ERP. Состав и цены заказа сохраняются до конца раунда."
    ;
    если не Игра.СвободныйРынок
        возврат ""
    ;
    если не ПродажиОткрыты(Игра)
        возврат "Новые заказы появляются только во время открытых продаж"
    ;
    знч Данные = ПредложениеВсехКоманд(Игра)
    знч НедоступноКоманд = ПротоколERP.ЧислоJson(Данные, "unavailableTeams")
    пер Всего = 0
    для Пара из ПротоколERP.ОбъектJson(Данные.Получить("quantities"))
        Всего = Всего + (Пара.Значение как Число)
    ;
    если Всего == 0
        если НедоступноКоманд > 0
            возврат "Заказы появляются по спросу даже без товара. Остатки недоступных команд (%{НедоступноКоманд}) приняты равными 0; цена новых заказов максимальная. Чтение ERP повторяется автоматически."
        ;
        возврат "Свободной продукции пока нет. Заказы появляются по спросу по максимальной цене модели. Заказ можно принять для последующего производства и обеспечения в ERP команды."
    ;
    если НедоступноКоманд > 0
        возврат "Заказы появляются по спросу. Остатки недоступных команд (%{НедоступноКоманд}) приняты равными 0 при расчёте цены. Чтение ERP повторяется автоматически."
    ;
    возврат "Общий рынок: цена новых заказов зависит от оставшегося спроса и свободных остатков всех команд."
;

// Проверяем и закрытые заказы: повторное открытие ERP должно вернуть их в работу.
@ВПодсистеме @НаСервере
метод ЕстьЗаказыERP(Игра: Игры.Ссылка, Участник: УчастникиИгры.Ссылка): Булево
    возврат не Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ ЗаказыРынка
        ГДЕ Игра == %Игра И Участник == %Участник
            И Статус == "Проведен в ERP" И ВнешнийДокумент != ""}.Выполнить().Пусто()
;

@НаСервере
метод ЗарезервироватьСтатусыERP(СсылкаИгры: Игры.Ссылка, Участник: УчастникиИгры.Ссылка): Соответствие<Строка, Объект?>?
    исп Транзакции.Начать()
    знч Игра = СсылкаИгры.ЗагрузитьОбъект(Истина)!
    знч Команда = Участник.ЗагрузитьОбъект(Истина)!
    если Игра.ПометкаУдаления или Команда.ПометкаУдаления или не Команда.Активен
        или Команда.Игра != СсылкаИгры или (Команда.СледующееЧтениеСтатусовERP != Неопределено
            и Команда.СледующееЧтениеСтатусовERP! > Момент.Сейчас())
        возврат Неопределено
    ;
    знч Заказы = <Объект?>[]
    для Строка из Запрос{ВЫБРАТЬ Ссылка, ВнешнийДокумент ИЗ ЗаказыРынка
        ГДЕ Игра == %СсылкаИгры И Участник == %Участник
            И Статус == "Проведен в ERP" И ВнешнийДокумент != ""}.Выполнить()
        Заказы.Добавить(<Строка, Объект?>{"orderId": Строка.Ссылка.Ид.ВСтроку(), "refKey": Строка.ВнешнийДокумент})
    ;
    если Заказы.Пусто()
        возврат Неопределено
    ;
    Команда.НачалоЧтенияСтатусовERP = Момент.Сейчас()
    Команда.СледующееЧтениеСтатусовERP = Момент.Сейчас() + 5м
    Команда.Записать()
    возврат {"startedAt": Команда.НачалоЧтенияСтатусовERP, "orders": Заказы}
;

@НаСервере
метод СохранитьСтатусыERP(СсылкаИгры: Игры.Ссылка, Участник: УчастникиИгры.Ссылка,
    Начало: Момент, Состояния: Массив<Объект?>, Ошибка: Строка)
    исп Транзакции.Начать()
    знч Игра = СсылкаИгры.ЗагрузитьОбъект(Истина)!
    знч Команда = Участник.ЗагрузитьОбъект(Истина)!
    если Игра.ПометкаУдаления или Команда.ПометкаУдаления или не Команда.Активен
        или Команда.Игра != СсылкаИгры или Команда.НачалоЧтенияСтатусовERP != Начало
        возврат
    ;
    // Включая ответ запроса, начатого до срока, но пришедшего после него.
    ЗавершитьПоСроку(Игра)
    для Значение из Состояния
        знч Состояние = ПротоколERP.ОбъектJson(Значение)
        знч СсылкаЗаказа = новый ЗаказыРынка.Ссылка(новый Ууид(ПротоколERP.СтрокаJson(Состояние, "orderId")))
        знч Заказ = СсылкаЗаказа.ЗагрузитьОбъект(Истина)
        если Заказ == Неопределено или Заказ!.Игра != СсылкаИгры
            или Заказ!.Участник != Участник или Заказ!.ВнешнийДокумент != Состояние.Получить("refKey")
            или Заказ!.Статус != "Проведен в ERP"
            продолжить
        ;
        ПрименитьСтатусERP(Заказ!, Состояние, Момент.Сейчас())
        Заказ!.Записать()
    ;
    Команда.ОшибкаСтатусовERP = Ошибка
    знч Интервал = Игра.ТолькоРынок и Игра.Статус != СостоянияИгры.Завершена ? 5с : 30с
    Команда.СледующееЧтениеСтатусовERP = Момент.Сейчас() + (Ошибка == "" ? Интервал : 15с)
    Команда.Записать()
;

@НаСервере
метод ПрименитьСтатусERP(Заказ: ЗаказыРынка.Объект, Состояние: Соответствие<Строка, Объект?>, Начало: Момент)
    // Транспортная ошибка не превращает закрытый заказ в открытый и не стирает последнее подтверждение.
    Заказ.ОшибкаПроверкиERP = ПротоколERP.СтрокаJson(Состояние, "error")
    если Состояние.СодержитКлюч("status")
        Заказ.СтатусERP = ПротоколERP.СтрокаJson(Состояние, "status")
        Заказ.ЗакрытERP = Состояние.Получить("closed") == Истина
        Заказ.НомерERP = ПротоколERP.СтрокаJson(Состояние, "number")
        Заказ.ДатаERP = ПротоколERP.СтрокаJson(Состояние, "date")
        Заказ.ВремяПроверкиERP = Начало
        если Заказ.ВремяФиксацииИтога == Неопределено
            Заказ.ЗачтенЗакрытым = Заказ.ЗакрытERP
        ;
    ;
;

@ВПодсистеме @НаСервере
метод СинхронизироватьСтатусыERP(СсылкаИгры: Игры.Ссылка, Участник: УчастникиИгры.Ссылка)
    исп КонтекстДоступа.Привилегированный()
    знч Контекст = ЗарезервироватьСтатусыERP(СсылкаИгры, Участник)
    если Контекст == Неопределено
        возврат
    ;
    знч Начало = Контекст!.Получить("startedAt") как Момент
    знч Заказы = ПротоколERP.МассивJson(Контекст!.Получить("orders"))
    попытка
        знч Команда = Участник.ЗагрузитьОбъект()!
        НастройкаБазOData.ПроверитьДоступЗаказов(Команда)
        знч База = Команда.ПодключениеERP!.ЗагрузитьОбъект()!
        знч Состояния = НастройкаБазOData.ПрочитатьСтатусыЗаказовOData(База.АдресOData, База.ЛогинOData,
            База.ПарольOData!, Команда.ОрганизацияERP, Заказы)
        СохранитьСтатусыERP(СсылкаИгры, Участник, Начало, Состояния, "")
    поймать Ошибка: Исключение
        знч ОшибкиЗаказов = <Объект?>[]
        для Значение из Заказы
            знч Состояние = ПротоколERP.ОбъектJson(Значение)
            Состояние.Вставить("error", "Не удалось проверить заказ ERP. Показан последний подтверждённый статус.")
            ОшибкиЗаказов.Добавить(Состояние)
        ;
        СохранитьСтатусыERP(СсылкаИгры, Участник, Начало, ОшибкиЗаказов, "Не удалось прочитать статусы заказов ERP")
    ;
;

@ВПроекте @НаСервере
метод ПредставлениеСтатусаERP(Заказ: ЗаказыРынка.Объект): Строка
    если Заказ.Участник == Неопределено
        возврат ""
    ;
    если Заказ.ВнешнийДокумент == ""
        возврат "Создание документа ERP ещё не подтверждено"
    ;
    знч Итог = Заказ.ВремяФиксацииИтога == Неопределено ? "" : " Итог раунда зафиксирован: %{Заказ.ЗачтенЗакрытым ? "зачтён закрытым" : "не зачтён закрытым"}"
    знч Документ = "ERP №%{Заказ.НомерERP} · %{Заказ.ДатаERP} · GUID %{Заказ.ВнешнийДокумент}.%{Итог}"
    если Заказ.ОшибкаПроверкиERP != ""
        возврат "%{Документ}. %{Заказ.ОшибкаПроверкиERP} Последний статус: %{Заказ.СтатусERP}; проверен %{Заказ.ВремяПроверкиERP}"
    ;
    если Заказ.ВремяПроверкиERP == Неопределено
        возврат "%{Документ}. Статус пока не прочитан; учитывается в незакрытых"
    ;
    возврат "%{Документ}. %{Заказ.ЗакрытERP ? "Закрыт" : "Не закрыт"} · статус ERP: %{Заказ.СтатусERP} · проверен %{Заказ.ВремяПроверкиERP}"
;

@ВПроекте @НаСервере
метод ПортфелиРаунда(СсылкаИгры: Игры.Ссылка, Раунд: РаундыИгры.Ссылка?): Массив<СтрокаКомандыИгрока>
    знч Игра = СсылкаИгры.ЗагрузитьОбъект()!
    знч Токен = Игра.ТокенФазы
    знч Команды = <СтрокаКомандыИгрока>[]
    для Строка из Запрос{ВЫБРАТЬ Ссылка, НаименованиеКоманды ИЗ УчастникиИгры
        ГДЕ Игра == %СсылкаИгры И Активен УПОРЯДОЧИТЬ ПО ПорядокУчастника}.Выполнить()
        знч Команда = Строка.Ссылка
        знч Заказы = Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Число, СУММА(ВЫБОР КОГДА СуммаЗаказа > 0 ТОГДА СуммаЗаказа ИНАЧЕ Количество * Цена КОНЕЦ).ЗаменитьNull(0) КАК Сумма
            ИЗ ЗаказыРынка ГДЕ Раунд == %Раунд И Участник == %Команда}.Выполнить().ПервыйИлиНеопределено()!
        знч Закрытые = Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Число, СУММА(ВЫБОР КОГДА СуммаЗаказа > 0 ТОГДА СуммаЗаказа ИНАЧЕ Количество * Цена КОНЕЦ).ЗаменитьNull(0) КАК Сумма
            ИЗ ЗаказыРынка ГДЕ Раунд == %Раунд И Участник == %Команда И ЗачтенЗакрытым}.Выполнить().ПервыйИлиНеопределено()!
        Команды.Добавить(новый СтрокаКомандыИгрока(Команда = Строка.НаименованиеКоманды,
            Готовность = Игра.Статус == СостоянияИгры.Завершена ? "Игра завершена"
                : (ДоступКабинета.Завершено(Команда, Раунд, Токен) ? "Этап завершён" : "В работе"),
            Заказов = Заказы.Число, Сумма = Заказы.Сумма,
            ЗакрытыхЗаказов = Закрытые.Число, НезакрытыхЗаказов = Заказы.Число - Закрытые.Число,
            ЗакрытыйПортфель = Закрытые.Сумма, НезакрытыйПортфель = Заказы.Сумма - Закрытые.Сумма))
    ;
    возврат Команды
;

@ВПроекте @НаСервере
метод СборПрайсЛистовОткрыт(Игра: Игры.Объект): Булево
    возврат Игра.ЗаказыПоЦенамERP и Игра.ТолькоРынок и Игра.Статус == СостоянияИгры.Идет
        и Игра.Фаза == ФазыИгры.Ценообразование и Игра.СостояниеФазы == СостоянияФазы.Открыта
;

@ВПроекте @НаСервере
метод ПричинаОжиданияПрайсЛиста(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка): Строка
    если не ДоступКабинета.Завершено(Участник, Игра.ТекущийРаунд, Игра.ТокенФазы)
        возврат "Установите цены в прайс-листе ERP и завершите этап в кабинете"
    ;
    знч Команда = Участник.ЗагрузитьОбъект()!
    если Команда.ТокенРынкаOData != Игра.ТокенФазы или Команда.ВремяРынкаOData == Неопределено
        или Команда.ДанныеРынкаOData == ""
        возврат Команда.ТокенРынкаOData == Игра.ТокенФазы и Команда.ОшибкаРынкаOData != ""
            ? Команда.ОшибкаРынкаOData : "Ожидается сбор прайс-листа ERP; повторяется автоматически"
    ;
    возврат Команда.ОшибкаРынкаOData
;

@ВПроекте @НаСервере
метод СтрокиЗаказаERP(Заказ: ЗаказыРынка.Объект): Массив<Объект?>
    если Заказ.СтрокиЗаказаJson != ""
        возврат ПротоколERP.МассивJson(ПротоколERP.Прочитать(Заказ.СтрокиЗаказаJson).Получить("lines"))
    ;
    возврат <Объект?>[{"productCode": Заказ.Продукт!.ЗагрузитьОбъект()!.Код,
        "quantity": Заказ.Количество, "unitPrice": НастройкиERP.Деньги(Заказ.Цена)}]
;

@ВПроекте @НаСервере
метод СуммаЗаказа(Заказ: ЗаказыРынка.Объект): Число
    возврат Заказ.СтрокиЗаказаJson == "" ? Заказ.Количество * Заказ.Цена : Заказ.СуммаЗаказа
;

// Вызывается в транзакции перехода фазы под блокировкой игры. Сетевых запросов здесь нет.
@ВПроекте @НаСервере
метод СоздатьПерсональныеЗаказы(Игра: Игры.Объект, Правила: Массив<ПараметрыПродукта>)
    ПроверкиДанных.Требовать(Транзакции.ЕстьАктивная() и СборПрайсЛистовОткрыт(Игра), "Заказы публикуются при завершении установки цен")
    знч Раунд = Игра.ТекущийРаунд!.ЗагрузитьОбъект(Истина)!
    ПроверкиДанных.Требовать(Раунд.ОкончательныйРасчет == Неопределено, "Заказы этого раунда уже сформированы")
    знч Параметры = Правила.Сортировать((Л, П) -> Л.КодПродукта.Сравнить(П.КодПродукта))
    знч СсылкаИгры = Игра.Ссылка
    знч Команды = <УчастникиИгры.Ссылка>[]
    знч ПрайсЛисты = <Строка, Соответствие<Строка, Объект?>>{:}
    знч Источники = <Объект?>[]
    для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ УчастникиИгры
        ГДЕ Игра == %СсылкаИгры И Активен И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО Ссылка}.Выполнить()
        знч Участник = Строка.Ссылка
        знч Причина = ПричинаОжиданияПрайсЛиста(Игра, Участник)
        ПроверкиДанных.Требовать(Причина == "", "%{Участник}: %{Причина}")
        знч Команда = Участник.ЗагрузитьОбъект()!
        знч Данные = ПротоколERP.Прочитать(Команда.ДанныеРынкаOData)
        Команды.Добавить(Участник)
        ПрайсЛисты.Вставить(Участник.Ид.ВСтроку(), Данные)
        Источники.Добавить(<Строка, Объект?>{"participantId": Участник.Ид.ВСтроку(),
            "phaseToken": Игра.ТокенФазы, "readAt": Команда.ВремяРынкаOData!.ВСтроку(), "data": Данные})
    ;
    знч Предложения = <Массив<ПредложениеРынка>>[]
    для Правило из Параметры
        знч Строки = <ПредложениеРынка>[]
        для Участник из Команды
            пер Найдено = 0
            для Значение из ПротоколERP.МассивJson(ПрайсЛисты.Получить(Участник.Ид.ВСтроку()).Получить("offers"))
                знч Предложение = ПротоколERP.ОбъектJson(Значение)
                если Предложение.Получить("productCode") == Правило.КодПродукта
                    Найдено = Найдено + 1
                    Строки.Добавить(новый ПредложениеРынка(Участник = Участник.Ид.ВСтроку(), Активен = Истина,
                        Цена = новый Число(ПротоколERP.СтрокаJson(Предложение, "price")),
                        Доступно = ПротоколERP.ЧислоJson(Предложение, "availableQuantity")))
                ;
            ;
            ПроверкиДанных.Требовать(Найдено == 1, "У команды %{Участник} отсутствует или повторяется цена %{Правило.КодПродукта}")
        ;
        Предложения.Добавить(Строки)
    ;
    знч Итоги = РасчетРынка.РассчитатьПерсональныеЗаказы(Параметры, Предложения, Игра.Алгоритм, Игра.Seed, Раунд.НомерРаунда)
    знч Расчет = новый РасчетыРынка.Объект(Ид = ИдРасчета(Раунд.Ссылка))
    Расчет.Дата = ДатаВремя.Сейчас()
    Расчет.Игра = Игра.Ссылка
    Расчет.Раунд = Раунд.Ссылка
    Расчет.Алгоритм = Игра.Алгоритм
    Расчет.ВерсияАлгоритма = "price-orders-v1"
    Расчет.Время = Момент.Сейчас()
    Расчет.Статус = СтатусыРасчетовРынка.Окончательный
    знч Вход: Соответствие<Строка, Объект?> = {"sources": Источники, "seed": Игра.Seed,
        "round": Раунд.НомерРаунда, "settingsHash": Игра.ОтпечатокНастроек, "algorithm": Игра.Алгоритм.Представление(), "version": "price-orders-v1"}
    Расчет.ХешВхода = ПротоколERP.Хеш(ПротоколERP.КаноническийJson(Вход))
    ОбменERP.СохранитьСообщение(Игра, Неопределено, "", Вход, "market-price-lists", Раунд.Ссылка.Ид.ВСтроку(), 1, "market-price-lists")
    пер Индекс = 0
    для Итог из Итоги
        знч Правило = Параметры[Индекс]
        знч Продукт = ОбменERP.Продукт(Правило.КодПродукта)
        Расчет.СпросПродуктов.Добавить(новый РасчетыРынка.СпросПродуктов(Продукт = Продукт,
            СредняяЦена = Итог.СредняяЦена, БазовыйСпрос = Правило.БазовыйСпрос, Тренд = Правило.Тренд,
            ИтоговыйСпрос = Итог.Спрос, ОбщаяДоступность = Итог.Доступность, НепокрытыйСпрос = 0))
        для Строка из Итог.Заказы
            знч Участник = новый УчастникиИгры.Ссылка(новый Ууид(Строка.Участник))
            Расчет.Распределение.Добавить(новый РасчетыРынка.Распределение(Участник = Участник, Продукт = Продукт,
                Цена = Строка.Цена, Доступно = Строка.Доступно, Заказано = Строка.Заказано,
                ЦеновойВес = Строка.Вес, РасчетнаяВыручка = Строка.Выручка))
        ;
        Индекс = Индекс + 1
    ;
    Расчет.Записать()
    для Участник из Команды
        знч Заказ = новый ЗаказыРынка.Объект(Ид = Ууид.Версия5("price-order:%{Раунд.Ссылка.Ид}:%{Участник.Ид}"))
        Заказ.Игра = Игра.Ссылка
        Заказ.Раунд = Раунд.Ссылка
        Заказ.Участник = Участник
        Заказ.НомерПакета = 1
        Заказ.Наименование = "Персональный заказ · %{Участник.ЗагрузитьОбъект()!.НаименованиеКоманды} · раунд %{Раунд.НомерРаунда}"
        Заказ.ВремяПоявления = Момент.Сейчас()
        Заказ.ВремяПолучения = Заказ.ВремяПоявления
        Заказ.Статус = "Назначен"
        знч СтрокиЗаказа = <Объект?>[]
        пер Описание = "Заказ по прайс-листу ERP на раунд %{Раунд.НомерРаунда}. "
        Индекс = 0
        для Итог из Итоги
            для Строка из Итог.Заказы
                если Строка.Участник != Участник.Ид.ВСтроку() или Строка.Заказано == 0
                    продолжить
                ;
                знч Код = Параметры[Индекс].КодПродукта
                если Заказ.Продукт == Неопределено
                    Заказ.Продукт = ОбменERP.Продукт(Код)
                    Заказ.Цена = Строка.Цена
                ;
                СтрокиЗаказа.Добавить(<Строка, Объект?>{"productCode": Код, "quantity": Строка.Заказано,
                    "unitPrice": НастройкиERP.Деньги(Строка.Цена)})
                Заказ.Количество = Заказ.Количество + Строка.Заказано
                Заказ.СуммаЗаказа = Заказ.СуммаЗаказа + Строка.Выручка
                Описание = Описание + "%{Код}: %{Строка.Заказано} шт. × %{Строка.Цена} ₽ = %{Строка.Выручка} ₽. "
            ;
            Индекс = Индекс + 1
        ;
        ПроверкиДанных.Требовать(Заказ.Количество >= 1 и не СтрокиЗаказа.Пусто(), "Команда осталась без заказа")
        Заказ.ОписаниеЗаказа = Описание + "Итого %{Заказ.СуммаЗаказа} ₽. Цены зафиксированы; выполните заказ в ERP своей команды."
        Заказ.СтрокиЗаказаJson = ПротоколERP.КаноническийJson(<Строка, Объект?>{"lines": СтрокиЗаказа})
        Заказ.ОснованиеЦены = "Прайс-листы ERP, price-orders-v1; расчёт %{Расчет.Ссылка.Ид}; минимум спроса — число команд"
        Заказ.ХешОснованияЦены = Расчет.ХешВхода
        Заказ.Записать()
    ;
    Раунд.ОкончательныйРасчет = Расчет.Ссылка
    Раунд.Записать()
;

@ВПодсистеме @НаСервере
метод ПроверитьПрайсЛист(Игра: Игры.Объект, Данные: Соответствие<Строка, Объект?>)
    для Правило из Игра.ПараметрыРынка
        знч Код = Правило.Продукт!.ЗагрузитьОбъект()!.Код
        пер Найдено = 0
        для Значение из ПротоколERP.МассивJson(Данные.Получить("offers"))
            знч Строка = ПротоколERP.ОбъектJson(Значение)
            если Строка.Получить("productCode") != Код
                продолжить
            ;
            Найдено = Найдено + 1
            знч Цена = новый Число(ПротоколERP.СтрокаJson(Строка, "price"))
            ПроверкиДанных.Требовать(Цена > 0 и Цена == Цена.Округлить(2)
                и Цена >= Правило.МинимальнаяЦена и Цена <= Правило.МаксимальнаяЦена,
                "Цена %{Код} должна быть в диапазоне %{Правило.МинимальнаяЦена}–%{Правило.МаксимальнаяЦена} ₽. Исправьте прайс-лист ERP; чтение повторится автоматически")
            ПроверкиДанных.ЦелоеНеотрицательное(ПротоколERP.ЧислоJson(Строка, "availableQuantity"), "Остаток %{Код}")
        ;
        ПроверкиДанных.Требовать(Найдено == 1, "Прайс-лист должен содержать одну цену %{Код}")
    ;
;

@ВПроекте @НаСервере
метод ПеренестиПрайсЛисты(Игра: Игры.Объект, ПредыдущийТокен: Строка)
    если не СборПрайсЛистовОткрыт(Игра)
        возврат
    ;
    знч СсылкаИгры = Игра.Ссылка
    для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ УчастникиИгры
        ГДЕ Игра == %СсылкаИгры И Активен И НЕ ПометкаУдаления}.Выполнить()
        знч Команда = Строка.Ссылка.ЗагрузитьОбъект(Истина)!
        если Команда.ТокенРынкаOData == ПредыдущийТокен и Команда.ДанныеРынкаOData != ""
            и Команда.ОшибкаРынкаOData == "" и Команда.ВремяРынкаOData != Неопределено
            Команда.ТокенРынкаOData = Игра.ТокенФазы
            Команда.Записать()
        ;
    ;
;
