импорт Данные
импорт Обмен

@ВПроекте
метод Инициализировать(ВыбраннаяИгра: Игры.Ссылка, КомандаERP: УчастникиИгры.Ссылка?, Строка: СтрокаНазначенияДоступа?, ЭтоСервис: Булево)
    Игра = ВыбраннаяИгра
    Участник = КомандаERP
    СервисERP = ЭтоСервис
    Роль = ЭтоСервис ? ПрикладныеРоли.СервисERP : ПрикладныеРоли.Наблюдатель
    Активно = Истина
    НовоеНазначение = Строка == Неопределено
    если Строка != Неопределено
        Пользователь = Строка!.Пользователь
        Роль = Строка!.Роль
        Активно = Строка!.Активно
    ;
;

метод ВыборРолей(): Массив<ЭлементСпискаЗначений<ПрикладныеРоли>>
    возврат [новый ЭлементСпискаЗначений<ПрикладныеРоли>(Значение = ПрикладныеРоли.Ведущий, Представление = "Ведущий"),
        новый ЭлементСпискаЗначений<ПрикладныеРоли>(Значение = ПрикладныеРоли.Наблюдатель, Представление = "Наблюдатель")]
;

метод Сохранить(Команда: ОбычнаяКоманда)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено и Пользователь != Неопределено, "Выберите пользователя")
        если СервисERP
            ПроверкиДанных.Требовать(Участник != Неопределено, "Выберите команду")
            ОбменERP.НазначитьСервис(Участник!, Пользователь!, Активно)
        иначе
            ДоступИгры.НазначитьПользователя(Игра!, Пользователь!, Роль, Активно)
        ;
        Закрыть(Истина)
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    Занято = Ложь
;
