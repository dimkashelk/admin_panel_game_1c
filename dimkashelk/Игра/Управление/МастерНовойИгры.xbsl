импорт Данные
импорт Обмен

@Обработчик
метод ПослеСоздания()
    НоваяИгра(Неопределено)
;

метод НоваяИгра(Команда: ОбычнаяКоманда?)
    если Занято
        возврат
    ;
    СозданнаяИгра = Неопределено
    ЗагруженнаяИгра = Неопределено
    НастраиваемаяКоманда = Неопределено
    ОчиститьКоманду()
    СписокКоманд = []
    Сценарий = Неопределено
    Администратор = УправлениеИгрой.АдминистраторНастройки()
    Сообщение = "Выберите сценарий и нажмите «Создать игру». Игроков и базы ERP можно добавить следующим шагом."
    СтатусИгры = "Новая игра"
    Черновик = Истина
    ВыборИгрыСвернут = Истина
    ПравилаСвернуты = Ложь
    ИгрокиСвернуты = Ложь
    Название = "Учебная игра"
    Команды = [новый ВводКоманды(Наименование = "Команда 1"),
        новый ВводКоманды(Наименование = "Команда 2")]
    СвободныйРынок = Истина
    Seed = 42
;

метод БазовыйПрофиль(Команда: ОбычнаяКоманда)
    попытка
        Сценарий = НачальныеДанные.СоздатьБазовыйПрофиль()
        Сообщение = "Базовый сценарий загружен. Проверьте начальные ресурсы в настройках сценария."
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод Создать(Команда: ОбычнаяКоманда)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        ПроверкиДанных.Требовать(СозданнаяИгра == Неопределено, "Игра уже создана. Продолжите её настройку или создайте другую игру.")
        ПроверкиДанных.Требовать(Сценарий != Неопределено, "Выберите сценарий")
        СохранитьЧерновикКоманды()
        ПроверкиДанных.Требовать(Команды.Размер() >= 2, "Добавьте минимум две команды")
        знч НазванияКоманд: Массив<Строка> = []
        для СтрокаКоманды из Команды
            знч НазваниеКоманды = СтрокаКоманды.Наименование.Сократить()
            ПроверкиДанных.Требовать(НазваниеКоманды != "", "Укажите название каждой команды")
            ПроверкиДанных.Требовать(не НазванияКоманд.Содержит(НазваниеКоманды),
                "Названия команд должны быть уникальными")
            НазванияКоманд.Добавить(НазваниеКоманды)
        ;
        СозданнаяИгра = УправлениеИгрой.СоздатьИгру(Название, Сценарий!,
            НазванияКоманд, Seed, СвободныйРынок, Команды)
        для СтрокаКоманды из Команды
            СтрокаКоманды.ПарольERP = ""
        ;
        Команды = []
        НастраиваемаяКоманда = Неопределено
        ПарольКоманды = ""
        ПрочитатьНастройки()
        Сообщение = "Игра создана. Команд: %{НазванияКоманд.Размер()}. Теперь добавьте игроков и подключите базы ERP для подготовки игры."
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    Занято = Ложь
;

метод ИграИзменена(Источник: ПолеВвода<Игры.Ссылка?>, Событие: СобытиеПриИзменении<Игры.Ссылка?>)
    если СозданнаяИгра == Неопределено
        НоваяИгра(Неопределено)
        возврат
    ;
    ЗагруженнаяИгра = Неопределено
    НастраиваемаяКоманда = Неопределено
    Команды = []
    СписокКоманд = []
    ОчиститьКоманду()
    ОбновитьНастройки(Неопределено)
;

@ВПроекте
метод ОбновитьНастройки(Команда: ОбычнаяКоманда?)
    попытка
        ПрочитатьНастройки()
        Сообщение = "Настройки загружены. Выберите команду для настройки игроков и базы ERP."
    поймать Ошибка: Исключение
        ЗагруженнаяИгра = Неопределено
        СписокКоманд = []
        ОчиститьКоманду()
        Сообщение = Ошибка.Описание
    ;
;

метод ПрочитатьНастройки()
    ПроверкиДанных.Требовать(СозданнаяИгра != Неопределено, "Выберите игру или создайте новую")
    знч ВыбраннаяИгра = СозданнаяИгра!
    знч ПрежняяКоманда = УчастникERP
    ЗагруженнаяИгра = Неопределено
    СписокКоманд = []
    ОчиститьКоманду()
    знч Настройки = УправлениеИгрой.ПолучитьНастройки(ВыбраннаяИгра)
    знч КомандыИгры = ДоступКабинета.КомандыИгры(ВыбраннаяИгра)
    если СозданнаяИгра != ВыбраннаяИгра
        возврат
    ;
    Название = Настройки.Получить("name") как Строка
    Сценарий = Настройки.Получить("scenario") как СценарииИгры.Ссылка?
    Seed = Настройки.Получить("seed") как Число
    СвободныйРынок = Настройки.Получить("market") как Булево
    Версия = Настройки.Получить("version") как Число
    Черновик = Настройки.Получить("draft") как Булево
    СтатусИгры = Настройки.Получить("status") как Строка
    Администратор = Настройки.Получить("admin") как Булево
    СписокКоманд = КомандыИгры
    ЗагруженнаяИгра = ВыбраннаяИгра
    ВыборИгрыСвернут = Ложь
    ПравилаСвернуты = Истина
    ИгрокиСвернуты = Истина
    для СтрокаКоманды из СписокКоманд
        если УчастникERP == Неопределено или СтрокаКоманды.Участник == ПрежняяКоманда
            УчастникERP = СтрокаКоманды.Участник
        ;
    ;
    ЗагрузитьКоманду()
;

метод СохранитьИгру(Команда: ОбычнаяКоманда)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        ТребоватьИгру()
        ПроверкиДанных.Требовать(Сценарий != Неопределено, "Выберите сценарий")
        УправлениеИгрой.СохранитьНастройки(СозданнаяИгра!, Версия, Название, Сценарий!, Seed, СвободныйРынок)
        ПрочитатьНастройки()
        Сообщение = "Настройки игры сохранены."
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    Занято = Ложь
;

метод ВыборКомандИгры(): Массив<ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>>
    знч Результат = новый Массив<ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>>()
    для СтрокаКоманды из СписокКоманд
        Результат.Добавить(новый ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>(
            Значение = СтрокаКоманды.Участник, Представление = СтрокаКоманды.Представление))
    ;
    возврат Результат
;

метод КомандаИзменена(Источник: ПолеВвода<УчастникиИгры.Ссылка?>, Событие: СобытиеПриИзменении<УчастникиИгры.Ссылка?>)
    знч ВыбраннаяКоманда = УчастникERP
    ОчиститьКоманду()
    УчастникERP = ВыбраннаяКоманда
    попытка
        ЗагрузитьКоманду()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод НастроитьКоманду(Команда: КомандаСПараметром<ВводКоманды>, СтрокаКоманды: ВводКоманды)
    если Занято или СозданнаяИгра != Неопределено
        возврат
    ;
    СохранитьЧерновикКоманды()
    ОчиститьКоманду()
    НастраиваемаяКоманда = СтрокаКоманды
    если СтрокаКоманды.АдресERP == "" и СтрокаКоманды.ОрганизацияERP == ""
        и СтрокаКоманды.ЛогинERP == "" и СтрокаКоманды.ПарольERP == ""
        СтрокаКоманды.ПодключениеАктивно = Истина
    ;
    НазваниеКоманды = СтрокаКоманды.Наименование
    АдресКоманды = СтрокаКоманды.АдресERP
    ОрганизацияКоманды = СтрокаКоманды.ОрганизацияERP
    ЛогинКоманды = СтрокаКоманды.ЛогинERP
    ПарольКоманды = СтрокаКоманды.ПарольERP
    ПодключениеАктивно = СтрокаКоманды.ПодключениеАктивно
    ОбновитьИгроковЧерновика()
    Сообщение = "Настройте команду «%{НазваниеКоманды}». Изменения будут записаны при создании игры."
;

метод ЗавершитьНастройкуКоманды(Команда: ОбычнаяКоманда)
    если Занято
        возврат
    ;
    СохранитьЧерновикКоманды()
    НастраиваемаяКоманда = Неопределено
    ОчиститьКоманду()
    Сообщение = "Настройки команды сохранены в форме. Нажмите «Создать игру», чтобы записать игру и команды."
;

метод СохранитьЧерновикКоманды()
    если СозданнаяИгра != Неопределено или НастраиваемаяКоманда == Неопределено
        возврат
    ;
    если не Команды.Содержит(НастраиваемаяКоманда!)
        НастраиваемаяКоманда = Неопределено
        ОчиститьКоманду()
        возврат
    ;
    знч ЧерновикКоманды = НастраиваемаяКоманда!
    ЧерновикКоманды.АдресERP = АдресКоманды.Сократить()
    ЧерновикКоманды.ОрганизацияERP = ОрганизацияКоманды.Сократить()
    ЧерновикКоманды.ЛогинERP = ЛогинКоманды.Сократить()
    ЧерновикКоманды.ПарольERP = ПарольКоманды
    ЧерновикКоманды.ПодключениеАктивно = ПодключениеАктивно
;

метод ОбновитьИгроковЧерновика()
    НастраиваемаяКоманда!.КоличествоИгроков = НастраиваемаяКоманда!.Игроки.Размер()
    пер Текст = ""
    для Игрок из НастраиваемаяКоманда!.Игроки
        Текст = Текст + "%{Игрок.Представление()} · Игрок\n"
    ;
    СписокПользователей = Текст == "" ? "В команде пока нет игроков" : Текст
;

метод ОчиститьКоманду()
    УчастникERP = Неопределено
    ЗагруженнаяКоманда = Неопределено
    ПодключениеERP = Неопределено
    НазваниеКоманды = ""
    НоваяКоманда = ""
    СписокПользователей = ""
    Пользователь = Неопределено
    ЛогинИгрока = ""
    ПарольИгрока = ""
    ВыданныйПароль = ""
    АдресКоманды = ""
    ОрганизацияКоманды = ""
    ЛогинКоманды = ""
    ПарольКоманды = ""
    ПодключениеАктивно = Ложь
    СостояниеПодключения = ""
;

метод ТребоватьИгру()
    ПроверкиДанных.Требовать(СозданнаяИгра != Неопределено и ЗагруженнаяИгра == СозданнаяИгра,
        "Сначала загрузите настройки выбранной игры")
;

метод ТребоватьКоманду()
    ТребоватьИгру()
    ПроверкиДанных.Требовать(УчастникERP != Неопределено и ЗагруженнаяКоманда == УчастникERP,
        "Сначала загрузите выбранную команду")
;

метод ЗагрузитьКоманду()
    ТребоватьИгру()
    если УчастникERP == Неопределено
        возврат
    ;
    знч ВыбраннаяИгра = СозданнаяИгра!
    знч ВыбраннаяКоманда = УчастникERP!
    знч Настройки = НастройкаБазOData.ПодключениеКоманды(ВыбраннаяИгра, ВыбраннаяКоманда)
    пер Игроки = "Управление игроками доступно администратору приложения."
    если Администратор
        Игроки = ДоступКабинета.ПользователиКоманды(ВыбраннаяКоманда)
    ;
    если СозданнаяИгра != ВыбраннаяИгра или УчастникERP != ВыбраннаяКоманда
        возврат
    ;
    для СтрокаКоманды из СписокКоманд
        если СтрокаКоманды.Участник == ВыбраннаяКоманда
            НазваниеКоманды = СтрокаКоманды.Представление
        ;
    ;
    ПодключениеERP = Настройки.Получить("connection") как ПодключенияERP.Ссылка?
    АдресКоманды = Настройки.Получить("address") как Строка
    ОрганизацияКоманды = Настройки.Получить("organization") как Строка
    ЛогинКоманды = Настройки.Получить("login") как Строка
    ПодключениеАктивно = Настройки.Получить("active") как Булево
    СостояниеПодключения = Настройки.Получить("hasPassword") == Истина ? "Пароль ERP сохранён. Пустое поле оставит его без изменения." : "Введите логин и пароль ERP, затем сохраните подключение."
    СписокПользователей = Игроки
    ЗагруженнаяКоманда = ВыбраннаяКоманда
;

метод ДобавитьКоманду(Команда: ОбычнаяКоманда)
    ЗаписатьКоманду(Неопределено, НоваяКоманда)
;

метод ПереименоватьКоманду(Команда: ОбычнаяКоманда)
    попытка
        ТребоватьКоманду()
        ЗаписатьКоманду(УчастникERP, НазваниеКоманды)
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод ЗаписатьКоманду(Участник: УчастникиИгры.Ссылка?, ИмяКоманды: Строка)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        ТребоватьИгру()
        УчастникERP = УправлениеИгрой.СохранитьКоманду(СозданнаяИгра!, Версия, Участник, ИмяКоманды)
        ПрочитатьНастройки()
        Сообщение = "Команда сохранена. Настройте её игроков и подключение ниже."
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    Занято = Ложь
;

метод ДобавитьИгрока(Команда: ОбычнаяКоманда)
    НазначитьИгрока(Истина)
;

метод ОтключитьИгрока(Команда: ОбычнаяКоманда)
    НазначитьИгрока(Ложь)
;

метод НазначитьИгрока(Активно: Булево)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        если СозданнаяИгра == Неопределено
            СохранитьЧерновикКоманды()
            ПроверкиДанных.Требовать(НастраиваемаяКоманда != Неопределено, "Выберите команду в таблице")
            ПроверкиДанных.Требовать(Пользователь != Неопределено, "Выберите пользователя")
            знч Игроки = НастраиваемаяКоманда!.Игроки
            если Активно
                ПроверкиДанных.Требовать(не Игроки.Содержит(Пользователь!), "Этот игрок уже добавлен в команду")
                Игроки.Добавить(Пользователь!)
            иначе
                ПроверкиДанных.Требовать(Игроки.Содержит(Пользователь!), "Этот игрок не добавлен в выбранную команду")
                Игроки.Удалить(Пользователь!)
            ;
            ОбновитьИгроковЧерновика()
            Пользователь = Неопределено
            Сообщение = Активно ? "Игрок добавлен. Доступ будет выдан при создании игры." : "Игрок убран из команды."
        иначе
            ТребоватьКоманду()
            ПроверкиДанных.Требовать(Пользователь != Неопределено, "Выберите пользователя")
            ДоступКабинета.НазначитьВИгре(СозданнаяИгра!, УчастникERP!, Пользователь!, Активно)
            СписокПользователей = ДоступКабинета.ПользователиКоманды(УчастникERP!)
            Сообщение = Активно ? "Игрок добавлен в команду." : "Игрок отключён от команды."
        ;
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    Занято = Ложь
;

метод СоздатьИгрока(Команда: ОбычнаяКоманда)
    если Занято
        возврат
    ;
    Занято = Истина
    ВыданныйПароль = ""
    попытка
        ТребоватьКоманду()
        ПроверкиДанных.Требовать(ЛогинИгрока.Сократить() != "", "Укажите логин нового игрока")
        если ПарольИгрока == ""
            ПарольИгрока = "G!" + новый Ууид().ВСтроку()
        ;
        знч ПарольСоздания = ПарольИгрока
        Пользователь = ДоступКабинета.СоздатьПользователяКоманды(УчастникERP!, ЛогинИгрока, ПарольИгрока)
        ВыданныйПароль = ПарольСоздания
        ПарольИгрока = ""
        ЛогинИгрока = ""
        СписокПользователей = ДоступКабинета.ПользователиКоманды(УчастникERP!)
        Сообщение = "Игрок создан и добавлен в команду. Сохраните временный пароль для первого входа."
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    ПарольИгрока = ""
    Занято = Ложь
;

метод СохранитьБазу(Команда: ОбычнаяКоманда)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        если СозданнаяИгра == Неопределено
            СохранитьЧерновикКоманды()
            ПроверкиДанных.Требовать(НастраиваемаяКоманда != Неопределено, "Выберите команду в таблице")
            Сообщение = "Настройки базы команды сохранены в форме и будут записаны при создании игры."
        иначе
            ТребоватьКоманду()
            НастройкаБазOData.СохранитьПодключениеКоманды(СозданнаяИгра!, УчастникERP!,
                АдресКоманды, ОрганизацияКоманды, ЛогинКоманды, ПарольКоманды, ПодключениеАктивно)
            ПарольКоманды = ""
            ЗагрузитьКоманду()
            Сообщение = "База ERP команды сохранена."
        ;
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    если СозданнаяИгра != Неопределено
        ПарольКоманды = ""
    ;
    Занято = Ложь
;

метод ПодготовкаБазы(Команда: ОбычнаяКоманда)
    попытка
        ТребоватьКоманду()
        ПроверкиДанных.Требовать(ПодключениеERP != Неопределено, "Сначала сохраните подключение ERP команды")
        знч Окно = новый НастройкаИнформационныхБаз()
        Окно.Подключение = ПодключениеERP
        Окно.КомандаERP = УчастникERP
        Окно.ОрганизацияИмя = ОрганизацияКоманды
        Окно.Логин = ЛогинКоманды
        Окно.ОткрытьВМодальномОкне()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод РасширенныеНастройки(Команда: ОбычнаяКоманда)
    попытка
        ТребоватьИгру()
        знч Окно = новый НазначенияИгры()
        Окно.Игра = СозданнаяИгра
        Окно.УчастникERP = УчастникERP
        Окно.ОткрытьВМодальномОкне()
        ОбновитьНастройки(Неопределено)
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод ОткрытьПульт(Команда: ОбычнаяКоманда)
    попытка
        ТребоватьИгру()
        знч Окно = новый ПультВедущего()
        Окно.Игра = СозданнаяИгра
        Окно.Открыть()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;
