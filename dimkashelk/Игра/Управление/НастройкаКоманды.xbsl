импорт Данные
импорт Обмен

@ВПроекте
метод Инициализировать(ЧерновикКоманды: ВводКоманды?, Игра: Игры.Ссылка?, Участник: УчастникиИгры.Ссылка?, ИмяКоманды: Строка, ЭтоАдминистратор: Булево)
    НастраиваемаяКоманда = ЧерновикКоманды
    СозданнаяИгра = Игра
    ЗагруженнаяИгра = Игра
    УчастникERP = Участник
    НазваниеКоманды = ИмяКоманды
    Администратор = ЭтоАдминистратор
    ИгрокиСвернуты = Игра != Неопределено
    если ЧерновикКоманды != Неопределено
        знч Черновик = ЧерновикКоманды!
        если Черновик.АдресERP == "" и Черновик.ОрганизацияERP == ""
            и Черновик.ЛогинERP == "" и Черновик.ПарольERP == ""
            Черновик.ПодключениеАктивно = Истина
        ;
        АдресКоманды = Черновик.АдресERP
        ОрганизацияКоманды = Черновик.ОрганизацияERP
        ЛогинКоманды = Черновик.ЛогинERP
        ПарольКоманды = Черновик.ПарольERP
        ПодключениеАктивно = Черновик.ПодключениеАктивно
        ОбновитьИгроковЧерновика()
    иначе
        ЗагрузитьКоманду()
    ;
;

метод Готово(Команда: ОбычнаяКоманда)
    если Занято
        возврат
    ;
    СохранитьЧерновикКоманды()
    Закрыть()
;

@ВПроекте
метод СохранитьЧерновикКоманды()
    если НастраиваемаяКоманда == Неопределено
        возврат
    ;
    знч ЧерновикКоманды = НастраиваемаяКоманда!
    ЧерновикКоманды.АдресERP = АдресКоманды.Сократить()
    ЧерновикКоманды.ОрганизацияERP = ОрганизацияКоманды.Сократить()
    ЧерновикКоманды.ЛогинERP = ЛогинКоманды.Сократить()
    ЧерновикКоманды.ПарольERP = ПарольКоманды
    ЧерновикКоманды.ПодключениеАктивно = ПодключениеАктивно
;

метод ОбновитьИгроковЧерновика()
    НастраиваемаяКоманда!.КоличествоИгроков = НастраиваемаяКоманда!.Игроки.Размер()
    пер Текст = ""
    для Игрок из НастраиваемаяКоманда!.Игроки
        Текст = Текст + "%{Игрок.Представление()} · Игрок\n"
    ;
    СписокПользователей = Текст == "" ? "В команде пока нет игроков" : Текст
;

метод ТребоватьИгру()
    ПроверкиДанных.Требовать(СозданнаяИгра != Неопределено и ЗагруженнаяИгра == СозданнаяИгра,
        "Сначала загрузите настройки выбранной игры")
;

метод ТребоватьКоманду()
    ТребоватьИгру()
    ПроверкиДанных.Требовать(УчастникERP != Неопределено и ЗагруженнаяКоманда == УчастникERP,
        "Сначала загрузите выбранную команду")
;

метод ЗагрузитьКоманду()
    ТребоватьИгру()
    если УчастникERP == Неопределено
        возврат
    ;
    знч ВыбраннаяИгра = СозданнаяИгра!
    знч ВыбраннаяКоманда = УчастникERP!
    знч Настройки = НастройкаБазOData.ПодключениеКоманды(ВыбраннаяИгра, ВыбраннаяКоманда)
    пер Игроки = "Управление игроками доступно администратору приложения."
    если Администратор
        Игроки = ДоступКабинета.ПользователиКоманды(ВыбраннаяКоманда)
    ;
    если СозданнаяИгра != ВыбраннаяИгра или УчастникERP != ВыбраннаяКоманда
        возврат
    ;
    ПодключениеERP = Настройки.Получить("connection") как ПодключенияERP.Ссылка?
    АдресКоманды = Настройки.Получить("address") как Строка
    ОрганизацияКоманды = Настройки.Получить("organization") как Строка
    ЛогинКоманды = Настройки.Получить("login") как Строка
    ПодключениеАктивно = Настройки.Получить("active") как Булево
    СостояниеПодключения = Настройки.Получить("hasPassword") == Истина ? "Пароль ERP сохранён. Пустое поле оставит его без изменения." : "Введите логин и пароль ERP, затем сохраните подключение."
    СписокПользователей = Игроки
    ЗагруженнаяКоманда = ВыбраннаяКоманда
;

метод ДобавитьИгрока(Команда: ОбычнаяКоманда)
    НазначитьИгрока(Истина)
;

метод ОтключитьИгрока(Команда: ОбычнаяКоманда)
    НазначитьИгрока(Ложь)
;

метод НазначитьИгрока(Активно: Булево)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        если СозданнаяИгра == Неопределено
            СохранитьЧерновикКоманды()
            ПроверкиДанных.Требовать(НастраиваемаяКоманда != Неопределено, "Выберите команду в таблице")
            ПроверкиДанных.Требовать(Пользователь != Неопределено, "Выберите пользователя")
            знч Игроки = НастраиваемаяКоманда!.Игроки
            если Активно
                ПроверкиДанных.Требовать(не Игроки.Содержит(Пользователь!), "Этот игрок уже добавлен в команду")
                Игроки.Добавить(Пользователь!)
            иначе
                ПроверкиДанных.Требовать(Игроки.Содержит(Пользователь!), "Этот игрок не добавлен в выбранную команду")
                Игроки.Удалить(Пользователь!)
            ;
            ОбновитьИгроковЧерновика()
            Пользователь = Неопределено
            Сообщение = Активно ? "Игрок добавлен. Доступ будет выдан при создании игры." : "Игрок убран из команды."
        иначе
            ТребоватьКоманду()
            ПроверкиДанных.Требовать(Пользователь != Неопределено, "Выберите пользователя")
            ДоступКабинета.НазначитьВИгре(СозданнаяИгра!, УчастникERP!, Пользователь!, Активно)
            СписокПользователей = ДоступКабинета.ПользователиКоманды(УчастникERP!)
            Сообщение = Активно ? "Игрок добавлен в команду." : "Игрок отключён от команды."
        ;
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    Занято = Ложь
;

метод СоздатьИгрока(Команда: ОбычнаяКоманда)
    если Занято
        возврат
    ;
    Занято = Истина
    ВыданныйПароль = ""
    попытка
        ТребоватьКоманду()
        ПроверкиДанных.Требовать(ЛогинИгрока.Сократить() != "", "Укажите логин нового игрока")
        если ПарольИгрока == ""
            ПарольИгрока = "G!" + новый Ууид().ВСтроку()
        ;
        знч ПарольСоздания = ПарольИгрока
        Пользователь = ДоступКабинета.СоздатьПользователяКоманды(УчастникERP!, ЛогинИгрока, ПарольИгрока)
        ВыданныйПароль = ПарольСоздания
        ПарольИгрока = ""
        ЛогинИгрока = ""
        СписокПользователей = ДоступКабинета.ПользователиКоманды(УчастникERP!)
        Сообщение = "Игрок создан и добавлен в команду. Сохраните временный пароль для первого входа."
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    ПарольИгрока = ""
    Занято = Ложь
;

метод СохранитьБазу(Команда: ОбычнаяКоманда)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        если СозданнаяИгра == Неопределено
            СохранитьЧерновикКоманды()
            ПроверкиДанных.Требовать(НастраиваемаяКоманда != Неопределено, "Выберите команду в таблице")
            Сообщение = "Настройки базы команды сохранены в форме и будут записаны при создании игры."
        иначе
            ТребоватьКоманду()
            НастройкаБазOData.СохранитьПодключениеКоманды(СозданнаяИгра!, УчастникERP!,
                АдресКоманды, ОрганизацияКоманды, ЛогинКоманды, ПарольКоманды, ПодключениеАктивно)
            ПарольКоманды = ""
            ЗагрузитьКоманду()
            Сообщение = "База ERP команды сохранена."
        ;
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    если СозданнаяИгра != Неопределено
        ПарольКоманды = ""
    ;
    Занято = Ложь
;

метод ПодготовкаБазы(Команда: ОбычнаяКоманда)
    попытка
        ТребоватьКоманду()
        ПроверкиДанных.Требовать(ПодключениеERP != Неопределено, "Сначала сохраните подключение ERP команды")
        знч Окно = новый НастройкаИнформационныхБаз()
        Окно.Подключение = ПодключениеERP
        Окно.КомандаERP = УчастникERP
        Окно.ОрганизацияИмя = ОрганизацияКоманды
        Окно.Логин = ЛогинКоманды
        Окно.ОткрытьВМодальномОкне()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;
