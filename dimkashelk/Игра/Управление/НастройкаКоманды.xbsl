импорт Данные
импорт Обмен

@ВПроекте
метод Инициализировать(ЧерновикКоманды: ВводКоманды?, Игра: Игры.Ссылка?, Участник: УчастникиИгры.Ссылка?, ИмяКоманды: Строка, ЭтоАдминистратор: Булево)
    НастраиваемаяКоманда = ЧерновикКоманды
    СозданнаяИгра = Игра
    ЗагруженнаяИгра = Игра
    УчастникERP = Участник
    НазваниеКоманды = ИмяКоманды
    Администратор = ЭтоАдминистратор
    Игроки = []
    Организации = []
    ПодключениеАктивно = Истина
    РедактироватьНазвание = Администратор
    если ЧерновикКоманды != Неопределено
        знч Черновик = ЧерновикКоманды!
        АдресКоманды = Черновик.АдресERP
        ОрганизацияКоманды = Черновик.ОрганизацияERP
        ЛогинКоманды = Черновик.ЛогинERP
        ПарольКоманды = Черновик.ПарольERP
        ПодключениеАктивно = Черновик.АдресERP == "" ? Истина : Черновик.ПодключениеАктивно
        для Пользователь из Черновик.Игроки
            Игроки.Добавить(новый СтрокаИгрокаКоманды(Пользователь = Пользователь))
        ;
        ИсходныйАдресБазы = АдресКоманды
        ИсходныйЛогинБазы = ЛогинКоманды
        ИсходнаяОрганизация = ОрганизацияКоманды
    иначе если Участник != Неопределено
        ЗагрузитьКоманду()
    ;
    если Игра != Неопределено
        знч Настройки = УправлениеИгрой.ПолучитьНастройки(Игра!)
        Версия = Настройки.Получить("version") как Число
        РедактироватьНазвание = Администратор и Настройки.Получить("draft") == Истина
    ;
    // Сохранённый выбор доступен сразу, даже когда ERP временно недоступна.
    если ОрганизацияКоманды != ""
        Организации.Добавить(ОрганизацияКоманды)
    ;
;

метод Готово(Команда: ОбычнаяКоманда)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        ПроверитьБазу()
        ПроверкиДанных.Требовать(НазваниеКоманды.Сократить() != "" и НазваниеКоманды.Сократить().Длина() <= 200, "Укажите название команды длиной до 200 символов")
        если СозданнаяИгра == Неопределено
            СохранитьЧерновикКоманды()
        иначе
            ПроверкиДанных.Требовать(СозданнаяИгра == ЗагруженнаяИгра, "Сначала загрузите выбранную игру")
            знч Пользователи = Администратор ? ПользователиИзТаблицы() : Неопределено
            УправлениеИгрой.СохранитьКарточкуКоманды(СозданнаяИгра!, Версия, УчастникERP, НазваниеКоманды,
                Пользователи, АдресКоманды, ОрганизацияКоманды, ЛогинКоманды, ПарольКоманды, ПодключениеАктивно)
            ПарольКоманды = ""
        ;
        Закрыть(Истина)
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
    Занято = Ложь
;

метод ПользователиИзТаблицы(): Массив<Пользователи.Ссылка>
    знч Результат = <Пользователи.Ссылка>[]
    для СтрокаИгрока из Игроки
        ПроверкиДанных.Требовать(СтрокаИгрока.Пользователь != Неопределено, "Выберите игрока в каждой строке таблицы или удалите пустую строку")
        знч Пользователь = СтрокаИгрока.Пользователь!
        ПроверкиДанных.Требовать(не Результат.Содержит(Пользователь), "Один игрок не может занимать две строки команды")
        Результат.Добавить(Пользователь)
    ;
    возврат Результат
;

метод ЕстьНастройкиБазы(): Булево
    возврат АдресКоманды.Сократить() != "" или ОрганизацияКоманды != ""
        или ЛогинКоманды.Сократить() != "" или ПарольКоманды != ""
;

метод ПроверитьБазу()
    если не ЕстьНастройкиБазы()
        возврат
    ;
    ПроверкиДанных.Требовать(АдресКоманды.Сократить() != "" и ЛогинКоманды.Сократить() != "", "Укажите адрес публикации ERP и логин")
    // Неизменное сохранённое подключение допускает настройку игроков при недоступной ERP.
    знч ПарольНеИзменен = НастраиваемаяКоманда == Неопределено
        ? ПарольКоманды == "" : ПарольКоманды == НастраиваемаяКоманда!.ПарольERP
    если (ПодключениеERP != Неопределено или НастраиваемаяКоманда != Неопределено)
        и АдресКоманды == ИсходныйАдресБазы
        и ЛогинКоманды == ИсходныйЛогинБазы и ПарольНеИзменен
        и ОрганизацияКоманды == ИсходнаяОрганизация
        возврат
    ;
    ПроверкиДанных.Требовать(ОрганизацииПроверены и ОрганизацияКоманды != "" и Организации.Содержит(ОрганизацияКоманды),
        "Загрузите организации базы ERP и выберите организацию из списка")
;

метод СохранитьЧерновикКоманды()
    ПроверкиДанных.Требовать(НастраиваемаяКоманда != Неопределено, "Выберите команду в таблице")
    знч Пользователи = ПользователиИзТаблицы()
    знч ЧерновикКоманды = НастраиваемаяКоманда!
    ЧерновикКоманды.Наименование = НазваниеКоманды.Сократить()
    ЧерновикКоманды.Игроки = Пользователи
    ЧерновикКоманды.КоличествоИгроков = Пользователи.Размер()
    ЧерновикКоманды.АдресERP = АдресКоманды.Сократить()
    ЧерновикКоманды.ОрганизацияERP = ОрганизацияКоманды
    ЧерновикКоманды.ЛогинERP = ЛогинКоманды.Сократить()
    ЧерновикКоманды.ПарольERP = ПарольКоманды
    ЧерновикКоманды.ПодключениеАктивно = ПодключениеАктивно
;

метод ТребоватьКоманду()
    ПроверкиДанных.Требовать(СозданнаяИгра != Неопределено и ЗагруженнаяИгра == СозданнаяИгра
        и УчастникERP != Неопределено и ЗагруженнаяКоманда == УчастникERP, "Сначала загрузите выбранную команду игры")
;

метод ЗагрузитьКоманду()
    ПроверкиДанных.Требовать(СозданнаяИгра != Неопределено и УчастникERP != Неопределено, "Выберите команду игры")
    знч Настройки = НастройкаБазOData.ПодключениеКоманды(СозданнаяИгра!, УчастникERP!)
    ПодключениеERP = Настройки.Получить("connection") как ПодключенияERP.Ссылка?
    АдресКоманды = Настройки.Получить("address") как Строка
    ОрганизацияКоманды = Настройки.Получить("organization") как Строка
    ЛогинКоманды = Настройки.Получить("login") как Строка
    ПодключениеАктивно = Настройки.Получить("active") как Булево
    СостояниеПодключения = Настройки.Получить("hasPassword") == Истина
        ? "Пароль ERP сохранён. Пустое поле оставит его без изменения." : "Введите адрес публикации, логин и пароль ERP."
    если Администратор
        для Пользователь из ДоступКабинета.АктивныеИгрокиКоманды(СозданнаяИгра!, УчастникERP!)
            Игроки.Добавить(новый СтрокаИгрокаКоманды(Пользователь = Пользователь))
        ;
    ;
    ИсходныйАдресБазы = АдресКоманды
    ИсходныйЛогинБазы = ЛогинКоманды
    ИсходнаяОрганизация = ОрганизацияКоманды
    ЗагруженнаяКоманда = УчастникERP
;

метод РеквизитыБазыИзменены(Источник: ПолеВвода<Строка>, Событие: СобытиеПриИзменении<Строка>)
    ОрганизацииПроверены = Ложь
    Организации = []
    // Только смена базы отменяет выбор организации. Смена учётных данных — нет.
    если Источник == Компоненты.АдресКоманды
        ОрганизацияКоманды = ""
    иначе если ОрганизацияКоманды != ""
        Организации.Добавить(ОрганизацияКоманды)
    ;
    СостояниеПодключения = "Введите логин и пароль, затем загрузите организации базы ERP."
;

метод ПарольКомандыИзменен(Источник: ПолеВвода<Строка>, Событие: СобытиеПриИзменении<Строка>)
    ОрганизацииПроверены = Ложь
    Организации = []
    если ОрганизацияКоманды != ""
        Организации.Добавить(ОрганизацияКоманды)
    ;
    если АдресКоманды.Сократить() != "" и ЛогинКоманды.Сократить() != ""
        ЗагрузитьОрганизации(Неопределено)
    ;
;

метод ЗагрузитьОрганизации(Команда: ОбычнаяКоманда?)
    если Занято
        возврат
    ;
    Занято = Истина
    ОрганизацииПроверены = Ложь
    попытка
        знч Доступные = НастройкаБазOData.ОрганизацииБазы(УчастникERP == Неопределено ? Неопределено : СозданнаяИгра, УчастникERP,
            АдресКоманды, ЛогинКоманды, ПарольКоманды)
        Организации = Доступные
        ОрганизацииПроверены = Истина
        если ОрганизацияКоманды == ""
            ОрганизацияКоманды = Организации.Размер() == 1 ? Организации[0] : ""
        иначе если не Организации.Содержит(ОрганизацияКоманды)
            СостояниеПодключения = "Выбранная организация недоступна в ERP. Проверьте права пользователя или выберите другую."
            // Сохраняем название для отображения, но ПроверитьБазу не разрешит новую запись без проверки.
            возврат
        ;
        СостояниеПодключения = Организации.Пусто() ? "В базе ERP нет доступных организаций."
            : (ОрганизацияКоманды == "" ? "Выберите организацию базы ERP." : "Организация ERP выбрана.")
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    вконце
        Занято = Ложь
    ;
;

метод ВыборОрганизаций(): Массив<ЭлементСпискаЗначений<Строка>>
    знч Выбор = Организации.Преобразовать(Имя -> новый ЭлементСпискаЗначений<Строка>(Значение = Имя, Представление = Имя))
    если ОрганизацияКоманды != "" и не Организации.Содержит(ОрганизацияКоманды)
        Выбор.Добавить(новый ЭлементСпискаЗначений<Строка>(Значение = ОрганизацияКоманды, Представление = ОрганизацияКоманды))
    ;
    возврат Выбор
;

метод ПодготовкаБазы(Команда: ОбычнаяКоманда)
    попытка
        ТребоватьКоманду()
        ПроверкиДанных.Требовать(ПодключениеERP != Неопределено, "Сначала сохраните подключение ERP кнопкой «Готово»")
        ПроверкиДанных.Требовать(АдресКоманды == ИсходныйАдресБазы
            и ЛогинКоманды == ИсходныйЛогинБазы и ОрганизацияКоманды == ИсходнаяОрганизация
            и ПарольКоманды == "", "Сначала сохраните изменённые параметры ERP кнопкой «Готово»")
        знч Окно = новый НастройкаИнформационныхБаз()
        Окно.Подключение = ПодключениеERP
        Окно.КомандаERP = УчастникERP
        Окно.ОрганизацияИмя = ОрганизацияКоманды
        Окно.ДатаНастройки = УправлениеИгрой.ПолучитьНастройки(СозданнаяИгра!).Получить("setupDate") как Строка
        ПроверкиДанных.Требовать(Окно.ДатаНастройки != "", "Сначала сохраните игру, чтобы сформировать профиль её сценария")
        Окно.Логин = ЛогинКоманды
        Окно.ОткрытьВМодальномОкне()
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;

метод СоздатьИгрока(Команда: ОбычнаяКоманда)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        ТребоватьКоманду()
        знч Окно = новый СозданиеПользователяКоманды()
        Окно.Участник = УчастникERP
        знч Пользователь = Окно.ОткрытьВМодальномОкне()
        если Пользователь != Неопределено
            Игроки.Добавить(новый СтрокаИгрокаКоманды(Пользователь = Пользователь!))
            Сообщение = "Пользователь создан и добавлен в команду."
            Сообщить(Сообщение)
        ;
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
    Занято = Ложь
;
