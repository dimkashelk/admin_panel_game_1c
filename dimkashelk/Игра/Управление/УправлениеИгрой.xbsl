импорт Данные
импорт Рынок
импорт Аналитика

@НаСервере @ДоступноСКлиента @ВПроекте
метод СоздатьИгру(Название: Строка, Сценарий: СценарииИгры.Ссылка,
    Команды: ЧитаемыйМассив<Строка>, Seed: Число, Демонстрационная: Булево): Игры.Ссылка
    знч Пользователь = ДоступИгры.ТекущийПользователь()
    ДоступИгры.ТребоватьАдминистратора()
    ПроверкиДанных.Требовать(Название != "" && Команды.Размер() >= 2, "Укажите название и минимум две команды")
    ПроверкиДанных.ЦелоеНеотрицательное(Seed, "Seed")
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Игра = новый Игры.Объект()
    Игра.Наименование = Название
    Игра.Сценарий = Сценарий
    Игра.Ведущий = Пользователь
    Игра.Seed = Seed
    Игра.Демонстрационная = Демонстрационная
    Игра.Записать()
    пер Порядок = 0
    для Команда из Команды
        Порядок = Порядок + 1
        знч Участник = новый УчастникиИгры.Объект()
        Участник.Игра = Игра.Ссылка
        Участник.Наименование = Команда
        Участник.НаименованиеКоманды = Команда
        Участник.ПорядокУчастника = Порядок
        Участник.Активен = Истина
        Участник.Записать()
    ;
    ДоступИгры.ПересчитатьЧтение()
    возврат Игра.Ссылка
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод Подготовить(Ссылка: Игры.Ссылка, Версия: Число)
    ДоступИгры.ПроверитьВедущего(Ссылка)
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Игра = Заблокировать(Ссылка, Версия)
    ПроверкиДанных.Требовать(Игра.Статус == СостоянияИгры.Черновик, "Игра уже подготовлена")
    ПроверкиДанных.Требовать(Игра.Сценарий != Неопределено, "Не выбран сценарий")
    знч Сценарий = Игра.Сценарий!.ЗагрузитьОбъект(Истина)!
    Сценарий.ПроверитьНастройки()
    СкопироватьНастройки(Сценарий, Игра)
    Игра.ВерсияАлгоритма = РасчетРынка.Версия()
    Игра.ПроверитьНастройки()
    ПроверкиДанных.Требовать(ПолучитьУчастников(Ссылка).Размер() >= 2, "Нужны минимум две активные команды")
    Игра.Статус = СостоянияИгры.Подготовка
    Игра.ВерсияСостояния = Версия + 1
    Игра.Записать()
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод Начать(Ссылка: Игры.Ссылка, Версия: Число)
    ДоступИгры.ПроверитьВедущего(Ссылка)
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Игра = Заблокировать(Ссылка, Версия)
    ПроверкиДанных.Требовать(Игра.Статус == СостоянияИгры.Подготовка, "Сначала подготовьте игру")
    ТребоватьДемонстрацию(Игра)
    Игра.Статус = СостоянияИгры.Идет
    СоздатьРаунд(Игра, 0)
    ОткрытьФазу(Игра, ФазыИгры.СтартоваяПродажа)
    СохранитьПереход(Игра, Версия, "НачалоИгры", "Демонстрационная игра на тестовых данных")
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод Пауза(Ссылка: Игры.Ссылка, Версия: Число, Причина: Строка)
    ДоступИгры.ПроверитьВедущего(Ссылка)
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Игра = Заблокировать(Ссылка, Версия)
    ПроверкиДанных.Требовать(Игра.Статус == СостоянияИгры.Идет && Причина != "", "Укажите причину паузы и проверьте состояние игры")
    Игра.ОстатокВремениПаузы = ОставшеесяВремя(Игра)
    Игра.Дедлайн = Неопределено
    Игра.Статус = СостоянияИгры.Пауза
    // A pause preserves the phase token: accepted evidence remains attached to this phase.
    СохранитьПереход(Игра, Версия, "Пауза", Причина)
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод Возобновить(Ссылка: Игры.Ссылка, Версия: Число)
    ДоступИгры.ПроверитьВедущего(Ссылка)
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Игра = Заблокировать(Ссылка, Версия)
    ПроверкиДанных.Требовать(Игра.Статус == СостоянияИгры.Пауза, "Игра не на паузе")
    Игра.Статус = СостоянияИгры.Идет
    если Игра.ОстатокВремениПаузы > 0
        Игра.Дедлайн = Момент.Сейчас() + 1с * Игра.ОстатокВремениПаузы
    иначе если ДлительностьФазы(Игра) > 0
        Игра.Дедлайн = Момент.Сейчас()
    иначе
        Игра.Дедлайн = Неопределено
    ;
    СохранитьПереход(Игра, Версия, "Возобновление", "")
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод Отменить(Ссылка: Игры.Ссылка, Версия: Число, Причина: Строка)
    ДоступИгры.ПроверитьВедущего(Ссылка)
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Игра = Заблокировать(Ссылка, Версия)
    ПроверкиДанных.Требовать(Игра.Статус != СостоянияИгры.Завершена
        && Игра.Статус != СостоянияИгры.Отменена && Причина != "", "Нельзя отменить игру без причины или после завершения")
    Игра.Статус = СостоянияИгры.Отменена
    Игра.Дедлайн = Неопределено
    Игра.ТокенФазы = новый Ууид().ВСтроку()
    Игра.ВерсияСостояния = Версия + 1
    Игра.Записать()
    если Игра.ТекущийРаунд != Неопределено
        ЗаписатьСобытие(Игра, Версия, "ОтменаИгры", Причина)
    ;
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод ПринятьТестовыйСнимок(Ссылка: Игры.Ссылка, Версия: Число, Токен: Строка,
    Участник: УчастникиИгры.Ссылка, Предложения: ЧитаемыйМассив<ВводПредложения>): СнимкиERP.Ссылка
    ДоступИгры.ПроверитьВедущего(Ссылка)
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Игра = Заблокировать(Ссылка, Версия)
    ТребоватьДемонстрацию(Игра)
    ПроверкиДанных.Требовать(Игра.Статус == СостоянияИгры.Идет
        && Игра.СостояниеФазы == СостоянияФазы.Открыта && Игра.ТокенФазы == Токен,
        "Фаза закрыта, игра приостановлена или токен устарел")
    ПроверкиДанных.Требовать(Игра.Дедлайн == Неопределено || Момент.Сейчас() <= Игра.Дедлайн!,
        "Время фазы истекло")
    ПроверкиДанных.Требовать(Игра.Фаза != ФазыИгры.Анализ, "В анализе нужен итоговый финансовый снимок")
    знч Команда = Участник.ЗагрузитьОбъект()!
    ПроверкиДанных.Требовать(Команда.Игра == Ссылка && Команда.Активен, "Команда не участвует в этой игре")
    ПроверкиДанных.Требовать(Предложения.Размер() == Игра.ПараметрыРынка.Размер(), "Нужны предложения по всем продуктам")
    знч Снимок = новый СнимкиERP.Объект()
    Снимок.Дата = ДатаВремя.Сейчас()
    Снимок.Игра = Ссылка
    Снимок.Участник = Участник
    Снимок.Раунд = Игра.ТекущийРаунд
    Снимок.ТокенФазы = Токен
    Снимок.ИдСообщения = новый Ууид().ВСтроку()
    Снимок.ВерсияИсточника = Игра.Фаза == ФазыИгры.Планирование ? "demo-planning-v1" : "demo-v1"
    Снимок.ВремяДанных = Момент.Сейчас()
    Снимок.ВремяПриема = Снимок.ВремяДанных
    Снимок.ТестовыеДанные = Истина
    пер Вход = "demo-snapshot:%{Ссылка}:%{Токен}:%{Участник}"
    знч Упорядоченные = Предложения.Сортировать((Левый, Правый) -> Левый.Продукт!.Ид.ВСтроку().Сравнить(Правый.Продукт!.Ид.ВСтроку()))
    знч Продукты = <НоменклатураИгры.Ссылка>[]
    для Предложение из Упорядоченные
        ПроверкиДанных.Требовать(Предложение.Продукт != Неопределено && !Продукты.Содержит(Предложение.Продукт!),
            "Продукт пропущен или указан дважды")
        Продукты.Добавить(Предложение.Продукт!)
        знч Параметры = ПараметрыДляПродукта(Игра, Предложение.Продукт!)
        ПроверкиДанных.ПроверитьПредложение(новый ПредложениеРынка(Участник = Участник.ВСтроку(),
            Цена = Предложение.Цена, Доступно = Предложение.Доступно, Активен = Истина), Параметры)
        если Игра.Фаза == ФазыИгры.Продажи && Игра.ФиксацияЦен == МоментыФиксацииЦен.ПослеПланирования
            ПроверитьЗафиксированнуюЦену(Игра, Участник, Предложение)
        ;
        Вход = Вход + ":%{Предложение.Продукт!.Ид}:%{Предложение.Цена}:%{Предложение.Доступно}"
        Снимок.Предложения.Добавить(новый СнимкиERP.Предложения(Продукт = Предложение.Продукт,
            Цена = Предложение.Цена, ДоступноКПродаже = Предложение.Доступно, Единица = "шт"))
    ;
    Снимок.ИдСообщения = Ууид.Версия5(Вход).ВСтроку()
    знч Повтор = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ СнимкиERP ГДЕ Игра == %Ссылка И ИдСообщения == %Снимок.ИдСообщения
    }.Выполнить().ПервыйИлиНеопределено()
    если Повтор != Неопределено
        возврат Повтор.Ссылка
    ;
    Снимок.Записать()
    знч Готовность = новый СостоянияУчастников.НаборЗаписей()
    Готовность.Фильтр.Установить(Участник = Участник, Раунд = Игра.ТекущийРаунд, ТокенФазы = Токен)
    Готовность.ДобавитьЗапись(Участник = Участник, Раунд = Игра.ТекущийРаунд,
        ТокенФазы = Токен, Готов = Истина, ПоследнийСнимок = Снимок.Ссылка,
        ВремяСвязи = Снимок.ВремяПриема, Версия = Версия)
    Готовность.Записать()
    возврат Снимок.Ссылка
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод СледующаяФаза(Ссылка: Игры.Ссылка, Версия: Число)
    ДоступИгры.ПроверитьВедущего(Ссылка)
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Игра = Заблокировать(Ссылка, Версия)
    ТребоватьДемонстрацию(Игра)
    ПроверкиДанных.Требовать(Игра.Статус == СостоянияИгры.Идет && Игра.СостояниеФазы == СостоянияФазы.Открыта,
        "Фаза не открыта")
    ПроверитьГотовность(Игра)
    если Игра.Фаза == ФазыИгры.Продажи || Игра.Фаза == ФазыИгры.СтартоваяПродажа
        СохранитьРасчет(Игра)
        ОткрытьФазу(Игра, ФазыИгры.Анализ)
    иначе если Игра.Фаза == ФазыИгры.Анализ
        РезультатыИгры.ПроверитьЗакрытиеРаунда(Игра.ТекущийРаунд!)
        знч Раунд = Игра.ТекущийРаунд!.ЗагрузитьОбъект(Истина)!
        Раунд.ВремяЗакрытия = Момент.Сейчас()
        Раунд.Состояние = СостоянияФазы.Закрыта
        Раунд.Записать()
        если Раунд.НомерРаунда == Игра.ЧислоРаундов
            Игра.Статус = СостоянияИгры.Завершена
            Игра.СостояниеФазы = СостоянияФазы.Закрыта
            Игра.Дедлайн = Неопределено
            Игра.ТокенФазы = новый Ууид().ВСтроку()
        иначе
            СоздатьРаунд(Игра, Раунд.НомерРаунда + 1)
            ОткрытьФазу(Игра, ФазыИгры.Планирование)
        ;
    иначе если Игра.Фаза == ФазыИгры.Планирование
        ОткрытьФазу(Игра, ФазыИгры.Закупки)
    иначе если Игра.Фаза == ФазыИгры.Закупки
        ОткрытьФазу(Игра, ФазыИгры.Производство)
    иначе если Игра.Фаза == ФазыИгры.Производство
        ОткрытьФазу(Игра, ФазыИгры.Продажи)
    иначе
        выбросить новый ИсключениеНедопустимоеСостояние("Нет следующей фазы")
    ;
    СохранитьПереход(Игра, Версия, "ПереходФазы", "")
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод ПолучитьПульт(Ссылка: Игры.Ссылка): СостояниеПульта
    ДоступИгры.ПроверитьВедущего(Ссылка)
    исп КонтекстДоступа.Привилегированный()
    знч Игра = Ссылка.ЗагрузитьОбъект()!
    знч Строки = <СтрокаГотовности>[]
    для Участник из ПолучитьУчастников(Ссылка)
        знч Готовность = Запрос{
            ВЫБРАТЬ Готов, ПоследнийСнимок, ВремяСвязи, Ошибка ИЗ СостоянияУчастников
            ГДЕ Участник == %Участник И Раунд == %Игра.ТекущийРаунд И ТокенФазы == %Игра.ТокенФазы
        }.Выполнить().ПервыйИлиНеопределено()
        Строки.Добавить(новый СтрокаГотовности(Участник = Участник,
            Команда = Участник.ЗагрузитьОбъект()!.НаименованиеКоманды,
            Готов = Готовность?.Готов ?? Ложь, Снимок = Готовность?.ПоследнийСнимок,
            Время = Готовность?.ВремяСвязи, Причина = Готовность?.Ошибка ?? "Снимок текущей фазы не принят"))
    ;
    возврат новый СостояниеПульта(Игра = Ссылка, Наименование = Игра.Наименование,
        Статус = Игра.Статус, Фаза = Игра.Фаза, СостояниеФазы = Игра.СостояниеФазы,
        Версия = Игра.ВерсияСостояния, Токен = Игра.ТокенФазы,
        НомерРаунда = Игра.ТекущийРаунд?.ЗагрузитьОбъект()?.НомерРаунда ?? 0,
        СекундОсталось = ОставшеесяВремя(Игра), ТаймерВключен = ДлительностьФазы(Игра) > 0, Демонстрационная = Игра.Демонстрационная, Участники = Строки)
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод ПолучитьТестовыеПредложения(Ссылка: Игры.Ссылка, Участник: УчастникиИгры.Ссылка?): Массив<ВводПредложения>
    ДоступИгры.ПроверитьВедущего(Ссылка)
    исп КонтекстДоступа.Привилегированный()
    знч Игра = Ссылка.ЗагрузитьОбъект()!
    ТребоватьДемонстрацию(Игра)
    если Участник != Неопределено
        ПроверкиДанных.Требовать(Участник.ЗагрузитьОбъект()!.Игра == Ссылка, "Команда принадлежит другой игре")
    ;
    знч Строки = <ВводПредложения>[]
    для Параметры из Игра.ПараметрыРынка
        пер Количество = 30
        если Игра.Фаза == ФазыИгры.СтартоваяПродажа
            Количество = 0
            для Ресурс из Игра.НачальныеРесурсы
                если Ресурс.Номенклатура == Параметры.Продукт
                    Количество = Ресурс.МинимальноеКоличество
                ;
            ;
        ;
        пер Цена = Параметры.РеферентнаяЦена
        если Игра.Фаза == ФазыИгры.Продажи && Игра.ФиксацияЦен == МоментыФиксацииЦен.ПослеПланирования
            ПроверкиДанных.Требовать(Участник != Неопределено, "Выберите команду для загрузки цен планирования")
            Цена = ЦенаПланирования(Игра, Участник!, Параметры.Продукт!)
        ;
        Строки.Добавить(новый ВводПредложения(Продукт = Параметры.Продукт, Цена = Цена, Доступно = Количество))
    ;
    возврат Строки
;

@ВПроекте
метод ПолучитьУчастников(Ссылка: Игры.Ссылка): Массив<УчастникиИгры.Ссылка>
    возврат Запрос{
        ВЫБРАТЬ Ссылка ИЗ УчастникиИгры ГДЕ Игра == %Ссылка И Активен
        УПОРЯДОЧИТЬ ПО ПорядокУчастника
    }.Выполнить().Преобразовать(Строка -> Строка.Ссылка)
;

метод Заблокировать(Ссылка: Игры.Ссылка, Версия: Число): Игры.Объект
    знч Игра = Ссылка.ЗагрузитьОбъект(Истина)
    ДоступИгры.ПроверитьВедущего(Ссылка)
    ПроверкиДанных.Требовать(Игра != Неопределено, "Игра не найдена")
    ПроверкиДанных.Требовать(Игра!.ВерсияСостояния == Версия, "Состояние изменилось. Обновите пульт")
    возврат Игра!
;

метод ТребоватьДемонстрацию(Игра: Игры.Объект)
    ПроверкиДанных.Требовать(Игра.Демонстрационная,
        "ERP ещё не подключена. Запуск и тестовые факты доступны только в демонстрационной игре")
;

метод ОставшеесяВремя(Игра: Игры.Объект): Число
    если Игра.Статус == СостоянияИгры.Пауза
        возврат Игра.ОстатокВремениПаузы
    ;
    если Игра.Дедлайн == Неопределено
        возврат 0
    ;
    знч Остаток = (Игра.Дедлайн! - Момент.Сейчас()).ВСекундах()
    возврат Остаток > 0 ? Остаток.Округлить(0, РежимОкругления.Вниз) : 0
;

метод СоздатьРаунд(Игра: Игры.Объект, Номер: Число)
    знч Раунд = новый РаундыИгры.Объект()
    Раунд.Игра = Игра.Ссылка
    Раунд.НомерРаунда = Номер
    Раунд.Наименование = "Раунд %{Номер}"
    Раунд.ВремяНачала = Момент.Сейчас()
    Раунд.Записать()
    Игра.ТекущийРаунд = Раунд.Ссылка
;

метод ОткрытьФазу(Игра: Игры.Объект, Фаза: ФазыИгры)
    Игра.Фаза = Фаза
    Игра.СостояниеФазы = СостоянияФазы.Открыта
    Игра.ТокенФазы = новый Ууид().ВСтроку()
    Игра.Дедлайн = Неопределено
    для Срок из Игра.СрокиФаз
        если Срок.Фаза == Фаза && Срок.ДлительностьМинут > 0
            Игра.Дедлайн = Момент.Сейчас() + 1м * Срок.ДлительностьМинут
        ;
    ;
    знч Раунд = Игра.ТекущийРаунд!.ЗагрузитьОбъект(Истина)!
    Раунд.Фаза = Фаза
    Раунд.ТокенФазы = Игра.ТокенФазы
    Раунд.Состояние = Игра.СостояниеФазы
    Раунд.Записать()
;

метод СохранитьПереход(Игра: Игры.Объект, ВерсияДо: Число, Вид: Строка, Причина: Строка)
    Игра.ВерсияСостояния = ВерсияДо + 1
    Игра.Записать()
    ЗаписатьСобытие(Игра, ВерсияДо, Вид, Причина)
;

метод ЗаписатьСобытие(Игра: Игры.Объект, ВерсияДо: Число, Вид: Строка, Причина: Строка)
    знч Событие = новый СобытияИгры.Объект()
    Событие.Дата = ДатаВремя.Сейчас()
    Событие.Момент = Момент.Сейчас()
    Событие.Игра = Игра.Ссылка
    Событие.Раунд = Игра.ТекущийРаунд
    Событие.Пользователь = ДоступИгры.ТекущийПользователь()
    Событие.Вид = Вид
    Событие.ИдОперации = новый Ууид().ВСтроку()
    Событие.ВерсияДо = ВерсияДо
    Событие.ВерсияПосле = Игра.ВерсияСостояния
    Событие.Причина = Причина
    Событие.Детали = "Фаза: %{Игра.Фаза}; тестовая игра: %{Игра.Демонстрационная}"
    Событие.Записать()
;

метод ПроверитьГотовность(Игра: Игры.Объект)
    знч Участники = ПолучитьУчастников(Игра.Ссылка)
    ПроверкиДанных.Требовать(!Участники.Пусто(), "Не осталось активных участников")
    для Участник из Участники
        знч Готовность = Запрос{
            ВЫБРАТЬ Готов, ПоследнийСнимок ИЗ СостоянияУчастников
            ГДЕ Участник == %Участник И Раунд == %Игра.ТекущийРаунд И ТокенФазы == %Игра.ТокенФазы
        }.Выполнить().ПервыйИлиНеопределено()
        ПроверкиДанных.Требовать(Готовность != Неопределено && Готовность!.Готов
            && Готовность!.ПоследнийСнимок != Неопределено, "Ожидается снимок команды %{Участник}")
    ;
;

метод ПараметрыДляПродукта(Игра: Игры.Объект, Продукт: НоменклатураИгры.Ссылка): ПараметрыПродукта
    для Строка из Игра.ПараметрыРынка
        если Строка.Продукт == Продукт
            пер Тренд = Строка.Тренд
            знч Номер = Игра.ТекущийРаунд!.ЗагрузитьОбъект()!.НомерРаунда
            для Поправка из Игра.ТрендыПоРаундам
                если Поправка.НомерРаунда == Номер && Поправка.Продукт == Продукт
                    Тренд = Поправка.Тренд
                ;
            ;
            возврат новый ПараметрыПродукта(КодПродукта = Продукт.ЗагрузитьОбъект()!.Код,
                БазовыйСпрос = Строка.БазовыйСпрос, РеферентнаяЦена = Строка.РеферентнаяЦена,
                МинимальнаяЦена = Строка.МинимальнаяЦена, МаксимальнаяЦена = Строка.МаксимальнаяЦена,
                Эластичность = Строка.Эластичность, ЧувствительностьКЦене = Строка.ЧувствительностьКЦене, Тренд = Тренд)
        ;
    ;
    выбросить новый ИсключениеНедопустимыйАргумент("Продукт отсутствует в сценарии")
;

метод ПроверитьЗафиксированнуюЦену(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Предложение: ВводПредложения)
    ПроверкиДанных.Требовать(Предложение.Цена == ЦенаПланирования(Игра, Участник, Предложение.Продукт!),
        "Цена зафиксирована после планирования")
;

метод ЦенаПланирования(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка, Продукт: НоменклатураИгры.Ссылка): Число
    знч Снимок = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ СнимкиERP
        ГДЕ Игра == %Игра.Ссылка И Раунд == %Игра.ТекущийРаунд И Участник == %Участник
            И ВерсияИсточника == "demo-planning-v1"
        УПОРЯДОЧИТЬ ПО ВремяПриема УБЫВ, Ссылка УБЫВ
    }.Выполнить().ПервыйИлиНеопределено()
    ПроверкиДанных.Требовать(Снимок != Неопределено, "Нет снимка планирования команды")
    для Строка из Снимок!.Ссылка.ЗагрузитьОбъект()!.Предложения
        если Строка.Продукт == Продукт
            возврат Строка.Цена
        ;
    ;
    выбросить новый ИсключениеНедопустимоеСостояние("Нет цены продукта в снимке планирования")
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод СмоделироватьПродажиИИтоги(Ссылка: Игры.Ссылка, Версия: Число)
    ДоступИгры.ПроверитьВедущего(Ссылка)
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Игра = Заблокировать(Ссылка, Версия)
    ТребоватьДемонстрацию(Игра)
    ПроверкиДанных.Требовать(Игра.Статус == СостоянияИгры.Идет && Игра.Фаза == ФазыИгры.Анализ,
        "Моделирование итогов доступно в фазе анализа")
    знч Раунд = Игра.ТекущийРаунд!.ЗагрузитьОбъект(Истина)!
    знч Расчет = Раунд.ОкончательныйРасчет!.ЗагрузитьОбъект()!
    для Участник из ПолучитьУчастников(Ссылка)
        знч ИдИтога = Ууид.Версия5("demo-final:%{Раунд.Ссылка}:%{Участник}").ВСтроку()
        знч Принят = Запрос{
            ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ СнимкиERP ГДЕ Игра == %Ссылка И ИдСообщения == %ИдИтога
        }.Выполнить().ПервыйИлиНеопределено()
        если Принят != Неопределено
            продолжить
        ;
        знч Снимок = новый СнимкиERP.Объект()
        Снимок.Дата = ДатаВремя.Сейчас()
        Снимок.Игра = Ссылка
        Снимок.Участник = Участник
        Снимок.Раунд = Раунд.Ссылка
        Снимок.ТокенФазы = Игра.ТокенФазы
        Снимок.ИдСообщения = ИдИтога
        Снимок.ВерсияИсточника = "demo-financial-v1"
        Снимок.ВремяДанных = Момент.Сейчас()
        Снимок.ВремяПриема = Снимок.ВремяДанных
        Снимок.ТестовыеДанные = Истина
        Снимок.ЕстьДеньги = Истина
        Снимок.ЗакрытиеМесяцаПодтверждено = Истина
        Снимок.Деньги = РезультатыИгры.ДеньгиНачалоРаунда(Раунд, Участник)
        // Explicit fixture: full shipment and full payment, no simulated production costs.
        для Заказ из Расчет.Распределение
            если Заказ.Участник != Участник || Заказ.Заказано == 0
                продолжить
            ;
            знч ИдРеализации = Ууид.Версия5("demo:%{Раунд.Ссылка}:%{Заказ.Продукт}").ВСтроку()
            ФактыПродаж.Принять(новый ФактПродажи(Расчет = Расчет.Ссылка, Участник = Участник,
                Продукт = Заказ.Продукт, ИдРеализации = ИдРеализации, Версия = 1,
                Отгружено = Заказ.Заказано, Цена = Заказ.Цена,
                Платежи = [новый ФактПлатежа(ИдПлатежа = ИдРеализации + ":paid", Сумма = Заказ.РасчетнаяВыручка,
                    Версия = 1, Момент = Снимок.ВремяДанных)]), Истина)
            Снимок.Деньги = Снимок.Деньги + Заказ.РасчетнаяВыручка
            Снимок.Остатки.Добавить(новый СнимкиERP.Остатки(Номенклатура = Заказ.Продукт,
                Количество = Заказ.Доступно - Заказ.Заказано, Единица = "шт"))
        ;
        Снимок.Записать()
        РезультатыИгры.ПринятьИтог(Снимок)
        знч Готовность = новый СостоянияУчастников.НаборЗаписей()
        Готовность.Фильтр.Установить(Участник = Участник, Раунд = Раунд.Ссылка, ТокенФазы = Игра.ТокенФазы)
        Готовность.ДобавитьЗапись(Участник = Участник, Раунд = Раунд.Ссылка, ТокенФазы = Игра.ТокенФазы,
            Готов = Истина, ПоследнийСнимок = Снимок.Ссылка, ВремяСвязи = Снимок.ВремяПриема, Версия = Версия)
        Готовность.Записать()
    ;
;

метод СкопироватьНастройки(Сценарий: СценарииИгры.Объект, Игра: Игры.Объект)
    Игра.ВерсияСценария = Сценарий.ВерсияСценария
    Игра.Алгоритм = Сценарий.Алгоритм
    Игра.ЧислоРаундов = Сценарий.ЧислоРаундов
    Игра.ФиксацияЦен = Сценарий.ФиксацияЦен
    Игра.СлучайныеНачальныеРесурсы = Сценарий.СлучайныеНачальныеРесурсы
    Игра.ПараметрыРынка.Очистить()
    для Строка из Сценарий.ПараметрыРынка
        Игра.ПараметрыРынка.Добавить(новый Игры.ПараметрыРынка(Продукт = Строка.Продукт, БазовыйСпрос = Строка.БазовыйСпрос, РеферентнаяЦена = Строка.РеферентнаяЦена, МинимальнаяЦена = Строка.МинимальнаяЦена, МаксимальнаяЦена = Строка.МаксимальнаяЦена, Эластичность = Строка.Эластичность, ЧувствительностьКЦене = Строка.ЧувствительностьКЦене, Тренд = Строка.Тренд))
    ;
    Игра.СрокиФаз.Очистить()
    для Строка из Сценарий.СрокиФаз
        Игра.СрокиФаз.Добавить(новый Игры.СрокиФаз(Фаза = Строка.Фаза, ДлительностьМинут = Строка.ДлительностьМинут))
    ;
    Игра.НачальныеРесурсы.Очистить()
    для Строка из Сценарий.НачальныеРесурсы
        знч Масштаб = Строка.Номенклатура!.ЗагрузитьОбъект()!.Вид == ВидыНоменклатурыИгры.ГотоваяПродукция ? 1 : 10000
        знч Минимум = (Строка.МинимальноеКоличество * Масштаб).Округлить(0, РежимОкругления.Вниз)
        знч Максимум = (Строка.МаксимальноеКоличество * Масштаб).Округлить(0, РежимОкругления.Вниз)
        знч СлучайнаяЧасть = ПроверкиДанных.СтабильныйПриоритет(Строка.Номенклатура!.ЗагрузитьОбъект()!.Код, Игра.Seed, 0)
        знч Количество = (Минимум + (Игра.СлучайныеНачальныеРесурсы ? СлучайнаяЧасть % (Максимум - Минимум + 1) : 0)) / Масштаб
        Игра.НачальныеРесурсы.Добавить(новый Игры.НачальныеРесурсы(Номенклатура = Строка.Номенклатура,
            МинимальноеКоличество = Количество, МаксимальноеКоличество = Количество, УчетнаяЦена = Строка.УчетнаяЦена))
    ;
    Игра.ТрендыПоРаундам.Очистить()
    для Строка из Сценарий.ТрендыПоРаундам
        Игра.ТрендыПоРаундам.Добавить(новый Игры.ТрендыПоРаундам(НомерРаунда = Строка.НомерРаунда, Продукт = Строка.Продукт, Тренд = Строка.Тренд))
    ;
;

метод СохранитьРасчет(Игра: Игры.Объект)
    знч Раунд = Игра.ТекущийРаунд!.ЗагрузитьОбъект(Истина)!
    ПроверкиДанных.Требовать(Раунд.ОкончательныйРасчет == Неопределено, "Расчет раунда уже зафиксирован")
    ПроверкиДанных.Требовать(Игра.ВерсияАлгоритма == РасчетРынка.Версия(), "Версия алгоритма не поддерживается")
    знч Расчет = новый РасчетыРынка.Объект()
    Расчет.Дата = ДатаВремя.Сейчас()
    Расчет.Игра = Игра.Ссылка
    Расчет.Раунд = Раунд.Ссылка
    Расчет.Алгоритм = Игра.Алгоритм
    Расчет.ВерсияАлгоритма = Игра.ВерсияАлгоритма
    Расчет.Время = Момент.Сейчас()
    Расчет.Статус = СтатусыРасчетовРынка.Окончательный
    знч Участники = ПолучитьУчастников(Игра.Ссылка)
    знч Снимки = <УчастникиИгры.Ссылка, СнимкиERP.Объект>{:}
    для Участник из Участники
        знч Готовность = Запрос{
            ВЫБРАТЬ ПоследнийСнимок ИЗ СостоянияУчастников
            ГДЕ Участник == %Участник И Раунд == %Раунд.Ссылка И ТокенФазы == %Игра.ТокенФазы
        }.Выполнить().ПервыйИлиНеопределено()!
        знч Снимок = Готовность.ПоследнийСнимок!.ЗагрузитьОбъект()!
        ПроверкиДанных.Требовать(Снимок.Игра == Игра.Ссылка && Снимок.Участник == Участник
            && Снимок.Раунд == Раунд.Ссылка && Снимок.ТокенФазы == Игра.ТокенФазы && Снимок.ТестовыеДанные,
            "Несогласованный снимок предложения")
        Снимки.Вставить(Участник, Снимок)
        Расчет.Источники.Добавить(новый РасчетыРынка.Источники(Участник = Участник, СнимокERP = Снимок.Ссылка))
    ;
    для Правило из Игра.ПараметрыРынка
        знч Параметры = ПараметрыДляПродукта(Игра, Правило.Продукт!)
        знч Предложения = <ПредложениеРынка>[]
        для Участник из Участники
            для Строка из Снимки.Получить(Участник).Предложения
                если Строка.Продукт == Правило.Продукт
                    Предложения.Добавить(новый ПредложениеРынка(Участник = Участник.ВСтроку(),
                        Цена = Строка.Цена, Доступно = Строка.ДоступноКПродаже, Активен = Истина))
                ;
            ;
        ;
        ПроверкиДанных.Требовать(Предложения.Размер() == Участники.Размер(), "Не хватает предложений по продукту")
        знч Итог = РасчетРынка.Рассчитать(Параметры, Предложения, Игра.Алгоритм, Игра.Seed, Раунд.НомерРаунда)
        Расчет.СпросПродуктов.Добавить(новый РасчетыРынка.СпросПродуктов(Продукт = Правило.Продукт,
            СредняяЦена = Итог.СредняяЦена, БазовыйСпрос = Параметры.БазовыйСпрос, Тренд = Параметры.Тренд,
            ИтоговыйСпрос = Итог.Спрос, ОбщаяДоступность = Итог.Доступность, НепокрытыйСпрос = Итог.НепокрытыйСпрос))
        для Заказ из Итог.Заказы
            для Участник из Участники
                если Участник.ВСтроку() == Заказ.Участник
                    Расчет.Распределение.Добавить(новый РасчетыРынка.Распределение(Участник = Участник,
                        Продукт = Правило.Продукт, Цена = Заказ.Цена, Доступно = Заказ.Доступно,
                        ЦеновойВес = Заказ.Вес, ПотенциальныйСпрос = Заказ.Доля,
                        Заказано = Заказ.Заказано, РасчетнаяВыручка = Заказ.Выручка))
                ;
            ;
        ;
    ;
    // Source documents and frozen settings provide the complete reproducible input.
    // Hashing for transport belongs to the deferred ERP integration stage.
    Расчет.Записать()
    Раунд.ОкончательныйРасчет = Расчет.Ссылка
    Раунд.Записать()
;

метод ДлительностьФазы(Игра: Игры.Объект): Число
    для Срок из Игра.СрокиФаз
        если Срок.Фаза == Игра.Фаза
            возврат Срок.ДлительностьМинут
        ;
    ;
    возврат 0
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод ИсключитьУчастника(Ссылка: Игры.Ссылка, Версия: Число, Участник: УчастникиИгры.Ссылка, Причина: Строка)
    ДоступИгры.ПроверитьВедущего(Ссылка)
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Игра = Заблокировать(Ссылка, Версия)
    ПроверкиДанных.Требовать(Причина != "" && (Игра.Статус == СостоянияИгры.Идет
        || Игра.Статус == СостоянияИгры.Пауза), "Укажите причину исключения в идущей игре")
    знч Команда = Участник.ЗагрузитьОбъект(Истина)!
    ПроверкиДанных.Требовать(Команда.Игра == Ссылка && Команда.Активен, "Команда не участвует в этой игре")
    ПроверкиДанных.Требовать(ПолучитьУчастников(Ссылка).Размер() > 1, "Нельзя исключить последнюю команду")
    Команда.Активен = Ложь
    Команда.Записать()
    СохранитьПереход(Игра, Версия, "ИсключениеКоманды", "%{Команда.НаименованиеКоманды}: %{Причина}")
;
