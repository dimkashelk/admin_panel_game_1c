импорт Данные
импорт Обмен

@Обработчик
метод ПослеСоздания()
    Администратор = УправлениеИгрой.АдминистраторНастройки()
    если СозданнаяИгра != Неопределено
        ОбновитьНастройки(Неопределено)
    ;
;

метод ИграИзменена(Источник: ПолеВвода<Игры.Ссылка?>, Событие: СобытиеПриИзменении<Игры.Ссылка?>)
    ЗагруженнаяИгра = Неопределено
    СписокКоманд = []
    ОчиститьКоманду()
    если СозданнаяИгра != Неопределено
        ОбновитьНастройки(Неопределено)
    иначе
        Сообщение = "Выберите игру для настройки"
        СтатусИгры = ""
        Черновик = Ложь
    ;
;

@ВПроекте
метод ОбновитьНастройки(Команда: ОбычнаяКоманда?)
    попытка
        ПрочитатьНастройки()
        Сообщение = "Настройки загружены. Выберите команду для настройки игроков и базы ERP."
    поймать Ошибка: Исключение
        ЗагруженнаяИгра = Неопределено
        СписокКоманд = []
        ОчиститьКоманду()
        Сообщение = Ошибка.Описание
    ;
;

метод ПрочитатьНастройки()
    ПроверкиДанных.Требовать(СозданнаяИгра != Неопределено, "Выберите игру")
    знч ВыбраннаяИгра = СозданнаяИгра!
    знч ПрежняяКоманда = УчастникERP
    ЗагруженнаяИгра = Неопределено
    СписокКоманд = []
    ОчиститьКоманду()
    знч Настройки = УправлениеИгрой.ПолучитьНастройки(ВыбраннаяИгра)
    знч КомандыИгры = ДоступКабинета.КомандыИгры(ВыбраннаяИгра)
    если СозданнаяИгра != ВыбраннаяИгра
        возврат
    ;
    Название = Настройки.Получить("name") как Строка
    Сценарий = Настройки.Получить("scenario") как СценарииИгры.Ссылка?
    Seed = Настройки.Получить("seed") как Число
    СвободныйРынок = Настройки.Получить("market") как Булево
    Версия = Настройки.Получить("version") как Число
    Черновик = Настройки.Получить("draft") как Булево
    СтатусИгры = Настройки.Получить("status") как Строка
    Администратор = Настройки.Получить("admin") как Булево
    СписокКоманд = КомандыИгры
    ЗагруженнаяИгра = ВыбраннаяИгра
    для СтрокаКоманды из СписокКоманд
        если УчастникERP == Неопределено или СтрокаКоманды.Участник == ПрежняяКоманда
            УчастникERP = СтрокаКоманды.Участник
        ;
    ;
    ЗагрузитьКоманду()
;

метод СохранитьИгру(Команда: ОбычнаяКоманда)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        ТребоватьИгру()
        ПроверкиДанных.Требовать(Сценарий != Неопределено, "Выберите сценарий")
        УправлениеИгрой.СохранитьНастройки(СозданнаяИгра!, Версия, Название, Сценарий!, Seed, СвободныйРынок)
        ПрочитатьНастройки()
        Сообщение = "Настройки игры сохранены."
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    Занято = Ложь
;

метод ВыборКомандИгры(): Массив<ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>>
    знч Результат = новый Массив<ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>>()
    для СтрокаКоманды из СписокКоманд
        Результат.Добавить(новый ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>(
            Значение = СтрокаКоманды.Участник, Представление = СтрокаКоманды.Представление))
    ;
    возврат Результат
;

метод КомандаИзменена(Источник: ПолеВвода<УчастникиИгры.Ссылка?>, Событие: СобытиеПриИзменении<УчастникиИгры.Ссылка?>)
    знч ВыбраннаяКоманда = УчастникERP
    ОчиститьКоманду()
    УчастникERP = ВыбраннаяКоманда
    попытка
        ЗагрузитьКоманду()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод ОчиститьКоманду()
    УчастникERP = Неопределено
    ЗагруженнаяКоманда = Неопределено
    НазваниеКоманды = ""
    НоваяКоманда = ""
;

метод ТребоватьИгру()
    ПроверкиДанных.Требовать(СозданнаяИгра != Неопределено и ЗагруженнаяИгра == СозданнаяИгра,
        "Сначала загрузите настройки выбранной игры")
;

метод ТребоватьКоманду()
    ТребоватьИгру()
    ПроверкиДанных.Требовать(УчастникERP != Неопределено и ЗагруженнаяКоманда == УчастникERP,
        "Сначала загрузите выбранную команду")
;

метод ЗагрузитьКоманду()
    ТребоватьИгру()
    если УчастникERP == Неопределено
        возврат
    ;
    для СтрокаКоманды из СписокКоманд
        если СтрокаКоманды.Участник == УчастникERP
            НазваниеКоманды = СтрокаКоманды.Представление
            ЗагруженнаяКоманда = УчастникERP
        ;
    ;
;

метод ДобавитьКоманду(Команда: ОбычнаяКоманда)
    ЗаписатьКоманду(Неопределено, НоваяКоманда)
;

метод ПереименоватьКоманду(Команда: ОбычнаяКоманда)
    попытка
        ТребоватьКоманду()
        ЗаписатьКоманду(УчастникERP, НазваниеКоманды)
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод ЗаписатьКоманду(Участник: УчастникиИгры.Ссылка?, ИмяКоманды: Строка)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        ТребоватьИгру()
        УчастникERP = УправлениеИгрой.СохранитьКоманду(СозданнаяИгра!, Версия, Участник, ИмяКоманды)
        ПрочитатьНастройки()
        Сообщение = "Команда сохранена. Нажмите на карандаш для настройки игроков и базы ERP."
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    Занято = Ложь
;

метод РасширенныеНастройки(Команда: ОбычнаяКоманда)
    попытка
        ТребоватьИгру()
        знч Окно = новый НазначенияИгры()
        Окно.Игра = СозданнаяИгра
        Окно.УчастникERP = УчастникERP
        Окно.ОткрытьВМодальномОкне()
        ОбновитьНастройки(Неопределено)
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод ОткрытьПульт(Команда: ОбычнаяКоманда)
    попытка
        ТребоватьИгру()
        знч Окно = новый ПультВедущего()
        Окно.Игра = СозданнаяИгра
        Окно.Открыть()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод НастроитьСохраненнуюКоманду(Команда: ОбычнаяКоманда)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        ТребоватьКоманду()
        знч Окно = новый НастройкаКоманды()
        Окно.Инициализировать(Неопределено, СозданнаяИгра, УчастникERP, НазваниеКоманды, Администратор)
        Окно.ОткрытьВМодальномОкне()
        ПрочитатьНастройки()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    Занято = Ложь
;
