импорт Данные
импорт Обмен

@Обработчик
метод ПослеСоздания()
    попытка
        ПодключитьОбработчикТаймера(&ОбновитьПодготовкуБаз, 5с)
        Администратор = УправлениеИгрой.АдминистраторНастройки()
        если СозданнаяИгра != Неопределено
            ОбновитьНастройки(Неопределено)
        иначе
            НоваяИгра()
        ;
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;

@ВПроекте
метод Инициализировать(Игра: Игры.Ссылка?)
    СозданнаяИгра = Игра
    если Игра == Неопределено
        НоваяИгра()
    иначе
        ПрочитатьНастройки()
    ;
;

метод НоваяИгра()
    если Занято
        возврат
    ;
    СозданнаяИгра = Неопределено
    Сценарий = Неопределено
    Администратор = УправлениеИгрой.АдминистраторНастройки()
    Название = "Учебная игра"
    НовыеКоманды = [новый ВводКоманды(Наименование = "Команда 1"),
        новый ВводКоманды(Наименование = "Команда 2")]
    СвободныйРынок = Истина
    ЗаказыПоЦенамERP = Ложь
    ДонастраиватьБазыERP = Истина
    ПроцентСпроса = 80
    МинКоличествоЗаказа = 1
    МаксКоличествоЗаказа = 5
    МинИнтервалЗаказов = 30
    МаксИнтервалЗаказов = 90
    Seed = 42
;


@ВПроекте
метод ОбновитьНастройки(Команда: ОбычнаяКоманда?)
    попытка
        ПрочитатьНастройки()
    поймать Ошибка: Исключение
        ЗагруженнаяИгра = Неопределено
        СписокКоманд = []
        Сообщить(Ошибка.Описание)
    ;
;

метод ПрочитатьНастройки()
    ПроверкиДанных.Требовать(СозданнаяИгра != Неопределено, "Выберите игру")
    знч ВыбраннаяИгра = СозданнаяИгра!
    ЗагруженнаяИгра = Неопределено
    СписокКоманд = []
    знч Настройки = УправлениеИгрой.ПолучитьНастройки(ВыбраннаяИгра)
    знч КомандыИгры = ДоступКабинета.КомандыИгры(ВыбраннаяИгра)
    если СозданнаяИгра != ВыбраннаяИгра
        возврат
    ;
    Название = Настройки.Получить("name") как Строка
    Сценарий = Настройки.Получить("scenario") как СценарииИгры.Ссылка?
    Seed = Настройки.Получить("seed") как Число
    СвободныйРынок = Настройки.Получить("market") как Булево
    ЗаказыПоЦенамERP = Настройки.Получить("priceOrders") как Булево
    ПроцентСпроса = Настройки.Получить("demandPercent") как Число
    МинКоличествоЗаказа = Настройки.Получить("minOrderQuantity") как Число
    МаксКоличествоЗаказа = Настройки.Получить("maxOrderQuantity") как Число
    МинИнтервалЗаказов = Настройки.Получить("minOrderIntervalSeconds") как Число
    МаксИнтервалЗаказов = Настройки.Получить("maxOrderIntervalSeconds") как Число
    Версия = Настройки.Получить("version") как Число
    Черновик = Настройки.Получить("draft") как Булево
    СтатусИгры = Настройки.Получить("status") как Строка
    Администратор = Настройки.Получить("admin") как Булево
    СписокКоманд = КомандыИгры
    ЗагруженнаяИгра = ВыбраннаяИгра
    ОбновитьПодготовкуБаз()
;

метод СохранитьИгру(Команда: ОбычнаяКоманда)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        если СозданнаяИгра == Неопределено
            СоздатьИгру()
        иначе
            СохранитьНастройкиИгры()
        ;
        ПрочитатьНастройки()
        Сообщить("Игра сохранена.")
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
    Занято = Ложь
;

метод СохранитьНастройкиИгры()
    ТребоватьИгру()
    ПроверкиДанных.Требовать(Сценарий != Неопределено, "Выберите сценарий")
    УправлениеИгрой.СохранитьНастройки(СозданнаяИгра!, Версия, Название, Сценарий!, Seed, СвободныйРынок,
        МинКоличествоЗаказа, МаксКоличествоЗаказа, МинИнтервалЗаказов, МаксИнтервалЗаказов, ЗаказыПоЦенамERP, ПроцентСпроса, ДонастраиватьБазыERP)
;

метод ТребоватьИгру()
    ПроверкиДанных.Требовать(СозданнаяИгра != Неопределено и ЗагруженнаяИгра == СозданнаяИгра,
        "Сначала загрузите настройки выбранной игры")
;

метод ДобавитьКоманду(Команда: ОбычнаяКоманда)
    ОткрытьКарточкуКоманды(Неопределено, "")
;

метод РасширенныеНастройки(Команда: ОбычнаяКоманда)
    попытка
        ТребоватьИгру()
        знч Окно = новый НазначенияИгры()
        Окно.Игра = СозданнаяИгра
        Окно.ОткрытьВМодальномОкне()
        ОбновитьНастройки(Неопределено)
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;

метод ОткрытьПульт(Команда: ОбычнаяКоманда)
    попытка
        ТребоватьИгру()
        знч Окно = новый ПультВедущего()
        Окно.Игра = СозданнаяИгра
        Окно.Открыть()
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;

метод НастроитьСохраненнуюКоманду(Команда: КомандаСПараметром<КомандаКабинета>, СтрокаКоманды: КомандаКабинета)
    если не СписокКоманд.Содержит(СтрокаКоманды)
        возврат
    ;
    ОткрытьКарточкуКоманды(СтрокаКоманды.Участник, СтрокаКоманды.Представление)
;

метод ОткрытьКарточкуКоманды(Участник: УчастникиИгры.Ссылка?, Наименование: Строка)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        ТребоватьИгру()
        знч Окно = новый НастройкаКоманды()
        Окно.Инициализировать(Неопределено, СозданнаяИгра, Участник, Наименование, Администратор)
        знч Сохранено = Окно.ОткрытьВМодальномОкне()
        если Сохранено == Истина
            ПрочитатьНастройки()
        ;
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
    Занято = Ложь
;

метод НастроитьБазы(Команда: ОбычнаяКоманда)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        ТребоватьИгру()
        СохранитьНастройкиИгры()
        знч СостояниеБаз = НастройкаБазOData.СостояниеНастройкиБаз(СозданнаяИгра!)
        если СостояниеБаз.Получить("running") != Истина
            НастройкаБазOData.НастроитьБазыИгры(СозданнаяИгра!, ДонастраиватьБазыERP)
        ;
        ПрочитатьНастройки()
        ОбновитьПодготовкуБаз()
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
    Занято = Ложь
;

метод ОбновитьПодготовкуБаз()
    если СозданнаяИгра == Неопределено или ОбновлениеПодготовки
        возврат
    ;
    ОбновлениеПодготовки = Истина
    попытка
        знч ВыбраннаяИгра = СозданнаяИгра!
        знч Результат = НастройкаБазOData.СостояниеНастройкиБаз(ВыбраннаяИгра)
        если СозданнаяИгра == ВыбраннаяИгра
            СостояниеПодготовкиБаз = Результат.Получить("text") как Строка
            БазыГотовы = Результат.Получить("ready") как Булево
            знч Ошибки = Результат.Получить("errors") как Строка
            если Ошибки != "" и Ошибки != ПоследняяОшибкаПодготовки
                Сообщить(Ошибки)
            ;
            ПоследняяОшибкаПодготовки = Ошибки
            знч Выполняется = Результат.Получить("running") как Булево
            если ОжидаласьПодготовка и не Выполняется и БазыГотовы
                Сообщить("Настройка баз ERP завершена.")
            ;
            ОжидаласьПодготовка = Выполняется
            если не РежимПодготовкиЗагружен
                ДонастраиватьБазыERP = Результат.Получить("apply") как Булево
                РежимПодготовкиЗагружен = Истина
            ;
        ;
    поймать Ошибка: Исключение
        если ПоследняяОшибкаПодготовки != Ошибка.Описание
            Сообщить(Ошибка.Описание)
        ;
        ПоследняяОшибкаПодготовки = Ошибка.Описание
        СостояниеПодготовкиБаз = Ошибка.Описание
        БазыГотовы = Ложь
    ;
    ОбновлениеПодготовки = Ложь
;

метод СоздатьИгру()
    ПроверкиДанных.Требовать(СозданнаяИгра == Неопределено, "Игра уже создана. Продолжите её настройку или создайте другую игру.")
    ПроверкиДанных.Требовать(Сценарий != Неопределено, "Выберите сценарий")
    ПроверкиДанных.Требовать(НовыеКоманды.Размер() >= 2, "Добавьте минимум две команды")
    знч НазванияКоманд: Массив<Строка> = []
    для СтрокаКоманды из НовыеКоманды
        знч НазваниеКоманды = СтрокаКоманды.Наименование.Сократить()
        ПроверкиДанных.Требовать(НазваниеКоманды != "", "Укажите название каждой команды")
        ПроверкиДанных.Требовать(не НазванияКоманд.Содержит(НазваниеКоманды),
            "Названия команд должны быть уникальными")
        НазванияКоманд.Добавить(НазваниеКоманды)
    ;
    СозданнаяИгра = УправлениеИгрой.СоздатьИгру(Название, Сценарий!,
        НазванияКоманд, Seed, СвободныйРынок, НовыеКоманды,
        МинКоличествоЗаказа, МаксКоличествоЗаказа, МинИнтервалЗаказов, МаксИнтервалЗаказов, ПроцентСпроса, ЗаказыПоЦенамERP, ДонастраиватьБазыERP)
    для СтрокаКоманды из НовыеКоманды
        СтрокаКоманды.ПарольERP = ""
    ;
    НовыеКоманды = []
;

метод НастроитьНовуюКоманду(Команда: КомандаСПараметром<ВводКоманды>, СтрокаКоманды: ВводКоманды)
    если Занято или СозданнаяИгра != Неопределено или не НовыеКоманды.Содержит(СтрокаКоманды)
        возврат
    ;
    Занято = Истина
    попытка
        знч Окно = новый НастройкаКоманды()
        Окно.Инициализировать(СтрокаКоманды, Неопределено, Неопределено, СтрокаКоманды.Наименование, Администратор)
        Окно.ОткрытьВМодальномОкне()
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
    Занято = Ложь
;
