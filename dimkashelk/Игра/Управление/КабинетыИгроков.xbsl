импорт Данные
импорт Обмен

@ВПроекте @НаСервере @ДоступноСКлиента
метод Получить(Участник: УчастникиИгры.Ссылка): СостояниеКабинета
    знч СсылкаИгры = ДоступКабинета.ПроверитьИгрока(Участник)
    РынокЗаказов.Обновить(СсылкаИгры)
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Игра = СсылкаИгры.ЗагрузитьОбъект(Истина)!
    ДоступКабинета.ПроверитьИгрока(Участник)
    знч Раунд = Игра.ТекущийРаунд
    знч Токен = Игра.ТокенФазы
    знч Завершено = Игра.Статус == СостоянияИгры.Завершена
        или ДоступКабинета.Завершено(Участник, Раунд, Токен)
    знч Рынок = <СтрокаРынкаИгрока>[]
    для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ ЗаказыРынка ГДЕ Игра == %СсылкаИгры И Раунд == %Раунд
        УПОРЯДОЧИТЬ ПО НомерПакета УБЫВ}.Выполнить()
        знч Заказ = Строка.Ссылка.ЗагрузитьОбъект()!
        знч Мой = Заказ.Участник == Участник
        если Игра.ЗаказыПоЦенамERP и не Мой
            продолжить
        ;
        Рынок.Добавить(новый СтрокаРынкаИгрока(Заказ = Заказ.Ссылка, Номер = Заказ.НомерПакета,
            Модель = Заказ.СтрокиЗаказаJson == "" ? Заказ.Продукт!.ЗагрузитьОбъект()!.Наименование : "Заказ команды", Количество = Заказ.Количество,
            Описание = Заказ.ОписаниеЗаказа, Составной = Заказ.СтрокиЗаказаJson != "",
            Цена = Заказ.Цена, Сумма = РынокЗаказов.СуммаЗаказа(Заказ),
            Команда = Заказ.Участник == Неопределено ? "—" : Заказ.Участник!.ЗагрузитьОбъект()!.НаименованиеКоманды,
            Статус = Заказ.Статус, Закрыт = Заказ.ЗачтенЗакрытым, СостояниеERP = РынокЗаказов.ПредставлениеСтатусаERP(Заказ), Мой = Мой, Свободен = Заказ.Участник == Неопределено, Появился = Заказ.ВремяПоявления,
            МожноЗакрыть = Мой и Заказ.Статус == "Проведен в ERP" и Заказ.ВнешнийДокумент != ""
                и (не Заказ.ЗакрытERP или не Заказ.ОплатаПодтвержденаERP) и РынокЗаказов.ПродажиОткрыты(Игра),
            МожноПолучить = (РынокЗаказов.ПродажиОткрыты(Игра) или (Мой и Игра.Статус == СостоянияИгры.Идет
                и (Игра.Фаза == ФазыИгры.Продажи или Игра.Фаза == ФазыИгры.СтартоваяПродажа))) и (не Завершено или Мой)
                и (Заказ.Участник == Неопределено или (Мой и (Заказ.Статус == "Назначен" или Заказ.Статус == "Ошибка ERP" или (Заказ.Статус == "Отправляется"
                    и Заказ.НачалоПопытки != Неопределено и Момент.Сейчас() > Заказ.НачалоПопытки! + 15м))))))
    ;
    знч Команды = РынокЗаказов.ПортфелиРаунда(СсылкаИгры, Раунд)
    знч Остаток = Игра.Дедлайн == Неопределено ? 0 : (Игра.Дедлайн! - Момент.Сейчас()).ВСекундах()
    возврат новый СостояниеКабинета(Участник = Участник, Игра = СсылкаИгры, Название = Игра.Наименование,
        Команда = Участник.ЗагрузитьОбъект()!.НаименованиеКоманды, Фаза = Игра.Фаза, Статус = Игра.Статус,
        Раунд = Раунд == Неопределено ? 0 : Раунд!.ЗагрузитьОбъект()!.НомерРаунда, Токен = Токен,
        СекундОсталось = Игра.Статус == СостоянияИгры.Пауза ? Игра.ОстатокВремениПаузы : (Остаток > 0 ? Остаток : 0),
        ТаймерВключен = Игра.Дедлайн != Неопределено или (Игра.Статус == СостоянияИгры.Пауза и Игра.ОстатокВремениПаузы > 0),
        СвободныйРынок = Игра.СвободныйРынок, ЗаказыПоЦенамERP = Игра.ЗаказыПоЦенамERP, СостояниеРынка = РынокЗаказов.СостояниеДанныхРынка(Игра),
        Завершено = Завершено, МожноЗавершить = не Завершено и Токен != ""
            и (Игра.Статус == СостоянияИгры.Подготовка или (Игра.Статус == СостоянияИгры.Идет
                и Игра.СостояниеФазы == СостоянияФазы.Открыта)),
        Рынок = Рынок, Команды = Команды)
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод ПолучитьЗаказ(Участник: УчастникиИгры.Ссылка, Заказ: ЗаказыРынка.Ссылка, Токен: Строка): Строка
    знч СсылкаИгры = ДоступКабинета.ПроверитьИгрока(Участник)
    исп КонтекстДоступа.Привилегированный()
    знч КомандаДоступа = Участник.ЗагрузитьОбъект()!
    НастройкаБазOData.ПроверитьДоступЗаказов(КомандаДоступа)
    // Отдельный серверный метод завершает транзакцию до сетевых запросов.
    знч Попытка = РынокЗаказов.Резервировать(Участник, Заказ, Токен)
    если Попытка == ""
        возврат "Заказ уже принят вашей командой"
    ;
    попытка
        исп КонтекстДоступа.Привилегированный()
        знч Игра = СсылкаИгры.ЗагрузитьОбъект()!
        знч Документ = Заказ.ЗагрузитьОбъект()!
        знч Команда = Участник.ЗагрузитьОбъект()!
        ПроверкиДанных.Требовать(Команда.ПодключениеERP != Неопределено, "Не настроено подключение ERP команды")
        знч База = Команда.ПодключениеERP!.ЗагрузитьОбъект()!
        НастройкаБазOData.ПроверитьДоступЗаказов(Команда)
        знч ДатаДокумента = ПротоколERP.СтрокаJson(НастройкиERP.КалендарьРаунда(Игра,
            Документ.Раунд!.ЗагрузитьОбъект()!.НомерРаунда), "documentDate")
        знч Результат = НастройкаБазOData.СоздатьЗаказПоСтрокамOData(База.АдресOData, База.ЛогинOData, База.ПарольOData!,
            Команда.ОрганизацияERP, Заказ.Ид.ВСтроку(), РынокЗаказов.СтрокиЗаказаERP(Документ), ДатаДокумента,
            НастройкаБазOData.СоответствияНоменклатуры(База.Ссылка))
        РынокЗаказов.Подтвердить(Участник, Заказ, Попытка, Результат, "")
        возврат "В ERP создан и проведён заказ №%{ПротоколERP.СтрокаJson(Результат, "number")} от %{ПротоколERP.СтрокаJson(Результат, "date")}. База: %{База.Наименование}; организация: %{Команда.ОрганизацияERP}. GUID: %{ПротоколERP.СтрокаJson(Результат, "refKey")}. Проверьте отбор по игровой дате."
    поймать Ошибка: Исключение
        знч ДоСоздания = Ошибка это ПротоколERP.Ошибка
            и ["ODATA_AUTH", "ODATA_STOCK", "ODATA_MAPPING", "ODATA_ORDER"].Содержит((Ошибка как ПротоколERP.Ошибка).Код)
        // Неопределённый результат сохраняет владельца; повтор ищет тот же документ.
        РынокЗаказов.Подтвердить(Участник, Заказ, Попытка, Неопределено, "Не удалось подтвердить заказ ERP. Повторите отправку", ДоСоздания)
        выбросить Ошибка
    ;
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод ЗавершитьЭтап(Участник: УчастникиИгры.Ссылка, Токен: Строка, Описание: Строка)
    знч Пользователь = ДоступИгры.ТекущийПользователь()
    знч СсылкаИгры = ДоступКабинета.ПроверитьИгрока(Участник)
    исп КонтекстДоступа.Привилегированный()
    // Сеть вызывается до транзакции: ведущий и другие команды не ждут ответа ERP под блокировкой игры.
    знч ДоПроверки = СсылкаИгры.ЗагрузитьОбъект()!
    ПроверитьОткрытыйЭтап(ДоПроверки, Токен)
    если ДоступКабинета.Завершено(Участник, ДоПроверки.ТекущийРаунд, Токен)
        возврат
    ;
    знч НачалоПроверки = Момент.Сейчас()
    знч ПрайсЛист = РынокЗаказов.СборПрайсЛистовОткрыт(ДоПроверки)
        ? РынокЗаказов.ПрочитатьПрайсЛистДляЗавершения(ДоПроверки, Участник) : Неопределено
    исп Транзакции.Начать()
    знч Игра = СсылкаИгры.ЗагрузитьОбъект(Истина)!
    ДоступКабинета.ПроверитьИгрока(Участник)
    ПроверитьОткрытыйЭтап(Игра, Токен)
    ПроверкиДанных.Требовать(Игра.ВерсияСостояния == ДоПроверки.ВерсияСостояния,
        "Состояние игры изменилось во время проверки. Повторите завершение этапа")
    РынокЗаказов.ЗавершитьПоСроку(Игра)
    знч Раунд = Игра.ТекущийРаунд
    если ДоступКабинета.Завершено(Участник, Раунд, Токен)
        возврат
    ;
    ПроверитьУсловияЗавершения(Игра, Участник, ПрайсЛист)
    если ПрайсЛист != Неопределено
        // Проверенный прайс-лист и заявление сохраняются одной транзакцией.
        знч Команда = Участник.ЗагрузитьОбъект(Истина)!
        Команда.ДанныеРынкаOData = ПротоколERP.Json(ПрайсЛист!)
        Команда.ТокенРынкаOData = Токен
        Команда.ВремяРынкаOData = НачалоПроверки
        Команда.ОшибкаРынкаOData = ""
        Команда.СледующееЧтениеРынкаOData = Момент.Сейчас() + 30с
        Команда.Записать()
    ;
    знч Записи = новый ЗаявленияКоманд.НаборЗаписей()
    Записи.Фильтр.Установить(Участник = Участник, Раунд = Раунд, ТокенФазы = Токен)
    Записи.ДобавитьЗапись(Участник = Участник, Раунд = Раунд, ТокенФазы = Токен, Завершено = Истина,
        Время = Момент.Сейчас(), Пользователь = Пользователь, Описание = Описание.Сократить(), ЗапрошенаБлокировкаERP = не Игра.ТолькоРынок)
    Записи.Записать()
    // Заявление игрока отдельно от технической готовности ERP и подтверждённых снимков.
    // TODO: применить ЗапрошенаБлокировкаERP в адаптере ERP и получить подтверждение отдельным событием.
;

@НаСервере
метод ПроверитьОткрытыйЭтап(Игра: Игры.Объект, Токен: Строка)
    ПроверкиДанных.Требовать(Игра.ТокенФазы == Токен и Токен != ""
        и (Игра.Статус == СостоянияИгры.Подготовка или (Игра.Статус == СостоянияИгры.Идет
            и Игра.СостояниеФазы == СостоянияФазы.Открыта)), "Этап изменился или закрыт")
;

@НаСервере
метод ПроверитьУсловияЗавершения(Игра: Игры.Объект, Участник: УчастникиИгры.Ссылка,
    ПрайсЛист: Соответствие<Строка, Объект?>?)
    знч Раунд = Игра.ТекущийРаунд
    знч Токен = Игра.ТокенФазы
    знч Незавершенный = Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ ЗаказыРынка
        ГДЕ Раунд == %Раунд И Участник == %Участник И Статус != "Проведен в ERP"}.Выполнить().ПервыйИлиНеопределено()
    ПроверкиДанных.Требовать(Незавершенный == Неопределено, "Сначала дождитесь проведения всех полученных заказов")
    если РынокЗаказов.СборПрайсЛистовОткрыт(Игра)
        ПроверкиДанных.Требовать(ПрайсЛист != Неопределено, "Не получен прайс-лист ERP текущего этапа")
        РынокЗаказов.ПроверитьПрайсЛист(Игра, ПрайсЛист!)
    ;
    если Игра.ТолькоРынок
        возврат
    ;
    знч Готовность = Запрос{ВЫБРАТЬ Готов, ПоследнийСнимок, Ошибка ИЗ СостоянияУчастников
        ГДЕ Участник == %Участник И Раунд == %Раунд И ТокенФазы == %Токен}.Выполнить().ПервыйИлиНеопределено()
    ПроверкиДанных.Требовать(Готовность != Неопределено, "Ожидается проверка условий этапа и снимок ERP команды")
    ПроверкиДанных.Требовать(Готовность!.Ошибка == "", "Условия этапа не выполнены: %{Готовность!.Ошибка}")
    ПроверкиДанных.Требовать(Готовность!.Готов и Готовность!.ПоследнийСнимок != Неопределено,
        "ERP команды ещё не подтвердила готовность к завершению текущего этапа")
    ФактыERP.ПроверитьГотовностьИсполнения(Игра, Участник)
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод ЗакрытьЗаказ(Участник: УчастникиИгры.Ссылка, Заказ: ЗаказыРынка.Ссылка, Токен: Строка): Строка
    знч СсылкаИгры = ДоступКабинета.ПроверитьИгрока(Участник)
    исп КонтекстДоступа.Привилегированный()
    знч Команда = Участник.ЗагрузитьОбъект()!
    НастройкаБазOData.ПроверитьДоступЗаказов(Команда)
    знч Попытка = РынокЗаказов.РезервироватьЗакрытие(Участник, Заказ, Токен)
    если Попытка == ""
        возврат "Заказ уже закрыт, банковское поступление подтверждено"
    ;
    попытка
        знч Игра = СсылкаИгры.ЗагрузитьОбъект()!
        знч Документ = Заказ.ЗагрузитьОбъект()!
        знч База = Команда.ПодключениеERP!.ЗагрузитьОбъект()!
        знч ДатаДокумента = ПротоколERP.СтрокаJson(НастройкиERP.КалендарьРаунда(Игра,
            Документ.Раунд!.ЗагрузитьОбъект()!.НомерРаунда), "documentDate")
        знч Результат = НастройкаБазOData.ЗакрытьИОплатитьЗаказOData(База.АдресOData, База.ЛогинOData,
            База.ПарольOData!, Команда.ОрганизацияERP, Заказ.Ид.ВСтроку(), Документ.ВнешнийДокумент,
            РынокЗаказов.СуммаЗаказа(Документ), ДатаДокумента,
            РынокЗаказов.СтрокиЗаказаERP(Документ), НастройкаБазOData.СоответствияНоменклатуры(База.Ссылка))
        РынокЗаказов.ПодтвердитьЗакрытие(Участник, Заказ, Попытка, Результат, "")
        возврат "Заказ полностью отгружен и закрыт. Поступление безналичных ДС №%{ПротоколERP.СтрокаJson(Результат, "paymentNumber")} проведено в ERP и банком."
    поймать Ошибка: Исключение
        // Повтор использует тот же GUID поступления, даже если ERP успела записать или провести документ.
        РынокЗаказов.ПодтвердитьЗакрытие(Участник, Заказ, Попытка, Неопределено, Ошибка.Описание)
        выбросить Ошибка
    ;
;
