импорт Данные
импорт Обмен

@ВПроекте @НаСервере @ДоступноСКлиента
метод Получить(Участник: УчастникиИгры.Ссылка): СостояниеКабинета
    знч СсылкаИгры = ДоступКабинета.ПроверитьИгрока(Участник)
    РынокЗаказов.Обновить(СсылкаИгры)
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Игра = СсылкаИгры.ЗагрузитьОбъект(Истина)!
    ДоступКабинета.ПроверитьИгрока(Участник)
    знч Раунд = Игра.ТекущийРаунд
    знч Токен = Игра.ТокенФазы
    знч Завершено = ДоступКабинета.Завершено(Участник, Раунд, Токен)
    знч Рынок = <СтрокаРынкаИгрока>[]
    для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ ЗаказыРынка ГДЕ Игра == %СсылкаИгры И Раунд == %Раунд
        УПОРЯДОЧИТЬ ПО НомерПакета УБЫВ}.Выполнить()
        знч Заказ = Строка.Ссылка.ЗагрузитьОбъект()!
        знч Мой = Заказ.Участник == Участник
        Рынок.Добавить(новый СтрокаРынкаИгрока(Заказ = Заказ.Ссылка, Номер = Заказ.НомерПакета,
            Модель = Заказ.Продукт!.ЗагрузитьОбъект()!.Наименование, Количество = Заказ.Количество,
            Цена = Заказ.Цена, Сумма = Заказ.Количество * Заказ.Цена,
            Команда = Заказ.Участник == Неопределено ? "—" : Заказ.Участник!.ЗагрузитьОбъект()!.НаименованиеКоманды,
            Статус = Заказ.Статус, Мой = Мой, Свободен = Заказ.Участник == Неопределено, Появился = Заказ.ВремяПоявления,
            МожноПолучить = (РынокЗаказов.ПродажиОткрыты(Игра) или (Мой и Игра.Статус == СостоянияИгры.Идет
                и (Игра.Фаза == ФазыИгры.Продажи или Игра.Фаза == ФазыИгры.СтартоваяПродажа))) и не Завершено
                и (Заказ.Участник == Неопределено или (Мой и (Заказ.Статус == "Ошибка ERP" или (Заказ.Статус == "Отправляется"
                    и Заказ.НачалоПопытки != Неопределено и Момент.Сейчас() > Заказ.НачалоПопытки! + 15м))))))
    ;
    знч Команды = <СтрокаКомандыИгрока>[]
    для Строка из Запрос{ВЫБРАТЬ Ссылка, НаименованиеКоманды ИЗ УчастникиИгры
        ГДЕ Игра == %СсылкаИгры И Активен УПОРЯДОЧИТЬ ПО ПорядокУчастника}.Выполнить()
        знч Команда = Строка.Ссылка
        знч Заказы = Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Число, СУММА(Количество * Цена).ЗаменитьNull(0) КАК Сумма
            ИЗ ЗаказыРынка ГДЕ Раунд == %Раунд И Участник == %Команда}.Выполнить().ПервыйИлиНеопределено()!
        Команды.Добавить(новый СтрокаКомандыИгрока(Команда = Строка.НаименованиеКоманды,
            Готовность = ДоступКабинета.Завершено(Команда, Раунд, Токен) ? "Этап завершён" : "В работе",
            Заказов = Заказы.Число, Сумма = Заказы.Сумма))
    ;
    знч Остаток = Игра.Дедлайн == Неопределено ? 0 : (Игра.Дедлайн! - Момент.Сейчас()).ВСекундах()
    возврат новый СостояниеКабинета(Участник = Участник, Игра = СсылкаИгры, Название = Игра.Наименование,
        Команда = Участник.ЗагрузитьОбъект()!.НаименованиеКоманды, Фаза = Игра.Фаза, Статус = Игра.Статус,
        Раунд = Раунд == Неопределено ? 0 : Раунд!.ЗагрузитьОбъект()!.НомерРаунда, Токен = Токен,
        СекундОсталось = Игра.Статус == СостоянияИгры.Пауза ? Игра.ОстатокВремениПаузы : (Остаток > 0 ? Остаток : 0),
        ТаймерВключен = Игра.Дедлайн != Неопределено или (Игра.Статус == СостоянияИгры.Пауза и Игра.ОстатокВремениПаузы > 0),
        Демонстрационная = Игра.Демонстрационная, СвободныйРынок = Игра.СвободныйРынок,
        Завершено = Завершено, МожноЗавершить = не Завершено и Токен != ""
            и (Игра.Статус == СостоянияИгры.Подготовка или (Игра.Статус == СостоянияИгры.Идет
                и Игра.СостояниеФазы == СостоянияФазы.Открыта)),
        Рынок = Рынок, Команды = Команды)
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод ПолучитьЗаказ(Участник: УчастникиИгры.Ссылка, Заказ: ЗаказыРынка.Ссылка, Токен: Строка,
    Логин: Строка, Пароль: Строка): Строка
    знч СсылкаИгры = ДоступКабинета.ПроверитьИгрока(Участник)
    исп КонтекстДоступа.Привилегированный()
    знч ИграДоступа = СсылкаИгры.ЗагрузитьОбъект()!
    если не ИграДоступа.Демонстрационная
        знч КомандаДоступа = Участник.ЗагрузитьОбъект()!
        ПроверкиДанных.Требовать(КомандаДоступа.ПодключениеERP != Неопределено
            и КомандаДоступа.ПодключениеERP!.ЗагрузитьОбъект()!.Активно, "Не настроено активное подключение ERP команды")
        ПроверкиДанных.Требовать(не Логин.Пусто() и не Пароль.Пусто(), "Заполните доступ к ERP для текущего сеанса")
    ;
    // Отдельный серверный метод завершает транзакцию до сетевых запросов.
    знч Попытка = РынокЗаказов.Резервировать(Участник, Заказ, Токен)
    если Попытка == ""
        возврат "Заказ уже принят вашей командой"
    ;
    попытка
        исп КонтекстДоступа.Привилегированный()
        знч Игра = СсылкаИгры.ЗагрузитьОбъект()!
        знч Документ = Заказ.ЗагрузитьОбъект()!
        пер Результат: Соответствие<Строка, Объект?> = {:}
        если Игра.Демонстрационная
            Результат = {"refKey": Заказ.Ид.ВСтроку(), "number": "ДЕМО-%{Документ.НомерПакета}", "posted": Истина}
        иначе
            знч Команда = Участник.ЗагрузитьОбъект()!
            ПроверкиДанных.Требовать(Команда.ПодключениеERP != Неопределено, "Не настроено подключение ERP команды")
            знч База = Команда.ПодключениеERP!.ЗагрузитьОбъект()!
            ПроверкиДанных.Требовать(База.Активно, "Подключение ERP команды неактивно")
            знч ДатаДокумента = ПротоколERP.СтрокаJson(НастройкиERP.КалендарьРаунда(Игра,
                Документ.Раунд!.ЗагрузитьОбъект()!.НомерРаунда), "documentDate")
            Результат = НастройкаБазOData.СоздатьЗаказРынкаOData(База.АдресOData, Логин, Пароль,
                Команда.ОрганизацияERP, Заказ.Ид.ВСтроку(), Документ.Продукт!.ЗагрузитьОбъект()!.Код,
                Документ.Количество, Документ.Цена, ДатаДокумента)
        ;
        РынокЗаказов.Подтвердить(Участник, Заказ, Попытка, Результат, "")
        возврат Игра.Демонстрационная ? "Заказ принят в демонстрационном режиме" : "Заказ получен и проведён в ERP"
    поймать Ошибка: Исключение
        знч ДоСоздания = Ошибка это ПротоколERP.Ошибка
            и ["ODATA_AUTH", "ODATA_STOCK", "ODATA_MAPPING", "ODATA_ORDER"].Содержит((Ошибка как ПротоколERP.Ошибка).Код)
        // Неопределённый результат сохраняет владельца; повтор ищет тот же документ.
        РынокЗаказов.Подтвердить(Участник, Заказ, Попытка, Неопределено, "Не удалось подтвердить заказ ERP. Повторите отправку", ДоСоздания)
        выбросить Ошибка
    ;
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод ЗавершитьЭтап(Участник: УчастникиИгры.Ссылка, Токен: Строка, Описание: Строка)
    знч Пользователь = ДоступИгры.ТекущийПользователь()
    знч СсылкаИгры = ДоступКабинета.ПроверитьИгрока(Участник)
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Игра = СсылкаИгры.ЗагрузитьОбъект(Истина)!
    ДоступКабинета.ПроверитьИгрока(Участник)
    ПроверкиДанных.Требовать(Игра.ТокенФазы == Токен и Токен != ""
        и (Игра.Статус == СостоянияИгры.Подготовка или (Игра.Статус == СостоянияИгры.Идет
            и Игра.СостояниеФазы == СостоянияФазы.Открыта)), "Этап изменился или закрыт")
    знч Раунд = Игра.ТекущийРаунд
    если ДоступКабинета.Завершено(Участник, Раунд, Токен)
        возврат
    ;
    знч Незавершенный = Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ ЗаказыРынка
        ГДЕ Раунд == %Раунд И Участник == %Участник И Статус != "Проведен в ERP" И Статус != "Принят в демо"}.Выполнить().ПервыйИлиНеопределено()
    ПроверкиДанных.Требовать(Незавершенный == Неопределено, "Сначала дождитесь проведения всех полученных заказов")
    знч Записи = новый ЗаявленияКоманд.НаборЗаписей()
    Записи.Фильтр.Установить(Участник = Участник, Раунд = Раунд, ТокенФазы = Токен)
    Записи.ДобавитьЗапись(Участник = Участник, Раунд = Раунд, ТокенФазы = Токен, Завершено = Истина,
        Время = Момент.Сейчас(), Пользователь = Пользователь, Описание = Описание.Сократить(), ЗапрошенаБлокировкаERP = Истина)
    Записи.Записать()
    // Заявление игрока отдельно от технической готовности ERP и подтверждённых снимков.
    // Будущий адаптер применяет ЗапрошенаБлокировкаERP и подтверждает результат отдельным событием.
;
