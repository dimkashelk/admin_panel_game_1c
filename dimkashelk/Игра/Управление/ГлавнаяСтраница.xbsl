импорт Данные

@Обработчик
метод ПослеСоздания()
    ПрочитатьСводку()
    ПодключитьОбработчикТаймера(&АвтоматическоеОбновление, 15с)
;

метод АвтоматическоеОбновление()
    если Открыта
        ПрочитатьСводку()
    ;
;

метод ОбновитьСводку(Команда: ОбычнаяКоманда)
    ПрочитатьСводку()
;

метод ПрочитатьСводку()
    если ОбновлениеВыполняется
        возврат
    ;
    ОбновлениеВыполняется = Истина
    попытка
        знч Данные = УправлениеИгрой.ПолучитьГлавнуюСтраницу()
        ТекущиеИгры = Данные.Игры
        ПроблемныеКоманды = Данные.ПроблемныеКоманды
        СводкаИгр = ТекущиеИгры.Пусто() ? "Нет текущих игр, доступных вам как ведущему." : "Текущих игр: %{ТекущиеИгры.Размер()}. Черновики и подготовка включены; завершённые и отменённые скрыты."
        СводкаПроблем = ПроблемныеКоманды.Пусто() ? "Нет команд, ожидающих подтверждения текущей фазы." : "Ожидают подтверждения: %{ПроблемныеКоманды.Размер()}."
        СостояниеОбновления = "Обновлено: %{Время.Сейчас()}. Автоматическое обновление каждые 15 секунд."
    поймать Ошибка: Исключение
        ТекущиеИгры = []
        ПроблемныеКоманды = []
        СводкаИгр = "Список игр недоступен."
        СводкаПроблем = "Сводка проблем недоступна."
        СостояниеОбновления = "Не удалось обновить сводку: %{Ошибка.Описание}"
    ;
    ОбновлениеВыполняется = Ложь
;

метод ОткрытьНовуюИгру(Источник: Карточка, Событие: СобытиеПриНажатии)
    МастерНовойИгры.Открыть()
;

метод ОткрытьНастройку(Источник: Карточка, Событие: СобытиеПриНажатии)
    НастройкаИгры.Открыть()
;

метод ОткрытьПульт(Источник: Карточка, Событие: СобытиеПриНажатии)
    ПультВедущего.Открыть()
;

метод ОткрытьПультИгры(Команда: КомандаСПараметром<СтрокаТекущейИгры>, Параметр: СтрокаТекущейИгры)
    если Параметр.Игра != Неопределено
        знч Окно = новый ПультВедущего()
        Окно.Игра = Параметр.Игра
        Окно.Открыть()
    ;
;

метод НастроитьВыбраннуюИгру(Команда: КомандаСПараметром<СтрокаТекущейИгры>, Параметр: СтрокаТекущейИгры)
    если Параметр.Игра != Неопределено
        знч Окно = новый НастройкаИгры()
        Окно.СозданнаяИгра = Параметр.Игра
        Окно.ОбновитьНастройки(Неопределено)
        Окно.Открыть()
    ;
;
