импорт Данные

@Обработчик
метод ПослеСоздания()
    Фильтр = "Все"
    ОчиститьСостояние()
    попытка
        ДоступныеКоманды = ДоступКабинета.ВыборКоманд()
        знч КомандыИгрока = ДоступныеКоманды
        если не КомандыИгрока.Пусто()
            Участник = КомандыИгрока[0].Участник
            Прочитать()
        иначе
            Сообщение = "Ведущий ещё не назначил вас в команду"
        ;
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    ПодключитьОбработчикТаймера(&Тик, 1с)
;

метод КомандаИзменена(Источник: ПолеВвода<УчастникиИгры.Ссылка?>, Событие: СобытиеПриИзменении<УчастникиИгры.Ссылка?>)
    Сообщение = ""
    ОчиститьСостояние()
    попытка
        Прочитать()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод ОчиститьСостояние()
    Состояние = Неопределено
    МоментСостояния = Неопределено
    СледующееОбновление = Неопределено
    Токен = ""
    СостояниеРынка = ""
    Рынок = []
    ВсеЗаказы = []
    Команды = []
    ВыбранныйЗаказ = Неопределено
    Свободных = 0
    МоихЗаказов = 0
    МояСумма = 0
    ЗакрытыхЗаказов = 0
    НезакрытыхЗаказов = 0
    ЗакрытаяСумма = 0
    НезакрытаяСумма = 0
    ГотовыхКоманд = "—"
    ЗаголовокКабинета = "Ваш игровой штаб"
    Подзаголовок = "Выберите свою команду"
    Таймер = ""
    ТекстГотовности = "Здесь можно сообщить о завершении подготовки или текущего этапа"
    Обновлено = ""
;

метод Тик()
    если не Открыта или Занято или ОбновлениеВыполняется или Участник == Неопределено
        возврат
    ;
    если СледующееОбновление == Неопределено или Момент.Сейчас() >= СледующееОбновление!
        попытка
            Прочитать()
        поймать Ошибка: Исключение
            возврат
        ;
    ;
    ОбновитьТаймер()
;

метод Обновить(Команда: ОбычнаяКоманда)
    попытка
        Прочитать()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод Прочитать()
    если Участник == Неопределено или ОбновлениеВыполняется
        возврат
    ;
    знч ВыбраннаяКоманда = Участник!
    ОбновлениеВыполняется = Истина
    попытка
        знч Ответ = КабинетыИгроков.Получить(ВыбраннаяКоманда)
        если Участник == ВыбраннаяКоманда
            если Токен != "" и Токен != Ответ.Токен
                ВыбранныйЗаказ = Неопределено
                Комментарий = ""
                Сообщение = "Начался новый этап игры"
            ;
            Состояние = Ответ
            Токен = Ответ.Токен
            Фаза = Ответ.Фаза
            МоментСостояния = Момент.Сейчас()
            СледующееОбновление = Момент.Сейчас() + 5с
            ЗаголовокКабинета = "Команда %{Ответ.Команда}"
            Подзаголовок = "%{Ответ.Название} · раунд %{Ответ.Раунд} · %{Ответ.Статус.Представление()}"
            СостояниеРынка = Ответ.СостояниеРынка
            // Не заменяем источники списков при неизменном ответе: сохраняем карточки и прокрутку.
            если не РынокСовпадает(ВсеЗаказы, Ответ.Рынок)
                ВсеЗаказы = Ответ.Рынок
                ПересчитатьПоказатели()
                ОбновитьВыбор()
                ПрименитьФильтр()
            ;
            если не КомандыСовпадают(Команды, Ответ.Команды)
                Команды = Ответ.Команды
                пер Готово = 0
                для Команда из Команды
                    если Команда.Готовность == "Этап завершён" или Команда.Готовность == "Игра завершена"
                        Готово = Готово + 1
                    ;
                ;
                ГотовыхКоманд = "%{Готово} / %{Команды.Размер()}"
            ;
            если Ответ.Статус == СостоянияИгры.Завершена
                ТекстГотовности = "Игра завершена. Итог последнего раунда зафиксирован."
            иначе если Ответ.Завершено
                ТекстГотовности = "Этап команды завершён. Завершение зафиксировано для ведущего."
            иначе если Ответ.ТаймерВключен
                ТекстГотовности = "Можно завершить этап досрочно. По истечении времени он завершится автоматически."
            иначе
                ТекстГотовности = "Подтвердите результат, когда команда закончит работу на этом этапе"
            ;
            Обновлено = "Обновлено %{Время.Сейчас()} · синхронизация каждые 5 секунд"
            ОбновитьТаймер()
        ;
    поймать Ошибка: Исключение
        если Участник == ВыбраннаяКоманда
            ОчиститьСостояние()
            Обновлено = "Связь с игрой потеряна. Повтор через 5 секунд"
            СледующееОбновление = Момент.Сейчас() + 5с
        ;
        ОбновлениеВыполняется = Ложь
        выбросить Ошибка
    ;
    ОбновлениеВыполняется = Ложь
;

метод ОбновитьТаймер()
    если Состояние == Неопределено или МоментСостояния == Неопределено
        возврат
    ;
    знч Ответ = Состояние!
    если не Ответ.ТаймерВключен
        Таймер = "%{Ответ.Фаза.Представление()} · время без ограничения"
        возврат
    ;
    знч Остаток = СводкиИгры.ОстатокПоСостоянию(Ответ.Статус, Ответ.ТаймерВключен,
        Ответ.СекундОсталось, (Момент.Сейчас() - МоментСостояния!).ВСекундах())
    знч Минуты = (Остаток / 60).Округлить(0, РежимОкругления.Вниз)
    знч Секунды = (Остаток - Минуты * 60).Округлить(0, РежимОкругления.Вниз)
    знч ТекстСекунд = Секунды < 10 ? "0%{Секунды}" : "%{Секунды}"
    Таймер = "%{Ответ.Фаза.Представление()} · %{Минуты}:%{ТекстСекунд}"
    если Ответ.Статус == СостоянияИгры.Пауза
        Таймер = Таймер + " · пауза"
    ;
;

метод ЗаказВыбран(Источник: Список<ИсточникДанныхМассив<СтрокаРынкаИгрока>>, Событие: СобытиеСДанными<СтрокаСписка<СтрокаРынкаИгрока>>)
    если не Занято
        ВыбранныйЗаказ = Событие.Данные.ДанныеСтроки
    ;
;

// Сравниваем значения, а не экземпляры структур, полученные новым серверным вызовом.
метод РынокСовпадает(Старые: ЧитаемыйМассив<СтрокаРынкаИгрока>, Новые: ЧитаемыйМассив<СтрокаРынкаИгрока>): Булево
    если Старые.Размер() != Новые.Размер()
        возврат Ложь
    ;
    пер Индекс = 0
    для Новый из Новые
        знч Старый = Старые[Индекс]
        если Старый.Заказ != Новый.Заказ или Старый.Номер != Новый.Номер или Старый.Модель != Новый.Модель
            или Старый.Количество != Новый.Количество или Старый.Цена != Новый.Цена или Старый.Сумма != Новый.Сумма
            или Старый.Команда != Новый.Команда или Старый.Статус != Новый.Статус или Старый.Мой != Новый.Мой
            или Старый.МожноПолучить != Новый.МожноПолучить или Старый.Появился != Новый.Появился
            или Старый.Свободен != Новый.Свободен или Старый.Закрыт != Новый.Закрыт или Старый.СостояниеERP != Новый.СостояниеERP
            возврат Ложь
        ;
        Индекс = Индекс + 1
    ;
    возврат Истина
;

метод КомандыСовпадают(Старые: ЧитаемыйМассив<СтрокаКомандыИгрока>, Новые: ЧитаемыйМассив<СтрокаКомандыИгрока>): Булево
    если Старые.Размер() != Новые.Размер()
        возврат Ложь
    ;
    пер Индекс = 0
    для Новый из Новые
        знч Старый = Старые[Индекс]
        если Старый.Команда != Новый.Команда или Старый.Готовность != Новый.Готовность
            или Старый.Заказов != Новый.Заказов или Старый.Сумма != Новый.Сумма
            или Старый.ЗакрытыхЗаказов != Новый.ЗакрытыхЗаказов или Старый.НезакрытыхЗаказов != Новый.НезакрытыхЗаказов
            или Старый.ЗакрытыйПортфель != Новый.ЗакрытыйПортфель или Старый.НезакрытыйПортфель != Новый.НезакрытыйПортфель
            возврат Ложь
        ;
        Индекс = Индекс + 1
    ;
    возврат Истина
;

метод ОбновитьВыбор()
    если ВыбранныйЗаказ == Неопределено
        возврат
    ;
    знч СсылкаЗаказа = ВыбранныйЗаказ!.Заказ
    пер НовыйВыбор: СтрокаРынкаИгрока? = Неопределено
    для Заказ из ВсеЗаказы
        если Заказ.Заказ == СсылкаЗаказа
            НовыйВыбор = Заказ
        ;
    ;
    ВыбранныйЗаказ = НовыйВыбор
;

метод ПрименитьФильтр()
    знч Отфильтрованные = <СтрокаРынкаИгрока>[]
    для Заказ из ВсеЗаказы
        если Фильтр == "Все" или (Фильтр == "Свободные" и Заказ.Свободен) или (Фильтр == "Мои" и Заказ.Мой)
            или (Фильтр == "Незакрытые" и Заказ.Мой и не Заказ.Закрыт)
            или (Фильтр == "Закрытые" и Заказ.Мой и Заказ.Закрыт)
            Отфильтрованные.Добавить(Заказ)
        ;
    ;
    если не РынокСовпадает(Рынок, Отфильтрованные)
        Рынок = Отфильтрованные
    ;
;

метод ПоказатьВсе(Команда: ОбычнаяКоманда)
    Фильтр = "Все"
    ПрименитьФильтр()
;

метод ПоказатьСвободные(Команда: ОбычнаяКоманда)
    Фильтр = "Свободные"
    ПрименитьФильтр()
;

метод ПоказатьМои(Команда: ОбычнаяКоманда)
    Фильтр = "Мои"
    ПрименитьФильтр()
;

метод ПоказатьНезакрытые(Команда: ОбычнаяКоманда)
    Фильтр = "Незакрытые"
    ПрименитьФильтр()
;

метод ПоказатьЗакрытые(Команда: ОбычнаяКоманда)
    Фильтр = "Закрытые"
    ПрименитьФильтр()
;

метод ПолучитьЗаказ(Команда: ОбычнаяКоманда)
    если Занято или ОбновлениеВыполняется
        возврат
    ;
    попытка
        ПроверкиДанных.Требовать(Участник != Неопределено и ВыбранныйЗаказ != Неопределено
            и ВыбранныйЗаказ!.МожноПолучить, "Выберите доступный заказ")
        знч КомандаДействия = Участник!
        знч ЗаказДействия = ВыбранныйЗаказ!.Заказ!
        Занято = Истина
        Сообщение = "Закрепляем заказ за командой и отправляем в ERP…"
        знч Результат = КабинетыИгроков.ПолучитьЗаказ(КомандаДействия, ЗаказДействия, Токен)
        если Участник == КомандаДействия
            Сообщение = Результат
            Прочитать()
        ;
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
        попытка
            Прочитать()
        поймать ОшибкаЧтения: Исключение
            Обновлено = "Не удалось обновить рынок. Повтор через 5 секунд"
        ;
    ;
    Занято = Ложь
;

метод ЗавершитьЭтап(Команда: ОбычнаяКоманда)
    если Занято или ОбновлениеВыполняется
        возврат
    ;
    попытка
        ПроверкиДанных.Требовать(Участник != Неопределено и Состояние != Неопределено
            и Состояние!.МожноЗавершить, "Завершение этапа сейчас недоступно")
        Занято = Истина
        КабинетыИгроков.ЗавершитьЭтап(Участник!, Токен, Комментарий)
        Сообщение = "Готовность команды зафиксирована"
        Прочитать()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    Занято = Ложь
;

метод ПолучитьКомандыДляВыбора(): Массив<ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>>
    знч Выбор = новый Массив<ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>>()
    для Команда из ДоступныеКоманды
        Выбор.Добавить(новый ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>(
            Значение = Команда.Участник, Представление = Команда.Представление))
    ;
    возврат Выбор
;

метод ПересчитатьПоказатели()
    Свободных = 0
    МоихЗаказов = 0
    МояСумма = 0
    ЗакрытыхЗаказов = 0
    НезакрытыхЗаказов = 0
    ЗакрытаяСумма = 0
    НезакрытаяСумма = 0
    для Заказ из ВсеЗаказы
        если Заказ.Свободен
            Свободных = Свободных + 1
        ;
        если Заказ.Мой
            МоихЗаказов = МоихЗаказов + 1
            МояСумма = МояСумма + Заказ.Сумма
            если Заказ.Закрыт
                ЗакрытыхЗаказов = ЗакрытыхЗаказов + 1
                ЗакрытаяСумма = ЗакрытаяСумма + Заказ.Сумма
            иначе
                НезакрытыхЗаказов = НезакрытыхЗаказов + 1
                НезакрытаяСумма = НезакрытаяСумма + Заказ.Сумма
            ;
        ;
    ;
;
