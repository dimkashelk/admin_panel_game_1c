импорт Данные

@Обработчик
метод ПослеСоздания()
    Фильтр = "Все"
    ОчиститьСостояние()
    попытка
        ДоступныеКоманды = ДоступКабинета.ВыборКоманд()
        знч КомандыИгрока = ДоступныеКоманды
        если не КомандыИгрока.Пусто()
            Участник = КомандыИгрока[0].Участник
            Прочитать()
        иначе
            Сообщение = "Ведущий ещё не назначил вас в команду"
        ;
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    ПодключитьОбработчикТаймера(&Тик, 1с)
;

метод КомандаИзменена(Источник: ПолеВвода<УчастникиИгры.Ссылка?>, Событие: СобытиеПриИзменении<УчастникиИгры.Ссылка?>)
    // Учётные данные одной команды не используются для другой.
    Логин = ""
    Пароль = ""
    Сообщение = ""
    ОчиститьСостояние()
    попытка
        Прочитать()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод ОчиститьСостояние()
    Состояние = Неопределено
    МоментСостояния = Неопределено
    СледующееОбновление = Неопределено
    Токен = ""
    Рынок = []
    ВсеЗаказы = []
    Команды = []
    ВыбранныйЗаказ = Неопределено
    Свободных = 0
    МоихЗаказов = 0
    МояСумма = 0
    ГотовыхКоманд = "—"
    ЗаголовокКабинета = "Ваш игровой штаб"
    Подзаголовок = "Выберите свою команду"
    Таймер = ""
    ТекстГотовности = "Здесь можно сообщить о завершении подготовки или текущего этапа"
    Обновлено = ""
;

метод Тик()
    если не Открыта или Занято или ОбновлениеВыполняется или Участник == Неопределено
        возврат
    ;
    если СледующееОбновление == Неопределено или Момент.Сейчас() >= СледующееОбновление!
        попытка
            Прочитать()
        поймать Ошибка: Исключение
            возврат
        ;
    ;
    ОбновитьТаймер()
;

метод Обновить(Команда: ОбычнаяКоманда)
    попытка
        Прочитать()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод Прочитать()
    если Участник == Неопределено или ОбновлениеВыполняется
        возврат
    ;
    знч ВыбраннаяКоманда = Участник!
    ОбновлениеВыполняется = Истина
    попытка
        знч Ответ = КабинетыИгроков.Получить(ВыбраннаяКоманда)
        если Участник == ВыбраннаяКоманда
            если Токен != "" и Токен != Ответ.Токен
                ВыбранныйЗаказ = Неопределено
                Комментарий = ""
                Сообщение = "Начался новый этап игры"
            ;
            Состояние = Ответ
            Токен = Ответ.Токен
            Фаза = Ответ.Фаза
            МоментСостояния = Момент.Сейчас()
            СледующееОбновление = Момент.Сейчас() + 5с
            ЗаголовокКабинета = "Команда %{Ответ.Команда}"
            Подзаголовок = "%{Ответ.Название} · раунд %{Ответ.Раунд} · %{Ответ.Статус.Представление()}"
            если Ответ.Демонстрационная
                Подзаголовок = Подзаголовок + " · демонстрация"
            ;
            ВсеЗаказы = Ответ.Рынок
            Команды = Ответ.Команды
            Свободных = 0
            МоихЗаказов = 0
            МояСумма = 0
            для Заказ из ВсеЗаказы
                если Заказ.Свободен
                    Свободных = Свободных + 1
                ;
                если Заказ.Мой
                    МоихЗаказов = МоихЗаказов + 1
                    МояСумма = МояСумма + Заказ.Сумма
                ;
            ;
            пер Готово = 0
            для Команда из Команды
                если Команда.Готовность == "Этап завершён"
                    Готово = Готово + 1
                ;
            ;
            ГотовыхКоманд = "%{Готово} / %{Команды.Размер()}"
            ТекстГотовности = Ответ.Завершено ? "Команда завершила этап. Ведущий видит ваше подтверждение."
                : "Подтвердите результат, когда команда закончит работу на этом этапе"
            Обновлено = "Обновлено %{Время.Сейчас()} · синхронизация каждые 5 секунд"
            ОбновитьВыбор()
            ПрименитьФильтр()
            ОбновитьТаймер()
        ;
    поймать Ошибка: Исключение
        если Участник == ВыбраннаяКоманда
            ОчиститьСостояние()
            Обновлено = "Связь с игрой потеряна. Повтор через 5 секунд"
            СледующееОбновление = Момент.Сейчас() + 5с
        ;
        ОбновлениеВыполняется = Ложь
        выбросить Ошибка
    ;
    ОбновлениеВыполняется = Ложь
;

метод ОбновитьТаймер()
    если Состояние == Неопределено или МоментСостояния == Неопределено
        возврат
    ;
    знч Ответ = Состояние!
    если не Ответ.ТаймерВключен
        Таймер = "%{Ответ.Фаза.Представление()} · время без ограничения"
        возврат
    ;
    знч Остаток = СводкиИгры.ОстатокПоСостоянию(Ответ.Статус, Ответ.ТаймерВключен,
        Ответ.СекундОсталось, (Момент.Сейчас() - МоментСостояния!).ВСекундах())
    знч Минуты = (Остаток / 60).Округлить(0, РежимОкругления.Вниз)
    знч Секунды = (Остаток - Минуты * 60).Округлить(0, РежимОкругления.Вниз)
    знч ТекстСекунд = Секунды < 10 ? "0%{Секунды}" : "%{Секунды}"
    Таймер = "%{Ответ.Фаза.Представление()} · %{Минуты}:%{ТекстСекунд}"
    если Ответ.Статус == СостоянияИгры.Пауза
        Таймер = Таймер + " · пауза"
    ;
;

метод ЗаказВыбран(Источник: Список<ИсточникДанныхМассив<СтрокаРынкаИгрока>>, Событие: СобытиеСДанными<СтрокаСписка<СтрокаРынкаИгрока>>)
    если не Занято
        ВыбранныйЗаказ = Событие.Данные.ДанныеСтроки
    ;
;

метод ОбновитьВыбор()
    если ВыбранныйЗаказ == Неопределено
        возврат
    ;
    знч СсылкаЗаказа = ВыбранныйЗаказ!.Заказ
    ВыбранныйЗаказ = Неопределено
    для Заказ из ВсеЗаказы
        если Заказ.Заказ == СсылкаЗаказа
            ВыбранныйЗаказ = Заказ
        ;
    ;
;

метод ПрименитьФильтр()
    Рынок = []
    для Заказ из ВсеЗаказы
        если Фильтр == "Все" или (Фильтр == "Свободные" и Заказ.Свободен) или (Фильтр == "Мои" и Заказ.Мой)
            Рынок.Добавить(Заказ)
        ;
    ;
;

метод ПоказатьВсе(Команда: ОбычнаяКоманда)
    Фильтр = "Все"
    ПрименитьФильтр()
;

метод ПоказатьСвободные(Команда: ОбычнаяКоманда)
    Фильтр = "Свободные"
    ПрименитьФильтр()
;

метод ПоказатьМои(Команда: ОбычнаяКоманда)
    Фильтр = "Мои"
    ПрименитьФильтр()
;

метод ПолучитьЗаказ(Команда: ОбычнаяКоманда)
    если Занято или ОбновлениеВыполняется
        возврат
    ;
    попытка
        ПроверкиДанных.Требовать(Участник != Неопределено и ВыбранныйЗаказ != Неопределено
            и ВыбранныйЗаказ!.МожноПолучить, "Выберите доступный заказ")
        знч КомандаДействия = Участник!
        знч ЗаказДействия = ВыбранныйЗаказ!.Заказ!
        Занято = Истина
        Сообщение = "Закрепляем заказ за командой и отправляем в ERP…"
        знч Результат = КабинетыИгроков.ПолучитьЗаказ(КомандаДействия, ЗаказДействия, Токен, Логин, Пароль)
        если Участник == КомандаДействия
            Сообщение = Результат
            Прочитать()
        ;
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
        попытка
            Прочитать()
        поймать ОшибкаЧтения: Исключение
            Обновлено = "Не удалось обновить рынок. Повтор через 5 секунд"
        ;
    ;
    Занято = Ложь
;

метод ЗавершитьЭтап(Команда: ОбычнаяКоманда)
    если Занято или ОбновлениеВыполняется
        возврат
    ;
    попытка
        ПроверкиДанных.Требовать(Участник != Неопределено и Состояние != Неопределено
            и Состояние!.МожноЗавершить, "Завершение этапа сейчас недоступно")
        Занято = Истина
        КабинетыИгроков.ЗавершитьЭтап(Участник!, Токен, Комментарий)
        Сообщение = "Готовность команды зафиксирована"
        Прочитать()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    Занято = Ложь
;

метод ПолучитьКомандыДляВыбора(): Массив<ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>>
    знч Выбор = новый Массив<ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>>()
    для Команда из ДоступныеКоманды
        Выбор.Добавить(новый ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>(
            Значение = Команда.Участник, Представление = Команда.Представление))
    ;
    возврат Выбор
;
