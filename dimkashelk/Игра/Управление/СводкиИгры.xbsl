импорт Данные

@ВПодсистеме
метод ИграТекущая(Статус: СостоянияИгры): Булево
    возврат Статус != СостоянияИгры.Завершена и Статус != СостоянияИгры.Отменена
;

@ВПодсистеме
метод ОжидаетсяГотовность(Статус: СостоянияИгры): Булево
    возврат Статус == СостоянияИгры.Идет или Статус == СостоянияИгры.Пауза
;

@ВПодсистеме
метод КомандаГотова(Готов: Булево, Снимок: СнимкиERP.Ссылка?, Ошибка: Строка): Булево
    возврат Готов и Снимок != Неопределено и Ошибка == ""
;

@ВПодсистеме
метод ПричинаОжидания(Готов: Булево, Снимок: СнимкиERP.Ссылка?, Ошибка: Строка): Строка
    если Ошибка != ""
        возврат Ошибка
    ;
    если КомандаГотова(Готов, Снимок, Ошибка)
        возврат ""
    ;
    если Снимок == Неопределено
        возврат "Снимок текущей фазы не принят"
    ;
    возврат "Команда не подтвердила готовность"
;

@ВПодсистеме
метод ОстатокПоСостоянию(Статус: СостоянияИгры, ТаймерВключен: Булево,
    СекундОсталось: Число, ПрошлоСекунд: Число): Число
    если не ТаймерВключен или не ОжидаетсяГотовность(Статус)
        возврат 0
    ;
    пер Остаток = СекундОсталось
    если Статус == СостоянияИгры.Идет и ПрошлоСекунд > 0
        Остаток = Остаток - ПрошлоСекунд
    ;
    возврат Остаток > 0 ? Остаток.Округлить(0, РежимОкругления.Вниз) : 0
;

@ВПодсистеме
метод ПредупреждениеВремени(Статус: СостоянияИгры, ТаймерВключен: Булево, СекундОсталось: Число): Строка
    если Статус != СостоянияИгры.Идет или не ТаймерВключен
        возврат ""
    ;
    если СекундОсталось <= 0
        возврат "Время фазы истекло. Проверьте готовность команд и зафиксируйте фазу; переход выполняет ведущий."
    ;
    если СекундОсталось <= 60
        возврат "До окончания фазы осталось не более минуты. Проверьте готовность команд."
    ;
    возврат ""
;

@ВПодсистеме
метод СформироватьСводку(Пульты: ЧитаемыйМассив<СостояниеПульта>): СводкаГлавнойСтраницы
    знч Игры = <СтрокаТекущейИгры>[]
    знч Проблемы = <СтрокаПроблемнойКоманды>[]
    для Пульт из Пульты
        если не ИграТекущая(Пульт.Статус)
            продолжить
        ;
        пер Готово = 0
        пер Ожидают = 0
        если ОжидаетсяГотовность(Пульт.Статус)
            для Команда из Пульт.Участники
                если КомандаГотова(Команда.Готов, Команда.Снимок, Команда.Причина)
                    Готово = Готово + 1
                иначе
                    Ожидают = Ожидают + 1
                    Проблемы.Добавить(новый СтрокаПроблемнойКоманды(Игра = Пульт.Игра,
                        НаименованиеИгры = Пульт.Наименование, Участник = Команда.Участник,
                        Команда = Команда.Команда, Время = Команда.Время,
                        Причина = ПричинаОжидания(Команда.Готов, Команда.Снимок, Команда.Причина)))
                ;
            ;
        ;
        Игры.Добавить(новый СтрокаТекущейИгры(Игра = Пульт.Игра, Наименование = Пульт.Наименование,
            Статус = Пульт.Статус, Фаза = Пульт.Фаза, НомерРаунда = Пульт.НомерРаунда,
            Готово = Готово, Всего = Пульт.Участники.Размер(), Ожидают = Ожидают))
    ;
    возврат новый СводкаГлавнойСтраницы(Игры = Игры, ПроблемныеКоманды = Проблемы)
;
