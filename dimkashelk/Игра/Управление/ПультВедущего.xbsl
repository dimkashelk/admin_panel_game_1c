импорт Данные
импорт Аналитика

@Обработчик
метод ПослеСоздания()
    СброситьСостояние()
    АвтоматическоеОбновление()
    // Один обработчик на экземпляр; платформа удаляет его при уничтожении формы.
    ПодключитьОбработчикТаймера(&АвтоматическоеОбновление, 1с)
;

метод ИграПриИзменении(Источник: ПолеВвода<Игры.Ссылка?>, Событие: СобытиеПриИзменении<Игры.Ссылка?>)
    СброситьСостояние()
    АвтоматическоеОбновление()
;

метод СброситьСостояние()
    Состояние = Неопределено
    МоментСостояния = Неопределено
    МоментСледующегоОбновления = Неопределено
    Версия = 0
    Токен = ""
    Участники = []
    Участник = Неопределено
    Предложения = []
    ПредупреждениеВремени = ""
    ОписаниеРежима = ""
    Сообщение = ""
    Сводка = "Выберите игру для просмотра состояния."
    СостояниеОбновления = ""
;

метод АвтоматическоеОбновление()
    если не Открыта или ОбновлениеВыполняется
        возврат
    ;
    если Состояние != Неопределено и Состояние!.Игра != Игра
        СброситьСостояние()
    ;
    если Игра == Неопределено
        возврат
    ;
    если МоментСледующегоОбновления == Неопределено или Момент.Сейчас() >= МоментСледующегоОбновления!
        попытка
            ПрочитатьСостояние()
        поймать Ошибка: Исключение
            возврат
        ;
    ;
    ОбновитьОтображение()
;

метод Обновить(Команда: ОбычнаяКоманда)
    попытка
        ПрочитатьСостояние()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод ПрочитатьСостояние()
    ПроверкиДанных.Требовать(Игра != Неопределено, "Выберите игру")
    если ОбновлениеВыполняется
        возврат
    ;
    знч ВыбраннаяИгра = Игра!
    ОбновлениеВыполняется = Истина
    попытка
        знч Пульт = УправлениеИгрой.ПолучитьПульт(ВыбраннаяИгра)
        // Ответ предыдущей игры не должен попасть в пульт после смены выбора.
        если Игра == ВыбраннаяИгра
            если Токен != "" и Токен != Пульт.Токен
                Предложения = []
                Сообщение = "Фаза изменилась. Заполните предложения для новой фазы."
            ;
            Состояние = Пульт
            МоментСостояния = Момент.Сейчас()
            МоментСледующегоОбновления = Момент.Сейчас() + 5с
            Версия = Пульт.Версия
            Токен = Пульт.Токен
            Участники = Пульт.Участники
            ОписаниеРежима = Пульт.Демонстрационная ? "Демонстрационная игра: все снимки и результаты тестовые." : "Обычная игра. Подключение и обмен с ERP отложены."
            СостояниеОбновления = "Обновлено: %{Время.Сейчас()}. Готовность обновляется каждые 5 секунд."
            ОбновитьОтображение()
        ;
    поймать Ошибка: Исключение
        если Игра == ВыбраннаяИгра
            СостояниеНедоступно(Ошибка)
        ;
        ОбновлениеВыполняется = Ложь
        выбросить Ошибка
    ;
    ОбновлениеВыполняется = Ложь
;

метод СостояниеНедоступно(Ошибка: Исключение)
    // Старые данные не выдаются за актуальные после потери связи или прав.
    Состояние = Неопределено
    МоментСостояния = Неопределено
    Участники = []
    ПредупреждениеВремени = ""
    ОписаниеРежима = ""
    Сводка = "Состояние игры недоступно."
    СостояниеОбновления = "Не удалось обновить пульт: %{Ошибка.Описание}. Повтор через 5 секунд."
    МоментСледующегоОбновления = Момент.Сейчас() + 5с
;

метод ОбновитьОтображение()
    если Состояние == Неопределено или МоментСостояния == Неопределено
        возврат
    ;
    знч Пульт = Состояние!
    знч Остаток = СводкиИгры.ОстатокПоСостоянию(Пульт.Статус, Пульт.ТаймерВключен,
        Пульт.СекундОсталось, (Момент.Сейчас() - МоментСостояния!).ВСекундах())
    пер Таймер = "без ограничения времени"
    если Пульт.ТаймерВключен
        знч Минуты = (Остаток / 60).Округлить(0, РежимОкругления.Вниз)
        знч Секунды = Остаток - Минуты * 60
        знч ТекстСекунд = Секунды < 10 ? "0%{Секунды}" : "%{Секунды}"
        Таймер = "осталось %{Минуты}:%{ТекстСекунд}"
        если Пульт.Статус == СостоянияИгры.Пауза
            Таймер = "таймер на паузе: %{Минуты}:%{ТекстСекунд}"
        ;
    ;
    пер Готово = 0
    для Команда из Пульт.Участники
        если Команда.Готов
            Готово = Готово + 1
        ;
    ;
    Сводка = "%{Пульт.Статус} · %{Пульт.Фаза} · раунд %{Пульт.НомерРаунда} · %{Таймер} · готовы %{Готово} из %{Пульт.Участники.Размер()}"
    ПредупреждениеВремени = СводкиИгры.ПредупреждениеВремени(Пульт.Статус, Пульт.ТаймерВключен, Остаток)
;

метод Подготовить(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено, "Выберите игру")
        УправлениеИгрой.Подготовить(Игра!, Версия)
        ПрочитатьСостояние()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

