импорт Данные
импорт Аналитика

метод Обновить(Команда: ОбычнаяКоманда)
    попытка
        ПрочитатьСостояние()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод ПрочитатьСостояние()
    ПроверкиДанных.Требовать(Игра != Неопределено, "Выберите игру")
    знч Пульт = УправлениеИгрой.ПолучитьПульт(Игра!)
    Версия = Пульт.Версия
    Токен = Пульт.Токен
    Участники = Пульт.Участники
    знч Таймер = Пульт.ТаймерВключен ? "осталось при обновлении: %{Пульт.СекундОсталось} с." : "без ограничения времени"
    Сводка = "%{Пульт.Статус} · %{Пульт.Фаза} · раунд %{Пульт.НомерРаунда} · %{Таймер}"
    Сообщение = Пульт.Демонстрационная ? "Демонстрационная игра: все снимки и результаты тестовые." : "Обычная игра. Подключение и обмен с ERP отложены."
;

метод Подготовить(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено, "Выберите игру")
        УправлениеИгрой.Подготовить(Игра!, Версия)
        ПрочитатьСостояние()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

