импорт Данные
импорт Аналитика
импорт Обмен

метод НастроитьИгру(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено, "Выберите игру")
        знч Окно = новый НастройкаИгры()
        Окно.Инициализировать(Игра)
        Окно.Открыть()
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;

@Обработчик
метод ПослеСоздания()
    СброситьСостояние()
    АвтоматическоеОбновление()
    // Один обработчик на экземпляр; платформа удаляет его при уничтожении формы.
    ПодключитьОбработчикТаймера(&АвтоматическоеОбновление, 1с, Однократно = Ложь)
;

метод ИграПриИзменении(Источник: ПолеВвода<Игры.Ссылка?>, Событие: СобытиеПриИзменении<Игры.Ссылка?>)
    СброситьСостояние()
    АвтоматическоеОбновление()
;

метод СброситьСостояние()
    Состояние = Неопределено
    БазыГотовы = Ложь
    СостояниеПодготовкиБаз = ""
    ОжидаласьПодготовка = Ложь
    МоментСостояния = Неопределено
    МоментСледующегоОбновления = Неопределено
    Версия = 0
    Токен = ""
    Участники = []
    Участник = Неопределено
    ПредупреждениеВремени = ""
    ОписаниеРежима = ""
    Сообщение = ""
    Сводка = "Выберите игру для просмотра состояния."
    СледующийШаг = "Выберите игру."
    СостояниеОбновления = ""
;

метод АвтоматическоеОбновление()
    если ОбновлениеВыполняется
        возврат
    ;
    если Состояние != Неопределено и Состояние!.Игра != Игра
        СброситьСостояние()
    ;
    если Игра == Неопределено
        возврат
    ;
    если МоментСледующегоОбновления == Неопределено или Момент.Сейчас() >= МоментСледующегоОбновления!
        попытка
            ПрочитатьСостояние()
        поймать Ошибка: Исключение
            СообщитьОшибкуОбновления(Ошибка.Описание)
            возврат
        ;
    ;
    ОбновитьОтображение()
;

метод Обновить(Команда: ОбычнаяКоманда)
    попытка
        ПрочитатьСостояние()
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;

метод ПрочитатьСостояние()
    ПроверкиДанных.Требовать(Игра != Неопределено, "Выберите игру")
    если ОбновлениеВыполняется
        возврат
    ;
    знч ВыбраннаяИгра = Игра!
    ОбновлениеВыполняется = Истина
    попытка
        знч Подготовка = НастройкаБазOData.СостояниеНастройкиБаз(ВыбраннаяИгра)
        знч Пульт = УправлениеИгрой.ПолучитьПульт(ВыбраннаяИгра)
        // Ответ предыдущей игры не должен попасть в пульт после смены выбора.
        если Игра == ВыбраннаяИгра
            СостояниеПодготовкиБаз = Подготовка.Получить("text") как Строка
            БазыГотовы = Подготовка.Получить("ready") как Булево
            знч Ошибки = Подготовка.Получить("errors") как Строка
            если Ошибки != "" и Ошибки != ПоследняяОшибкаПодготовки
                Сообщить(Ошибки)
            ;
            ПоследняяОшибкаПодготовки = Ошибки
            знч Выполняется = Подготовка.Получить("running") как Булево
            если ОжидаласьПодготовка и не Выполняется и БазыГотовы
                Сообщить("Настройка баз ERP завершена.")
            ;
            ОжидаласьПодготовка = Выполняется
            если Токен != "" и Токен != Пульт.Токен
                Сообщение = Пульт.ТолькоРынок ? "Состояние рынка изменилось. Данные обновлены." : "Фаза изменилась. Ожидается готовность команд и ERP."
            ;
            ПоследняяОшибкаОбновления = ""
            Состояние = Пульт
            МоментСостояния = Момент.Сейчас()
            МоментСледующегоОбновления = Момент.Сейчас() + 5с
            Версия = Пульт.Версия
            Токен = Пульт.Токен
            Участники = Пульт.Участники
            ОписаниеРежима = Пульт.ЗаказыПоЦенамERP
                ? "Заказы по ценам ERP: установка цен → персональные заказы → выполнение и анализ → планирование, закупки, производство. В конце установки цен прайс-листы собираются автоматически. Переход выполняет ведущий после готовности команд."
                : Пульт.ТолькоРынок
                ? "Только рынок OData: получайте заказы в кабинете игрока. Заказ создаётся и проводится в ERP. Для завершения раунда нужны проведённые заказы и завершение этапа игроками."
                : "Игра сама обращается к ERP: документы через OData, фиксация и итоги через HTTP-сервис. Переходы ждут проверенных результатов."
            ОписаниеРежима = ОписаниеРежима + " " + Пульт.СостояниеРынка
            СостояниеОбновления = "Обновлено: %{Время.Сейчас()}. Готовность обновляется каждые 5 секунд."
            ОбновитьОтображение()
        ;
    поймать Ошибка: Исключение
        если Игра == ВыбраннаяИгра
            СостояниеНедоступно(Ошибка)
        ;
        ОбновлениеВыполняется = Ложь
        выбросить Ошибка
    ;
    ОбновлениеВыполняется = Ложь
;

метод СостояниеНедоступно(Ошибка: Исключение)
    // Старые данные не выдаются за актуальные после потери связи или прав.
    Состояние = Неопределено
    БазыГотовы = Ложь
    СостояниеПодготовкиБаз = ""
    ОжидаласьПодготовка = Ложь
    МоментСостояния = Неопределено
    Участники = []
    ПредупреждениеВремени = ""
    ОписаниеРежима = ""
    Сводка = "Состояние игры недоступно."
    СледующийШаг = "Не удалось прочитать игру. Нажмите «Обновить состояние» или дождитесь восстановления связи."
    СостояниеОбновления = "Не удалось обновить пульт: %{Ошибка.Описание}. Повтор через 5 секунд."
    МоментСледующегоОбновления = Момент.Сейчас() + 5с
;

метод ОбновитьОтображение()
    если Состояние == Неопределено или МоментСостояния == Неопределено
        возврат
    ;
    знч Пульт = Состояние!
    знч Остаток = СводкиИгры.ОстатокПоСостоянию(Пульт.Статус, Пульт.ТаймерВключен,
        Пульт.СекундОсталось, (Момент.Сейчас() - МоментСостояния!).ВСекундах())
    пер Таймер = "без ограничения времени"
    если Пульт.ТаймерВключен
        знч Минуты = (Остаток / 60).Округлить(0, РежимОкругления.Вниз)
        знч Секунды = (Остаток - Минуты * 60).Округлить(0, РежимОкругления.Вниз)
        знч ТекстСекунд = Секунды < 10 ? "0%{Секунды}" : "%{Секунды}"
        Таймер = "осталось %{Минуты}:%{ТекстСекунд}"
        если Пульт.Статус == СостоянияИгры.Пауза
            Таймер = "таймер на паузе: %{Минуты}:%{ТекстСекунд}"
        ;
    ;
    пер Готово = 0
    для Команда из Пульт.Участники
        если Команда.Готов
            Готово = Готово + 1
        ;
    ;
    Сводка = "%{Пульт.Статус.Представление()} · %{Пульт.Фаза.Представление()} · раунд %{Пульт.НомерРаунда} · %{Таймер} · готовы %{Готово} из %{Пульт.Участники.Размер()}"
    если Пульт.ТолькоРынок
        Сводка = "Рынок OData · " + Сводка
    ;
    если Пульт.Статус == СостоянияИгры.Черновик
        СледующийШаг = "Для игры без HTTP-расширения ERP нажмите «Запустить рынок OData». Для полного режима с расширением нажмите «Подготовить игру»."
    иначе если Пульт.Статус == СостоянияИгры.Подготовка
        СледующийШаг = "Дождитесь готовности команд и ERP в таблице ниже, затем нажмите «Начать игру». Для режима без HTTP-расширения используйте «Запустить рынок OData»."
    иначе если Пульт.Статус == СостоянияИгры.Пауза
        СледующийШаг = "Игра на паузе. Нажмите «Возобновить», когда команды будут готовы продолжить."
    иначе если Пульт.Статус == СостоянияИгры.Завершена
        СледующийШаг = Пульт.ТолькоРынок ? "Игра завершена. Откройте «Результаты» и выберите раунд на вкладке «Заказы OData»."
            : "Игра завершена. Опубликуйте результаты и откройте раздел «Результаты»."
    иначе если Пульт.Статус == СостоянияИгры.Отменена
        СледующийШаг = "Игра отменена. Для новой игры вернитесь на главную страницу."
    иначе
        СледующийШаг = "Дождитесь готовности команд в таблице ниже и перейдите к следующему этапу кнопкой над таблицей. Причина ожидания указана у каждой команды."
    ;
    ПредупреждениеВремени = СводкиИгры.ПредупреждениеВремени(Пульт.Статус, Пульт.ТаймерВключен, Остаток)
;

метод НачатьРынокOData(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено, "Выберите игру")
        УправлениеИгрой.НачатьРынокOData(Игра!, Версия)
        ПрочитатьСостояние()
        Сообщение = "Рынок открыт. Перейдите в кабинет игрока и получите заказ для отправки в ERP."
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;

метод Подготовить(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено, "Выберите игру")
        УправлениеИгрой.Подготовить(Игра!, Версия)
        ПрочитатьСостояние()
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;

метод Начать(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено, "Выберите игру")
        УправлениеИгрой.Начать(Игра!, Версия)
        ПрочитатьСостояние()
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;

метод СледующаяФаза(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено, "Выберите игру")
        УправлениеИгрой.СледующаяФаза(Игра!, Версия)
        ПрочитатьСостояние()
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;

метод ЗавершитьЭтапПринудительно(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено и Состояние != Неопределено, "Выберите игру")
        знч ВыбраннаяИгра = Игра!
        знч ВерсияДействия = Версия
        знч ТокенДействия = Токен
        знч Этап = Состояние!.Фаза.Представление()
        знч ПричинаДействия = ЗапроситьПричину("Завершить этап принудительно",
            "Этап: %{Этап}. Время этапа закончится сейчас, результаты будут зафиксированы, команды отмечены завершившими этап. Переход к следующему этапу выполняется отдельно после проверки данных ERP.")
        если ПричинаДействия == Неопределено
            возврат
        ;
        ПроверкиДанных.Требовать(Игра == ВыбраннаяИгра, "Выбрана другая игра. Повторите действие.")
        УправлениеИгрой.ЗавершитьЭтапПринудительно(ВыбраннаяИгра, ВерсияДействия, ТокенДействия, ПричинаДействия!)
        ПрочитатьСостояние()
        Сообщение = "Этап принудительно завершён. После проверки данных ERP перейдите к следующему этапу."
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;

метод Пауза(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено, "Выберите игру")
        знч ВыбраннаяИгра = Игра!
        знч ВерсияДействия = Версия
        знч НазваниеИгры = Состояние == Неопределено ? "Выбранная игра" : Состояние!.Наименование
        знч ПричинаДействия = ЗапроситьПричину("Приостановить игру", "Игра: %{НазваниеИгры}. Игра будет поставлена на паузу. Таймер остановится, принятая готовность команд сохранится.")
        если ПричинаДействия == Неопределено
            возврат
        ;
        ПроверкиДанных.Требовать(Игра == ВыбраннаяИгра, "Выбрана другая игра. Повторите действие.")
        УправлениеИгрой.Пауза(ВыбраннаяИгра, ВерсияДействия, ПричинаДействия!)
        ПрочитатьСостояние()
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;

метод Возобновить(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено, "Выберите игру")
        УправлениеИгрой.Возобновить(Игра!, Версия)
        ПрочитатьСостояние()
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;

метод Отменить(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено, "Выберите игру")
        знч ВыбраннаяИгра = Игра!
        знч ВерсияДействия = Версия
        знч НазваниеИгры = Состояние == Неопределено ? "Выбранная игра" : Состояние!.Наименование
        знч ПричинаДействия = ЗапроситьПричину("Отменить игру", "Игра: %{НазваниеИгры}. Игра будет отменена. Продолжить её проведение после отмены нельзя.")
        если ПричинаДействия == Неопределено
            возврат
        ;
        ПроверкиДанных.Требовать(Игра == ВыбраннаяИгра, "Выбрана другая игра. Повторите действие.")
        УправлениеИгрой.Отменить(ВыбраннаяИгра, ВерсияДействия, ПричинаДействия!)
        ПрочитатьСостояние()
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;

метод Опубликовать(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено, "Выберите игру")
        РезультатыИгры.Опубликовать(Игра!, Версия)
        ПрочитатьСостояние()
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;

метод ИсключитьУчастника(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено и Участник != Неопределено, "Выберите игру и команду")
        знч ВыбраннаяИгра = Игра!
        знч ВерсияДействия = Версия
        знч НазваниеИгры = Состояние == Неопределено ? "Выбранная игра" : Состояние!.Наименование
        знч ВыбраннаяКоманда = Участник!
        знч НазваниеКоманды = ПолучитьНазваниеКоманды(ВыбраннаяКоманда)
        знч ПричинаДействия = ЗапроситьПричину("Исключить команду", "Команда: %{НазваниеКоманды}. Выбранная команда будет исключена из игры. Причина сохранится в истории событий.")
        если ПричинаДействия == Неопределено
            возврат
        ;
        ПроверкиДанных.Требовать(Игра == ВыбраннаяИгра, "Выбрана другая игра. Повторите действие.")
        УправлениеИгрой.ИсключитьУчастника(ВыбраннаяИгра, ВерсияДействия, ВыбраннаяКоманда, ПричинаДействия!)
        ПрочитатьСостояние()
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;

метод ЗапроситьПричину(ЗаголовокДействия: Строка, ОписаниеДействия: Строка): Строка?
    знч Окно = новый ВводПричины()
    Окно.Заголовок = ЗаголовокДействия
    Окно.Описание = ОписаниеДействия
    Окно.ТекстДействия = ЗаголовокДействия
    возврат Окно.ОткрытьВМодальномОкне()
;

метод ПолучитьНазваниеКоманды(ВыбраннаяКоманда: УчастникиИгры.Ссылка): Строка
    для СтрокаКоманды из Участники
        если СтрокаКоманды.Участник == ВыбраннаяКоманда
            возврат СтрокаКоманды.Команда
        ;
    ;
    возврат "Выбранная команда"
;

метод ПолучитьКомандыДляВыбора(): Массив<ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>>
    знч КомандыДляВыбора = новый Массив<ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>>()
    для СтрокаКоманды из Участники
        КомандыДляВыбора.Добавить(новый ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>(
            Значение = СтрокаКоманды.Участник, Представление = СтрокаКоманды.Команда))
    ;
    возврат КомандыДляВыбора
;

метод ПовторитьОбмен(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено, "Выберите игру")
        УправлениеИгрой.ПовторитьОбмен(Игра!, Версия)
        ПрочитатьСостояние()
        Сообщение = "Обмен возобновлён. Дождитесь обновления готовности команд."
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;

метод СообщитьОшибкуОбновления(Текст: Строка)
    если ПоследняяОшибкаОбновления != Текст
        Сообщить(Текст)
    ;
    ПоследняяОшибкаОбновления = Текст
;
