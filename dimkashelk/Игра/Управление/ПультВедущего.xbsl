;

метод ПринятьСнимок(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено и Участник != Неопределено, "Выберите игру и команду")
        знч Снимок = УправлениеИгрой.ПринятьТестовыйСнимок(Игра!, Версия, Токен, Участник!, Предложения)
        ПрочитатьСостояние()
        Сообщение = "Тестовый снимок принят; команда готова."
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

