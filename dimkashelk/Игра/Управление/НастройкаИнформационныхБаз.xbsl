импорт Данные
импорт Обмен

метод Проверить(Команда: ОбычнаяКоманда)
    ПодключениеПлана = Неопределено
    ПодключениеРезультата = Неопределено
    Соответствия = ""
    ВыполнитьНастройку(Ложь)
;

метод Применить(Команда: ОбычнаяКоманда)
    если Подключение == Неопределено или Подключение != ПодключениеПлана или Логин != ЛогинПлана
        или ПараметрыПлана != ОрганизацияИмя + "|" + ДатаНастройки
        Сообщение = "Сначала проверьте выбранную базу и покажите план."
        возврат
    ;
    ВыполнитьНастройку(Истина)
    Пароль = ""
    ПодключениеПлана = Неопределено
;

метод ВыполнитьНастройку(Применить: Булево)
    попытка
        ПроверкиДанных.Требовать(Подключение != Неопределено, "Выберите информационную базу")
        знч ВыбраннаяБаза = Подключение!
        знч ВыбранныйЛогин = Логин
        знч Параметры = ОрганизацияИмя + "|" + ДатаНастройки
        ПодключениеРезультата = Неопределено
        Соответствия = ""
        знч Результат = НастройкаБазOData.Выполнить(ВыбраннаяБаза, Логин, Пароль, Применить, ОрганизацияИмя, ДатаНастройки)
        если Подключение != ВыбраннаяБаза или Логин != ВыбранныйЛогин
            или Параметры != ОрганизацияИмя + "|" + ДатаНастройки
            Отчет = ""
            Сообщение = "База или логин изменены. Повторите проверку."
            возврат
        ;
        Отчет = ПредставитьОтчет(Результат)
        если Результат.Получить("success") == Истина
            если Применить
                Соответствия = Результат.Получить("mappingsText") как Строка
                ПодключениеРезультата = ВыбраннаяБаза
                Сообщение = "Данные созданы и сверены, начальные документы проведены. Можно сохранить соответствия для команды этой базы."
            иначе
                ПодключениеПлана = ВыбраннаяБаза
                ЛогинПлана = ВыбранныйЛогин
                ПараметрыПлана = Параметры
                Сообщение = "Проверка пройдена. План показан ниже; записи выполняются отдельной кнопкой."
            ;
        иначе
            ПодключениеПлана = Неопределено
            Сообщение = "Настройка не завершена. Отчёт содержит причину и завершённые шаги."
        ;
    поймать Ошибка: Исключение
        ПодключениеПлана = Неопределено
        ПодключениеРезультата = Неопределено
        Соответствия = ""
        Отчет = ""
        Сообщение = Ошибка.Описание
    ;
;

метод СохранитьСоответствия(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(КомандаERP != Неопределено и Подключение != Неопределено
            и ПодключениеРезультата == Подключение и не Соответствия.Пусто(), "Сначала завершите настройку выбранной базы")
        НастройкаБазOData.СохранитьСоответствия(КомандаERP!, Подключение!, Соответствия)
        Сообщение = "Соответствия 15 игровых позиций сохранены для команды."
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод ПредставитьОтчет(Результат: Соответствие<Строка, Объект?>): Строка
    пер Текст = ""
    если Результат.Получить("success") != Истина
        Текст = "Остановлено на шаге %{Результат.Получить("step")}: %{Результат.Получить("message")}\n"
    ;
    знч Шаги = Результат.ПолучитьИлиНеопределено("entries") ?? Результат.ПолучитьИлиНеопределено("completed")
    если Шаги это ЧитаемыйМассив<Объект?>
        для Значение из Шаги как ЧитаемыйМассив<Объект?>
            знч Шаг = Значение как ЧитаемоеСоответствие<Строка, Объект?>
            знч Действие = Шаг.Получить("action")
            знч Описание = Действие == "reuse" ? "Использовать существующее" : (Действие == "create" ? "Создать" : "Проверить и завершить")
            Текст = Текст + Описание + ": %{Шаг.ПолучитьИлиНеопределено("label") ?? Шаг.Получить("key")}\n"
        ;
    ;
    возврат Текст
;
