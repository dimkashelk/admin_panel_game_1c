импорт Данные
импорт Обмен

метод Сохранить(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено и Пользователь != Неопределено, "Выберите игру и пользователя")
        если Роль == ПрикладныеРоли.Игрок
            ПроверкиДанных.Требовать(УчастникERP != Неопределено, "Выберите команду игры")
            ДоступКабинета.НазначитьВИгре(Игра!, УчастникERP!, Пользователь!, Активно)
        иначе
            ДоступИгры.НазначитьПользователя(Игра!, Пользователь!, Роль, Активно)
        ;
        Сообщение = "Назначение сохранено, права пересчитаны."
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

@Обработчик
метод ПослеСоздания()
    Роль = ПрикладныеРоли.Игрок
    Активно = Истина
;

метод НазначитьСервис(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(УчастникERP != Неопределено и Пользователь != Неопределено, "Выберите команду и сервисного пользователя")
        знч Ид = ОбменERP.НазначитьСервис(УчастникERP!, Пользователь!, Активно)
        Сообщение = "Привязка ERP: %{Ид}"
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод ЗаполнитьПрофиль(Команда: ОбычнаяКоманда)
    ПрофильERP = НастройкиERP.ПримерПрофиля()
    СоответствияERP = НастройкиERP.ПримерСоответствий()
    Сообщение = "Пример: проверьте месяцы календаря, режим исполнения и границы цен сценария перед сохранением."
;

метод СохранитьПрофиль(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено, "Выберите игру")
        НастройкиERP.СохранитьПрофиль(Игра!, ПрофильERP)
        Сообщение = "Профиль ERP сохранён. Настройте подключения и соответствия номенклатуры для каждой команды."
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод СохранитьСоответствия(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(УчастникERP != Неопределено, "Выберите команду")
        ОбменERP.СохранитьСоответствия(УчастникERP!, СоответствияERP)
        ТаблицаСоответствий = []
        УчастникТаблицы = Неопределено
        Сообщение = "Соответствия ERP сохранены."
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод УчастникПриИзменении(Источник: ПолеВвода<УчастникиИгры.Ссылка?>, Событие: СобытиеПриИзменении<УчастникиИгры.Ссылка?>)
    ОчиститьПодключение()
    ТаблицаСоответствий = []
    УчастникТаблицы = Неопределено
    СоответствияERP = ""
    Сообщение = "Загрузите соответствия выбранной команды."
;

метод ЗагрузитьТаблицуСоответствий(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(УчастникERP != Неопределено, "Выберите команду ERP")
        знч ВыбраннаяКоманда = УчастникERP!
        знч Строки = ОбменERP.ПолучитьСоответствия(ВыбраннаяКоманда)
        если УчастникERP == ВыбраннаяКоманда
            ТаблицаСоответствий = Строки
            УчастникТаблицы = ВыбраннаяКоманда
            Сообщение = "Загружены соответствия 15 позиций. Изменения сохраняются отдельной кнопкой."
        ;
    поймать Ошибка: Исключение
        ТаблицаСоответствий = []
        УчастникТаблицы = Неопределено
        Сообщение = Ошибка.Описание
    ;
;

метод СохранитьТаблицу(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(УчастникERP != Неопределено и УчастникERP == УчастникТаблицы,
            "Сначала загрузите соответствия выбранной команды")
        ОбменERP.СохранитьТаблицуСоответствий(УчастникERP!, ТаблицаСоответствий)
        Сообщение = "Таблица соответствий сохранена."
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод НазначитьИгрока(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено и УчастникERP != Неопределено и Пользователь != Неопределено, "Выберите игру, команду и пользователя")
        ДоступКабинета.НазначитьВИгре(Игра!, УчастникERP!, Пользователь!, Активно)
        Роль = ПрикладныеРоли.Игрок
        Сообщение = "Назначение игрока сохранено"
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод ИграИзменена(Источник: ПолеВвода<Игры.Ссылка?>, Событие: СобытиеПриИзменении<Игры.Ссылка?>)
    ОчиститьПодключение()
    УчастникERP = Неопределено
    УчастникТаблицы = Неопределено
    ТаблицаСоответствий = []
    СоответствияERP = ""
;

метод ВыборКомандИгры(): Массив<ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>>
    знч Выбор = новый Массив<ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>>()
    если Игра != Неопределено
        для Команда из ДоступКабинета.КомандыИгры(Игра!)
            Выбор.Добавить(новый ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>(Значение = Команда.Участник, Представление = Команда.Представление))
        ;
    ;
    возврат Выбор
;

метод ОчиститьПодключение()
    УчастникПодключения = Неопределено
    АдресКоманды = ""
    ОрганизацияКоманды = ""
    ЛогинКоманды = ""
    ПарольКоманды = ""
    ПодключениеАктивно = Ложь
    СостояниеПодключения = ""
;

метод ЗагрузитьПодключение(Команда: ОбычнаяКоманда)
    ОчиститьПодключение()
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено и УчастникERP != Неопределено, "Выберите игру и команду")
        знч ВыбраннаяИгра = Игра!
        знч ВыбраннаяКоманда = УчастникERP!
        знч Ответ = НастройкаБазOData.ПодключениеКоманды(ВыбраннаяИгра, ВыбраннаяКоманда)
        если Игра != ВыбраннаяИгра или УчастникERP != ВыбраннаяКоманда
            возврат
        ;
        АдресКоманды = Ответ.Получить("address") как Строка
        ОрганизацияКоманды = Ответ.Получить("organization") как Строка
        ЛогинКоманды = Ответ.Получить("login") как Строка
        ПодключениеАктивно = Ответ.Получить("active") как Булево
        СостояниеПодключения = Ответ.Получить("hasPassword") == Истина ? "Пароль сохранён на сервере. Для замены введите новый." : "Пароль ещё не задан. Заполните его перед сохранением."
        УчастникПодключения = ВыбраннаяКоманда
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод СохранитьПодключение(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено и УчастникERP != Неопределено
            и УчастникПодключения == УчастникERP, "Сначала загрузите подключение выбранной команды")
        знч ВыбраннаяИгра = Игра!
        знч ВыбраннаяКоманда = УчастникERP!
        НастройкаБазOData.СохранитьПодключениеКоманды(ВыбраннаяИгра, ВыбраннаяКоманда,
            АдресКоманды, ОрганизацияКоманды, ЛогинКоманды, ПарольКоманды, ПодключениеАктивно)
        если Игра == ВыбраннаяИгра и УчастникERP == ВыбраннаяКоманда
            ПарольКоманды = ""
            Сообщение = "Подключение команды сохранено. Заказы игроков отправляются в ERP автоматически."
            ЗагрузитьПодключение(Команда)
        ;
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    ПарольКоманды = ""
;
