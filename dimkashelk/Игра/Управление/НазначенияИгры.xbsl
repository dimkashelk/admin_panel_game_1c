импорт Данные
импорт Обмен

@Обработчик
метод ПослеСоздания()
    Администратор = УправлениеИгрой.АдминистраторНастройки()
    если Игра != Неопределено
        Обновить(Неопределено)
    ;
;

метод ОчиститьНастройки()
    ЗагруженнаяИгра = Неопределено
    НазначенияДоступа = []
    СписокКоманд = []
    ПрофильERP = ""
    ОчиститьКоманду()
;

метод ОчиститьКоманду()
    АдресHttpERP = ""
    УчастникТаблицы = Неопределено
    ТаблицаСоответствий = []
    СоответствияERP = ""
;

метод ИграИзменена(Источник: ПолеВвода<Игры.Ссылка?>, Событие: СобытиеПриИзменении<Игры.Ссылка?>)
    УчастникERP = Неопределено
    ОчиститьНастройки()
    если Игра != Неопределено
        Обновить(Неопределено)
    ;
;

метод Обновить(Команда: ОбычнаяКоманда?)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено, "Выберите игру")
        знч ВыбраннаяИгра = Игра!
        РедактироватьHttp = УправлениеИгрой.ПолучитьНастройки(ВыбраннаяИгра).Получить("draft") как Булево
        ОчиститьНастройки()
        СписокКоманд = ДоступКабинета.КомандыИгры(ВыбраннаяИгра)
        ПрофильERP = УправлениеИгрой.ПолучитьПрофильERP(ВыбраннаяИгра)
        если Администратор
            НазначенияДоступа = УправлениеИгрой.НазначенияДоступа(ВыбраннаяИгра)
        ;
        пер КомандаДоступна = Ложь
        для Строка из СписокКоманд
            если Строка.Участник == УчастникERP
                КомандаДоступна = Истина
            ;
        ;
        если не КомандаДоступна
            УчастникERP = СписокКоманд.Пусто() ? Неопределено : СписокКоманд[0].Участник
        ;
        ЗагруженнаяИгра = ВыбраннаяИгра
        Сообщение = "Настройки загружены."
        ЗагрузитьКоманду()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    Занято = Ложь
;

метод ВыборКомандИгры(): Массив<ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>>
    возврат СписокКоманд.Преобразовать(Строка -> новый ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>(
        Значение = Строка.Участник, Представление = Строка.Представление))
;

метод УчастникПриИзменении(Источник: ПолеВвода<УчастникиИгры.Ссылка?>, Событие: СобытиеПриИзменении<УчастникиИгры.Ссылка?>)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        ЗагрузитьКоманду()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    Занято = Ложь
;

метод ЗагрузитьКоманду()
    ОчиститьКоманду()
    если УчастникERP != Неопределено
        АдресHttpERP = КлиентERP.НастройкиHttp(Игра!, УчастникERP!)
        если Администратор
            ЗагрузитьТаблицуСоответствий(Неопределено)
        ;
    ;
;

метод ДобавитьДоступ(Команда: ОбычнаяКоманда)
    ОткрытьНазначение(Неопределено, Ложь)
;

метод РедактироватьДоступ(Команда: КомандаСПараметром<СтрокаНазначенияДоступа>, Строка: СтрокаНазначенияДоступа)
    если НазначенияДоступа.Содержит(Строка)
        ОткрытьНазначение(Строка, Ложь)
    ;
;

метод СохранитьHttp(Команда: ОбычнаяКоманда)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено и Игра == ЗагруженнаяИгра и УчастникERP != Неопределено,
            "Выберите команду сохранённой игры")
        КлиентERP.СохранитьАдресHttp(Игра!, УчастникERP!, АдресHttpERP)
        АдресHttpERP = КлиентERP.НастройкиHttp(Игра!, УчастникERP!)
        Сообщение = "Адрес HTTP-сервиса сохранён. Используются логин и пароль ERP из карточки команды."
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    Занято = Ложь
;

метод ОткрытьНазначение(Строка: СтрокаНазначенияДоступа?, СервисERP: Булево)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено и Игра == ЗагруженнаяИгра, "Сначала загрузите игру")
        знч Окно = новый РедактированиеНазначенияИгры()
        Окно.Инициализировать(Игра!, УчастникERP, Строка, СервисERP)
        знч Сохранено = Окно.ОткрытьВМодальномОкне()
        если Сохранено == Истина
            НазначенияДоступа = УправлениеИгрой.НазначенияДоступа(Игра!)
            Сообщение = "Назначение сохранено."
        ;
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
    Занято = Ложь
;

метод СохранитьПрофиль(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено, "Выберите игру")
        НастройкиERP.СохранитьПрофиль(Игра!, ПрофильERP)
        Сообщение = "Профиль ERP сохранён. Настройте подключения и соответствия номенклатуры для каждой команды."
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод СохранитьСоответствия(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(УчастникERP != Неопределено, "Выберите команду")
        ОбменERP.СохранитьСоответствия(УчастникERP!, СоответствияERP)
        ТаблицаСоответствий = []
        УчастникТаблицы = Неопределено
        ЗагрузитьТаблицуСоответствий(Команда)
        Сообщение = "Соответствия ERP сохранены."
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод ЗагрузитьТаблицуСоответствий(Команда: ОбычнаяКоманда?)
    попытка
        ПроверкиДанных.Требовать(УчастникERP != Неопределено, "Выберите команду ERP")
        знч ВыбраннаяКоманда = УчастникERP!
        знч Строки = ОбменERP.ПолучитьСоответствия(ВыбраннаяКоманда)
        если УчастникERP == ВыбраннаяКоманда
            ТаблицаСоответствий = Строки
            УчастникТаблицы = ВыбраннаяКоманда
            Сообщение = "Загружены соответствия 15 позиций. Изменения сохраняются отдельной кнопкой."
        ;
    поймать Ошибка: Исключение
        ТаблицаСоответствий = []
        УчастникТаблицы = Неопределено
        Сообщение = Ошибка.Описание
    ;
;

метод СохранитьТаблицу(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(УчастникERP != Неопределено и УчастникERP == УчастникТаблицы,
            "Сначала загрузите соответствия выбранной команды")
        ОбменERP.СохранитьТаблицуСоответствий(УчастникERP!, ТаблицаСоответствий)
        Сообщение = "Таблица соответствий сохранена."
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;
