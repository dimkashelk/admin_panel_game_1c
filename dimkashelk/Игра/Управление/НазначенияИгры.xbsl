импорт Данные
импорт Обмен

метод Сохранить(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено и Пользователь != Неопределено, "Выберите игру и пользователя")
        ДоступИгры.НазначитьПользователя(Игра!, Пользователь!, Роль, Активно)
        Сообщение = "Назначение сохранено, права пересчитаны."
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

@Обработчик
метод ПослеСоздания()
    Роль = ПрикладныеРоли.Ведущий
    Активно = Истина
;

метод НазначитьСервис(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(УчастникERP != Неопределено и Пользователь != Неопределено, "Выберите команду и сервисного пользователя")
        знч Ид = ОбменERP.НазначитьСервис(УчастникERP!, Пользователь!, Активно)
        Сообщение = "Привязка ERP: %{Ид}"
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод ЗаполнитьПрофиль(Команда: ОбычнаяКоманда)
    ПрофильERP = НастройкиERP.ПримерПрофиля()
    СоответствияERP = НастройкиERP.ПримерСоответствий()
    Сообщение = "Пример: проверьте месяцы календаря, режим исполнения и границы цен сценария перед сохранением."
;

метод СохранитьПрофиль(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено, "Выберите игру")
        НастройкиERP.СохранитьПрофиль(Игра!, ПрофильERP)
        Сообщение = "Профиль ERP сохранён. Настройте подключения и соответствия номенклатуры для каждой команды."
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;

метод СохранитьСоответствия(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(УчастникERP != Неопределено, "Выберите команду")
        ОбменERP.СохранитьСоответствия(УчастникERP!, СоответствияERP)
        Сообщение = "Соответствия ERP сохранены."
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;
