импорт Данные

метод Создать(Команда: ОбычнаяКоманда)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        ПроверкиДанных.Требовать(Участник != Неопределено, "Выберите сохранённую команду игры")
        ПроверкиДанных.Требовать(Логин.Сократить() != "", "Укажите логин нового пользователя")
        знч ПарольСоздания = Пароль == "" ? "G!" + новый Ууид().ВСтроку() : Пароль
        знч Пользователь = ДоступКабинета.СоздатьПользователяКоманды(Участник!, Логин, ПарольСоздания)
        Пароль = ""
        Сообщить("Пользователь «%{Логин.Сократить()}» создан. Пароль: %{ПарольСоздания}")
        Закрыть(Пользователь)
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
    Занято = Ложь
;
