импорт Данные
импорт Обмен

@Обработчик
метод ПослеСоздания()
    ТолькоНезавершенные = Истина
    ПодключитьОбработчикТаймера(&АвтоматическоеОбновление, 5с)
;

метод ИграПриИзменении(Источник: ПолеВвода<Игры.Ссылка?>, Событие: СобытиеПриИзменении<Игры.Ссылка?>)
    Подключения = []
    Задания = []
    Сводка = ""
    Сообщение = ""
    Прочитать()
;

метод ФильтрПриИзменении(Источник: Флажок, Событие: СобытиеПриИзменении<Булево?>)
    Задания = []
    Прочитать()
;

метод Обновить(Команда: ОбычнаяКоманда)
    Прочитать()
;

метод АвтоматическоеОбновление()
    если Открыта
        Прочитать()
    ;
;

метод Прочитать()
    если Игра == Неопределено или ОбновлениеВыполняется
        возврат
    ;
    знч ВыбраннаяИгра = Игра!
    знч Фильтр = ТолькоНезавершенные
    ОбновлениеВыполняется = Истина
    попытка
        знч Данные = ДиагностикаОбменаERP.Получить(ВыбраннаяИгра, Фильтр)
        если Игра == ВыбраннаяИгра и ТолькоНезавершенные == Фильтр
            ПоследняяОшибкаОбновления = ""
            Подключения = Данные.Подключения
            Задания = Данные.Команды
            пер ОшибкиОбмена = ""
            для Задание из Задания
                если Задание.ОписаниеОшибки != ""
                    ОшибкиОбмена = ОшибкиОбмена + Задание.Команда + ": " + Задание.ОписаниеОшибки + "\n"
                ;
            ;
            если ОшибкиОбмена != "" и ОшибкиОбмена != ПоследниеОшибкиОбмена
                Сообщить(ОшибкиОбмена)
            ;
            ПоследниеОшибкиОбмена = ОшибкиОбмена
            Сводка = Данные.Сводка
            Сообщение = "Обновлено: %{Время.Сейчас()}. Обновление каждые 5 секунд."
        ;
    поймать Ошибка: Исключение
        если Игра == ВыбраннаяИгра и ТолькоНезавершенные == Фильтр
            Подключения = []
            Задания = []
            Сводка = ""
            Сообщение = "Не удалось получить состояние: %{Ошибка.Описание}"
            СообщитьОшибкуОбновления(Ошибка.Описание)
        ;
    ;
    ОбновлениеВыполняется = Ложь
;

метод СообщитьОшибкуОбновления(Текст: Строка)
    если ПоследняяОшибкаОбновления != Текст
        Сообщить(Текст)
    ;
    ПоследняяОшибкаОбновления = Текст
;
