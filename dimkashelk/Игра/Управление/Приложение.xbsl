импорт Данные
импорт Стд::КонтрольДоступа

метод Выйти(Команда: ОбычнаяКоманда)
    Аутентификация.ЗавершитьТекущийСеанс("")
;

@Обработчик
метод ПослеСоздания()
    УправлениеДоступно = ДоступКабинета.ДоступноУправление()
    РезультатыДоступны = ДоступКабинета.ДоступныРезультаты()
    если не УправлениеДоступно и не РезультатыДоступны
        КабинетИгрока.Открыть()
    ;
;

@Обработчик
метод ПриОткрытииПоСсылке(Событие: СобытиеПриОткрытииПоСсылке)
    УправлениеДоступно = ДоступКабинета.ДоступноУправление()
    РезультатыДоступны = ДоступКабинета.ДоступныРезультаты()
    если не УправлениеДоступно и не РезультатыДоступны
        Событие.СтандартнаяОбработка = Ложь
        КабинетИгрока.Открыть()
    ;
;
