импорт Данные

@Обработчик
метод ПослеСоздания()
    Сводка = новый Соответствие<Строка, Число>()
    Обновить(Неопределено)
;

метод Обновить(Команда: ОбычнаяКоманда?)
    попытка
        Сводка = УдалениеДанныхИгры.ПолучитьСводку()
        Сообщение = ""
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;

метод УдалитьВсе(Команда: ОбычнаяКоманда)
    УдалитьВид("ВСЕ", "все данные приложения: игры, настройки, история обмена и записи регистров")
;

метод УдалитьВид(Вид: Строка, Описание: Строка)
    если Занято
        возврат
    ;
    Занято = Истина
    попытка
        знч Окно = новый ПодтверждениеУдаленияДанных()
        Окно.Описание = "Будут удалены %{Описание}. Восстановление невозможно. Данные баз ERP и учётные записи пользователей сохраняются."
        Окно.Фраза = "УДАЛИТЬ " + Вид
        знч Ответ = Окно.ОткрытьВМодальномОкне()
        если Ответ != Неопределено
            знч Удалено = УдалениеДанныхИгры.Очистить(Вид, Ответ)
            Сводка = УдалениеДанныхИгры.ПолучитьСводку()
            Сообщение = "Удалено записей: %{Удалено}."
        ;
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
    Занято = Ложь
;

