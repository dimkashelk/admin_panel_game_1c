метод УдалитьВыбраннуюИгру(Команда: ОбычнаяКоманда)
    если Занято или Игра == Неопределено
        возврат
    ;
    Занято = Истина
    попытка
        знч ВыбраннаяИгра = Игра!
        знч Окно = новый ПодтверждениеУдаленияДанных()
        Окно.Описание = "Игра «%{ВыбраннаяИгра}», её команды, раунды, расчёты, результаты и история обмена будут удалены навсегда. Общие настройки и другие игры сохраняются."
        Окно.Фраза = "УДАЛИТЬ " + ВыбраннаяИгра.Ид.ВСтроку()
        знч Ответ = Окно.ОткрытьВМодальномОкне()
        если Ответ != Неопределено
            УдалениеДанныхИгры.УдалитьИгры(ВыбраннаяИгра, Ответ)
            если Игра == ВыбраннаяИгра
                Игра = Неопределено
            ;
            Сводка = УдалениеДанныхИгры.ПолучитьСводку()
            Сообщение = "Выбранная игра и её данные удалены."
        ;
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
    Занято = Ложь
;
