импорт Данные
импорт Обмен

метод ИграПриИзменении(Источник: ПолеВвода<Игры.Ссылка?>, Событие: СобытиеПриИзменении<Игры.Ссылка?>)
    Периоды = []
    Раунд = Неопределено
    Участник = Неопределено
    Версия = 0
    СнимокJSON = ""
    Причина = ""
    Прочитать()
;

метод Загрузить(Команда: ОбычнаяКоманда)
    Прочитать()
;

метод РаундПриИзменении(Источник: ПолеВвода<РаундыИгры.Ссылка?>, Событие: СобытиеПриИзменении<РаундыИгры.Ссылка?>)
    Участник = Неопределено
    СнимокJSON = ""
    Причина = ""
;

метод ПолучитьРаундыДляВыбора(): Массив<ЭлементСпискаЗначений<РаундыИгры.Ссылка?>>
    знч Список = новый Массив<ЭлементСпискаЗначений<РаундыИгры.Ссылка?>>()
    знч Добавленные = <РаундыИгры.Ссылка>[]
    для Период из Периоды
        если не Период.Подтвержден и Период.Раунд != Неопределено и не Добавленные.Содержит(Период.Раунд!)
            Добавленные.Добавить(Период.Раунд!)
            Список.Добавить(новый ЭлементСпискаЗначений<РаундыИгры.Ссылка?>(Значение = Период.Раунд, Представление = "Раунд %{Период.НомерРаунда}"))
        ;
    ;
    возврат Список
;

метод ПолучитьКомандыДляВыбора(): Массив<ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>>
    знч Список = новый Массив<ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>>()
    для Период из Периоды
        если не Период.Подтвержден и Раунд != Неопределено и Период.Раунд == Раунд
            Список.Добавить(новый ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>(Значение = Период.Участник, Представление = Период.Команда))
        ;
    ;
    возврат Список
;

метод Прочитать()
    если Игра == Неопределено
        возврат
    ;
    знч ВыбраннаяИгра = Игра!
    попытка
        // Версия читается до списка: изменение между запросами отклонит действие.
        знч ВерсияСписка = СверкаРезультатовERP.ПолучитьВерсию(ВыбраннаяИгра)
        знч Список = СверкаРезультатовERP.ПолучитьПериоды(ВыбраннаяИгра)
        если Игра == ВыбраннаяИгра
            Версия = ВерсияСписка
            Периоды = Список
            Сообщение = Список.Пусто() ? "Нет закрытых периодов." : "Периодов: %{Список.Размер()}. Выберите неподтверждённый период и команду."
        ;
    поймать Ошибка: Исключение
        если Игра == ВыбраннаяИгра
            Версия = 0
            Периоды = []
            Сообщение = Ошибка.Описание
        ;
    ;
;

метод Сверить(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено и Раунд != Неопределено и Участник != Неопределено,
            "Выберите игру, раунд и команду")
        знч ВыбраннаяИгра = Игра!
        знч ВыбранныйРаунд = Раунд!
        знч ВыбранныйУчастник = Участник!
        знч Ресурс = СверкаРезультатовERP.Сверить(ВыбраннаяИгра, ВыбранныйРаунд, ВыбранныйУчастник, Версия, СнимокJSON, Причина)
        если Игра == ВыбраннаяИгра и Раунд == ВыбранныйРаунд и Участник == ВыбранныйУчастник
            СнимокJSON = ""
            Причина = ""
            Прочитать()
            Сообщение = "Период подтверждён по снимку %{Ресурс}. Сверьте последующие неподтверждённые периоды, затем опубликуйте рейтинг в пульте."
        ;
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;
