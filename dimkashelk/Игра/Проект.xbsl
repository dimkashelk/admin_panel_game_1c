импорт Данные

@ОбновлениеПроекта(Ид = "game_access_v1", Номер = 1)
метод НастроитьДоступИгры()
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ Игры}.Выполнить()
        знч Игра = Строка.Ссылка.ЗагрузитьОбъект(Истина)!
        если Игра.КонтекстДоступаИгры != Игра.Ссылка
            Игра.КонтекстДоступаИгры = Игра.Ссылка
            Игра.Записать()
        ;
    ;
    Игры.ПересчитатьРазрешенияДоступа()
    УчастникиИгры.ПересчитатьРазрешенияДоступа()
    РаундыИгры.ПересчитатьРазрешенияДоступа()
    СнимкиERP.ПересчитатьРазрешенияДоступа()
    РасчетыРынка.ПересчитатьРазрешенияДоступа()
    СобытияИгры.ПересчитатьРазрешенияДоступа()
    ДоступИгры.ПересчитатьЧтение()
;

@ОбновлениеПроекта(Ид = "player_access_v2", Номер = 2)
метод НастроитьДоступИгроков()
    исп КонтекстДоступа.Привилегированный()
    УчастникиИгры.ПересчитатьРазрешенияДоступа()
    ДоступИгры.ПересчитатьЧтение()
;
