импорт Данные

@ВПроекте
метод РасставитьМеста(Вход: ЧитаемыйМассив<СтрокаРейтинга>): Массив<СтрокаРейтинга>
    пер Строки = <СтрокаРейтинга>[]
    для Строка из Вход
        ПроверкиДанных.Требовать(не Строка.Подтвержден или Строка.Деньги != Неопределено, "В подтвержденном результате нет денег")
        // Work on copies; an incomplete result never receives a place.
        знч Копия = новый СтрокаРейтинга(Участник = Строка.Участник,
            Команда = Строка.Команда, Деньги = Строка.Деньги, Выручка = Строка.Выручка,
            Прибыль = Строка.Прибыль, Долги = Строка.Долги,
            Подтвержден = Строка.Подтвержден, ТестовыеДанные = Строка.ТестовыеДанные, НазваниеИгры = Строка.НазваниеИгры, НомерРаунда = Строка.НомерРаунда,
            Заказано = Строка.Заказано, Отгружено = Строка.Отгружено, Оплачено = Строка.Оплачено, ОстаткиГП = Строка.ОстаткиГП)
        если не Строка.Подтвержден
            Копия.Деньги = Неопределено
            Копия.Выручка = Неопределено
            Копия.Прибыль = Неопределено
            Копия.Долги = Неопределено
        ;
        Строки.Добавить(Копия)
    ;
    Строки = Строки.Сортировать((Левый, Правый) -> СравнитьСтроки(Левый, Правый))
    пер Позиция = 0
    пер Место = 0
    пер ПредыдущиеДеньги: Число? = Неопределено
    для Строка из Строки
        если не Строка.Подтвержден
            продолжить
        ;
        Позиция = Позиция + 1
        если ПредыдущиеДеньги == Неопределено или Строка.Деньги != ПредыдущиеДеньги
            Место = Позиция
        ;
        Строка.Место = Место
        ПредыдущиеДеньги = Строка.Подтвержден ? Строка.Деньги : Неопределено
    ;
    возврат Строки
;

метод СравнитьСтроки(Левый: СтрокаРейтинга, Правый: СтрокаРейтинга): Число
    если Левый.Подтвержден != Правый.Подтвержден
        возврат Левый.Подтвержден ? -1 : 1
    ;
    если Левый.Подтвержден и Левый.Деньги != Правый.Деньги
        возврат Правый.Деньги!.Сравнить(Левый.Деньги!)
    ;
    возврат Левый.Команда.Сравнить(Правый.Команда)
;
