импорт Данные

@Обработчик
метод ПослеСоздания()
    попытка
        ДоступныеКоманды = ДоступКабинета.ВыборКоманд()
        если не ДоступныеКоманды.Пусто()
            Участник = ДоступныеКоманды[0].Участник
            Прочитать()
        иначе
            Сообщение = "Ведущий ещё не назначил вас в команду"
        ;
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
        Сообщить(Ошибка.Описание)
    ;
    ПодключитьОбработчикТаймера(&Тик, 5с, Однократно = Ложь)
;

метод ПолучитьКомандыДляВыбора(): Массив<ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>>
    знч Выбор = новый Массив<ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>>()
    для Команда из ДоступныеКоманды
        Выбор.Добавить(новый ЭлементСпискаЗначений<УчастникиИгры.Ссылка?>(
            Значение = Команда.Участник, Представление = Команда.Представление))
    ;
    возврат Выбор
;

метод ПолучитьРаундыДляВыбора(): Массив<ЭлементСпискаЗначений<Число?>>
    знч Выбор = новый Массив<ЭлементСпискаЗначений<Число?>>()
    Выбор.Добавить(новый ЭлементСпискаЗначений<Число?>(Значение = Неопределено, Представление = "Все раунды"))
    знч Номера = <Число>[]
    для Строка из ВсеСтроки
        если не Номера.Содержит(Строка.Раунд)
            Номера.Добавить(Строка.Раунд)
            Выбор.Добавить(новый ЭлементСпискаЗначений<Число?>(Значение = Строка.Раунд,
                Представление = Строка.Раунд == 0 ? "0 · Стартовая продажа" : "Раунд %{Строка.Раунд}"))
        ;
    ;
    возврат Выбор
;

метод КомандаИзменена(Источник: ПолеВвода<УчастникиИгры.Ссылка?>, Событие: СобытиеПриИзменении<УчастникиИгры.Ссылка?>)
    ВсеСтроки = []
    Строки = []
    ВыбранныйРаунд = Неопределено
    Обновлено = ""
    попытка
        Прочитать()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
        Сообщить(Ошибка.Описание)
    ;
;

метод РаундИзменен(Источник: ПолеВвода<Число?>, Событие: СобытиеПриИзменении<Число?>)
    ПрименитьФильтр()
;

метод ПрименитьФильтр()
    Строки = ВсеСтроки.Отобрать(Строка -> ВыбранныйРаунд == Неопределено или Строка.Раунд == ВыбранныйРаунд)
;

метод Обновить(Команда: ОбычнаяКоманда)
    попытка
        Прочитать()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
        Сообщить(Ошибка.Описание)
    ;
;

метод Тик()
    если ОбновлениеВыполняется или Участник == Неопределено
        возврат
    ;
    попытка
        Прочитать()
    поймать Ошибка: Исключение
        если Сообщение != Ошибка.Описание
            Сообщить(Ошибка.Описание)
        ;
        Сообщение = Ошибка.Описание
    ;
;

метод Прочитать()
    если ОбновлениеВыполняется
        возврат
    ;
    если Участник == Неопределено
        ВсеСтроки = []
        Строки = []
        Сообщение = "Выберите команду"
        возврат
    ;
    знч Команда = Участник!
    ОбновлениеВыполняется = Истина
    попытка
        знч Ответ = АналитикаРынка.Получить(Команда)
        если Участник == Команда
            Сообщение = ""
            // Сохраняем прокрутку и сортировку при неизменных результатах.
            если СериализацияJson.ЗаписатьОбъект(ВсеСтроки) != СериализацияJson.ЗаписатьОбъект(Ответ)
                ВсеСтроки = Ответ
                ПрименитьФильтр()
            ;
            Обновлено = "Обновлено %{Время.Сейчас()} · синхронизация каждые 5 секунд"
        ;
    поймать Ошибка: Исключение
        ВсеСтроки = []
        Строки = []
        Обновлено = "Связь с игрой потеряна. Повтор через 5 секунд"
        ОбновлениеВыполняется = Ложь
        выбросить Ошибка
    ;
    ОбновлениеВыполняется = Ложь
;
