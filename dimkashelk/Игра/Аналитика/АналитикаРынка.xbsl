импорт Данные
импорт Обмен

@ВПроекте @НаСервере @ДоступноСКлиента
метод Получить(Участник: УчастникиИгры.Ссылка): Массив<СтрокаАналитикиРынка>
    знч СсылкаИгры = ДоступКабинета.ПроверитьИгрока(Участник)
    исп КонтекстДоступа.Привилегированный()
    знч Игра = СсылкаИгры.ЗагрузитьОбъект()!
    знч Продажи = <Объект?>[]
    если Игра.СвободныйРынок или Игра.ЗаказыПоЦенамERP
        // Закрытие засчитывается только после проверки полной отгрузки и банковской оплаты.
        для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ ЗаказыРынка
            ГДЕ Игра == %СсылкаИгры И ЗачтенЗакрытым
            УПОРЯДОЧИТЬ ПО Раунд.НомерРаунда, НомерПакета}.Выполнить()
            знч Заказ = Строка.Ссылка.ЗагрузитьОбъект()!
            если Заказ.Участник == Неопределено или Заказ.Раунд == Неопределено
                продолжить
            ;
            знч Себестоимости = Заказ.СебестоимостьДляАналитики == "" ? <Строка, Объект?>{:}
                : ПротоколERP.Прочитать(Заказ.СебестоимостьДляАналитики)
            для Значение из РынокЗаказов.СтрокиЗаказаERP(Заказ)
                знч СтрокаЗаказа = ПротоколERP.ОбъектJson(Значение)
                знч Код = ПротоколERP.СтрокаJson(СтрокаЗаказа, "productCode")
                знч Количество = ПротоколERP.ЧислоJson(СтрокаЗаказа, "quantity")
                знч Цена = новый Число(ПротоколERP.СтрокаJson(СтрокаЗаказа, "unitPrice"))
                Продажи.Добавить(Факт(Игра, Заказ.Раунд!.ЗагрузитьОбъект()!.НомерРаунда,
                    Заказ.Участник!, Код, Количество, (Количество * Цена).Округлить(2), Себестоимости))
            ;
        ;
    иначе
        // Классический режим: актуальные факты ERP; отменённые реализации имеют нулевую отгрузку.
        для Строка из Запрос{ВЫБРАТЬ Расчет.Раунд.НомерРаунда.ЗаменитьNull(-1) КАК Раунд, Участник,
            Продукт.Код.ЗаменитьNull("") КАК Код, Отгружено, СуммаРеализации ИЗ ИсполнениеПродаж
            ГДЕ Расчет.Игра == %СсылкаИгры И Отгружено > 0
            УПОРЯДОЧИТЬ ПО Расчет.Раунд.НомерРаунда, Продукт.Код}.Выполнить()
            если Строка.Участник != Неопределено и Строка.Раунд >= 0 и Строка.Код != ""
                Продажи.Добавить(Факт(Игра, Строка.Раунд, Строка.Участник!, Строка.Код,
                    Строка.Отгружено, Строка.СуммаРеализации, <Строка, Объект?>{:}))
            ;
        ;
    ;
    // Клиенту передаём только показатели своей команды и агрегаты рынка без ссылок на чужие базы.
    возврат Собрать(Продажи, Участник.Ид.ВСтроку())
;

@НаСервере
метод Факт(Игра: Игры.Объект, Раунд: Число, Участник: УчастникиИгры.Ссылка,
    Код: Строка, Количество: Число, Выручка: Число,
    Себестоимости: Соответствие<Строка, Объект?>): Соответствие<Строка, Объект?>
    знч Правило = НастройкиERP.ПравилоПродукта(Игра, Код)
    знч СтавкаНдс = новый Число(ПротоколERP.СтрокаJson(Правило, "vatRate"))
    пер Себестоимость: Число? = Неопределено
    если Себестоимости.СодержитКлюч("costs")
        знч Цены = ПротоколERP.ОбъектJson(Себестоимости.Получить("costs"))
        если Цены.СодержитКлюч(Код) и Себестоимости.ПолучитьИлиНеопределено("includesVAT") это Булево
            знч Цена = ПротоколERP.ЧислоJson(Цены, Код)
            Себестоимость = Себестоимости.Получить("includesVAT") == Истина ? Цена / (1 + СтавкаНдс / 100) : Цена
        ;
    ;
    знч ВыручкаБезНдс = Выручка / (1 + СтавкаНдс / 100)
    возврат {"round": Раунд, "team": Участник.Ид.ВСтроку(), "code": Код,
        "model": ОбменERP.Продукт(Код).ЗагрузитьОбъект()!.Наименование,
        "quantity": Количество, "revenue": Выручка, "netRevenue": ВыручкаБезНдс, "unitCost": Себестоимость}
;

// Чистый расчёт: средняя цена взвешивается по количеству, проценты — по суммам.
@ВПодсистеме @НаСервере
метод Собрать(Продажи: ЧитаемыйМассив<Объект?>, Команда: Строка): Массив<СтрокаАналитикиРынка>
    знч Строки = <СтрокаАналитикиРынка>[]
    знч ПоМоделям = <Строка, СтрокаАналитикиРынка>{:}
    для Значение из Продажи
        знч Продажа = ПротоколERP.ОбъектJson(Значение)
        знч Количество = ПротоколERP.ЧислоJson(Продажа, "quantity")
        если Количество <= 0
            продолжить
        ;
        знч Раунд = ПротоколERP.ЧислоJson(Продажа, "round")
        знч Код = ПротоколERP.СтрокаJson(Продажа, "code")
        знч Ключ = "%{Раунд}:%{Код}"
        знч Выручка = ПротоколERP.ЧислоJson(Продажа, "revenue")
        знч Цена = Выручка / Количество
        если не ПоМоделям.СодержитКлюч(Ключ)
            знч Новая = новый СтрокаАналитикиРынка(Раунд = Раунд, КодМодели = Код,
                Модель = ПротоколERP.СтрокаJson(Продажа, "model"), МинимальнаяЦена = Цена, МаксимальнаяЦена = Цена)
            ПоМоделям.Вставить(Ключ, Новая)
            Строки.Добавить(Новая)
        ;
        знч Строка = ПоМоделям.Получить(Ключ)
        Строка.ПроданоНаРынке = Строка.ПроданоНаРынке + Количество
        Строка.ВыручкаРынка = Строка.ВыручкаРынка + Выручка
        Строка.МинимальнаяЦена = Цена < Строка.МинимальнаяЦена ? Цена : Строка.МинимальнаяЦена
        Строка.МаксимальнаяЦена = Цена > Строка.МаксимальнаяЦена ? Цена : Строка.МаксимальнаяЦена
        если Продажа.Получить("team") == Команда
            Строка.Продано = Строка.Продано + Количество
            Строка.Выручка = Строка.Выручка + Выручка
            Строка.ВыручкаБезНДС = Строка.ВыручкаБезНДС + ПротоколERP.ЧислоJson(Продажа, "netRevenue")
            если Продажа.ПолучитьИлиНеопределено("unitCost") != Неопределено
                Строка.КоличествоССебестоимостью = Строка.КоличествоССебестоимостью + Количество
                Строка.СебестоимостьПродаж = Строка.СебестоимостьПродаж + Количество * ПротоколERP.ЧислоJson(Продажа, "unitCost")
            ;
        ;
    ;
    для Строка из Строки
        Строка.СредняяЦенаРынка = (Строка.ВыручкаРынка / Строка.ПроданоНаРынке).Округлить(2)
        Строка.ДоляРынка = (100 * Строка.Продано / Строка.ПроданоНаРынке).Округлить(2)
        если Строка.Продано <= 0
            продолжить
        ;
        Строка.ЦенаПродажи = (Строка.Выручка / Строка.Продано).Округлить(2)
        если Строка.ВыручкаРынка > 0
            Строка.ОтклонениеЦены = (100 * ((Строка.Выручка / Строка.Продано)
                / (Строка.ВыручкаРынка / Строка.ПроданоНаРынке) - 1)).Округлить(2)
        ;
        // Если хотя бы у одной продажи нет исторической себестоимости, общая маржа неизвестна.
        если Строка.КоличествоССебестоимостью == Строка.Продано
            знч Маржа = Строка.ВыручкаБезНДС - Строка.СебестоимостьПродаж
            Строка.Себестоимость = (Строка.СебестоимостьПродаж / Строка.Продано).Округлить(2)
            Строка.МаржаНаЕдиницу = (Маржа / Строка.Продано).Округлить(2)
            Строка.МаржаВсего = Маржа.Округлить(2)
            если Строка.ВыручкаБезНДС > 0
                Строка.Маржинальность = (100 * Маржа / Строка.ВыручкаБезНДС).Округлить(2)
            ;
        ;
    ;
    возврат Строки.Сортировать((Л, П) -> Л.Раунд == П.Раунд ? Л.КодМодели.Сравнить(П.КодМодели) : (Л.Раунд > П.Раунд ? -1 : 1))
;
