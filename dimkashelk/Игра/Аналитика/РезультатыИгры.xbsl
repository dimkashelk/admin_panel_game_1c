импорт Данные

@ВПроекте @НаСервере @ДоступноСКлиента
метод ПолучитьРаундыВедущего(Игра: Игры.Ссылка): Массив<РаундыИгры.Ссылка>
    ДоступИгры.ПроверитьВедущего(Игра)
    исп КонтекстДоступа.Привилегированный()
    возврат Запрос{
        ВЫБРАТЬ Ссылка ИЗ РаундыИгры ГДЕ Игра == %Игра УПОРЯДОЧИТЬ ПО НомерРаунда
    }.Выполнить().Преобразовать(Строка -> Строка.Ссылка)
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод ПолучитьДетали(Игра: Игры.Ссылка, Раунд: РаундыИгры.Ссылка): ДеталиРезультатовИгры
    ДоступИгры.ПроверитьРезультаты(Игра)
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Объект = Игра.ЗагрузитьОбъект(Истина)!
    ДоступИгры.ПроверитьРезультаты(Игра)
    ПроверкиДанных.Требовать(Раунд.ЗагрузитьОбъект()!.Игра == Игра, "Раунд принадлежит другой игре")
    возврат новый ДеталиРезультатовИгры(Рейтинг = ПолучитьРейтинг(Игра, Раунд),
        Модели = ПродажиПоМоделям(Раунд), Остатки = ОстаткиРаунда(Раунд), История = ИсторияИтогов(Игра))
;

@НаСервере
метод ПродажиПоМоделям(Раунд: РаундыИгры.Ссылка): Массив<СтрокаПродажПоМоделям>
    знч Период = Раунд.ЗагрузитьОбъект()!
    знч Игра = Период.Игра
    знч Расчет = Период.ОкончательныйРасчет
    знч Строки = <СтрокаПродажПоМоделям>[]
    если Расчет == Неопределено
        возврат Строки
    ;
    для Команда из Запрос{ВЫБРАТЬ Ссылка, НаименованиеКоманды ИЗ УчастникиИгры ГДЕ Игра == %Игра И Активен УПОРЯДОЧИТЬ ПО ПорядокУчастника}.Выполнить()
        знч Участник = Команда.Ссылка
        знч Подтвержден = Запрос{ВЫБРАТЬ ЗакрытиеМесяцаПодтверждено ИЗ РезультатыРаундов ГДЕ Раунд == %Раунд И Участник == %Участник}.Выполнить().ПервыйИлиНеопределено()?.ЗакрытиеМесяцаПодтверждено ?? Ложь
        для Номенклатура из Запрос{ВЫБРАТЬ Ссылка, Наименование ИЗ НоменклатураИгры ГДЕ Активна И Вид == ВидыНоменклатурыИгры.ГотоваяПродукция УПОРЯДОЧИТЬ ПО Код}.Выполнить()
            знч Продукт = Номенклатура.Ссылка
            знч Заказы = Запрос{
                ВЫБРАТЬ СУММА(Заказано).ЗаменитьNull(0) КАК Количество ИЗ РасчетыРынка.Распределение
                ГДЕ Владелец == %Расчет И Участник == %Участник И Продукт == %Продукт
            }.Выполнить().ПервыйИлиНеопределено()!
            знч Продажи = Запрос{
                ВЫБРАТЬ СУММА(Отгружено).ЗаменитьNull(0) КАК Количество, СУММА(СуммаРеализации).ЗаменитьNull(0) КАК Выручка,
                    СУММА(Оплачено).ЗаменитьNull(0) КАК Оплачено
                ИЗ ИсполнениеПродаж ГДЕ Расчет == %Расчет И Участник == %Участник И Продукт == %Продукт
            }.Выполнить().ПервыйИлиНеопределено()!
            Строки.Добавить(новый СтрокаПродажПоМоделям(Команда = Команда.НаименованиеКоманды, Модель = Номенклатура.Наименование,
                Заказано = Заказы.Количество, Отгружено = Продажи.Количество, Выручка = Продажи.Выручка,
                Оплачено = Продажи.Оплачено, Подтвержден = Подтвержден))
        ;
    ;
    возврат Строки
;

@НаСервере
метод ОстаткиРаунда(Раунд: РаундыИгры.Ссылка): Массив<СтрокаОстатковИгры>
    знч Строки = <СтрокаОстатковИгры>[]
    для Итог из Запрос{
        ВЫБРАТЬ Участник, ФинальныйСнимок, ЗакрытиеМесяцаПодтверждено ИЗ РезультатыРаундов
        ГДЕ Раунд == %Раунд И Участник.Активен УПОРЯДОЧИТЬ ПО Участник.ПорядокУчастника
    }.Выполнить()
        если Итог.ФинальныйСнимок == Неопределено
            продолжить
        ;
        знч Снимок = Итог.ФинальныйСнимок!.ЗагрузитьОбъект()!
        знч Команда = Итог.Участник!.ЗагрузитьОбъект()!.НаименованиеКоманды
        для Остаток из Снимок.Остатки
            Строки.Добавить(новый СтрокаОстатковИгры(Команда = Команда, Номенклатура = Остаток.Номенклатура!.ЗагрузитьОбъект()!.Наименование,
                Склад = Остаток.СкладERP, Характеристика = Остаток.ХарактеристикаERP,
                Количество = Остаток.Количество, Единица = Остаток.Единица, ВремяДанных = Снимок.ВремяДанных,
                Подтвержден = Итог.ЗакрытиеМесяцаПодтверждено))
        ;
    ;
    возврат Строки
;

@НаСервере
метод ИсторияИтогов(Игра: Игры.Ссылка): Массив<СтрокаИсторииИтогов>
    знч Строки = <СтрокаИсторииИтогов>[]
    для Итог из Запрос{
        ВЫБРАТЬ Раунд, Участник, ДеньгиНачало, ДеньгиКонец, ВыручкаФакт, Прибыль, ЗакрытиеМесяцаПодтверждено, ФинальныйСнимок
        ИЗ РезультатыРаундов ГДЕ Раунд.Игра == %Игра И Участник.Активен
        УПОРЯДОЧИТЬ ПО Раунд.НомерРаунда, Участник.ПорядокУчастника
    }.Выполнить()
        знч Снимок = Итог.ФинальныйСнимок?.ЗагрузитьОбъект()
        // В представлении для наблюдателя нет ссылок на закрытые сущности.
        Строки.Добавить(новый СтрокаИсторииИтогов(НомерРаунда = Итог.Раунд!.ЗагрузитьОбъект()!.НомерРаунда,
            Команда = Итог.Участник!.ЗагрузитьОбъект()!.НаименованиеКоманды, ДеньгиНачало = Итог.ДеньгиНачало,
            ДеньгиКонец = Итог.ДеньгиКонец, Выручка = Итог.ВыручкаФакт, Прибыль = Итог.Прибыль,
            Подтвержден = Итог.ЗакрытиеМесяцаПодтверждено, ВремяДанных = Снимок?.ВремяДанных,
            Источник = Снимок?.ВерсияИсточника ?? ""))
    ;
    возврат Строки
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод ПолучитьРейтинг(Игра: Игры.Ссылка, Раунд: РаундыИгры.Ссылка): Массив<СтрокаРейтинга>
    ДоступИгры.ПроверитьРезультаты(Игра)
    исп КонтекстДоступа.Привилегированный()
    знч ИграОбъект = Игра.ЗагрузитьОбъект()!
    знч РаундОбъект = Раунд.ЗагрузитьОбъект()!
    ПроверкиДанных.Требовать(РаундОбъект.Игра == Игра, "Раунд принадлежит другой игре")
    знч Строки = <СтрокаРейтинга>[]
    для Команда из Запрос{
        ВЫБРАТЬ Ссылка, НаименованиеКоманды ИЗ УчастникиИгры ГДЕ Игра == %Игра И Активен
    }.Выполнить()
        знч ПараметрЗапроса1_0 = Команда.Ссылка
        знч Результат = Запрос{
            ВЫБРАТЬ ДеньгиКонец, ВыручкаФакт, Прибыль, Долги, ОстаткиГП, ЗакрытиеМесяцаПодтверждено ИЗ РезультатыРаундов
            ГДЕ Раунд == %Раунд И Участник == %ПараметрЗапроса1_0
        }.Выполнить().ПервыйИлиНеопределено()
        знч ПараметрЗапроса2_0 = РаундОбъект.ОкончательныйРасчет
        знч ПараметрЗапроса2_1 = Команда.Ссылка
        знч Продажи = Запрос{
            ВЫБРАТЬ СУММА(Отгружено).ЗаменитьNull(0) КАК Количество, СУММА(Оплачено).ЗаменитьNull(0) КАК Сумма
            ИЗ ИсполнениеПродаж ГДЕ Расчет == %ПараметрЗапроса2_0 И Участник == %ПараметрЗапроса2_1
        }.Выполнить().ПервыйИлиНеопределено()
        знч ПараметрЗапроса3_0 = РаундОбъект.ОкончательныйРасчет
        знч ПараметрЗапроса3_1 = Команда.Ссылка
        знч Заказы = Запрос{
            ВЫБРАТЬ СУММА(Заказано).ЗаменитьNull(0) КАК Количество ИЗ РасчетыРынка.Распределение
            ГДЕ Владелец == %ПараметрЗапроса3_0 И Участник == %ПараметрЗапроса3_1
        }.Выполнить().ПервыйИлиНеопределено()
        Строки.Добавить(новый СтрокаРейтинга(Участник = Команда.Ссылка, Команда = Команда.НаименованиеКоманды,
            Деньги = Результат?.ДеньгиКонец, Выручка = Результат?.ВыручкаФакт,
            Прибыль = Результат?.Прибыль, Долги = Результат?.Долги,
            НазваниеИгры = ИграОбъект.Наименование, НомерРаунда = РаундОбъект.НомерРаунда,
            Заказано = РаундОбъект.ОкончательныйРасчет == Неопределено ? Неопределено : (Заказы?.Количество ?? 0),
            Отгружено = Результат == Неопределено ? Неопределено : (Продажи?.Количество ?? 0),
            Оплачено = Результат == Неопределено ? Неопределено : (Продажи?.Сумма ?? 0), ОстаткиГП = Результат?.ОстаткиГП,
            Подтвержден = Результат?.ЗакрытиеМесяцаПодтверждено ?? Ложь))
    ;
    возврат Рейтинг.РасставитьМеста(Строки)
;

@ВПроекте
@НаСервере
метод ПроверитьЗакрытиеРаунда(Раунд: РаундыИгры.Ссылка)
    знч Игра = Раунд.ЗагрузитьОбъект()!.Игра!
    для Команда из Запрос{
        ВЫБРАТЬ Ссылка ИЗ УчастникиИгры ГДЕ Игра == %Игра И Активен
    }.Выполнить()
        знч ПараметрЗапроса5_0 = Команда.Ссылка
        знч Результат = Запрос{
            ВЫБРАТЬ ФинальныйСнимок, Долги, ЗакрытиеМесяцаПодтверждено ИЗ РезультатыРаундов
            ГДЕ Раунд == %Раунд И Участник == %ПараметрЗапроса5_0
        }.Выполнить().ПервыйИлиНеопределено()
        ПроверкиДанных.Требовать(Результат != Неопределено и Результат!.ЗакрытиеМесяцаПодтверждено
            и Результат!.Долги == 0 и Результат!.ФинальныйСнимок != Неопределено,
            "Нет подтвержденного финансового итога команды %{Команда.Ссылка}")
    ;
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод Опубликовать(Игра: Игры.Ссылка, Версия: Число)
    ДоступИгры.ПроверитьВедущего(Игра)
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Объект = Игра.ЗагрузитьОбъект(Истина)!
    ДоступИгры.ПроверитьВедущего(Игра)
    ПроверкиДанных.Требовать(Объект.Статус == СостоянияИгры.Завершена и Объект.ВерсияСостояния == Версия,
        "Публикация доступна после завершения игры; обновите состояние")
    ПроверитьЗакрытиеИгры(Объект)
    Объект.РезультатыОпубликованы = Истина
    Объект.ВерсияСостояния = Версия + 1
    Объект.Записать()
;

@ВПроекте @НаСервере
метод ПроверитьЗакрытиеИгры(Игра: Игры.Объект)
    знч СсылкаИгры = Игра.Ссылка
    пер Номер = 0
    пока Номер <= Игра.ЧислоРаундов
        знч Раунд = Запрос{
            ВЫБРАТЬ Ссылка ИЗ РаундыИгры ГДЕ Игра == %СсылкаИгры И НомерРаунда == %Номер
        }.Выполнить().ПервыйИлиНеопределено()
        ПроверкиДанных.Требовать(Раунд != Неопределено, "Не создан раунд %{Номер}")
        ПроверитьЗакрытиеРаунда(Раунд!.Ссылка)
        Номер = Номер + 1
    ;
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод ПолучитьОпубликованныеИтоги(): Массив<СтрокаРейтинга>
    знч Пользователь = ДоступИгры.ТекущийПользователь()
    знч Администратор = ДоступИгры.ЭтоАдминистратор()
    исп КонтекстДоступа.Привилегированный()
    знч ВсеСтроки = <СтрокаРейтинга>[]
    для Игра из Запрос{
        ВЫБРАТЬ Ссылка, Ведущий, ТекущийРаунд ИЗ Игры
        ГДЕ РезультатыОпубликованы И Статус == СостоянияИгры.Завершена
        УПОРЯДОЧИТЬ ПО Наименование, Ссылка
    }.Выполнить()
        знч ПараметрЗапроса9_0 = Игра.Ссылка
        знч Назначение = Запрос{
            ВЫБРАТЬ ПЕРВЫЕ 1 Пользователь ИЗ НазначенияПользователей
            ГДЕ Игра == %ПараметрЗапроса9_0 И Пользователь == %Пользователь И Активно
                И (ПрикладнаяРоль == ПрикладныеРоли.Ведущий ИЛИ ПрикладнаяРоль == ПрикладныеРоли.Наблюдатель)
        }.Выполнить().ПервыйИлиНеопределено()
        если не Администратор и Игра.Ведущий != Пользователь и Назначение == Неопределено
            продолжить
        ;
        для Строка из ПолучитьРейтинг(Игра.Ссылка, Игра.ТекущийРаунд!)
            // Observers receive figures and names; entity links remain private.
            Строка.Участник = Неопределено
            ВсеСтроки.Добавить(Строка)
        ;
    ;
    возврат ВсеСтроки
;
