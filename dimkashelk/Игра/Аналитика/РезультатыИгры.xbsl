импорт Данные

@НаСервере @ДоступноСКлиента @ВПроекте
метод ПолучитьРейтинг(Игра: Игры.Ссылка, Раунд: РаундыИгры.Ссылка): Массив<СтрокаРейтинга>
    ДоступИгры.ПроверитьРезультаты(Игра)
    исп КонтекстДоступа.Привилегированный()
    знч ИграОбъект = Игра.ЗагрузитьОбъект()!
    знч РаундОбъект = Раунд.ЗагрузитьОбъект()!
    ПроверкиДанных.Требовать(РаундОбъект.Игра == Игра, "Раунд принадлежит другой игре")
    знч Строки = <СтрокаРейтинга>[]
    для Команда из Запрос{
        ВЫБРАТЬ Ссылка, НаименованиеКоманды ИЗ УчастникиИгры ГДЕ Игра == %Игра И Активен
    }.Выполнить()
        знч ПараметрЗапроса1_0 = Команда.Ссылка
        знч Результат = Запрос{
            ВЫБРАТЬ ДеньгиКонец, ВыручкаФакт, Прибыль, Долги, ОстаткиГП, ЗакрытиеМесяцаПодтверждено ИЗ РезультатыРаундов
            ГДЕ Раунд == %Раунд И Участник == %ПараметрЗапроса1_0
        }.Выполнить().ПервыйИлиНеопределено()
        знч ПараметрЗапроса2_0 = РаундОбъект.ОкончательныйРасчет
        знч ПараметрЗапроса2_1 = Команда.Ссылка
        знч Продажи = Запрос{
            ВЫБРАТЬ СУММА(Отгружено) КАК Количество, СУММА(Оплачено) КАК Сумма
            ИЗ ИсполнениеПродаж ГДЕ Расчет == %ПараметрЗапроса2_0 И Участник == %ПараметрЗапроса2_1
        }.Выполнить().ПервыйИлиНеопределено()
        знч ПараметрЗапроса3_0 = РаундОбъект.ОкончательныйРасчет
        знч ПараметрЗапроса3_1 = Команда.Ссылка
        знч Заказы = Запрос{
            ВЫБРАТЬ СУММА(Заказано) КАК Количество ИЗ РасчетыРынка.Распределение
            ГДЕ Владелец == %ПараметрЗапроса3_0 И Участник == %ПараметрЗапроса3_1
        }.Выполнить().ПервыйИлиНеопределено()
        Строки.Добавить(новый СтрокаРейтинга(Участник = Команда.Ссылка, Команда = Команда.НаименованиеКоманды,
            Деньги = Результат?.ДеньгиКонец, Выручка = Результат?.ВыручкаФакт,
            Прибыль = Результат?.Прибыль, Долги = Результат?.Долги,
            НазваниеИгры = ИграОбъект.Наименование, НомерРаунда = РаундОбъект.НомерРаунда,
            Заказано = РаундОбъект.ОкончательныйРасчет == Неопределено ? Неопределено : (Заказы?.Количество ?? 0),
            Отгружено = Результат == Неопределено ? Неопределено : (Продажи?.Количество ?? 0),
            Оплачено = Результат == Неопределено ? Неопределено : (Продажи?.Сумма ?? 0), ОстаткиГП = Результат?.ОстаткиГП,
            Подтвержден = Результат?.ЗакрытиеМесяцаПодтверждено ?? Ложь,
            ТестовыеДанные = ИграОбъект.Демонстрационная))
    ;
    возврат Рейтинг.РасставитьМеста(Строки)
;

@ВПроекте
@НаСервере
метод ПроверитьЗакрытиеРаунда(Раунд: РаундыИгры.Ссылка)
    знч Игра = Раунд.ЗагрузитьОбъект()!.Игра!
    для Команда из Запрос{
        ВЫБРАТЬ Ссылка ИЗ УчастникиИгры ГДЕ Игра == %Игра И Активен
    }.Выполнить()
        знч ПараметрЗапроса5_0 = Команда.Ссылка
        знч Результат = Запрос{
            ВЫБРАТЬ ФинальныйСнимок, Долги, ЗакрытиеМесяцаПодтверждено ИЗ РезультатыРаундов
            ГДЕ Раунд == %Раунд И Участник == %ПараметрЗапроса5_0
        }.Выполнить().ПервыйИлиНеопределено()
        ПроверкиДанных.Требовать(Результат != Неопределено и Результат!.ЗакрытиеМесяцаПодтверждено
            и Результат!.Долги == 0 и Результат!.ФинальныйСнимок != Неопределено,
            "Нет подтвержденного финансового итога команды %{Команда.Ссылка}")
    ;
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод Опубликовать(Игра: Игры.Ссылка, Версия: Число)
    ДоступИгры.ПроверитьВедущего(Игра)
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Объект = Игра.ЗагрузитьОбъект(Истина)!
    ДоступИгры.ПроверитьВедущего(Игра)
    ПроверкиДанных.Требовать(Объект.Статус == СостоянияИгры.Завершена и Объект.ВерсияСостояния == Версия,
        "Публикация доступна после завершения игры; обновите состояние")
    Объект.РезультатыОпубликованы = Истина
    Объект.ВерсияСостояния = Версия + 1
    Объект.Записать()
;

@ВПроекте
@НаСервере
метод ПринятьИтог(Снимок: СнимкиERP.Объект)
    ПроверкиДанных.Требовать(Транзакции.ЕстьАктивная(), "Прием итога требует транзакции")
    ДоступИгры.ПроверитьВедущего(Снимок.Игра!)
    знч Игра = Снимок.Игра!.ЗагрузитьОбъект(Истина)!
    ПроверкиДанных.Требовать(Игра.Статус == СостоянияИгры.Идет и Игра.Фаза == ФазыИгры.Анализ
        и Игра.ТекущийРаунд == Снимок.Раунд и Игра.ТокенФазы == Снимок.ТокенФазы
        и Игра.Демонстрационная == Снимок.ТестовыеДанные, "Итог не соответствует текущей фазе игры")
    ПроверкиДанных.Требовать(Снимок.ЕстьДеньги и Снимок.ЗакрытиеМесяцаПодтверждено
        и Снимок.ДолгПоставщику == 0 и Снимок.ДолгПокупателя == 0, "Нужны деньги, закрытый месяц и завершенные оплаты")
    знч Раунд = Снимок.Раунд!.ЗагрузитьОбъект()!
    ПроверкиДанных.Требовать(Раунд.ОкончательныйРасчет != Неопределено, "Нет окончательного расчета")
    знч ПараметрЗапроса6_0 = Раунд.ОкончательныйРасчет
    знч ПараметрЗапроса6_1 = Снимок.Участник
    знч Финансы = Запрос{
        ВЫБРАТЬ СУММА(СуммаРеализации) КАК Выручка, СУММА(Оплачено) КАК Оплачено
        ИЗ ИсполнениеПродаж ГДЕ Расчет == %ПараметрЗапроса6_0 И Участник == %ПараметрЗапроса6_1
    }.Выполнить().ПервыйИлиНеопределено()
    знч Выручка = Финансы?.Выручка ?? 0
    ПроверкиДанных.Требовать(Выручка == (Финансы?.Оплачено ?? 0), "Фактические реализации еще не оплачены")
    пер Остаток = 0
    для Строка из Снимок.Остатки
        если Строка.Номенклатура!.ЗагрузитьОбъект()!.Вид == ВидыНоменклатурыИгры.ГотоваяПродукция
            Остаток = Остаток + Строка.Количество
        ;
    ;
    знч Итоги = новый РезультатыРаундов.НаборЗаписей()
    Итоги.Фильтр.Установить(Раунд = Снимок.Раунд, Участник = Снимок.Участник)
    Итоги.ДобавитьЗапись(Раунд = Снимок.Раунд, Участник = Снимок.Участник,
        ФинальныйСнимок = Снимок.Ссылка, ДеньгиНачало = ДеньгиНачалоРаунда(Раунд, Снимок.Участник!),
        ДеньгиКонец = Снимок.Деньги, ВыручкаФакт = Выручка, Прибыль = Снимок.Прибыль,
        Долги = 0, ОстаткиГП = Остаток, ЗакрытиеМесяцаПодтверждено = Истина)
    Итоги.Записать()
;

@ВПроекте
@НаСервере
метод ДеньгиНачалоРаунда(Раунд: РаундыИгры.Объект, Участник: УчастникиИгры.Ссылка): Число
    если Раунд.НомерРаунда == 0
        возврат 0
    ;
    знч НомерПредыдущего = Раунд.НомерРаунда - 1
    знч ПараметрЗапроса7_0 = Раунд.Игра
    знч Предыдущий = Запрос{
        ВЫБРАТЬ ДеньгиКонец ИЗ РезультатыРаундов
        ГДЕ Раунд.Игра == %ПараметрЗапроса7_0 И Раунд.НомерРаунда == %НомерПредыдущего И Участник == %Участник
            И ЗакрытиеМесяцаПодтверждено
    }.Выполнить().ПервыйИлиНеопределено()
    ПроверкиДанных.Требовать(Предыдущий != Неопределено, "Нет подтвержденного итога предыдущего раунда")
    возврат Предыдущий!.ДеньгиКонец
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод ПолучитьОпубликованныеИтоги(): Массив<СтрокаРейтинга>
    знч Пользователь = ДоступИгры.ТекущийПользователь()
    знч Администратор = ДоступИгры.ЭтоАдминистратор()
    исп КонтекстДоступа.Привилегированный()
    знч ВсеСтроки = <СтрокаРейтинга>[]
    для Игра из Запрос{
        ВЫБРАТЬ Ссылка, Ведущий, ТекущийРаунд ИЗ Игры
        ГДЕ РезультатыОпубликованы И Статус == СостоянияИгры.Завершена
        УПОРЯДОЧИТЬ ПО Наименование, Ссылка
    }.Выполнить()
        знч ПараметрЗапроса9_0 = Игра.Ссылка
        знч Назначение = Запрос{
            ВЫБРАТЬ ПЕРВЫЕ 1 Пользователь ИЗ НазначенияПользователей
            ГДЕ Игра == %ПараметрЗапроса9_0 И Пользователь == %Пользователь И Активно
                И (ПрикладнаяРоль == ПрикладныеРоли.Ведущий ИЛИ ПрикладнаяРоль == ПрикладныеРоли.Наблюдатель)
        }.Выполнить().ПервыйИлиНеопределено()
        если не Администратор и Игра.Ведущий != Пользователь и Назначение == Неопределено
            продолжить
        ;
        для Строка из ПолучитьРейтинг(Игра.Ссылка, Игра.ТекущийРаунд!)
            // Observers receive figures and names; entity links remain private.
            Строка.Участник = Неопределено
            ВсеСтроки.Добавить(Строка)
        ;
    ;
    возврат ВсеСтроки
;
