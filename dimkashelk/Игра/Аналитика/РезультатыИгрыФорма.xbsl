импорт Данные

метод Обновить(Команда: ОбычнаяКоманда)
    если ОбновлениеВыполняется
        возврат
    ;
    знч ВыбраннаяИгра = Игра
    знч ВыбранныйРаунд = Раунд
    ОбновлениеВыполняется = Истина
    попытка
        ПроверкиДанных.Требовать(ВыбраннаяИгра != Неопределено и ВыбранныйРаунд != Неопределено, "Выберите игру и раунд")
        знч Данные = РезультатыИгры.ПолучитьДетали(ВыбраннаяИгра!, ВыбранныйРаунд!)
        если Игра == ВыбраннаяИгра и Раунд == ВыбранныйРаунд
            Строки = Данные.Рейтинг
            Модели = Данные.Модели
            Остатки = Данные.Остатки
            История = Данные.История
            Сообщение = "Рейтинг по подтверждённым деньгам. Продажи, остатки и история доступны на вкладках. Неподтверждённые итоги не получают места."
        ;
    поймать Ошибка: Исключение
        если Игра == ВыбраннаяИгра и Раунд == ВыбранныйРаунд
            Очистить()
            Сообщение = Ошибка.Описание
        ;
    ;
    ОбновлениеВыполняется = Ложь
;

метод Опубликованные(Команда: ОбычнаяКоманда)
    если ОбновлениеВыполняется
        возврат
    ;
    знч ВыбраннаяИгра = Игра
    знч ВыбранныйРаунд = Раунд
    ОбновлениеВыполняется = Истина
    попытка
        знч Данные = РезультатыИгры.ПолучитьОпубликованныеИтоги()
        если Игра == ВыбраннаяИгра и Раунд == ВыбранныйРаунд
            Очистить()
            Строки = Данные
            Сообщение = "Опубликованные итоги завершённых игр. Для детализации выберите игру и раунд, затем нажмите «Показать рейтинг»."
        ;
    поймать Ошибка: Исключение
        если Игра == ВыбраннаяИгра и Раунд == ВыбранныйРаунд
            Очистить()
            Сообщение = Ошибка.Описание
        ;
    ;
    ОбновлениеВыполняется = Ложь
;

метод Очистить()
    Строки = []
    Модели = []
    Остатки = []
    История = []
    Сообщение = ""
;

метод ИграПриИзменении(Источник: ПолеВвода<Игры.Ссылка?>, Событие: СобытиеПриИзменении<Игры.Ссылка?>)
    Раунд = Неопределено
    Раунды = []
    Очистить()
    если Игра == Неопределено
        возврат
    ;
    знч ВыбраннаяИгра = Игра!
    попытка
        знч Список = РезультатыИгры.ПолучитьРаундыВедущего(ВыбраннаяИгра)
        если Игра == ВыбраннаяИгра
            Раунды = Список
        ;
    поймать Ошибка: Исключение
        если Игра == ВыбраннаяИгра
            Сообщение = Ошибка.Описание
        ;
    ;
;

метод РаундПриИзменении(Источник: ПолеВвода<РаундыИгры.Ссылка?>, Событие: СобытиеПриИзменении<РаундыИгры.Ссылка?>)
    Очистить()
;

метод ПолучитьРаундыДляВыбора(): Массив<ЭлементСпискаЗначений<РаундыИгры.Ссылка?>>
    знч Список = новый Массив<ЭлементСпискаЗначений<РаундыИгры.Ссылка?>>()
    для СсылкаРаунда из Раунды
        Список.Добавить(новый ЭлементСпискаЗначений<РаундыИгры.Ссылка?>(Значение = СсылкаРаунда, Представление = СсылкаРаунда.Представление()))
    ;
    возврат Список
;
