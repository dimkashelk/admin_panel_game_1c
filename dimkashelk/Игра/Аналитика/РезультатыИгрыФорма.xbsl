импорт Данные

метод Обновить(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(Игра != Неопределено и Раунд != Неопределено, "Выберите игру и раунд")
        Строки = РезультатыИгры.ПолучитьРейтинг(Игра!, Раунд!)
        Сообщение = "Неподтвержденные итоги не получают место. Тестовые данные отмечены в отдельном столбце."
    поймать Ошибка: Исключение
        Строки = []
        Сообщение = Ошибка.Описание
    ;
;

метод Опубликованные(Команда: ОбычнаяКоманда)
    попытка
        Строки = РезультатыИгры.ПолучитьОпубликованныеИтоги()
        Сообщение = "Опубликованные итоги доступных игр; пустая таблица означает, что таких игр пока нет."
    поймать Ошибка: Исключение
        Строки = []
        Сообщение = Ошибка.Описание
    ;
;
