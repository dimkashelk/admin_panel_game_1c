импорт Данные

@ВПроекте
метод Выполнить(): Строка
    знч Параметры = новый ПараметрыПродукта(КодПродукта = "test", БазовыйСпрос = 12,
        РеферентнаяЦена = 10, МинимальнаяЦена = 1, МаксимальнаяЦена = 100,
        Эластичность = 0, ЧувствительностьКЦене = 1, Тренд = 1)
    знч Предложения = [Предложение("А", 10, 1), Предложение("Б", 10, 10), Предложение("В", 10, 10)]
    для Алгоритм из [АлгоритмыРынка.ЦеновыеДоли, АлгоритмыРынка.СначалаДешевые]
        знч Итог = РасчетРынка.Рассчитать(Параметры, Предложения, Алгоритм, 42, 0)
        ПроверкиДанных.Требовать(Итог.Спрос == 12, "Не учтен дефицит запаса")
        если Алгоритм == АлгоритмыРынка.ЦеновыеДоли
            ПроверкиДанных.Требовать(Итог.Заказы[0].Заказано == 1, "Не учтен ограниченный запас")
            ПроверкиДанных.Требовать(Итог.Заказы[1].Заказано >= 5 && Итог.Заказы[1].Заказано <= 6,
                "Ошибка перераспределения ценовых долей")
        иначе
            ПроверкиДанных.Требовать(Итог.Заказы[0].Заказано == 0
                && Итог.Заказы[1].Заказано == 6 && Итог.Заказы[2].Заказано == 6, "Неверная пропорция запаса в ценовой группе")
        ;
        знч Повтор = РасчетРынка.Рассчитать(Параметры,
            [Предложения[2], Предложения[0], Предложения[1]], Алгоритм, 42, 0)
        пер Индекс = 0
        пока Индекс < Итог.Заказы.Размер()
            ПроверкиДанных.Требовать(Итог.Заказы[Индекс].Заказано == Повтор.Заказы[Индекс].Заказано,
                "Перестановка строк изменила результат")
            Индекс = Индекс + 1
        ;
        знч Пустой = РасчетРынка.Рассчитать(Параметры, [], Алгоритм, 0, 0)
        ПроверкиДанных.Требовать(Пустой.Заказы.Пусто() && Пустой.НепокрытыйСпрос == 12, "Ошибка пустого рынка")
        знч Дефицит = РасчетРынка.Рассчитать(Параметры,
            [Предложение("А", 10, 2), Предложение("Б", 10, 3)], Алгоритм, 0, 0)
        ПроверкиДанных.Требовать(Дефицит.НепокрытыйСпрос == 7
            && Дефицит.Заказы[0].Заказано == 2 && Дефицит.Заказы[1].Заказано == 3, "Ошибка дефицитного рынка")
    ;
    знч РазныеЦены = [Предложение("А", 10, 100), Предложение("Б", 20, 100)]
    знч Доли = РасчетРынка.Рассчитать(Параметры, РазныеЦены, АлгоритмыРынка.ЦеновыеДоли, 0, 0)
    знч Ранжирование = РасчетРынка.Рассчитать(Параметры, РазныеЦены, АлгоритмыРынка.СначалаДешевые, 0, 0)
    ПроверкиДанных.Требовать(Доли.Заказы[0].Заказано == 8 && Доли.Заказы[1].Заказано == 4,
        "Неверные ценовые доли")
    ПроверкиДанных.Требовать(Ранжирование.Заказы[0].Заказано == 12 && Ранжирование.Заказы[1].Заказано == 0,
        "Дешевое предложение должно обслуживаться первым")
    возврат "Проверки алгоритмов пройдены: дефицит, округление, пустой рынок, порядок строк и различие алгоритмов."
;

метод Предложение(Участник: Строка, Цена: Число, Доступно: Число): ПредложениеРынка
    возврат новый ПредложениеРынка(Участник = Участник, Цена = Цена, Доступно = Доступно, Активен = Истина)
;
