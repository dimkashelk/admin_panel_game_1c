импорт Данные

@ВПроекте
метод Версия(): Строка
    возврат "market-v1"
;

@ВПроекте
метод Рассчитать(Параметры: ПараметрыПродукта, Предложения: ЧитаемыйМассив<ПредложениеРынка>,
    Алгоритм: АлгоритмыРынка, Seed: Число, Раунд: Число): ИтогРынка
    ПроверкиДанных.ПроверитьПродукт(Параметры)
    ПроверкиДанных.ЦелоеНеотрицательное(Seed, "Seed")
    ПроверкиДанных.ЦелоеНеотрицательное(Раунд, "Номер раунда")
    знч Идентификаторы = <Строка>[]
    пер Заказы = <СтрокаЗаказа>[]
    пер СуммаЦен = 0
    пер ЧислоПредложений = 0
    пер Доступность = 0
    для Предложение из Предложения
        ПроверкиДанных.Требовать(не Идентификаторы.Содержит(Предложение.Участник), "Повтор участника в предложениях")
        Идентификаторы.Добавить(Предложение.Участник)
        если не Предложение.Активен
            продолжить
        ;
        ПроверкиДанных.ПроверитьПредложение(Предложение, Параметры)
        если Предложение.Доступно == 0
            продолжить
        ;
        СуммаЦен = СуммаЦен + Предложение.Цена
        ЧислоПредложений = ЧислоПредложений + 1
        Доступность = Доступность + Предложение.Доступно
        Заказы.Добавить(новый СтрокаЗаказа(Участник = Предложение.Участник,
            Цена = Предложение.Цена, Доступно = Предложение.Доступно,
            Вес = (Параметры.РеферентнаяЦена / Предложение.Цена) ** Параметры.ЧувствительностьКЦене,
            Приоритет = ПроверкиДанных.СтабильныйПриоритет(
                Параметры.КодПродукта + ":" + Предложение.Участник, Seed, Раунд)))
    ;
    // Canonical order also fixes the order of decimal additions.
    Заказы = Заказы.Сортировать((Левый, Правый) -> Левый.Участник.Сравнить(Правый.Участник))
    знч СредняяЦена = ЧислоПредложений == 0 ? Параметры.РеферентнаяЦена : СуммаЦен / ЧислоПредложений
    знч Спрос = (Параметры.БазовыйСпрос * Параметры.Тренд
        * (Параметры.РеферентнаяЦена / СредняяЦена) ** Параметры.Эластичность).Округлить(0, РежимОкругления.ПоловинаВверх)
    знч Цель = Спрос < Доступность ? Спрос : Доступность
    если Алгоритм == АлгоритмыРынка.ЦеновыеДоли
        РаспределитьДоли(Заказы, Цель)
    иначе
        РаспределитьПоЦене(Заказы, Цель)
    ;
    пер ПроверочнаяСумма = 0
    для Заказ из Заказы
        Заказ.Выручка = Заказ.Цена * Заказ.Заказано
        ПроверкиДанных.ЦелоеНеотрицательное(Заказ.Заказано, "Заказ")
        ПроверкиДанных.Требовать(Заказ.Заказано <= Заказ.Доступно, "Заказ превышает остаток")
        ПроверочнаяСумма = ПроверочнаяСумма + Заказ.Заказано
    ;
    ПроверкиДанных.Требовать(ПроверочнаяСумма == Цель, "Нарушено сохранение количества заказов")
    возврат новый ИтогРынка(СредняяЦена = СредняяЦена, Спрос = Спрос,
        Доступность = Доступность, НепокрытыйСпрос = Спрос - Цель, Заказы = Заказы)
;

метод РаспределитьДоли(Заказы: Массив<СтрокаЗаказа>, Цель: Число)
    пер Осталось = Цель
    знч Доступные = <СтрокаЗаказа>[]
    для Заказ из Заказы
        Доступные.Добавить(Заказ)
    ;
    пока Осталось > 0 и не Доступные.Пусто()
        пер СуммаВесов = 0
        для Заказ из Доступные
            СуммаВесов = СуммаВесов + Заказ.Вес
        ;
        знч Ограниченные = <СтрокаЗаказа>[]
        для Заказ из Доступные
            Заказ.Доля = Осталось * Заказ.Вес / СуммаВесов
            если Заказ.Доля >= Заказ.Доступно
                Ограниченные.Добавить(Заказ)
            ;
        ;
        если Ограниченные.Пусто()
            ОкруглитьГруппу(Доступные, Осталось)
            Осталось = 0
        иначе
            для Заказ из Ограниченные
                Заказ.Доля = Заказ.Доступно
                Заказ.Заказано = Заказ.Доступно
                Осталось = Осталось - Заказ.Доступно
                Доступные.Удалить(Заказ)
            ;
        ;
    ;
;

метод РаспределитьПоЦене(Заказы: Массив<СтрокаЗаказа>, Цель: Число)
    знч Доступные = <СтрокаЗаказа>[]
    для Заказ из Заказы
        Доступные.Добавить(Заказ)
    ;
    пер Осталось = Цель
    пока Осталось > 0 и не Доступные.Пусто()
        пер ЦенаГруппы = Доступные[0].Цена
        для Заказ из Доступные
            если Заказ.Цена < ЦенаГруппы
                ЦенаГруппы = Заказ.Цена
            ;
        ;
        знч Группа = <СтрокаЗаказа>[]
        пер ЗапасГруппы = 0
        для Заказ из Доступные
            если Заказ.Цена == ЦенаГруппы
                Группа.Добавить(Заказ)
                ЗапасГруппы = ЗапасГруппы + Заказ.Доступно
            ;
        ;
        знч Объем = Осталось < ЗапасГруппы ? Осталось : ЗапасГруппы
        для Заказ из Группа
            Заказ.Доля = Объем * Заказ.Доступно / ЗапасГруппы
        ;
        ОкруглитьГруппу(Группа, Объем)
        Осталось = Осталось - Объем
        для Заказ из Группа
            Доступные.Удалить(Заказ)
        ;
    ;
;

метод ОкруглитьГруппу(Группа: Массив<СтрокаЗаказа>, Объем: Число)
    пер Осталось = Объем
    для Заказ из Группа
        Заказ.Заказано = Заказ.Доля.Округлить(0, РежимОкругления.Вниз)
        Осталось = Осталось - Заказ.Заказано
    ;
    знч ПолучившиеЕдиницу = <Строка>[]
    пока Осталось > 0
        пер Лучший: СтрокаЗаказа? = Неопределено
        для Заказ из Группа
            если Заказ.Заказано >= Заказ.Доступно или ПолучившиеЕдиницу.Содержит(Заказ.Участник)
                продолжить
            ;
            если Лучший == Неопределено или Предпочтительнее(Заказ, Лучший)
                Лучший = Заказ
            ;
        ;
        ПроверкиДанных.Требовать(Лучший != Неопределено, "Не удалось распределить остаток спроса")
        Лучший!.Заказано = Лучший!.Заказано + 1
        ПолучившиеЕдиницу.Добавить(Лучший!.Участник)
        Осталось = Осталось - 1
    ;
;

метод Предпочтительнее(Кандидат: СтрокаЗаказа, Текущий: СтрокаЗаказа): Булево
    знч ОстатокКандидата = Кандидат.Доля - Кандидат.Доля.Округлить(0, РежимОкругления.Вниз)
    знч ОстатокТекущего = Текущий.Доля - Текущий.Доля.Округлить(0, РежимОкругления.Вниз)
    если ОстатокКандидата != ОстатокТекущего
        возврат ОстатокКандидата > ОстатокТекущего
    ;
    если Кандидат.Приоритет != Текущий.Приоритет
        возврат Кандидат.Приоритет < Текущий.Приоритет
    ;
    возврат Кандидат.Участник.Сравнить(Текущий.Участник) < 0
;
