импорт Данные

@ВПроекте
метод Версия(): Строка
    возврат "market-v1"
;

@ВПроекте
метод Рассчитать(Параметры: ПараметрыПродукта, Предложения: ЧитаемыйМассив<ПредложениеРынка>,
    Алгоритм: АлгоритмыРынка, Seed: Число, Раунд: Число, ПроцентСпроса: Число = 80): ИтогРынка
    ПроверкиДанных.ПроверитьПродукт(Параметры)
    ПроверкиДанных.ЦелоеНеотрицательное(Seed, "Seed")
    ПроверкиДанных.ЦелоеНеотрицательное(Раунд, "Номер раунда")
    знч Идентификаторы = <Строка>[]
    пер Заказы = <СтрокаЗаказа>[]
    пер СуммаЦен = 0
    пер ЧислоПредложений = 0
    пер Доступность = 0
    для Предложение из Предложения
        ПроверкиДанных.Требовать(не Идентификаторы.Содержит(Предложение.Участник), "Повтор участника в предложениях")
        Идентификаторы.Добавить(Предложение.Участник)
        если не Предложение.Активен
            продолжить
        ;
        ПроверкиДанных.ПроверитьПредложение(Предложение, Параметры)
        если Предложение.Доступно == 0
            продолжить
        ;
        СуммаЦен = СуммаЦен + Предложение.Цена
        ЧислоПредложений = ЧислоПредложений + 1
        Доступность = Доступность + Предложение.Доступно
        Заказы.Добавить(новый СтрокаЗаказа(Участник = Предложение.Участник,
            Цена = Предложение.Цена, Доступно = Предложение.Доступно,
            Вес = (Параметры.РеферентнаяЦена / Предложение.Цена) ** Параметры.ЧувствительностьКЦене,
            Приоритет = ПроверкиДанных.СтабильныйПриоритет(
                Параметры.КодПродукта + ":" + Предложение.Участник, Seed, Раунд)))
    ;
    // Canonical order also fixes the order of decimal additions.
    Заказы = Заказы.Сортировать((Левый, Правый) -> Левый.Участник.Сравнить(Правый.Участник))
    знч СредняяЦена = ЧислоПредложений == 0 ? Параметры.РеферентнаяЦена : СуммаЦен / ЧислоПредложений
    знч Спрос = СпросОтПредложения(Доступность, ПроцентСпроса)
    знч Цель = Спрос < Доступность ? Спрос : Доступность
    если Алгоритм == АлгоритмыРынка.ЦеновыеДоли
        РаспределитьДоли(Заказы, Цель)
    иначе
        РаспределитьПоЦене(Заказы, Цель)
    ;
    пер ПроверочнаяСумма = 0
    для Заказ из Заказы
        Заказ.Выручка = Заказ.Цена * Заказ.Заказано
        ПроверкиДанных.ЦелоеНеотрицательное(Заказ.Заказано, "Заказ")
        ПроверкиДанных.Требовать(Заказ.Заказано <= Заказ.Доступно, "Заказ превышает остаток")
        ПроверочнаяСумма = ПроверочнаяСумма + Заказ.Заказано
    ;
    ПроверкиДанных.Требовать(ПроверочнаяСумма == Цель, "Нарушено сохранение количества заказов")
    возврат новый ИтогРынка(СредняяЦена = СредняяЦена, Спрос = Спрос,
        Доступность = Доступность, НепокрытыйСпрос = Спрос - Цель, Заказы = Заказы)
;

@ВПроекте
метод СпросОтПредложения(Предложение: Число, ПроцентСпроса: Число): Число
    ПроверкиДанных.ПроверитьПроцентСпроса(ПроцентСпроса)
    ПроверкиДанных.ЦелоеНеотрицательное(Предложение, "Доступный объём поставки")
    возврат (Предложение * ПроцентСпроса / 100).Округлить(0, РежимОкругления.ПоловинаВверх)
;

метод РаспределитьДоли(Заказы: Массив<СтрокаЗаказа>, Цель: Число)
    пер Осталось = Цель
    знч Доступные = <СтрокаЗаказа>[]
    для Заказ из Заказы
        Доступные.Добавить(Заказ)
    ;
    пока Осталось > 0 и не Доступные.Пусто()
        пер СуммаВесов = 0
        для Заказ из Доступные
            СуммаВесов = СуммаВесов + Заказ.Вес
        ;
        знч Ограниченные = <СтрокаЗаказа>[]
        для Заказ из Доступные
            Заказ.Доля = Осталось * Заказ.Вес / СуммаВесов
            если Заказ.Доля >= Заказ.Доступно
                Ограниченные.Добавить(Заказ)
            ;
        ;
        если Ограниченные.Пусто()
            ОкруглитьГруппу(Доступные, Осталось)
            Осталось = 0
        иначе
            для Заказ из Ограниченные
                Заказ.Доля = Заказ.Доступно
                Заказ.Заказано = Заказ.Доступно
                Осталось = Осталось - Заказ.Доступно
                Доступные.Удалить(Заказ)
            ;
        ;
    ;
;

метод РаспределитьПоЦене(Заказы: Массив<СтрокаЗаказа>, Цель: Число)
    знч Доступные = <СтрокаЗаказа>[]
    для Заказ из Заказы
        Доступные.Добавить(Заказ)
    ;
    пер Осталось = Цель
    пока Осталось > 0 и не Доступные.Пусто()
        пер ЦенаГруппы = Доступные[0].Цена
        для Заказ из Доступные
            если Заказ.Цена < ЦенаГруппы
                ЦенаГруппы = Заказ.Цена
            ;
        ;
        знч Группа = <СтрокаЗаказа>[]
        пер ЗапасГруппы = 0
        для Заказ из Доступные
            если Заказ.Цена == ЦенаГруппы
                Группа.Добавить(Заказ)
                ЗапасГруппы = ЗапасГруппы + Заказ.Доступно
            ;
        ;
        знч Объем = Осталось < ЗапасГруппы ? Осталось : ЗапасГруппы
        для Заказ из Группа
            Заказ.Доля = Объем * Заказ.Доступно / ЗапасГруппы
        ;
        ОкруглитьГруппу(Группа, Объем)
        Осталось = Осталось - Объем
        для Заказ из Группа
            Доступные.Удалить(Заказ)
        ;
    ;
;

метод ОкруглитьГруппу(Группа: Массив<СтрокаЗаказа>, Объем: Число)
    пер Осталось = Объем
    для Заказ из Группа
        Заказ.Заказано = Заказ.Доля.Округлить(0, РежимОкругления.Вниз)
        Осталось = Осталось - Заказ.Заказано
    ;
    знч ПолучившиеЕдиницу = <Строка>[]
    пока Осталось > 0
        пер Лучший: СтрокаЗаказа? = Неопределено
        для Заказ из Группа
            если Заказ.Заказано >= Заказ.Доступно или ПолучившиеЕдиницу.Содержит(Заказ.Участник)
                продолжить
            ;
            если Лучший == Неопределено или Предпочтительнее(Заказ, Лучший)
                Лучший = Заказ
            ;
        ;
        ПроверкиДанных.Требовать(Лучший != Неопределено, "Не удалось распределить остаток спроса")
        Лучший!.Заказано = Лучший!.Заказано + 1
        ПолучившиеЕдиницу.Добавить(Лучший!.Участник)
        Осталось = Осталось - 1
    ;
;

метод Предпочтительнее(Кандидат: СтрокаЗаказа, Текущий: СтрокаЗаказа): Булево
    знч ОстатокКандидата = Кандидат.Доля - Кандидат.Доля.Округлить(0, РежимОкругления.Вниз)
    знч ОстатокТекущего = Текущий.Доля - Текущий.Доля.Округлить(0, РежимОкругления.Вниз)
    если ОстатокКандидата != ОстатокТекущего
        возврат ОстатокКандидата > ОстатокТекущего
    ;
    если Кандидат.Приоритет != Текущий.Приоритет
        возврат Кандидат.Приоритет < Текущий.Приоритет
    ;
    возврат Кандидат.Участник.Сравнить(Текущий.Участник) < 0
;

// Объём спроса задаётся процентом предложения ERP; цены определяют доли команд.
@ВПроекте
метод РассчитатьПерсональныеЗаказы(Параметры: ЧитаемыйМассив<ПараметрыПродукта>,
    Предложения: ЧитаемыйМассив<Массив<ПредложениеРынка>>, Алгоритм: АлгоритмыРынка,
    Seed: Число, Раунд: Число, ПроцентСпроса: Число = 80): Массив<ИтогРынка>
    ПроверкиДанных.Требовать(не Параметры.Пусто() и Параметры.Размер() == Предложения.Размер(), "Нет прайс-листов моделей")
    ПроверкиДанных.ЦелоеНеотрицательное(Seed, "Seed")
    ПроверкиДанных.ЦелоеНеотрицательное(Раунд, "Раунд")
    знч Команды = <Строка>[]
    для Предложение из Предложения[0]
        ПроверкиДанных.Требовать(Предложение.Активен и не Команды.Содержит(Предложение.Участник), "Повтор или неактивная команда в прайс-листе")
        Команды.Добавить(Предложение.Участник)
    ;
    ПроверкиДанных.Требовать(не Команды.Пусто(), "Нет команд для заказов")
    знч ПорядокКоманд = Команды.Сортировать((Л, П) -> Л.Сравнить(П))
    знч Итоги = <ИтогРынка>[]
    знч Потребности = <Число>[]
    знч Резервы = <Соответствие<Строка, Число>>[]
    знч ВсегоКоманде = <Строка, Число>{:}
    пер ВсегоОстатков = 0
    пер Индекс = 0
    для Правило из Параметры
        ПроверкиДанных.ПроверитьПродукт(Правило)
        знч Строки = Предложения[Индекс].Сортировать((Л, П) -> Л.Участник.Сравнить(П.Участник))
        ПроверкиДанных.Требовать(Строки.Размер() == ПорядокКоманд.Размер(), "Неполный прайс-лист команды")
        пер СуммаЦен = 0
        пер ОстатокМодели = 0
        пер НомерКоманды = 0
        для Предложение из Строки
            ПроверкиДанных.Требовать(Предложение.Активен и Предложение.Участник == ПорядокКоманд[НомерКоманды], "Разный состав команд в прайс-листах")
            ПроверкиДанных.ПроверитьПредложение(Предложение, Правило)
            СуммаЦен = СуммаЦен + Предложение.Цена
            ОстатокМодели = ОстатокМодели + Предложение.Доступно
            НомерКоманды = НомерКоманды + 1
        ;
        знч СредняяЦена = СуммаЦен / Строки.Размер()
        знч Спрос = ОстатокМодели
        знч Заказы = <СтрокаЗаказа>[]
        знч Резерв = <Строка, Число>{:}
        для Предложение из Строки
            Заказы.Добавить(новый СтрокаЗаказа(Участник = Предложение.Участник,
                Цена = Предложение.Цена, Доступно = Предложение.Доступно,
                Вес = (Правило.РеферентнаяЦена / Предложение.Цена) ** Правило.ЧувствительностьКЦене))
            Резерв.Вставить(Предложение.Участник, 0)
            ВсегоКоманде.Вставить(Предложение.Участник, 0)
        ;
        Итоги.Добавить(новый ИтогРынка(СредняяЦена = СредняяЦена, Спрос = Спрос,
            Доступность = ОстатокМодели, Заказы = Заказы))
        Резервы.Добавить(Резерв)
        Потребности.Добавить(Спрос)
        ВсегоОстатков = ВсегоОстатков + ОстатокМодели
        Индекс = Индекс + 1
    ;
    знч Цель = СпросОтПредложения(ВсегоОстатков, ПроцентСпроса)
    ПроверкиДанных.Требовать(Цель >= Команды.Размер(),
        "При спросе %{ПроцентСпроса}% от %{ВсегоОстатков} шт. получается %{Цель} шт. Для персонального заказа каждой команде нужно минимум %{Команды.Размер()} шт. Увеличьте доступный объём или процент спроса в настройках игры")
    // Гарантируем каждой команде одну единицу в пределах подтверждённого предложения ERP.
    пер НомерКоманды = 0
    для Участник из ПорядокКоманд
        пер ЛучшаяМодель = -1
        Индекс = 0
        пока Индекс < Итоги.Размер()
            знч Заказ = Итоги[Индекс].Заказы[НомерКоманды]
            если Заказ.Доступно > 0 и (ЛучшаяМодель == -1 или Потребности[Индекс] > Потребности[ЛучшаяМодель])
                ЛучшаяМодель = Индекс
            ;
            Индекс = Индекс + 1
        ;
        ПроверкиДанных.Требовать(ЛучшаяМодель >= 0, "У команды %{Участник} нет доступного товара для персонального заказа")
        знч Заказ = Итоги[ЛучшаяМодель].Заказы[НомерКоманды]
        Заказ.Доступно = Заказ.Доступно - 1
        Резервы[ЛучшаяМодель].Вставить(Участник, 1)
        Потребности[ЛучшаяМодель] = Потребности[ЛучшаяМодель] > 0 ? Потребности[ЛучшаяМодель] - 1 : 0
        ВсегоКоманде.Вставить(Участник, 1)
        НомерКоманды = НомерКоманды + 1
    ;
    пер Осталось = Цель - Команды.Размер()
    пер СуммаПотребностей = 0
    для Потребность из Потребности
        СуммаПотребностей = СуммаПотребностей + Потребность
    ;
    пер Нераспределено = Осталось
    Индекс = 0
    пока Индекс < Итоги.Размер()
        знч Итог = Итоги[Индекс]
        знч Объем = СуммаПотребностей == 0 ? 0
            : (Осталось * Потребности[Индекс] / СуммаПотребностей).Округлить(0, РежимОкругления.Вниз)
        РаспределитьПерсональнуюМодель(Итог.Заказы, Объем, Алгоритм, ВсегоКоманде, Seed, Раунд)
        Нераспределено = Нераспределено - Объем
        Осталось = Осталось - Объем
        СуммаПотребностей = СуммаПотребностей - Потребности[Индекс]
        Индекс = Индекс + 1
    ;
    ПроверкиДанных.Требовать(Нераспределено == 0, "Не удалось распределить рыночный спрос")
    Индекс = 0
    пер ПроверочнаяСумма = 0
    для Итог из Итоги
        пер Назначено = 0
        для Заказ из Итог.Заказы
            Заказ.Заказано = Заказ.Заказано + Резервы[Индекс].Получить(Заказ.Участник)
            Заказ.Доступно = Заказ.Доступно + Резервы[Индекс].Получить(Заказ.Участник)
            Заказ.Выручка = Заказ.Цена * Заказ.Заказано
            Назначено = Назначено + Заказ.Заказано
            ПроверкиДанных.Требовать(Заказ.Заказано <= Заказ.Доступно, "Заказ превышает доступный объём поставки")
        ;
        Итог.Спрос = Назначено
        Итог.НепокрытыйСпрос = 0
        ПроверочнаяСумма = ПроверочнаяСумма + Назначено
        Индекс = Индекс + 1
    ;
    ПроверкиДанных.Требовать(ПроверочнаяСумма == Цель, "Нарушено сохранение общего спроса")
    возврат Итоги
;

метод РаспределитьПерсональнуюМодель(Заказы: Массив<СтрокаЗаказа>, Объем: Число, Алгоритм: АлгоритмыРынка,
    ВсегоКоманде: Соответствие<Строка, Число>, Seed: Число, Раунд: Число)
    для Заказ из Заказы
        // Меньший портфель выигрывает равенство остатков, затем действует seed раунда.
        Заказ.Приоритет = ВсегоКоманде.Получить(Заказ.Участник) * 2147483647
            + ПроверкиДанных.СтабильныйПриоритет(Заказ.Участник, Seed, Раунд)
    ;
    если Алгоритм == АлгоритмыРынка.ЦеновыеДоли
        РаспределитьДоли(Заказы, Объем)
    иначе
        РаспределитьРавныеЦены(Заказы, Объем)
    ;
    для Заказ из Заказы
        ВсегоКоманде.Вставить(Заказ.Участник, ВсегоКоманде.Получить(Заказ.Участник) + Заказ.Заказано)
    ;
;

метод РаспределитьРавныеЦены(Заказы: Массив<СтрокаЗаказа>, Объем: Число)
    знч Доступные = Заказы.Сортировать((Л, П) -> Л.Цена < П.Цена ? -1 : (Л.Цена > П.Цена ? 1 : Л.Участник.Сравнить(П.Участник)))
    пер Осталось = Объем
    пока Осталось > 0 и не Доступные.Пусто()
        знч Цена = Доступные[0].Цена
        знч Группа = <СтрокаЗаказа>[]
        пер Вместимость = 0
        для Заказ из Доступные
            если Заказ.Цена == Цена
                Заказ.Вес = 1
                Группа.Добавить(Заказ)
                Вместимость = Вместимость + Заказ.Доступно
            ;
        ;
        знч Количество = Осталось < Вместимость ? Осталось : Вместимость
        РаспределитьДоли(Группа, Количество)
        Осталось = Осталось - Количество
        для Заказ из Группа
            Доступные.Удалить(Заказ)
        ;
    ;
;
