импорт Данные

@Обработчик
метод ПослеСоздания()
    КодПродукта = "CityRide"
    Параметры = новый ПараметрыПродукта(КодПродукта = КодПродукта, БазовыйСпрос = 120,
        РеферентнаяЦена = 52000, МинимальнаяЦена = 35000, МаксимальнаяЦена = 75000,
        Эластичность = 1, ЧувствительностьКЦене = 1.35, Тренд = 1)
    Seed = 42
    Предложения = [новый ПредложениеРынка(Участник = "Альфа", Цена = 52000, Доступно = 100, Активен = Истина),
        новый ПредложениеРынка(Участник = "Бета", Цена = 52000, Доступно = 100, Активен = Истина)]
;

метод Рассчитать(Команда: ОбычнаяКоманда)
    попытка
        Параметры.КодПродукта = КодПродукта
        знч Итог = РасчетРынка.Рассчитать(Параметры, Предложения, Алгоритм, Seed, НомерРаунда)
        Заказы = Итог.Заказы
        Сообщение = "Предварительный расчет: спрос %{Итог.Спрос}, доступно %{Итог.Доступность}, не покрыто %{Итог.НепокрытыйСпрос}."
    поймать Ошибка: Исключение
        Заказы = []
        Сообщение = Ошибка.Описание
    ;
;

метод Проверить(Команда: ОбычнаяКоманда)
    попытка
        Сообщение = ПроверкиРынка.Выполнить()
    поймать Ошибка: Исключение
        Сообщение = Ошибка.Описание
    ;
;
