@Обработчик
метод ВычислитьРазрешенияДоступа(): Массив<РазрешениеДоступа>
    возврат [новый РазрешениеДоступа(
        [новый КлючДоступаДляАутентифицированных.Объект()], [Сущность.Право.Чтение])]
;

@Обработчик
метод ВычислитьРазрешенияДоступаДляОбъектов(
    Объекты: ЧитаемыйМассив<Игры.ДанныеРасчетаРазрешений>
): ЧитаемоеСоответствие<Игры.ДанныеРасчетаРазрешений, ЧитаемаяКоллекция<РазрешениеДоступа>>
    знч Разрешения = <Игры.ДанныеРасчетаРазрешений, ЧитаемаяКоллекция<РазрешениеДоступа>>{:}
    для Объект из Объекты
        если Объект.КонтекстДоступаИгры != Неопределено
            знч Права = ДоступИгры.РазрешенияЧтенияИгры(Объект.КонтекстДоступаИгры)
            если Права.Пусто() && Объект.Ведущий != Неопределено
                Права.Добавить(новый РазрешениеДоступа(
                    [новый КлючДоступаПользователя.Объект(Владелец = Объект.Ведущий)], [Сущность.Право.Чтение]))
            ;
            Разрешения.Вставить(Объект, Права)
        ;
    ;
    возврат Разрешения
;
