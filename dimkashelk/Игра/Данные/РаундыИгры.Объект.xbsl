@Обработчик
метод ПередЗаписью(До: РаундыИгры.Данные, ПараметрыЗаписи: РаундыИгры.ПараметрыЗаписи)
    ПроверкиДанных.Требовать(Игра != Неопределено, "Не указана игра")
    ПроверкиДанных.ЦелоеНеотрицательное(НомерРаунда, "Номер раунда")
    знч ИграОбъект = Игра!.ЗагрузитьОбъект(Истина)!
    знч Дубликат = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ РаундыИгры
        ГДЕ Игра == %Игра И НомерРаунда == %НомерРаунда И Ссылка != %Ссылка
    }.Выполнить().ПервыйИлиНеопределено()
    ПроверкиДанных.Требовать(Дубликат == Неопределено, "Раунд с таким номером уже существует")
    если !ЭтоНовый()
        ПроверкиДанных.Требовать(До.Состояние != СостоянияФазы.Закрыта, "Закрытый раунд неизменяем")
        ПроверкиДанных.Требовать(Игра == До.Игра && НомерРаунда == До.НомерРаунда,
            "Нельзя изменить принадлежность раунда")
    ;
;

@Обработчик
метод ПередУдалением(ПараметрыУдаления: РаундыИгры.ПараметрыУдаления)
    выбросить новый ИсключениеНедопустимоеСостояние("История игры не удаляется")
;
