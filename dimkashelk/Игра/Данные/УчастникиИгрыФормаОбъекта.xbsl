метод ПроверитьСохранение()
    ПроверкиДанных.Требовать(не Объект.ЭтоНовый(), "Сначала сохраните команду")
;

метод ПоказатьПользователей(Команда: ОбычнаяКоманда)
    попытка
        ПроверитьСохранение()
        СписокПользователей = ДоступКабинета.ПользователиКоманды(Объект.Ссылка)
    поймать Ошибка: Исключение
        СообщениеПользователей = Ошибка.Описание
    ;
;

метод ДобавитьПользователя(Команда: ОбычнаяКоманда)
    НазначитьПользователя(Истина)
;

метод ОтключитьПользователя(Команда: ОбычнаяКоманда)
    НазначитьПользователя(Ложь)
;

метод НазначитьПользователя(Активно: Булево)
    попытка
        ПроверитьСохранение()
        ПроверкиДанных.Требовать(ПользовательКоманды != Неопределено, "Выберите пользователя")
        ДоступКабинета.НазначитьИгрока(Объект.Ссылка, ПользовательКоманды!, Активно)
        СписокПользователей = ДоступКабинета.ПользователиКоманды(Объект.Ссылка)
        СообщениеПользователей = Активно ? "Игрок добавлен в команду" : "Игрок отключён от команды"
    поймать Ошибка: Исключение
        СообщениеПользователей = Ошибка.Описание
    ;
;

метод СоздатьПользователя(Команда: ОбычнаяКоманда)
    попытка
        ПроверитьСохранение()
        если ПарольИгрока == ""
            ПарольИгрока = "G!" + новый Ууид().ВСтроку()
        ;
        знч ПарольСоздания = ПарольИгрока
        ПользовательКоманды = ДоступКабинета.СоздатьПользователяКоманды(Объект.Ссылка, ЛогинИгрока, ПарольИгрока)
        ВыданныйПароль = ПарольСоздания
        ПарольИгрока = ""
        ЛогинИгрока = ""
        СписокПользователей = ДоступКабинета.ПользователиКоманды(Объект.Ссылка)
        СообщениеПользователей = "Пользователь создан и назначен игроком команды. При первом входе он сменит временный пароль."
    поймать Ошибка: Исключение
        ПарольИгрока = ""
        СообщениеПользователей = Ошибка.Описание
    ;
;
