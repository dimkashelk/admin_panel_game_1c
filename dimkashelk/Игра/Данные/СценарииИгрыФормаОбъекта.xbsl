метод СоздатьВерсию(Команда: ОбычнаяКоманда)
    попытка
        ПроверкиДанных.Требовать(не Объект.ЭтоНовый(), "Сначала сохраните сценарий")
        НоваяВерсия = НачальныеДанные.СоздатьВерсиюСценария(Объект.Ссылка)
        Сообщение = "Новая версия создана из сохраненных настроек; откройте ее в списке сценариев."
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;

метод УдалитьОбъект(Команда: ОбычнаяКоманда)
    если Объект.ЭтоНовый()
        возврат
    ;
    знч Ссылка = Объект.Ссылка
    знч Окно = новый ПодтверждениеУдаленияДанных()
    Окно.Описание = "Объект «%{Ссылка}» будет удалён навсегда. Связанные данные должны быть удалены предварительно."
    Окно.Фраза = "УДАЛИТЬ " + Ссылка.Ид.ВСтроку()
    знч Ответ = Окно.ОткрытьВМодальномОкне()
    если Ответ == Неопределено
        возврат
    ;
    попытка
        УдалениеДанныхИгры.УдалитьСценарииИгры(Ссылка, Ответ)
        Закрыть()
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;
