@ВПроекте
метод Требовать(Условие: Булево, Сообщение: Строка)
    если !Условие
        выбросить новый ИсключениеНедопустимыйАргумент(Сообщение)
    ;
;

@ВПроекте
метод ЦелоеНеотрицательное(Значение: Число, ИмяПоля: Строка)
    Требовать(Значение >= 0 && Значение == Значение.Округлить(0, РежимОкругления.Вниз),
        "%{ИмяПоля}: требуется целое неотрицательное число")
;

@ВПроекте
метод ПроверитьПродукт(Параметры: ПараметрыПродукта)
    Требовать(Параметры.КодПродукта != "", "Не задан код продукта")
    ЦелоеНеотрицательное(Параметры.БазовыйСпрос, "Базовый спрос")
    Требовать(Параметры.РеферентнаяЦена > 0, "Референтная цена должна быть положительной")
    Требовать(Параметры.МинимальнаяЦена > 0
        && Параметры.МинимальнаяЦена <= Параметры.РеферентнаяЦена
        && Параметры.РеферентнаяЦена <= Параметры.МаксимальнаяЦена, "Некорректный диапазон цен")
    Требовать(Параметры.Эластичность >= 0 && Параметры.ЧувствительностьКЦене >= 0
        && Параметры.Тренд >= 0, "Коэффициенты рынка должны быть неотрицательными")
;

@ВПроекте
метод ПроверитьПредложение(Предложение: ПредложениеРынка, Параметры: ПараметрыПродукта)
    Требовать(Предложение.Участник != "", "Не задан идентификатор участника")
    ЦелоеНеотрицательное(Предложение.Доступно, "Доступное количество")
    Требовать(Предложение.Цена > 0 && Предложение.Цена == Предложение.Цена.Округлить(2),
        "Цена должна быть положительной с точностью до копейки")
    Требовать(Предложение.Цена >= Параметры.МинимальнаяЦена
        && Предложение.Цена <= Параметры.МаксимальнаяЦена, "Цена вне диапазона сценария")
;

@ВПроекте
метод СтабильныйПриоритет(Ключ: Строка, Seed: Число, Раунд: Число): Число
    // Polynomial hash, modulo 2147483647. This exact rule is part of market-v1.
    пер Значение = (Seed + Раунд * 104729) % 2147483647
    пер Позиция = 0
    пока Позиция < Ключ.Длина()
        Значение = (Значение * 131 + Символы.ПолучитьКод(Ключ[Позиция])) % 2147483647
        Позиция = Позиция + 1
    ;
    возврат Значение
;

@ВПроекте
метод ПроверитьСостояниеПродажи(Факт: ФактПродажи): Число
    Требовать(Факт.ИдРеализации != "" && Факт.ИдРеализации.Длина() <= 128, "Некорректный идентификатор реализации")
    ЦелоеНеотрицательное(Факт.Версия, "Версия факта")
    ЦелоеНеотрицательное(Факт.Отгружено, "Отгружено")
    Требовать(Факт.Версия > 0 && Факт.Цена > 0 && Факт.Цена == Факт.Цена.Округлить(2), "Некорректная версия или цена реализации")
    знч Идентификаторы = <Строка>[]
    пер Оплачено = 0
    для Платеж из Факт.Платежи
        Требовать(Платеж.ИдПлатежа != "" && Платеж.ИдПлатежа.Длина() <= 128
            && !Идентификаторы.Содержит(Платеж.ИдПлатежа), "Некорректный или повторный идентификатор платежа")
        Идентификаторы.Добавить(Платеж.ИдПлатежа)
        ЦелоеНеотрицательное(Платеж.Версия, "Версия платежа")
        Требовать(Платеж.Версия > 0 && Платеж.Сумма >= 0 && Платеж.Сумма == Платеж.Сумма.Округлить(2), "Некорректная версия или сумма платежа")
        Оплачено = Оплачено + Платеж.Сумма
    ;
    Требовать(Оплачено <= Факт.Отгружено * Факт.Цена, "Оплата превышает фактическую реализацию")
    возврат Оплачено
;

@ВПроекте
метод ПроверитьПовторПродажи(Факт: ФактПродажи, Предыдущий: ФактПродажи?): Булево
    ПроверитьСостояниеПродажи(Факт)
    если Предыдущий == Неопределено
        возврат Ложь
    ;
    Требовать(Факт.Расчет == Предыдущий.Расчет && Факт.Участник == Предыдущий.Участник
        && Факт.Продукт == Предыдущий.Продукт && Факт.ИдРеализации == Предыдущий.ИдРеализации, "Чужое состояние реализации")
    Требовать(Факт.Версия >= Предыдущий.Версия, "Устаревшая версия реализации")
    знч Повтор = Факт.Версия == Предыдущий.Версия
    если Повтор
        Требовать(Факт.Отгружено == Предыдущий.Отгружено && Факт.Цена == Предыдущий.Цена
            && Факт.Платежи.Размер() == Предыдущий.Платежи.Размер(), "Та же версия реализации содержит другие данные")
    ;
    для Старый из Предыдущий.Платежи
        пер Найден = Ложь
        для Новый из Факт.Платежи
            если Новый.ИдПлатежа != Старый.ИдПлатежа
                продолжить
            ;
            Найден = Истина
            Требовать(Новый.Версия >= Старый.Версия, "Устаревшая версия платежа")
            если Новый.Версия == Старый.Версия
                Требовать(Новый.Сумма == Старый.Сумма && Новый.Момент == Старый.Момент, "Повтор платежа с другим содержимым")
            ;
            если Повтор
                Требовать(Новый.Версия == Старый.Версия, "Обновленные платежи требуют новой версии реализации")
            ;
        ;
        Требовать(Найден, "В факте пропущен ранее принятый платеж")
    ;
    возврат Повтор
;
