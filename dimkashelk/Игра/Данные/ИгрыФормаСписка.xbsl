импорт Управление

метод СоздатьИгру(Команда: ОбычнаяКоманда)
    ОткрытьИгру(Неопределено)
;

метод ИграВыбрана(Источник: Список<ДинамическийСписок<dimkashelk::Игра::Данные::ИгрыФормаСписка.ДанныеСтрокиСписка>>, Событие: СобытиеСДанными<СтрокаСписка<СтрокаДинамическогоСписка<dimkashelk::Игра::Данные::ИгрыФормаСписка.ДанныеСтрокиСписка>>>)
    ОткрытьИгру(Событие.Данные.ДанныеСтроки.Данные.Ссылка)
;

метод РедактированиеИгры(Источник: Список<ДинамическийСписок<dimkashelk::Игра::Данные::ИгрыФормаСписка.ДанныеСтрокиСписка>>, Событие: СобытиеПриРедактированииСтроки<СтрокаДинамическогоСписка<dimkashelk::Игра::Данные::ИгрыФормаСписка.ДанныеСтрокиСписка>>)
    Событие.СтандартнаяОбработка = Ложь
    ОткрытьИгру(Событие.Строка.Данные.Ссылка)
;

метод ОткрытьИгру(Ссылка: Игры.Ссылка?)
    попытка
        знч Окно = новый НастройкаИгры()
        Окно.Инициализировать(Ссылка)
        Окно.ОткрытьВМодальномОкне()
        Компоненты.ОсновнаяТаблица.Обновить()
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;


метод УдалитьСтроку(Команда: КомандаСПараметром<СтрокаДинамическогоСписка<dimkashelk::Игра::Данные::ИгрыФормаСписка.ДанныеСтрокиСписка>>, Строка: СтрокаДинамическогоСписка<dimkashelk::Игра::Данные::ИгрыФормаСписка.ДанныеСтрокиСписка>)
    знч Ссылка = Строка.Данные.Ссылка
    знч Окно = новый ПодтверждениеУдаленияДанных()
    Окно.Описание = "Игра «%{Ссылка}», её команды, раунды, расчёты, результаты и история обмена будут удалены навсегда. Общие настройки и другие игры сохраняются."
    Окно.Фраза = "УДАЛИТЬ " + Ссылка.Ид.ВСтроку()
    знч Ответ = Окно.ОткрытьВМодальномОкне()
    если Ответ == Неопределено
        возврат
    ;
    попытка
        УдалениеДанныхИгры.УдалитьИгры(Ссылка, Ответ)
        Компоненты.ОсновнаяТаблица.Обновить()
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;
