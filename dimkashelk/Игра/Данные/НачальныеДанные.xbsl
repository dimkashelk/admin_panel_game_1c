@НаСервере @ДоступноСКлиента @ВПроекте
метод СоздатьБазовыйПрофиль(): СценарииИгры.Ссылка
    ДоступИгры.ТребоватьАдминистратора()
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    Блокировки.Заблокировать(новый НоменклатураИгры.Блокировки.ПоКоду(Код = "#base-profile"))
    знч Существующий = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ СценарииИгры
        ГДЕ Наименование == "Велосипеды — базовый профиль" И ВерсияСценария == 1
    }.Выполнить().ПервыйИлиНеопределено()
    если Существующий != Неопределено
        возврат Существующий.Ссылка
    ;
    знч Сценарий = новый СценарииИгры.Объект()
    Сценарий.Наименование = "Велосипеды — базовый профиль"
    Сценарий.ВерсияСценария = 1
    Сценарий.Алгоритм = АлгоритмыРынка.ЦеновыеДоли
    Сценарий.ФиксацияЦен = МоментыФиксацииЦен.ПередПродажами
    Сценарий.ЧислоРаундов = 4
    Сценарий.Описание = "Параметры рынка из Модель_рынка.xlsx. Начальные ресурсы задаются в настройках сценария."
    // TODO: заполнить начальные ресурсы после утверждения состава и количества.
    знч CityRide = ПолучитьИлиСоздатьПродукт("CityRide")
    Сценарий.ПараметрыРынка.Добавить(новый СценарииИгры.ПараметрыРынка(
        Продукт = CityRide, БазовыйСпрос = 120, РеферентнаяЦена = 52000, МинимальнаяЦена = 35000,
        МаксимальнаяЦена = 75000, Эластичность = 1, ЧувствительностьКЦене = 1.35, Тренд = 1))
    знч SportDrive = ПолучитьИлиСоздатьПродукт("SportDrive")
    Сценарий.ПараметрыРынка.Добавить(новый СценарииИгры.ПараметрыРынка(
        Продукт = SportDrive, БазовыйСпрос = 35, РеферентнаяЦена = 82000, МинимальнаяЦена = 60000,
        МаксимальнаяЦена = 120000, Эластичность = 1, ЧувствительностьКЦене = 1.1, Тренд = 0.92))
    знч CargoMax = ПолучитьИлиСоздатьПродукт("CargoMax")
    Сценарий.ПараметрыРынка.Добавить(новый СценарииИгры.ПараметрыРынка(
        Продукт = CargoMax, БазовыйСпрос = 95, РеферентнаяЦена = 90000, МинимальнаяЦена = 65000,
        МаксимальнаяЦена = 130000, Эластичность = 1, ЧувствительностьКЦене = 1.2, Тренд = 1.05))
    знч TourPro = ПолучитьИлиСоздатьПродукт("TourPro")
    Сценарий.ПараметрыРынка.Добавить(новый СценарииИгры.ПараметрыРынка(
        Продукт = TourPro, БазовыйСпрос = 45, РеферентнаяЦена = 88000, МинимальнаяЦена = 65000,
        МаксимальнаяЦена = 125000, Эластичность = 1, ЧувствительностьКЦене = 1.4, Тренд = 1.12))
    для Фаза из [ФазыИгры.СтартоваяПродажа, ФазыИгры.Планирование, ФазыИгры.Закупки,
        ФазыИгры.Производство, ФазыИгры.Продажи, ФазыИгры.Анализ]
        Сценарий.СрокиФаз.Добавить(новый СценарииИгры.СрокиФаз(Фаза = Фаза, ДлительностьМинут = 10))
    ;
    Сценарий.Записать()
    возврат Сценарий.Ссылка
;

@НаСервере
метод ПолучитьИлиСоздатьПродукт(Код: Строка): НоменклатураИгры.Ссылка
    Блокировки.Заблокировать(новый НоменклатураИгры.Блокировки.ПоКоду(Код = Код))
    знч Существующий = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ НоменклатураИгры ГДЕ Код == %Код
    }.Выполнить().ПервыйИлиНеопределено()
    если Существующий != Неопределено
        возврат Существующий.Ссылка
    ;
    знч Продукт = новый НоменклатураИгры.Объект()
    Продукт.Код = Код
    Продукт.Наименование = Код
    Продукт.Вид = ВидыНоменклатурыИгры.ГотоваяПродукция
    Продукт.Единица = "шт"
    Продукт.Активна = Истина
    Продукт.Записать()
    возврат Продукт.Ссылка
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод СоздатьВерсиюСценария(Ссылка: СценарииИгры.Ссылка): СценарииИгры.Ссылка
    ДоступИгры.ТребоватьАдминистратора()
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    Блокировки.Заблокировать(новый НоменклатураИгры.Блокировки.ПоКоду(Код = "#scenario-versions"))
    знч Исходный = Ссылка.ЗагрузитьОбъект(Истина)!
    знч НовыйСценарий = новый СценарииИгры.Объект()
    НовыйСценарий.Наименование = Исходный.Наименование
    знч ПараметрЗапроса2_0 = Исходный.Наименование
    знч Версия = Запрос{
        ВЫБРАТЬ ВерсияСценария ИЗ СценарииИгры
        ГДЕ Наименование == %ПараметрЗапроса2_0
        УПОРЯДОЧИТЬ ПО ВерсияСценария УБЫВ
    }.Выполнить().ПервыйИлиНеопределено()
    НовыйСценарий.ВерсияСценария = (Версия?.ВерсияСценария ?? 0) + 1
    НовыйСценарий.Алгоритм = Исходный.Алгоритм
    НовыйСценарий.ЧислоРаундов = Исходный.ЧислоРаундов
    НовыйСценарий.ФиксацияЦен = МоментыФиксацииЦен.ПередПродажами
    НовыйСценарий.СлучайныеНачальныеРесурсы = Исходный.СлучайныеНачальныеРесурсы
    НовыйСценарий.Описание = Исходный.Описание
    для Строка из Исходный.ПараметрыРынка
        НовыйСценарий.ПараметрыРынка.Добавить(новый СценарииИгры.ПараметрыРынка(Продукт = Строка.Продукт, БазовыйСпрос = Строка.БазовыйСпрос, РеферентнаяЦена = Строка.РеферентнаяЦена, МинимальнаяЦена = Строка.МинимальнаяЦена, МаксимальнаяЦена = Строка.МаксимальнаяЦена, Эластичность = Строка.Эластичность, ЧувствительностьКЦене = Строка.ЧувствительностьКЦене, Тренд = Строка.Тренд))
    ;
    для Строка из Исходный.СрокиФаз
        НовыйСценарий.СрокиФаз.Добавить(новый СценарииИгры.СрокиФаз(Фаза = Строка.Фаза, ДлительностьМинут = Строка.ДлительностьМинут))
    ;
    для Строка из Исходный.НачальныеРесурсы
        НовыйСценарий.НачальныеРесурсы.Добавить(новый СценарииИгры.НачальныеРесурсы(Номенклатура = Строка.Номенклатура, МинимальноеКоличество = Строка.МинимальноеКоличество, МаксимальноеКоличество = Строка.МаксимальноеКоличество, УчетнаяЦена = Строка.УчетнаяЦена))
    ;
    для Строка из Исходный.ТрендыПоРаундам
        НовыйСценарий.ТрендыПоРаундам.Добавить(новый СценарииИгры.ТрендыПоРаундам(НомерРаунда = Строка.НомерРаунда, Продукт = Строка.Продукт, Тренд = Строка.Тренд))
    ;
    НовыйСценарий.Записать()
    возврат НовыйСценарий.Ссылка
;
