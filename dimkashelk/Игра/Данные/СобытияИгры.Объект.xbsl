@Обработчик
метод ПередЗаписью(До: СобытияИгры.Данные, ПараметрыЗаписи: СобытияИгры.ПараметрыЗаписи)
    ПроверкиДанных.Требовать(ЭтоНовый(), "История неизменяема; создайте новую запись")
    ПроверкиДанных.Требовать(Игра != Неопределено && Раунд != Неопределено, "Не указаны игра и раунд")
    ПроверкиДанных.Требовать(Раунд!.ЗагрузитьОбъект()!.Игра == Игра, "Раунд принадлежит другой игре")
;

@Обработчик
метод ПередУдалением(ПараметрыУдаления: СобытияИгры.ПараметрыУдаления)
    выбросить новый ИсключениеНедопустимоеСостояние("История игры не удаляется")
;
