@Обработчик
метод ПередЗаписью(До: СобытияИгры.Данные, ПараметрыЗаписи: СобытияИгры.ПараметрыЗаписи)
    ПроверкиДанных.Требовать(ЭтоНовый(), "История неизменяема; создайте новую запись")
    ПроверкиДанных.Требовать(Игра != Неопределено, "Не указана игра")
    если Раунд == Неопределено
        // Подготовка баз заканчивается до создания раундов. Её результат нельзя откатывать из-за истории.
        ПроверкиДанных.Требовать(Игра!.ЗагрузитьОбъект()!.Статус == СостоянияИгры.Черновик
            и (Вид == "НастройкаERPЗавершена" или Вид == "ОшибкаНастройкиERP"), "Не указан раунд")
    иначе
        ПроверкиДанных.Требовать(Раунд!.ЗагрузитьОбъект()!.Игра == Игра, "Раунд принадлежит другой игре")
    ;
;

@Обработчик
метод ПередУдалением(ПараметрыУдаления: СобытияИгры.ПараметрыУдаления)
    УдалениеДанныхИгры.ПроверитьУдалениеСобытияИгры(Ссылка, ПараметрыУдаления.АдминистративнаяОчистка ?? Ложь)
;
