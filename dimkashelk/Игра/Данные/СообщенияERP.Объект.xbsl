@Обработчик
метод ПередЗаписью(До: СообщенияERP.Данные, ПараметрыЗаписи: СообщенияERP.ПараметрыЗаписи)
    ПроверкиДанных.Требовать(ЭтоНовый(), "История обмена неизменяема")
    ПроверкиДанных.Требовать(Игра != Неопределено и Вид != "" и Ресурс != "", "Неполный конверт ERP")
;

@Обработчик
метод ПередУдалением(ПараметрыУдаления: СообщенияERP.ПараметрыУдаления)
    выбросить новый ИсключениеНедопустимоеСостояние("История обмена не удаляется")
;
