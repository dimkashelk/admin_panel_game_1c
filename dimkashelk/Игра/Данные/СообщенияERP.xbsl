@ВПроекте
метод Текст(Ссылка: СообщенияERP.Ссылка): Строка
    пер Результат = ""
    для Часть из Ссылка.ЗагрузитьОбъект()!.ЧастиТела
        Результат = Результат + Часть.Текст
    ;
    возврат Результат
;

@ВПроекте
метод ЗаполнитьТело(Документ: СообщенияERP.Объект, Тело: Строка)
    пер Позиция = 0
    пока Позиция < Тело.Длина()
        знч Конец = Позиция + 1000 < Тело.Длина() ? Позиция + 1000 : Тело.Длина()
        Документ.ЧастиТела.Добавить(новый СообщенияERP.ЧастиТела(Текст = Тело.Подстрока(Позиция, Конец)))
        Позиция = Конец
    ;
;
