@Обработчик
метод ВычислитьРазрешенияДоступа(): Массив<РазрешениеДоступа>
    возврат [новый РазрешениеДоступа(
        [новый КлючДоступаДляАутентифицированных.Объект()], [Сущность.Право.Чтение])]
;

@Обработчик
метод ВычислитьРазрешенияДоступаДляОбъектов(
    Объекты: ЧитаемыйМассив<РаундыИгры.ДанныеРасчетаРазрешений>
): ЧитаемоеСоответствие<РаундыИгры.ДанныеРасчетаРазрешений, ЧитаемаяКоллекция<РазрешениеДоступа>>
    знч Разрешения = <РаундыИгры.ДанныеРасчетаРазрешений, ЧитаемаяКоллекция<РазрешениеДоступа>>{:}
    для Объект из Объекты
        если Объект.Игра != Неопределено
            Разрешения.Вставить(Объект, ДоступИгры.РазрешенияЧтенияИгры(Объект.Игра))
        ;
    ;
    возврат Разрешения
;

@ВПроекте
метод ЕстьСовпадение1(Игра: Игры.Ссылка?, НомерРаунда: Число, Ссылка: РаундыИгры.Ссылка): Булево
    возврат Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ РаундыИгры
        ГДЕ Игра == %Игра И НомерРаунда == %НомерРаунда И Ссылка != %Ссылка
    }.Выполнить().ПервыйИлиНеопределено() != Неопределено
;
