@Обработчик
метод ПередЗаписью(До: НоменклатураИгры.Данные, ПараметрыЗаписи: НоменклатураИгры.ПараметрыЗаписи)
    ПроверкиДанных.Требовать(Код != "" && Наименование != "" && Единица != "", "Укажите код, название и единицу")
    Блокировки.Заблокировать(новый НоменклатураИгры.Блокировки.ПоКоду(Код = Код))
    знч Дубликат = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ НоменклатураИгры ГДЕ Код == %Код И Ссылка != %Ссылка
    }.Выполнить().ПервыйИлиНеопределено()
    ПроверкиДанных.Требовать(Дубликат == Неопределено, "Код номенклатуры уже используется")
    если !ЭтоНовый() && (Код != До.Код || Вид != До.Вид || Единица != До.Единица || Активна != До.Активна)
        знч Использование = Запрос{
            ВЫБРАТЬ ПЕРВЫЕ 1 Контейнер ИЗ Игры.ПараметрыРынка
            ГДЕ Продукт == %Ссылка И Контейнер.Статус != СостоянияИгры.Черновик
        }.Выполнить().ПервыйИлиНеопределено()
        ПроверкиДанных.Требовать(Использование == Неопределено, "Номенклатура используется в подготовленной игре")
    ;
;
