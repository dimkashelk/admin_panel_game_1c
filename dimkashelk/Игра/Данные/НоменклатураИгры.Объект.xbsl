@Обработчик
метод ПередЗаписью(До: НоменклатураИгры.Данные, ПараметрыЗаписи: НоменклатураИгры.ПараметрыЗаписи)
    ПроверкиДанных.Требовать(Код != "" и Наименование != "" и Единица != "", "Укажите код, название и единицу")
    Блокировки.Заблокировать(новый НоменклатураИгры.Блокировки.ПоКоду(Код = Код))
    знч Дубликат = НоменклатураИгры.ЕстьСовпадение1(Код, Ссылка)
    ПроверкиДанных.Требовать(не Дубликат, "Код номенклатуры уже используется")
    если не ЭтоНовый() и (Код != До.Код или Вид != До.Вид или Единица != До.Единица или Активна != До.Активна)
        знч Использование = НоменклатураИгры.ЕстьСовпадение2(Ссылка)
        ПроверкиДанных.Требовать(не Использование, "Номенклатура используется в подготовленной игре")
    ;
;
