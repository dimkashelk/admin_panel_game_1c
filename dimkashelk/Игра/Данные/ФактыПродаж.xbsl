@ВПроекте
метод Принять(Факт: ФактПродажи, ТестовыеДанные: Булево)
    ПроверкиДанных.Требовать(Транзакции.ЕстьАктивная(), "Прием факта требует транзакции")
    ПроверкиДанных.Требовать(Факт.Расчет != Неопределено && Факт.Участник != Неопределено
        && Факт.Продукт != Неопределено && Факт.ИдРеализации != "", "Неполный факт продажи")
    ПроверкиДанных.ЦелоеНеотрицательное(Факт.Версия, "Версия факта")
    ПроверкиДанных.ЦелоеНеотрицательное(Факт.Отгружено, "Отгружено")
    ПроверкиДанных.Требовать(Факт.Версия > 0, "Версия факта должна быть положительной")
    знч Расчет = Факт.Расчет!.ЗагрузитьОбъект()!
    ДоступИгры.ПроверитьВедущего(Расчет.Игра!)
    знч Игра = Расчет.Игра!.ЗагрузитьОбъект(Истина)!
    ПроверкиДанных.Требовать(Игра.Демонстрационная == ТестовыеДанные
        && Игра.ТекущийРаунд == Расчет.Раунд && Игра.Статус == СостоянияИгры.Идет
        && Игра.Фаза == ФазыИгры.Анализ, "Факт относится к закрытому раунду или другому режиму игры")
    ПроверкиДанных.Требовать(Факт.Участник!.ЗагрузитьОбъект()!.Игра == Игра.Ссылка, "Чужой участник")
    знч Заказ = Запрос{
        ВЫБРАТЬ Заказано, Цена ИЗ РасчетыРынка.Распределение
        ГДЕ Контейнер == %Факт.Расчет И Участник == %Факт.Участник И Продукт == %Факт.Продукт
    }.Выполнить().ПервыйИлиНеопределено()
    ПроверкиДанных.Требовать(Заказ != Неопределено && Факт.Цена == Заказ!.Цена, "Нет заказа или цена отличается от расчета")
    знч Другие = Запрос{
        ВЫБРАТЬ СУММА(Отгружено) КАК Количество ИЗ ИсполнениеПродаж
        ГДЕ Расчет == %Факт.Расчет И Участник == %Факт.Участник И Продукт == %Факт.Продукт
            И ИдРеализацииERP != %Факт.ИдРеализации
    }.Выполнить().ПервыйИлиНеопределено()
    ПроверкиДанных.Требовать(Факт.Отгружено + (Другие?.Количество ?? 0) <= Заказ!.Заказано,
        "Отгрузка превышает заказ рынка")
    знч Предыдущий = Запрос{
        ВЫБРАТЬ ВерсияФакта, Отгружено, Цена, Оплачено ИЗ ИсполнениеПродаж
        ГДЕ Расчет == %Факт.Расчет И Участник == %Факт.Участник И Продукт == %Факт.Продукт
            И ИдРеализацииERP == %Факт.ИдРеализации
    }.Выполнить().ПервыйИлиНеопределено()
    пер СтароеСостояние: ФактПродажи? = Неопределено
    если Предыдущий != Неопределено
        знч СтарыеПлатежи = <ФактПлатежа>[]
        для Платеж из Запрос{
            ВЫБРАТЬ ИдПлатежаERP, СуммаПлатежа, ВерсияФакта, МоментПлатежа ИЗ ПлатежиПродаж
            ГДЕ Расчет == %Факт.Расчет И Участник == %Факт.Участник И Продукт == %Факт.Продукт
                И ИдРеализацииERP == %Факт.ИдРеализации
        }.Выполнить()
            СтарыеПлатежи.Добавить(новый ФактПлатежа(ИдПлатежа = Платеж.ИдПлатежаERP,
                Сумма = Платеж.СуммаПлатежа, Версия = Платеж.ВерсияФакта, Момент = Платеж.МоментПлатежа))
        ;
        СтароеСостояние = новый ФактПродажи(Расчет = Факт.Расчет, Участник = Факт.Участник,
            Продукт = Факт.Продукт, ИдРеализации = Факт.ИдРеализации, Версия = Предыдущий.ВерсияФакта,
            Отгружено = Предыдущий.Отгружено, Цена = Предыдущий.Цена, Платежи = СтарыеПлатежи)
    ;
    знч Оплачено = ПроверкиДанных.ПроверитьСостояниеПродажи(Факт)
    если ПроверкиДанных.ПроверитьПовторПродажи(Факт, СтароеСостояние)
        возврат
    ;
    знч ЗаписиПлатежей = новый ПлатежиПродаж.НаборЗаписей()
    ЗаписиПлатежей.Фильтр.Установить(Расчет = Факт.Расчет, Участник = Факт.Участник,
        Продукт = Факт.Продукт, ИдРеализацииERP = Факт.ИдРеализации)
    для Платеж из Факт.Платежи
        ЗаписиПлатежей.ДобавитьЗапись(Расчет = Факт.Расчет, Участник = Факт.Участник,
            Продукт = Факт.Продукт, ИдРеализацииERP = Факт.ИдРеализации, ИдПлатежаERP = Платеж.ИдПлатежа,
            СуммаПлатежа = Платеж.Сумма, ВерсияФакта = Платеж.Версия, МоментПлатежа = Платеж.Момент)
    ;
    ЗаписиПлатежей.Записать()
    знч Исполнение = новый ИсполнениеПродаж.НаборЗаписей()
    Исполнение.Фильтр.Установить(Расчет = Факт.Расчет, Участник = Факт.Участник,
        Продукт = Факт.Продукт, ИдРеализацииERP = Факт.ИдРеализации)
    Исполнение.ДобавитьЗапись(Расчет = Факт.Расчет, Участник = Факт.Участник,
        Продукт = Факт.Продукт, ИдРеализацииERP = Факт.ИдРеализации, Отгружено = Факт.Отгружено,
        Цена = Факт.Цена, СуммаРеализации = Факт.Отгружено * Факт.Цена, Оплачено = Оплачено, ВерсияФакта = Факт.Версия)
    Исполнение.Записать()
;
