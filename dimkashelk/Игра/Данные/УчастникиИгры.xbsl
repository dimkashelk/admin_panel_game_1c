@Обработчик
метод ВычислитьРазрешенияДоступа(): Массив<РазрешениеДоступа>
    возврат [новый РазрешениеДоступа(
        [новый КлючДоступаДляАутентифицированных.Объект()], [Сущность.Право.Чтение])]
;

@Обработчик
метод ВычислитьРазрешенияДоступаДляОбъектов(
    Объекты: ЧитаемыйМассив<УчастникиИгры.ДанныеРасчетаРазрешений>
): ЧитаемоеСоответствие<УчастникиИгры.ДанныеРасчетаРазрешений, ЧитаемаяКоллекция<РазрешениеДоступа>>
    знч Разрешения = <УчастникиИгры.ДанныеРасчетаРазрешений, ЧитаемаяКоллекция<РазрешениеДоступа>>{:}
    для Объект из Объекты
        если Объект.Игра != Неопределено
            Разрешения.Вставить(Объект, ДоступКабинета.РазрешенияЧтенияКоманд(Объект.Игра, Объект.ПорядокУчастника))
        ;
    ;
    возврат Разрешения
;

@ВПроекте
метод ЕстьСовпадение1(Игра: Игры.Ссылка?, Ссылка: УчастникиИгры.Ссылка, ПорядокУчастника: Число, НаименованиеКоманды: Строка): Булево
    возврат Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ УчастникиИгры
        ГДЕ Игра == %Игра И Ссылка != %Ссылка
            И (ПорядокУчастника == %ПорядокУчастника ИЛИ НаименованиеКоманды == %НаименованиеКоманды)
    }.Выполнить().ПервыйИлиНеопределено() != Неопределено
;
