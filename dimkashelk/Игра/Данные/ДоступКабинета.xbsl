@ВПроекте @НаСервере
метод ПроверитьИгрока(Участник: УчастникиИгры.Ссылка): Игры.Ссылка
    знч Пользователь = ДоступИгры.ТекущийПользователь()
    исп КонтекстДоступа.Привилегированный()
    знч Команда = Участник.ЗагрузитьОбъект()
    ПроверкиДанных.Требовать(Команда != Неопределено и Команда!.Активен и не Команда!.ПометкаУдаления и Команда!.Игра != Неопределено,
        "Команда недоступна")
    знч Игра = Команда!.Игра!
    если ДоступИгры.ЭтоАдминистратор()
        возврат Игра
    ;
    знч ОбъектИгры = Игра.ЗагрузитьОбъект()
    ПроверкиДанных.Требовать(ОбъектИгры != Неопределено и не ОбъектИгры!.ПометкаУдаления
        и ОбъектИгры!.Статус != СостоянияИгры.Завершена и ОбъектИгры!.Статус != СостоянияИгры.Отменена,
        "Игра завершена, отменена или недоступна")
    знч Назначение = Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Пользователь ИЗ ИгрокиКоманд
        ГДЕ Пользователь == %Пользователь И Участник == %Участник И Игра == %Игра И Активно}.Выполнить().ПервыйИлиНеопределено()
    ПроверкиДанных.Требовать(Назначение != Неопределено, "Нет назначения игрока в эту команду")
    возврат Игра
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод МоиКоманды(): Массив<УчастникиИгры.Ссылка>
    знч Пользователь = ДоступИгры.ТекущийПользователь()
    исп КонтекстДоступа.Привилегированный()
    если ДоступИгры.ЭтоАдминистратор()
        возврат Запрос{ВЫБРАТЬ Ссылка ИЗ УчастникиИгры ГДЕ Активен И НЕ ПометкаУдаления И НЕ Игра.ПометкаУдаления
            И Игра.Статус != СостоянияИгры.Завершена И Игра.Статус != СостоянияИгры.Отменена
            УПОРЯДОЧИТЬ ПО Игра.Наименование, ПорядокУчастника}.Выполнить().Преобразовать(Строка -> Строка.Ссылка)
    ;
    возврат Запрос{ВЫБРАТЬ Участник ИЗ ИгрокиКоманд ГДЕ Пользователь == %Пользователь И Активно
        И Участник.Активен И НЕ Участник.ПометкаУдаления И Игра == Участник.Игра
        И НЕ Игра.ПометкаУдаления И Игра.Статус != СостоянияИгры.Завершена И Игра.Статус != СостоянияИгры.Отменена
        УПОРЯДОЧИТЬ ПО Игра.Наименование, Участник.ПорядокУчастника}.Выполнить().Преобразовать(Строка -> Строка.Участник!)
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод НазначитьИгрока(Участник: УчастникиИгры.Ссылка, Пользователь: Пользователи.Ссылка, Активно: Булево)
    ДоступИгры.ТребоватьАдминистратора()
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч Команда = Участник.ЗагрузитьОбъект()!
    ПроверкиДанных.Требовать(Команда.Игра != Неопределено и Команда.Активен и не Команда.ПометкаУдаления, "Команда недоступна")
    ПроверкиДанных.Требовать(не Пользователь.ЗагрузитьОбъект()!.Администратор, "Администратор не может быть назначен игроком")
    знч Игра = Команда.Игра!
    знч ОбъектИгры = Игра.ЗагрузитьОбъект(Истина)!
    ПроверкиДанных.Требовать(ОбъектИгры.Ведущий != Пользователь, "Ведущий этой игры не может быть назначен игроком")
    знч Записи = новый ИгрокиКоманд.НаборЗаписей()
    Записи.Фильтр.Установить(Пользователь = Пользователь, Игра = Игра, Участник = Участник)
    Записи.ДобавитьЗапись(Пользователь = Пользователь, Игра = Игра, Участник = Участник, Активно = Активно)
    Записи.Записать()
    // Назначение игрока заменяет его роль ведущего/наблюдателя в этой игре.
    для Роль из [ПрикладныеРоли.Ведущий, ПрикладныеРоли.Наблюдатель, ПрикладныеРоли.Игрок]
        знч Роли = новый НазначенияПользователей.НаборЗаписей()
        Роли.Фильтр.Установить(Пользователь = Пользователь, Игра = Игра, ПрикладнаяРоль = Роль)
        Роли.ДобавитьЗапись(Пользователь = Пользователь, Игра = Игра, ПрикладнаяРоль = Роль,
            Активно = Роль == ПрикладныеРоли.Игрок и ЕстьАктивноеНазначение(Пользователь, Игра))
        Роли.Записать()
    ;
    ДоступИгры.ПересчитатьЧтение()
;

@ВПроекте @НаСервере
метод РазрешенияЧтенияКоманд(Игра: Игры.Ссылка, ПорядокУчастника: Число): Массив<РазрешениеДоступа>
    знч Разрешения = ДоступИгры.РазрешенияЧтенияИгры(Игра)
    исп КонтекстДоступа.Привилегированный()
    знч ОбъектИгры = Игра.ЗагрузитьОбъект()!
    если ОбъектИгры.ПометкаУдаления или ОбъектИгры.Статус == СостоянияИгры.Завершена или ОбъектИгры.Статус == СостоянияИгры.Отменена
        возврат Разрешения
    ;
    для Назначение из Запрос{ВЫБРАТЬ Пользователь ИЗ ИгрокиКоманд
        ГДЕ Игра == %Игра И Участник.ПорядокУчастника == %ПорядокУчастника И Участник.Игра == %Игра
            И Участник.Активен И НЕ Участник.ПометкаУдаления И Активно}.Выполнить()
        если Назначение.Пользователь != Неопределено
            Разрешения.Добавить(новый РазрешениеДоступа(
                [новый КлючДоступаПользователя.Объект(Владелец = Назначение.Пользователь)], [Сущность.Право.Чтение]))
        ;
    ;
    возврат Разрешения
;

@ВПроекте @НаСервере
метод Завершено(Участник: УчастникиИгры.Ссылка, Раунд: РаундыИгры.Ссылка?, Токен: Строка): Булево
    возврат Запрос{ВЫБРАТЬ Завершено ИЗ ЗаявленияКоманд
        ГДЕ Участник == %Участник И Раунд == %Раунд И ТокенФазы == %Токен}.Выполнить().ПервыйИлиНеопределено()?.Завершено ?? Ложь
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод ВыборКоманд(): Массив<КомандаКабинета>
    знч Ссылки = МоиКоманды()
    исп КонтекстДоступа.Привилегированный()
    знч Строки = <КомандаКабинета>[]
    для Ссылка из Ссылки
        знч Команда = Ссылка.ЗагрузитьОбъект()!
        Строки.Добавить(новый КомандаКабинета(Участник = Ссылка,
            Представление = "%{Команда.Игра!.ЗагрузитьОбъект()!.Наименование} · %{Команда.НаименованиеКоманды}"))
    ;
    возврат Строки
;

@ВПроекте @НаСервере
метод ЕстьАктивноеНазначение(Пользователь: Пользователи.Ссылка, Игра: Игры.Ссылка): Булево
    возврат Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Пользователь ИЗ ИгрокиКоманд
        ГДЕ Пользователь == %Пользователь И Игра == %Игра И Активно}.Выполнить().ПервыйИлиНеопределено() != Неопределено
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод КомандыИгры(Игра: Игры.Ссылка): Массив<КомандаКабинета>
    ДоступИгры.ПроверитьВедущего(Игра)
    исп КонтекстДоступа.Привилегированный()
    возврат Запрос{ВЫБРАТЬ Ссылка, НаименованиеКоманды ИЗ УчастникиИгры
        ГДЕ Игра == %Игра И Активен И НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО ПорядокУчастника}.Выполнить()
        .Преобразовать(Строка -> новый КомандаКабинета(Участник = Строка.Ссылка, Представление = Строка.НаименованиеКоманды))
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод НазначитьВИгре(Игра: Игры.Ссылка, Участник: УчастникиИгры.Ссылка, Пользователь: Пользователи.Ссылка, Активно: Булево)
    ДоступИгры.ТребоватьАдминистратора()
    ПроверкиДанных.Требовать(Участник.ЗагрузитьОбъект()!.Игра == Игра, "Выберите команду выбранной игры")
    НазначитьИгрока(Участник, Пользователь, Активно)
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод ПользователиКоманды(Участник: УчастникиИгры.Ссылка): Строка
    ДоступИгры.ТребоватьАдминистратора()
    пер Текст = ""
    для Строка из Запрос{ВЫБРАТЬ Пользователь, Активно ИЗ ИгрокиКоманд ГДЕ Участник == %Участник}.Выполнить()
        знч Статус = Строка.Активно ? "активен" : "отключён"
        Текст = Текст + "%{Строка.Пользователь.Представление()} · Игрок · %{Статус}\n"
    ;
    возврат Текст == "" ? "В команде пока нет пользователей" : Текст
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод СоздатьПользователяКоманды(Участник: УчастникиИгры.Ссылка, Логин: Строка, ВременныйПароль: Строка): Пользователи.Ссылка
    ДоступИгры.ТребоватьАдминистратора()
    ПроверкиДанных.Требовать(Логин.Сократить() != "" и ВременныйПароль.Длина() >= 8,
        "Укажите логин и временный пароль длиной не менее 8 символов")
    знч Команда = Участник.ЗагрузитьОбъект()!
    ПроверкиДанных.Требовать(Команда.Игра != Неопределено и Команда.Активен и не Команда.ПометкаУдаления,
        "Сначала сохраните активную команду игры")
    знч Список = СпискиПользователей.ПолучитьСписокПоУмолчанию().Ид
    ПроверкиДанных.Требовать(ПользователиСервиса.НайтиПоЛогину(Логин.Сократить(), Список) == Неопределено,
        "Пользователь с этим логином уже существует. Выберите его в поле пользователя и назначьте в команду")
    знч Описание = новый ОписаниеПользователяСервиса(Список, Логин.Сократить(), Логин.Сократить())
    ПользователиСервиса.Создать(Описание)
    ПользователиСервиса.СброситьПароль(Описание.Ид, ВременныйПароль)
    знч Пользователь = Пользователи.Подключить(Описание.Ид, новый Ууид()).Ссылка
    НазначитьИгрока(Участник, Пользователь, Истина)
    возврат Пользователь
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод ДоступноУправление(): Булево
    знч Пользователь = ДоступИгры.ТекущийПользователь()
    если ДоступИгры.ЭтоАдминистратор()
        возврат Истина
    ;
    исп КонтекстДоступа.Привилегированный()
    возврат Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Игры
        ГДЕ Ведущий == %Пользователь И НЕ ПометкаУдаления}.Выполнить().ПервыйИлиНеопределено() != Неопределено
        или Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Пользователь ИЗ НазначенияПользователей
            ГДЕ Пользователь == %Пользователь И Активно И ПрикладнаяРоль == ПрикладныеРоли.Ведущий}.Выполнить().ПервыйИлиНеопределено() != Неопределено
;

@ВПроекте @НаСервере @ДоступноСКлиента
метод ДоступныРезультаты(): Булево
    если ДоступноУправление()
        возврат Истина
    ;
    знч Пользователь = ДоступИгры.ТекущийПользователь()
    исп КонтекстДоступа.Привилегированный()
    возврат Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Пользователь ИЗ НазначенияПользователей
        ГДЕ Пользователь == %Пользователь И Активно И ПрикладнаяРоль == ПрикладныеРоли.Наблюдатель}.Выполнить().ПервыйИлиНеопределено() != Неопределено
;
