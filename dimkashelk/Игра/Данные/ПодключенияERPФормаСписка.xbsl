
метод УдалитьСтроку(Команда: КомандаСПараметром<СтрокаДинамическогоСписка<dimkashelk::Игра::Данные::ПодключенияERPФормаСписка.ДанныеСтрокиСписка>>, Строка: СтрокаДинамическогоСписка<dimkashelk::Игра::Данные::ПодключенияERPФормаСписка.ДанныеСтрокиСписка>)
    знч Ссылка = Строка.Данные.Ссылка
    знч Окно = новый ПодтверждениеУдаленияДанных()
    Окно.Описание = "Объект «%{Ссылка}» будет удалён навсегда. Связанные данные должны быть удалены предварительно."
    Окно.Фраза = "УДАЛИТЬ " + Ссылка.Ид.ВСтроку()
    знч Ответ = Окно.ОткрытьВМодальномОкне()
    если Ответ == Неопределено
        возврат
    ;
    попытка
        УдалениеДанныхИгры.УдалитьПодключенияERP(Ссылка, Ответ)
        Компоненты.ОсновнаяТаблица.Обновить()
    поймать Ошибка: Исключение
        Сообщить(Ошибка.Описание)
    ;
;
