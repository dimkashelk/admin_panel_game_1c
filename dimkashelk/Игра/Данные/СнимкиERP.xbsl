@Обработчик
метод ВычислитьРазрешенияДоступа(): Массив<РазрешениеДоступа>
    возврат [новый РазрешениеДоступа(
        [новый КлючДоступаДляАутентифицированных.Объект()], [Сущность.Право.Чтение])]
;

@Обработчик
метод ВычислитьРазрешенияДоступаДляОбъектов(
    Объекты: ЧитаемыйМассив<СнимкиERP.ДанныеРасчетаРазрешений>
): ЧитаемоеСоответствие<СнимкиERP.ДанныеРасчетаРазрешений, ЧитаемаяКоллекция<РазрешениеДоступа>>
    знч Разрешения = <СнимкиERP.ДанныеРасчетаРазрешений, ЧитаемаяКоллекция<РазрешениеДоступа>>{:}
    для Объект из Объекты
        если Объект.Игра != Неопределено
            Разрешения.Вставить(Объект, ДоступИгры.РазрешенияЧтенияИгры(Объект.Игра))
        ;
    ;
    возврат Разрешения
;
