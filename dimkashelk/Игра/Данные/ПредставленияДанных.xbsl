// Представления старых и новых событий; технические коды в истории сохраняются.
@ВПодсистеме
метод ПредставлениеВида(Вид: Строка): Строка
    если Вид == "НачалоИгры"
        возврат "Начало игры"
    иначе если Вид == "ОтменаИгры"
        возврат "Отмена игры"
    иначе если Вид == "ПереходФазы"
        возврат "Переход фазы"
    иначе если Вид == "ИсключениеКоманды"
        возврат "Исключение команды"
    ;
    возврат Вид
;

@ВПодсистеме
метод ПредставлениеДеталей(Детали: Строка): Строка
    возврат Детали.Заменить("СтартоваяПродажа", "Стартовая продажа")
;
