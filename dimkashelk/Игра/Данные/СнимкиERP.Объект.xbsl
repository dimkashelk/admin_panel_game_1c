@Обработчик
метод ПередЗаписью(До: СнимкиERP.Данные, ПараметрыЗаписи: СнимкиERP.ПараметрыЗаписи)
    ПроверкиДанных.Требовать(ЭтоНовый(), "История неизменяема; создайте новую запись")
    ПроверкиДанных.Требовать(Игра != Неопределено && Раунд != Неопределено, "Не указаны игра и раунд")
    ПроверкиДанных.Требовать(Раунд!.ЗагрузитьОбъект()!.Игра == Игра, "Раунд принадлежит другой игре")
    ПроверкиДанных.Требовать(Участник != Неопределено && Участник!.ЗагрузитьОбъект()!.Игра == Игра,
        "Участник принадлежит другой игре")
    ПроверкиДанных.Требовать(ИдСообщения != "" && ТокенФазы != "", "Нет идентификатора снимка или токена")
    ПроверкиДанных.Требовать(ТестовыеДанные == Игра!.ЗагрузитьОбъект()!.Демонстрационная,
        "Тестовый снимок нельзя использовать в обычной игре")
;

@Обработчик
метод ПередУдалением(ПараметрыУдаления: СнимкиERP.ПараметрыУдаления)
    выбросить новый ИсключениеНедопустимоеСостояние("История игры не удаляется")
;
