@Обработчик
метод ПередЗаписью(До: СнимкиERP.Данные, ПараметрыЗаписи: СнимкиERP.ПараметрыЗаписи)
    ПроверкиДанных.Требовать(ЭтоНовый(), "История неизменяема; создайте новую запись")
    ПроверкиДанных.Требовать(Игра != Неопределено и Раунд != Неопределено, "Не указаны игра и раунд")
    ПроверкиДанных.Требовать(Раунд!.ЗагрузитьОбъект()!.Игра == Игра, "Раунд принадлежит другой игре")
    ПроверкиДанных.Требовать(Участник != Неопределено и Участник!.ЗагрузитьОбъект()!.Игра == Игра,
        "Участник принадлежит другой игре")
    ПроверкиДанных.Требовать(ИдСообщения != "" и ТокенФазы != "", "Нет идентификатора снимка или токена")
;

@Обработчик
метод ПередУдалением(ПараметрыУдаления: СнимкиERP.ПараметрыУдаления)
    УдалениеДанныхИгры.ПроверитьУдалениеСнимкиERP(Ссылка, ПараметрыУдаления.АдминистративнаяОчистка ?? Ложь)
;
