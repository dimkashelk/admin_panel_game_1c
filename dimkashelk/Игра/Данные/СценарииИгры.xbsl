@ВПроекте
метод ЕстьСовпадение1(Наименование: Строка, ВерсияСценария: Число, Ссылка: СценарииИгры.Ссылка): Булево
    возврат Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ СценарииИгры
        ГДЕ Наименование == %Наименование И ВерсияСценария == %ВерсияСценария И Ссылка != %Ссылка
    }.Выполнить().ПервыйИлиНеопределено() != Неопределено
;

@ВПроекте
метод ЕстьСовпадение2(Ссылка: СценарииИгры.Ссылка): Булево
    возврат Запрос{
            ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Игры
            ГДЕ Сценарий == %Ссылка И Статус != СостоянияИгры.Черновик
        }.Выполнить().ПервыйИлиНеопределено() != Неопределено
;

@ВПроекте
метод ЕстьСовпадение3(Ссылка: СценарииИгры.Ссылка): Булево
    возврат Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Игры ГДЕ Сценарий == %Ссылка
    }.Выполнить().ПервыйИлиНеопределено() != Неопределено
;
