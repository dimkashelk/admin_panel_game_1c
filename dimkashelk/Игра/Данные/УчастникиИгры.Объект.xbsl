@Обработчик
метод ПередЗаписью(До: УчастникиИгры.Данные, ПараметрыЗаписи: УчастникиИгры.ПараметрыЗаписи)
    ПроверкиДанных.Требовать(Игра != Неопределено && НаименованиеКоманды != "", "Укажите игру и команду")
    ПроверкиДанных.ЦелоеНеотрицательное(ПорядокУчастника, "Порядок участника")
    знч ИграОбъект = Игра!.ЗагрузитьОбъект(Истина)!
    если ИграОбъект.Статус != СостоянияИгры.Черновик
        ПроверкиДанных.Требовать(!ЭтоНовый() && Игра == До.Игра
            && ПодключениеERP == До.ПодключениеERP && КодОбластиERP == До.КодОбластиERP
            && ПорядокУчастника == До.ПорядокУчастника, "Состав и подключения подготовленной игры зафиксированы")
    ;
    знч Дубликат = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ УчастникиИгры
        ГДЕ Игра == %Игра И Ссылка != %Ссылка
            И (ПорядокУчастника == %ПорядокУчастника ИЛИ НаименованиеКоманды == %НаименованиеКоманды)
    }.Выполнить().ПервыйИлиНеопределено()
    ПроверкиДанных.Требовать(Дубликат == Неопределено, "Имя и порядок команды должны быть уникальными в игре")
;

@Обработчик
метод ПередУдалением(ПараметрыУдаления: УчастникиИгры.ПараметрыУдаления)
    знч ОбъектИгры = Игра!.ЗагрузитьОбъект(Истина)!
    ПроверкиДанных.Требовать(ОбъектИгры.Статус == СостоянияИгры.Черновик, "Подготовленная игра и ее участники не удаляются")
;
