// Административное удаление данных приложения. Сетевых вызовов в ERP нет.
@НаСервере @ДоступноСКлиента @ВПроекте
метод Доступно(): Булево
    возврат ДоступИгры.ЭтоАдминистратор()
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод ПолучитьСводку(): Соответствие<Строка, Число>
    ДоступИгры.ТребоватьАдминистратора()
    исп КонтекстДоступа.Привилегированный()
    знч Сводка = новый Соответствие<Строка, Число>()
    Сводка.Вставить("ПлатежиПродаж", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ ПлатежиПродаж}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    Сводка.Вставить("ИсполнениеПродаж", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ ИсполнениеПродаж}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    Сводка.Вставить("РезультатыРаундов", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ РезультатыРаундов}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    Сводка.Вставить("СостоянияУчастников", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ СостоянияУчастников}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    Сводка.Вставить("ЗаявленияКоманд", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ ЗаявленияКоманд}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    Сводка.Вставить("ИгрокиКоманд", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ ИгрокиКоманд}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    Сводка.Вставить("ПривязкиСервисовERP", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ ПривязкиСервисовERP}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    Сводка.Вставить("НазначенияПользователей", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ НазначенияПользователей}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    Сводка.Вставить("ПринятыеСообщения", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ ПринятыеСообщения}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    Сводка.Вставить("СоответствияERP", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ СоответствияERP}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    Сводка.Вставить("ЗаказыРынка", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ ЗаказыРынка}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    Сводка.Вставить("КомандыОбмена", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ КомандыОбмена}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    Сводка.Вставить("СобытияИгры", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ СобытияИгры}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    Сводка.Вставить("РасчетыРынка", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ РасчетыРынка}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    Сводка.Вставить("СнимкиERP", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ СнимкиERP}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    Сводка.Вставить("СообщенияERP", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ СообщенияERP}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    Сводка.Вставить("РаундыИгры", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ РаундыИгры}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    Сводка.Вставить("УчастникиИгры", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ УчастникиИгры}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    Сводка.Вставить("Игры", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ Игры}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    Сводка.Вставить("СценарииИгры", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ СценарииИгры}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    Сводка.Вставить("НоменклатураИгры", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ НоменклатураИгры}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    Сводка.Вставить("ПодключенияERP", Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ ПодключенияERP}.Выполнить().ПервыйИлиНеопределено()!.Всего)
    возврат Сводка
;

// Сериализуем очистку с игровыми переходами и входящими сообщениями ERP.
// Все игровые операции используют исключительную блокировку объекта игры.
@НаСервере
метод БлокироватьИгры()
    для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ Игры УПОРЯДОЧИТЬ ПО Ссылка}.Выполнить()
        знч Игра = Строка.Ссылка.ЗагрузитьОбъект(Истина)
        если Игра != Неопределено
            ПроверкиДанных.Требовать(Игра.Статус != СостоянияИгры.Подготовка
                и Игра.Статус != СостоянияИгры.Идет и Игра.Статус != СостоянияИгры.Пауза,
                "Перед удалением завершите или отмените игру «%{Игра.Наименование}»")
        ;
    ;
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод Очистить(ВидДанных: Строка, Подтверждение: Строка): Число
    ДоступИгры.ТребоватьАдминистратора()
    ПроверкиДанных.Требовать(Подтверждение == "УДАЛИТЬ " + ВидДанных,
        "Введите точную фразу подтверждения для выбранного вида данных")
    ПроверкиДанных.Требовать(["ВСЕ", "ПлатежиПродаж", "ИсполнениеПродаж", "РезультатыРаундов", "СостоянияУчастников", "ЗаявленияКоманд", "ИгрокиКоманд", "ПривязкиСервисовERP", "НазначенияПользователей", "ПринятыеСообщения", "СоответствияERP", "ЗаказыРынка", "КомандыОбмена", "СобытияИгры", "РасчетыРынка", "СнимкиERP", "СообщенияERP", "РаундыИгры", "УчастникиИгры", "Игры", "СценарииИгры", "НоменклатураИгры", "ПодключенияERP"].Содержит(ВидДанных), "Неизвестный вид данных")
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    БлокироватьИгры()
    пер Удалено = 0
    если ВидДанных == "ВСЕ" или ВидДанных == "ПлатежиПродаж"
        Удалено = Удалено + ОчиститьПлатежиПродаж(ВидДанных == "ВСЕ")
    ;
    если ВидДанных == "ВСЕ" или ВидДанных == "ИсполнениеПродаж"
        Удалено = Удалено + ОчиститьИсполнениеПродаж(ВидДанных == "ВСЕ")
    ;
    если ВидДанных == "ВСЕ" или ВидДанных == "РезультатыРаундов"
        Удалено = Удалено + ОчиститьРезультатыРаундов(ВидДанных == "ВСЕ")
    ;
    если ВидДанных == "ВСЕ" или ВидДанных == "СостоянияУчастников"
        Удалено = Удалено + ОчиститьСостоянияУчастников(ВидДанных == "ВСЕ")
    ;
    если ВидДанных == "ВСЕ" или ВидДанных == "ЗаявленияКоманд"
        Удалено = Удалено + ОчиститьЗаявленияКоманд(ВидДанных == "ВСЕ")
    ;
    если ВидДанных == "ВСЕ" или ВидДанных == "ИгрокиКоманд"
        Удалено = Удалено + ОчиститьИгрокиКоманд(ВидДанных == "ВСЕ")
    ;
    если ВидДанных == "ВСЕ" или ВидДанных == "ПривязкиСервисовERP"
        Удалено = Удалено + ОчиститьПривязкиСервисовERP(ВидДанных == "ВСЕ")
    ;
    если ВидДанных == "ВСЕ" или ВидДанных == "НазначенияПользователей"
        Удалено = Удалено + ОчиститьНазначенияПользователей(ВидДанных == "ВСЕ")
    ;
    если ВидДанных == "ВСЕ" или ВидДанных == "ПринятыеСообщения"
        Удалено = Удалено + ОчиститьПринятыеСообщения(ВидДанных == "ВСЕ")
    ;
    если ВидДанных == "ВСЕ" или ВидДанных == "СоответствияERP"
        Удалено = Удалено + ОчиститьСоответствияERP(ВидДанных == "ВСЕ")
    ;
    если ВидДанных == "ВСЕ" или ВидДанных == "ЗаказыРынка"
        Удалено = Удалено + ОчиститьЗаказыРынка(ВидДанных == "ВСЕ")
    ;
    если ВидДанных == "ВСЕ" или ВидДанных == "КомандыОбмена"
        Удалено = Удалено + ОчиститьКомандыОбмена(ВидДанных == "ВСЕ")
    ;
    если ВидДанных == "ВСЕ" или ВидДанных == "СобытияИгры"
        Удалено = Удалено + ОчиститьСобытияИгры(ВидДанных == "ВСЕ")
    ;
    если ВидДанных == "ВСЕ" или ВидДанных == "РасчетыРынка"
        Удалено = Удалено + ОчиститьРасчетыРынка(ВидДанных == "ВСЕ")
    ;
    если ВидДанных == "ВСЕ" или ВидДанных == "СнимкиERP"
        Удалено = Удалено + ОчиститьСнимкиERP(ВидДанных == "ВСЕ")
    ;
    если ВидДанных == "ВСЕ" или ВидДанных == "СообщенияERP"
        Удалено = Удалено + ОчиститьСообщенияERP(ВидДанных == "ВСЕ")
    ;
    если ВидДанных == "ВСЕ" или ВидДанных == "РаундыИгры"
        Удалено = Удалено + ОчиститьРаундыИгры(ВидДанных == "ВСЕ")
    ;
    если ВидДанных == "ВСЕ" или ВидДанных == "УчастникиИгры"
        Удалено = Удалено + ОчиститьУчастникиИгры(ВидДанных == "ВСЕ")
    ;
    если ВидДанных == "ВСЕ" или ВидДанных == "Игры"
        Удалено = Удалено + ОчиститьИгры(ВидДанных == "ВСЕ")
    ;
    если ВидДанных == "ВСЕ" или ВидДанных == "СценарииИгры"
        Удалено = Удалено + ОчиститьСценарииИгры(ВидДанных == "ВСЕ")
    ;
    если ВидДанных == "ВСЕ" или ВидДанных == "НоменклатураИгры"
        Удалено = Удалено + ОчиститьНоменклатураИгры(ВидДанных == "ВСЕ")
    ;
    если ВидДанных == "ВСЕ" или ВидДанных == "ПодключенияERP"
        Удалено = Удалено + ОчиститьПодключенияERP(ВидДанных == "ВСЕ")
    ;
    возврат Удалено
;

@НаСервере
метод ОчиститьПлатежиПродаж(ПолнаяОчистка: Булево): Число
    знч Всего = Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ ПлатежиПродаж}.Выполнить().ПервыйИлиНеопределено()!.Всего
    знч Записи = новый ПлатежиПродаж.НаборЗаписей()
    Записи.Фильтр.Установить()
    Записи.Записать()
    возврат Всего
;

