@НаСервере
метод ОчиститьИгры(ПолнаяОчистка: Булево): Число
    если не ПолнаяОчистка
        пер УдаленоСИсторией = 0
        для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ Игры УПОРЯДОЧИТЬ ПО Ссылка}.Выполнить()
            УдаленоСИсторией = УдаленоСИсторией + ОчиститьСвязанныеДанныеИгры(Строка.Ссылка)
        ;
        возврат УдаленоСИсторией
    ;
    знч Строки = Запрос{ВЫБРАТЬ Ссылка ИЗ Игры УПОРЯДОЧИТЬ ПО Ссылка}.Выполнить()
    пер Удалено = 0
    для Строка из Строки
        знч Объект = Строка.Ссылка.ЗагрузитьОбъект(Истина)
        если Объект != Неопределено
            Объект.Удалить(новый Игры.ПараметрыУдаления(АдминистративнаяОчистка = Истина))
            Удалено = Удалено + 1
        ;
    ;
    возврат Удалено
;

