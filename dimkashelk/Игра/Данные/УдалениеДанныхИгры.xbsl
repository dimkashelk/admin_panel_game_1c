            ПроверитьСсылкиУчастникиИгры(Строка.Ссылка, Истина)
        ;
    ;
    пер Удалено = 0
    для Строка из Строки
        знч Объект = Строка.Ссылка.ЗагрузитьОбъект(Истина)
        если Объект != Неопределено
            Объект.Удалить(новый УчастникиИгры.ПараметрыУдаления(АдминистративнаяОчистка = Истина))
            Удалено = Удалено + 1
        ;
    ;
    возврат Удалено
;

