    ПроверкиДанных.Требовать(Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Номенклатура
        ИЗ Игры.НачальныеРесурсы ГДЕ Номенклатура == %Ссылка}.Выполнить().Пусто(),
        "Удалению мешают ссылки: Игры.НачальныеРесурсы.Номенклатура. Сначала удалите связанные данные.")
    ПроверкиДанных.Требовать(Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Продукт
        ИЗ Игры.ТрендыПоРаундам ГДЕ Продукт == %Ссылка}.Выполнить().Пусто(),
        "Удалению мешают ссылки: Игры.ТрендыПоРаундам.Продукт. Сначала удалите связанные данные.")
    ПроверкиДанных.Требовать(Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 НоменклатураИгры
        ИЗ СоответствияERP ГДЕ НоменклатураИгры == %Ссылка}.Выполнить().Пусто(),
        "Удалению мешают ссылки: СоответствияERP.НоменклатураИгры. Сначала удалите связанные данные.")
    ПроверкиДанных.Требовать(Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Продукт
        ИЗ ИсполнениеПродаж ГДЕ Продукт == %Ссылка}.Выполнить().Пусто(),
        "Удалению мешают ссылки: ИсполнениеПродаж.Продукт. Сначала удалите связанные данные.")
    ПроверкиДанных.Требовать(Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Продукт
        ИЗ СценарииИгры.ПараметрыРынка ГДЕ Продукт == %Ссылка}.Выполнить().Пусто(),
        "Удалению мешают ссылки: СценарииИгры.ПараметрыРынка.Продукт. Сначала удалите связанные данные.")
    ПроверкиДанных.Требовать(Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Номенклатура
        ИЗ СценарииИгры.НачальныеРесурсы ГДЕ Номенклатура == %Ссылка}.Выполнить().Пусто(),
        "Удалению мешают ссылки: СценарииИгры.НачальныеРесурсы.Номенклатура. Сначала удалите связанные данные.")
    ПроверкиДанных.Требовать(Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Продукт
        ИЗ СценарииИгры.ТрендыПоРаундам ГДЕ Продукт == %Ссылка}.Выполнить().Пусто(),
        "Удалению мешают ссылки: СценарииИгры.ТрендыПоРаундам.Продукт. Сначала удалите связанные данные.")
    ПроверкиДанных.Требовать(Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Продукт
        ИЗ ЗаказыРынка ГДЕ Продукт == %Ссылка}.Выполнить().Пусто(),
        "Удалению мешают ссылки: ЗаказыРынка.Продукт. Сначала удалите связанные данные.")
    ПроверкиДанных.Требовать(Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Продукт
        ИЗ РасчетыРынка.СпросПродуктов ГДЕ Продукт == %Ссылка}.Выполнить().Пусто(),
        "Удалению мешают ссылки: РасчетыРынка.СпросПродуктов.Продукт. Сначала удалите связанные данные.")
    ПроверкиДанных.Требовать(Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Продукт
        ИЗ РасчетыРынка.Распределение ГДЕ Продукт == %Ссылка}.Выполнить().Пусто(),
        "Удалению мешают ссылки: РасчетыРынка.Распределение.Продукт. Сначала удалите связанные данные.")
    ПроверкиДанных.Требовать(Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Продукт
        ИЗ СнимкиERP.Предложения ГДЕ Продукт == %Ссылка}.Выполнить().Пусто(),
        "Удалению мешают ссылки: СнимкиERP.Предложения.Продукт. Сначала удалите связанные данные.")
    ПроверкиДанных.Требовать(Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Номенклатура
        ИЗ СнимкиERP.Остатки ГДЕ Номенклатура == %Ссылка}.Выполнить().Пусто(),
        "Удалению мешают ссылки: СнимкиERP.Остатки.Номенклатура. Сначала удалите связанные данные.")
;

@НаСервере
метод ОчиститьПодключенияERP(ПолнаяОчистка: Булево): Число
    знч Строки = Запрос{ВЫБРАТЬ Ссылка ИЗ ПодключенияERP УПОРЯДОЧИТЬ ПО Ссылка}.Выполнить()
    если не ПолнаяОчистка
        // Проверяем весь набор до удаления первой записи.
        для Строка из Строки
            ПроверитьСсылкиПодключенияERP(Строка.Ссылка, Истина)
        ;
    ;
    пер Удалено = 0
    для Строка из Строки
        знч Объект = Строка.Ссылка.ЗагрузитьОбъект(Истина)
        если Объект != Неопределено
            Объект.Удалить(новый ПодключенияERP.ПараметрыУдаления(АдминистративнаяОчистка = Истина))
            Удалено = Удалено + 1
        ;
    ;
    возврат Удалено
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод УдалитьПодключенияERP(Ссылка: ПодключенияERP.Ссылка, Подтверждение: Строка)
    ДоступИгры.ТребоватьАдминистратора()
    ПроверкиДанных.Требовать(Подтверждение == "УДАЛИТЬ " + Ссылка.Ид.ВСтроку(), "Подтверждение не соответствует объекту")
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    БлокироватьИгры()
    знч Объект = Ссылка.ЗагрузитьОбъект(Истина)
    ПроверкиДанных.Требовать(Объект != Неопределено, "Объект уже удалён")
    Объект!.Удалить()
;

@НаСервере @ВПроекте
метод ПроверитьУдалениеПодключенияERP(Ссылка: ПодключенияERP.Ссылка, АдминистративнаяОчистка: Булево)
    ДоступИгры.ТребоватьАдминистратора()
    если не АдминистративнаяОчистка
        исп КонтекстДоступа.Привилегированный()
        БлокироватьИгры()
        ПроверитьСсылкиПодключенияERP(Ссылка, Ложь)
    ;
;

@НаСервере
метод ПроверитьСсылкиПодключенияERP(Ссылка: ПодключенияERP.Ссылка, УдаляетсяВесьВид: Булево)
    ПроверкиДанных.Требовать(Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 ПодключениеERP
        ИЗ УчастникиИгры ГДЕ ПодключениеERP == %Ссылка}.Выполнить().Пусто(),
        "Удалению мешают ссылки: УчастникиИгры.ПодключениеERP. Сначала удалите связанные данные.")
    ПроверкиДанных.Требовать(Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Подключение
        ИЗ ПринятыеСообщения ГДЕ Подключение == %Ссылка}.Выполнить().Пусто(),
        "Удалению мешают ссылки: ПринятыеСообщения.Подключение. Сначала удалите связанные данные.")
    ПроверкиДанных.Требовать(Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Подключение
        ИЗ СоответствияERP ГДЕ Подключение == %Ссылка}.Выполнить().Пусто(),
        "Удалению мешают ссылки: СоответствияERP.Подключение. Сначала удалите связанные данные.")
;


// Удаление одной игры сохраняет общие настройки и данные других игр.
// Соответствия ERP и общий журнал ПринятыеСообщения не имеют измерения Игра
// и не очищаются по подключению, которое может использоваться другой игрой.
@НаСервере
метод ОчиститьСвязанныеДанныеИгры(Ссылка: Игры.Ссылка): Число
    знч Игра = Ссылка.ЗагрузитьОбъект(Истина)
    ПроверкиДанных.Требовать(Игра != Неопределено, "Игра уже удалена")
    ПроверкиДанных.Требовать(Игра!.Статус != СостоянияИгры.Подготовка
        и Игра!.Статус != СостоянияИгры.Идет и Игра!.Статус != СостоянияИгры.Пауза,
        "Перед удалением завершите или отмените выбранную игру")
    ПроверкиДанных.Требовать(Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Игры
        ГДЕ КонтекстДоступаИгры == %Ссылка И Ссылка != %Ссылка}.Выполнить().Пусто(),
        "Другая игра использует контекст доступа выбранной игры")
    пер Удалено = 0
    для Строка из Запрос{ВЫБРАТЬ Расчет, Участник, Продукт, ИдРеализацииERP, ИдПлатежаERP ИЗ ПлатежиПродаж
        ГДЕ Расчет.Игра == %Ссылка ИЛИ Участник.Игра == %Ссылка}.Выполнить()
        знч Записи = новый ПлатежиПродаж.НаборЗаписей()
        Записи.Фильтр.Установить(Расчет = Строка.Расчет, Участник = Строка.Участник, Продукт = Строка.Продукт, ИдРеализацииERP = Строка.ИдРеализацииERP, ИдПлатежаERP = Строка.ИдПлатежаERP)
        Записи.Записать()
        Удалено = Удалено + 1
    ;
    для Строка из Запрос{ВЫБРАТЬ Расчет, Участник, Продукт, ИдРеализацииERP ИЗ ИсполнениеПродаж
        ГДЕ Расчет.Игра == %Ссылка ИЛИ Участник.Игра == %Ссылка}.Выполнить()
        знч Записи = новый ИсполнениеПродаж.НаборЗаписей()
        Записи.Фильтр.Установить(Расчет = Строка.Расчет, Участник = Строка.Участник, Продукт = Строка.Продукт, ИдРеализацииERP = Строка.ИдРеализацииERP)
        Записи.Записать()
        Удалено = Удалено + 1
    ;
    для Строка из Запрос{ВЫБРАТЬ Раунд, Участник ИЗ РезультатыРаундов
        ГДЕ Раунд.Игра == %Ссылка ИЛИ Участник.Игра == %Ссылка}.Выполнить()
        знч Записи = новый РезультатыРаундов.НаборЗаписей()
        Записи.Фильтр.Установить(Раунд = Строка.Раунд, Участник = Строка.Участник)
        Записи.Записать()
        Удалено = Удалено + 1
    ;
    для Строка из Запрос{ВЫБРАТЬ Участник, Раунд, ТокенФазы ИЗ СостоянияУчастников
        ГДЕ Участник.Игра == %Ссылка ИЛИ Раунд.Игра == %Ссылка}.Выполнить()
        знч Записи = новый СостоянияУчастников.НаборЗаписей()
        Записи.Фильтр.Установить(Участник = Строка.Участник, Раунд = Строка.Раунд, ТокенФазы = Строка.ТокенФазы)
        Записи.Записать()
        Удалено = Удалено + 1
    ;
    для Строка из Запрос{ВЫБРАТЬ Участник, Раунд, ТокенФазы ИЗ ЗаявленияКоманд
        ГДЕ Участник.Игра == %Ссылка ИЛИ Раунд.Игра == %Ссылка}.Выполнить()
        знч Записи = новый ЗаявленияКоманд.НаборЗаписей()
        Записи.Фильтр.Установить(Участник = Строка.Участник, Раунд = Строка.Раунд, ТокенФазы = Строка.ТокенФазы)
        Записи.Записать()
        Удалено = Удалено + 1
    ;
    для Строка из Запрос{ВЫБРАТЬ Пользователь, Игра, Участник ИЗ ИгрокиКоманд
        ГДЕ Игра == %Ссылка ИЛИ Участник.Игра == %Ссылка}.Выполнить()
        знч Записи = новый ИгрокиКоманд.НаборЗаписей()
        Записи.Фильтр.Установить(Пользователь = Строка.Пользователь, Игра = Строка.Игра, Участник = Строка.Участник)
        Записи.Записать()
        Удалено = Удалено + 1
    ;
    для Строка из Запрос{ВЫБРАТЬ СервисныйПользователь, Участник ИЗ ПривязкиСервисовERP
        ГДЕ Участник.Игра == %Ссылка}.Выполнить()
        знч Записи = новый ПривязкиСервисовERP.НаборЗаписей()
        Записи.Фильтр.Установить(СервисныйПользователь = Строка.СервисныйПользователь, Участник = Строка.Участник)
        Записи.Записать()
        Удалено = Удалено + 1
    ;
    для Строка из Запрос{ВЫБРАТЬ Пользователь, Игра, ПрикладнаяРоль ИЗ НазначенияПользователей
        ГДЕ Игра == %Ссылка}.Выполнить()
        знч Записи = новый НазначенияПользователей.НаборЗаписей()
        Записи.Фильтр.Установить(Пользователь = Строка.Пользователь, Игра = Строка.Игра, ПрикладнаяРоль = Строка.ПрикладнаяРоль)
        Записи.Записать()
        Удалено = Удалено + 1
    ;
    для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ ЗаказыРынка ГДЕ Игра == %Ссылка УПОРЯДОЧИТЬ ПО Ссылка}.Выполнить()
        знч Объект = Строка.Ссылка.ЗагрузитьОбъект(Истина)
        если Объект != Неопределено
            Объект.Удалить(новый ЗаказыРынка.ПараметрыУдаления(АдминистративнаяОчистка = Истина))
            Удалено = Удалено + 1
        ;
    ;
    для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ КомандыОбмена ГДЕ Игра == %Ссылка УПОРЯДОЧИТЬ ПО Ссылка}.Выполнить()
        знч Объект = Строка.Ссылка.ЗагрузитьОбъект(Истина)
        если Объект != Неопределено
            Объект.Удалить(новый КомандыОбмена.ПараметрыУдаления(АдминистративнаяОчистка = Истина))
            Удалено = Удалено + 1
        ;
    ;
    для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ СобытияИгры ГДЕ Игра == %Ссылка УПОРЯДОЧИТЬ ПО Ссылка}.Выполнить()
        знч Объект = Строка.Ссылка.ЗагрузитьОбъект(Истина)
        если Объект != Неопределено
            Объект.Удалить(новый СобытияИгры.ПараметрыУдаления(АдминистративнаяОчистка = Истина))
            Удалено = Удалено + 1
        ;
    ;
    для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ РасчетыРынка ГДЕ Игра == %Ссылка УПОРЯДОЧИТЬ ПО Ссылка}.Выполнить()
        знч Объект = Строка.Ссылка.ЗагрузитьОбъект(Истина)
        если Объект != Неопределено
            Объект.Удалить(новый РасчетыРынка.ПараметрыУдаления(АдминистративнаяОчистка = Истина))
            Удалено = Удалено + 1
        ;
    ;
    для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ СнимкиERP ГДЕ Игра == %Ссылка УПОРЯДОЧИТЬ ПО Ссылка}.Выполнить()
        знч Объект = Строка.Ссылка.ЗагрузитьОбъект(Истина)
        если Объект != Неопределено
            Объект.Удалить(новый СнимкиERP.ПараметрыУдаления(АдминистративнаяОчистка = Истина))
            Удалено = Удалено + 1
        ;
    ;
    для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ СообщенияERP ГДЕ Игра == %Ссылка УПОРЯДОЧИТЬ ПО Ссылка}.Выполнить()
        знч Объект = Строка.Ссылка.ЗагрузитьОбъект(Истина)
        если Объект != Неопределено
            Объект.Удалить(новый СообщенияERP.ПараметрыУдаления(АдминистративнаяОчистка = Истина))
            Удалено = Удалено + 1
        ;
    ;
    для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ РаундыИгры ГДЕ Игра == %Ссылка УПОРЯДОЧИТЬ ПО Ссылка}.Выполнить()
        знч Объект = Строка.Ссылка.ЗагрузитьОбъект(Истина)
        если Объект != Неопределено
            Объект.Удалить(новый РаундыИгры.ПараметрыУдаления(АдминистративнаяОчистка = Истина))
            Удалено = Удалено + 1
        ;
    ;
    для Строка из Запрос{ВЫБРАТЬ Ссылка ИЗ УчастникиИгры ГДЕ Игра == %Ссылка УПОРЯДОЧИТЬ ПО Ссылка}.Выполнить()
        знч Объект = Строка.Ссылка.ЗагрузитьОбъект(Истина)
        если Объект != Неопределено
            Объект.Удалить(новый УчастникиИгры.ПараметрыУдаления(АдминистративнаяОчистка = Истина))
            Удалено = Удалено + 1
        ;
    ;
    знч УдаляемаяИгра = Ссылка.ЗагрузитьОбъект(Истина)!
    УдаляемаяИгра.Удалить(новый Игры.ПараметрыУдаления(АдминистративнаяОчистка = Истина))
    возврат Удалено + 1
;
