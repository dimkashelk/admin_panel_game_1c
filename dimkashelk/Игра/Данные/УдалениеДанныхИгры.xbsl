@НаСервере
метод ОчиститьЗаказыРынка(ПолнаяОчистка: Булево): Число
    знч Строки = Запрос{ВЫБРАТЬ Ссылка ИЗ ЗаказыРынка УПОРЯДОЧИТЬ ПО Ссылка}.Выполнить()
    если не ПолнаяОчистка
        // Проверяем весь набор до удаления первой записи.
        для Строка из Строки
            ПроверитьСсылкиЗаказыРынка(Строка.Ссылка, Истина)
        ;
    ;
    пер Удалено = 0
    для Строка из Строки
        знч Объект = Строка.Ссылка.ЗагрузитьОбъект(Истина)
        если Объект != Неопределено
            Объект.Удалить(новый ЗаказыРынка.ПараметрыУдаления(АдминистративнаяОчистка = Истина))
            Удалено = Удалено + 1
        ;
    ;
    возврат Удалено
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод УдалитьЗаказыРынка(Ссылка: ЗаказыРынка.Ссылка, Подтверждение: Строка)
    ДоступИгры.ТребоватьАдминистратора()
    ПроверкиДанных.Требовать(Подтверждение == "УДАЛИТЬ " + Ссылка.Ид.ВСтроку(), "Подтверждение не соответствует объекту")
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    БлокироватьИгры()
    знч Объект = Ссылка.ЗагрузитьОбъект(Истина)
    ПроверкиДанных.Требовать(Объект != Неопределено, "Объект уже удалён")
    Объект!.Удалить()
;

@НаСервере @ВПроекте
метод ПроверитьУдалениеЗаказыРынка(Ссылка: ЗаказыРынка.Ссылка, АдминистративнаяОчистка: Булево)
    ДоступИгры.ТребоватьАдминистратора()
    если не АдминистративнаяОчистка
        исп КонтекстДоступа.Привилегированный()
        БлокироватьИгры()
        ПроверитьСсылкиЗаказыРынка(Ссылка, Ложь)
    ;
;

@НаСервере
метод ПроверитьСсылкиЗаказыРынка(Ссылка: ЗаказыРынка.Ссылка, УдаляетсяВесьВид: Булево)
;

@НаСервере
метод ОчиститьКомандыОбмена(ПолнаяОчистка: Булево): Число
    знч Строки = Запрос{ВЫБРАТЬ Ссылка ИЗ КомандыОбмена УПОРЯДОЧИТЬ ПО Ссылка}.Выполнить()
    если не ПолнаяОчистка
        // Проверяем весь набор до удаления первой записи.
        для Строка из Строки
