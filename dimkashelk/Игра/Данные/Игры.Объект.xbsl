@ВПроекте
метод ПроверитьНастройки()
    ПроверкиДанных.Требовать(Наименование != "", "Укажите название")
    ПроверкиДанных.ЦелоеНеотрицательное(ЧислоРаундов, "Число раундов")
    ПроверкиДанных.Требовать(ЧислоРаундов > 0, "Нужен хотя бы один производственный раунд")
    ПроверкиДанных.Требовать(ПараметрыРынка.Размер() == 4, "В сценарии нужны четыре модели велосипедов")
    знч Продукты = <НоменклатураИгры.Ссылка>[]
    для Строка из ПараметрыРынка
        ПроверкиДанных.Требовать(Строка.Продукт != Неопределено, "Не указан продукт")
        ПроверкиДанных.Требовать(не Продукты.Содержит(Строка.Продукт!), "Продукт указан дважды")
        Продукты.Добавить(Строка.Продукт!)
        знч Продукт = Строка.Продукт!.ЗагрузитьОбъект()!
        ПроверкиДанных.Требовать(Продукт.Активна и Продукт.Вид == ВидыНоменклатурыИгры.ГотоваяПродукция
            и Продукт.Единица == "шт", "Нужна активная готовая продукция в штуках")
        ПроверкиДанных.ПроверитьПродукт(новый ПараметрыПродукта(КодПродукта = Продукт.Код,
            БазовыйСпрос = Строка.БазовыйСпрос, РеферентнаяЦена = Строка.РеферентнаяЦена,
            МинимальнаяЦена = Строка.МинимальнаяЦена, МаксимальнаяЦена = Строка.МаксимальнаяЦена,
            Эластичность = Строка.Эластичность, ЧувствительностьКЦене = Строка.ЧувствительностьКЦене,
            Тренд = Строка.Тренд))
    ;
    знч Фазы = <ФазыИгры>[]
    для Срок из СрокиФаз
        ПроверкиДанных.Требовать(не Фазы.Содержит(Срок.Фаза), "Срок фазы задан дважды")
        Фазы.Добавить(Срок.Фаза)
        ПроверкиДанных.ЦелоеНеотрицательное(Срок.ДлительностьМинут, "Длительность фазы")
    ;
    знч Ресурсы = <НоменклатураИгры.Ссылка>[]
    для Ресурс из НачальныеРесурсы
        ПроверкиДанных.Требовать(Ресурс.Номенклатура != Неопределено, "Не указан начальный ресурс")
        ПроверкиДанных.Требовать(не Ресурсы.Содержит(Ресурс.Номенклатура!), "Начальный ресурс указан дважды")
        Ресурсы.Добавить(Ресурс.Номенклатура!)
        если Ресурс.Номенклатура!.ЗагрузитьОбъект()!.Вид == ВидыНоменклатурыИгры.ГотоваяПродукция
            ПроверкиДанных.ЦелоеНеотрицательное(Ресурс.МинимальноеКоличество, "Минимум готовой продукции")
            ПроверкиДанных.ЦелоеНеотрицательное(Ресурс.МаксимальноеКоличество, "Максимум готовой продукции")
        ;
        ПроверкиДанных.Требовать(Ресурс.МинимальноеКоличество >= 0
            и Ресурс.МаксимальноеКоличество >= Ресурс.МинимальноеКоличество и Ресурс.УчетнаяЦена >= 0,
            "Некорректный диапазон начальных ресурсов")
    ;
    знч Тренды = <Строка>[]
    для Тренд из ТрендыПоРаундам
        ПроверкиДанных.ЦелоеНеотрицательное(Тренд.НомерРаунда, "Номер раунда тренда")
        ПроверкиДанных.Требовать(Тренд.Продукт != Неопределено и Тренд.НомерРаунда <= ЧислоРаундов
            и Тренд.Тренд >= 0 и Продукты.Содержит(Тренд.Продукт!), "Некорректный тренд раунда")
        знч Ключ = "%{Тренд.НомерРаунда}:%{Тренд.Продукт}"
        ПроверкиДанных.Требовать(не Тренды.Содержит(Ключ), "Тренд продукта в раунде задан дважды")
        Тренды.Добавить(Ключ)
    ;
;

@Обработчик
метод ПередЗаписью(До: Игры.Данные, ПараметрыЗаписи: Игры.ПараметрыЗаписи)
    КонтекстДоступаИгры = Ссылка
    ПроверкиДанных.Требовать(Ведущий != Неопределено и Наименование != "", "Укажите ведущего и название игры")
    если ЭтоНовый()
        ПроверкиДанных.Требовать(Статус == СостоянияИгры.Черновик, "Новая игра создается в черновике")
    ;
    если Статус != СостоянияИгры.Черновик
        ПроверитьНастройки()
    ;
    если не ЭтоНовый() и До.Статус != СостоянияИгры.Черновик
        ПроверкиДанных.Требовать(Статус != СостоянияИгры.Черновик, "Подготовленная игра не возвращается в черновик")
        если До.Статус == СостоянияИгры.Завершена или До.Статус == СостоянияИгры.Отменена
            ПроверкиДанных.Требовать(Статус == До.Статус и ТекущийРаунд == До.ТекущийРаунд
                и Фаза == До.Фаза и ТокенФазы == До.ТокенФазы, "Завершенную или отмененную игру нельзя возобновить")
        ;
        ПроверкиДанных.Требовать(Сценарий == До.Сценарий и Seed == До.Seed
            и Алгоритм == До.Алгоритм и ЧислоРаундов == До.ЧислоРаундов
            и ПрофильERP == До.ПрофильERP
            и СвободныйРынок == До.СвободныйРынок
            и Демонстрационная == До.Демонстрационная и ФиксацияЦен == До.ФиксацияЦен
            и СлучайныеНачальныеРесурсы == До.СлучайныеНачальныеРесурсы
            и ВерсияАлгоритма == До.ВерсияАлгоритма и ВерсияСценария == До.ВерсияСценария,
            "Правила подготовленной игры неизменяемы")
        если До.ОтпечатокНастроек != ""
            ПроверкиДанных.Требовать(ОтпечатокТабличныхНастроек() == До.ОтпечатокНастроек,
                "Настройки подготовленной игры неизменяемы")
        ;
    ;
    если Статус != СостоянияИгры.Черновик
        ОтпечатокНастроек = ОтпечатокТабличныхНастроек()
    ;
;

@Обработчик
метод ПередУдалением(ПараметрыУдаления: Игры.ПараметрыУдаления)
    знч ОбъектИгры = этот
    ПроверкиДанных.Требовать(ОбъектИгры.Статус == СостоянияИгры.Черновик, "Подготовленная игра и ее участники не удаляются")
;

@Обработчик
метод ПослеЗаписи(До: Игры.Данные, ПараметрыЗаписи: Игры.ПараметрыЗаписи)
    если До.Ведущий != Ведущий
        исп КонтекстДоступа.Привилегированный()
        ДоступИгры.ПересчитатьЧтение()
    ;
;

метод ОтпечатокТабличныхНастроек(): Строка
    пер Данные = "game-settings-v1"
    для Строка из ПараметрыРынка
        Данные = Данные + "|market:%{Строка.Продукт}:%{Строка.БазовыйСпрос}:%{Строка.РеферентнаяЦена}:%{Строка.МинимальнаяЦена}:%{Строка.МаксимальнаяЦена}:%{Строка.Эластичность}:%{Строка.ЧувствительностьКЦене}:%{Строка.Тренд}"
    ;
    для Строка из СрокиФаз
        Данные = Данные + "|time:%{Строка.Фаза}:%{Строка.ДлительностьМинут}"
    ;
    для Строка из НачальныеРесурсы
        Данные = Данные + "|stock:%{Строка.Номенклатура}:%{Строка.МинимальноеКоличество}:%{Строка.МаксимальноеКоличество}:%{Строка.УчетнаяЦена}"
    ;
    для Строка из ТрендыПоРаундам
        Данные = Данные + "|trend:%{Строка.НомерРаунда}:%{Строка.Продукт}:%{Строка.Тренд}"
    ;
    возврат Ууид.Версия5(Данные).ВСтроку()
;
