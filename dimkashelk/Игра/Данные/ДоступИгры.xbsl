@ВПроекте
@НаСервере
метод ТекущийПользователь(): Пользователи.Ссылка
    знч Пользователь = Пользователи.ТекущийПользователь
    если Пользователь == Неопределено
        выбросить новый ИсключениеНедопустимоеСостояние("Войдите в приложение")
    ;
    возврат Пользователь
;

@ВПроекте
@НаСервере
метод ЭтоАдминистратор(): Булево
    знч Пользователь = ТекущийПользователь()
    возврат Пользователь.ЗагрузитьОбъект()!.Администратор
;

@ВПроекте
@НаСервере
метод ТребоватьАдминистратора()
    если не ЭтоАдминистратор()
        выбросить новый ИсключениеНедопустимоеСостояние("Действие доступно администратору приложения")
    ;
;

@ВПроекте
@НаСервере
метод ПроверитьВедущего(Игра: Игры.Ссылка)
    знч Пользователь = ТекущийПользователь()
    если ЭтоАдминистратор()
        возврат
    ;
    исп КонтекстДоступа.Привилегированный()
    знч Объект = Игра.ЗагрузитьОбъект()
    если Объект == Неопределено
        выбросить новый ИсключениеНедопустимоеСостояние("Игра недоступна")
    ;
    если Объект.Ведущий == Пользователь
        возврат
    ;
    знч Назначение = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 Пользователь
        ИЗ НазначенияПользователей
        ГДЕ Пользователь == %Пользователь И Игра == %Игра
            И ПрикладнаяРоль == ПрикладныеРоли.Ведущий И Активно
    }.Выполнить().ПервыйИлиНеопределено()
    если Назначение == Неопределено
        выбросить новый ИсключениеНедопустимоеСостояние("Нет назначения ведущего на эту игру")
    ;
;

@ВПроекте
@НаСервере
метод ПроверитьРезультаты(Игра: Игры.Ссылка)
    знч Пользователь = ТекущийПользователь()
    если ЭтоАдминистратор()
        возврат
    ;
    исп КонтекстДоступа.Привилегированный()
    знч Объект = Игра.ЗагрузитьОбъект()
    если Объект == Неопределено
        выбросить новый ИсключениеНедопустимоеСостояние("Игра недоступна")
    ;
    если Объект.Ведущий == Пользователь
        возврат
    ;
    знч Назначения = Запрос{
        ВЫБРАТЬ ПрикладнаяРоль
        ИЗ НазначенияПользователей
        ГДЕ Пользователь == %Пользователь И Игра == %Игра И Активно
    }.Выполнить()
    для Назначение из Назначения
        если Назначение.ПрикладнаяРоль == ПрикладныеРоли.Ведущий
            или (Назначение.ПрикладнаяРоль == ПрикладныеРоли.Наблюдатель и Объект.РезультатыОпубликованы)
            возврат
        ;
    ;
    выбросить новый ИсключениеНедопустимоеСостояние("Нет доступа к опубликованным результатам игры")
;

@ВПроекте
@НаСервере
метод РазрешенияЧтенияИгры(Игра: Игры.Ссылка): Массив<РазрешениеДоступа>
    // Only leaders read private entities. Observers use the published results service.
    исп КонтекстДоступа.Привилегированный()
    знч Разрешения = <РазрешениеДоступа>[]
    знч Объект = Игра.ЗагрузитьОбъект()
    если Объект == Неопределено
        возврат Разрешения
    ;
    если Объект.Ведущий != Неопределено
        Разрешения.Добавить(новый РазрешениеДоступа(
            [новый КлючДоступаПользователя.Объект(Владелец = Объект.Ведущий)], [Сущность.Право.Чтение]))
    ;
    для Назначение из Запрос{
        ВЫБРАТЬ Пользователь ИЗ НазначенияПользователей
        ГДЕ Игра == %Игра И Активно И ПрикладнаяРоль == ПрикладныеРоли.Ведущий
    }.Выполнить()
        если Назначение.Пользователь != Неопределено
            Разрешения.Добавить(новый РазрешениеДоступа(
                [новый КлючДоступаПользователя.Объект(Владелец = Назначение.Пользователь)], [Сущность.Право.Чтение]))
        ;
    ;
    возврат Разрешения
;

@ВПроекте
@НаСервере
метод ПересчитатьЧтение()
    Игры.ПересчитатьРазрешенияДоступаДляОбъектов()
    УчастникиИгры.ПересчитатьРазрешенияДоступаДляОбъектов()
    РаундыИгры.ПересчитатьРазрешенияДоступаДляОбъектов()
    СнимкиERP.ПересчитатьРазрешенияДоступаДляОбъектов()
    РасчетыРынка.ПересчитатьРазрешенияДоступаДляОбъектов()
    СобытияИгры.ПересчитатьРазрешенияДоступаДляОбъектов()
;

@НаСервере @ДоступноСКлиента @ВПроекте
метод НазначитьПользователя(Игра: Игры.Ссылка, Пользователь: Пользователи.Ссылка,
    Роль: ПрикладныеРоли, Активно: Булево)
    ТребоватьАдминистратора()
    ПроверкиДанных.Требовать(Роль == ПрикладныеРоли.Ведущий или Роль == ПрикладныеРоли.Наблюдатель,
        "Назначение сервиса ERP будет доступно на этапе интеграции")
    исп КонтекстДоступа.Привилегированный()
    исп Транзакции.Начать()
    знч ИграОбъект = Игра.ЗагрузитьОбъект(Истина)!
    знч Назначения = новый НазначенияПользователей.НаборЗаписей()
    Назначения.Фильтр.Установить(Игра = Игра, Пользователь = Пользователь, ПрикладнаяРоль = Роль)
    Назначения.ДобавитьЗапись(Игра = Игра, Пользователь = Пользователь, ПрикладнаяРоль = Роль, Активно = Активно)
    Назначения.Записать()
    ПересчитатьЧтение()
;
