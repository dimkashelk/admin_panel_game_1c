{
  "openapi": "3.1.0",
  "info": {
    "title": "API обмена экономической игры с ERP",
    "version": "0.1.0-design",
    "description": "Проект прикладного HTTP API Элемента 10.0. Реализация отсутствует. Это не спецификация стандартного OData ERP. Транспорт OData адаптируется к тем же предметным данным и операциям."
  },
  "servers": [
    {
      "url": "/api/game/v1",
      "description": "Относительно адреса приложения Элемента; префикс /api добавляет платформа."
    }
  ],
  "security": [
    {
      "platformBearer": []
    }
  ],
  "paths": {
    "/bindings/{bindingId}/context": {
      "get": {
        "operationId": "getContext",
        "summary": "Получить доступный контекст игры",
        "parameters": [
          {
            "name": "bindingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Назначенная аутентифицированному сервису привязка к участнику игры."
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный результат; для повторного POST возвращается прежний ресурс.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Context"
                }
              }
            }
          },
          "401": {
            "description": "Требуется аутентификация.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Нет прав на привязку или операцию.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Несовместимое состояние, старый токен или конфликт ключа повтора.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Неверные или неполные данные.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Временная недоступность.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/bindings/{bindingId}/snapshots": {
      "post": {
        "operationId": "submitSnapshot",
        "summary": "Передать снимок ERP",
        "parameters": [
          {
            "name": "bindingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Назначенная аутентифицированному сервису привязка к участнику игры."
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Совпадает с messageId; повтор с иным маршрутом или телом отклоняется."
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный результат; для повторного POST возвращается прежний ресурс.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "401": {
            "description": "Требуется аутентификация.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Нет прав на привязку или операцию.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Несовместимое состояние, старый токен или конфликт ключа повтора.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Неверные или неполные данные.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Временная недоступность.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SnapshotRequest"
              },
              "example": {
                "messageId": "f3247bb9-9192-4f73-9a58-0ed88e45d3ab",
                "phaseToken": "d9b326e9-8332-4647-803d-9e687ed4ad6a",
                "roundNumber": 1,
                "sourceVersion": "erp-freeze-1",
                "capturedAt": "2026-10-06T15:00:00+03:00",
                "kind": "frozen",
                "currency": "RUB",
                "offers": [
                  {
                    "productCode": "CityRide",
                    "price": "52000.00",
                    "availableQuantity": 30
                  },
                  {
                    "productCode": "SportDrive",
                    "price": "82000.00",
                    "availableQuantity": 10
                  },
                  {
                    "productCode": "CargoMax",
                    "price": "90000.00",
                    "availableQuantity": 25
                  },
                  {
                    "productCode": "TourPro",
                    "price": "88000.00",
                    "availableQuantity": 12
                  }
                ],
                "balances": []
              }
            }
          }
        },
        "description": "Для final обязателен financials; для frozen и final требуется подтверждённая фиксация источника. Набор offers должен содержать все продукты текущей игры без повторов. Monitoring не является входом окончательного расчёта."
      }
    },
