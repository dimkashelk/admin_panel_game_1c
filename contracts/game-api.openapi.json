    "/bindings/{bindingId}/sales-events": {
      "post": {
        "operationId": "submitSalesEvent",
        "summary": "Передать состояние реализации и связанных оплат",
        "parameters": [
          {
            "name": "bindingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Назначенная аутентифицированному сервису привязка к участнику игры."
          },
          {
