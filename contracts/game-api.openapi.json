                }
              }
            }
          },
          "403": {
            "description": "Нет прав на привязку или операцию.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Несовместимое состояние, старый токен или конфликт ключа повтора.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Неверные или неполные данные.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Временная недоступность.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadinessRequest"
              }
            }
          }
        },
        "description": "snapshotId — resourceId ранее принятого снимка того же участника, раунда и токена. Старый снимок и неподтверждённая фиксация отклоняются."
      }
    },
    "/bindings/{bindingId}/commands": {
      "get": {
        "operationId": "getCommands",
        "summary": "Получить неподтверждённые команды по порядку",
        "parameters": [
          {
            "name": "bindingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Назначенная аутентифицированному сервису привязка к участнику игры."
          },
          {
            "name": "afterSequence",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный результат; для повторного POST возвращается прежний ресурс.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Требуется аутентификация.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Нет прав на привязку или операцию.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Несовместимое состояние, старый токен или конфликт ключа повтора.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Неверные или неполные данные.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Временная недоступность.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "GET не подтверждает выполнение. Предыдущую неподтверждённую команду нельзя пропустить по afterSequence. Один исполнитель ERP последовательно обрабатывает очередь участника."
      }
    },
