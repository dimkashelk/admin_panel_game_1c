              }
            }
          }
        },
        "description": "Передаётся актуальное накопленное состояние конкретной реализации с монотонной stateVersion, а не дельта для повторного суммирования. Сервер сверяет заказ, расчёт, цены и платежи. После финализации требуется отдельная процедура исправления."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "platformBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Штатная аутентификация платформы; точный способ получения токена подтвердить на выбранной сборке."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "message": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "code",
          "message",
          "correlationId"
        ],
        "additionalProperties": false
      },
      "Accepted": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "format": "uuid"
          },
          "resourceId": {
            "type": "string",
            "format": "uuid"
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "required": [
          "messageId",
          "resourceId",
          "replayed"
        ],
        "additionalProperties": false
      },
      "Context": {
        "type": "object",
        "properties": {
          "gameId": {
            "type": "string",
            "format": "uuid"
          },
          "participantId": {
            "type": "string",
            "format": "uuid"
          },
          "roundNumber": {
            "type": "integer",
            "minimum": 0
          },
          "phaseCode": {
            "type": "string",
            "enum": [
              "initialization",
              "initial_sales",
              "planning",
              "purchasing",
              "production",
              "sales",
              "analysis"
            ]
          },
          "phaseToken": {
            "type": "string",
            "format": "uuid"
          },
          "stateVersion": {
            "type": "integer",
            "minimum": 1
          },
          "gameState": {
            "type": "string",
            "enum": [
              "draft",
              "preparing",
              "running",
              "paused",
              "completed",
              "cancelled"
            ]
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "consistentSnapshot",
                "phaseGuard",
                "idempotentCommands",
                "salesFacts",
                "finalFinancials"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "gameId",
          "participantId",
          "roundNumber",
          "phaseCode",
          "phaseToken",
          "stateVersion",
          "gameState",
          "capabilities"
        ],
        "additionalProperties": false
      },
      "Offer": {
        "type": "object",
        "properties": {
          "productCode": {
            "type": "string",
            "enum": [
              "CityRide",
              "SportDrive",
              "CargoMax",
              "TourPro"
            ]
          },
          "price": {
            "type": "string",
            "pattern": "^(?!0\\.00$)(0|[1-9][0-9]*)\\.[0-9]{2}$",
            "description": "Цена должна быть положительной; диапазон проверяет сервер по сценарию."
          },
          "availableQuantity": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "productCode",
          "price",
          "availableQuantity"
        ],
        "additionalProperties": false
      },
      "Balance": {
        "type": "object",
        "properties": {
          "itemCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "quantity": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
          },
          "unitCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "warehouseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "characteristicId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "itemCode",
          "quantity",
          "unitCode",
          "warehouseId"
        ],
        "additionalProperties": false
      },
      "Financials": {
        "type": "object",
        "properties": {
          "cash": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
          },
          "profit": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
          },
          "customerDebt": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$",
            "description": "Десятичная сумма в строке, два знака после точки."
          },
          "supplierDebt": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$",
            "description": "Десятичная сумма в строке, два знака после точки."
          },
          "monthClosed": {
            "type": "boolean"
          }
        },
        "required": [
          "cash",
          "profit",
          "customerDebt",
          "supplierDebt",
          "monthClosed"
        ],
        "additionalProperties": false
      },
      "SnapshotRequest": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "format": "uuid"
          },
          "phaseToken": {
            "type": "string",
            "format": "uuid"
          },
          "roundNumber": {
            "type": "integer",
            "minimum": 0
          },
          "sourceVersion": {
